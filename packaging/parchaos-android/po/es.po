#: files/parchaos-android:90 files/parchaos-android:118
msgid "Android Apps"
msgstr "Aplicaciones de Android"

#: files/parchaos-android:94
msgid "Install an APK File…"
msgstr "Instalar un archivo APK…"

#: files/parchaos-android:97
msgid "Stop Android"
msgstr "Detener Android"

#. Not set up yet.
#: files/parchaos-android:109
msgid "Set Up"
msgstr "Configurar"

#: files/parchaos-android:119
msgid ""
"Run Android apps in their own windows. Setting up downloads the Android "
"system from the Waydroid project (about 800 MB) and needs your password. "
"Android only runs while you use an Android app."
msgstr "Usa aplicaciones de Android en sus propias ventanas. La configuración descarga el sistema Android del proyecto Waydroid (unos 800 MB) y pide tu contraseña. Android solo se ejecuta mientras usas una aplicación de Android."

#. Set up, Android stopped.
#: files/parchaos-android:124
msgid "Start Android"
msgstr "Iniciar Android"

#: files/parchaos-android:127
msgid "Android Is Not Running"
msgstr "Android no se está ejecutando"

#: files/parchaos-android:128
msgid ""
"Start Android to see and manage your apps. Opening an Android app from the "
"launcher starts it too."
msgstr "Inicia Android para ver y administrar tus aplicaciones. Abrir una aplicación de Android desde el lanzador también lo inicia."

#: files/parchaos-android:133 files/parchaos-android:159
msgid "Installed Android Apps"
msgstr "Aplicaciones de Android instaladas"

#: files/parchaos-android:162
msgid "No Android apps yet. Install an APK file with the + button."
msgstr "Todavía no hay aplicaciones de Android. Instala un archivo APK con el botón +."

#: files/parchaos-android:165
msgid "Open"
msgstr "Abrir"

#: files/parchaos-android:168 files/parchaos-android:208
msgid "Remove"
msgstr "Quitar"

#: files/parchaos-android:179
msgid "Setting up. This can take several minutes."
msgstr "Configurando. Esto puede tardar varios minutos."

#: files/parchaos-android:186
#, python-format
msgid "Setup did not finish: %s"
msgstr "La configuración no terminó: %s"

#: files/parchaos-android:194
msgid "Starting Android…"
msgstr "Iniciando Android…"

#: files/parchaos-android:202
#, python-format
msgid "Could not open the app: %s"
msgstr "No se pudo abrir la aplicación: %s"

#: files/parchaos-android:205
#, python-format
msgid "Remove %s?"
msgstr "¿Quitar %s?"

#: files/parchaos-android:206
msgid "The app and its data are removed from Android."
msgstr "La aplicación y sus datos se quitan de Android."

#: files/parchaos-android:207
msgid "Cancel"
msgstr "Cancelar"

#: files/parchaos-android:218
msgid "Android apps (APK)"
msgstr "Aplicaciones de Android (APK)"

#: files/parchaos-android:222
msgid "Install an APK File"
msgstr "Instalar un archivo APK"

#: files/parchaos-android:229
msgid "Installing…"
msgstr "Instalando…"

#: files/parchaos-android:241
msgid "Installed."
msgstr "Instalada."

#: files/parchaos-android:241
#, python-format
msgid "Could not install: %s"
msgstr "No se pudo instalar: %s"