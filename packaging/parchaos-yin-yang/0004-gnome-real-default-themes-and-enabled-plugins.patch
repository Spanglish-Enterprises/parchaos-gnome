+def _gnome_prefers_dark() -> bool:
+    """ParchaOS: start from the desktop's real mode, so the first toggle on a
+    fresh config isn't a no-op on an already-dark GNOME desktop."""
+    if get_desktop() != Desktop.GNOME:
+        return False
+    try:
+        out = subprocess.run(['gsettings', 'get', 'org.gnome.desktop.interface', 'color-scheme'],
+                             capture_output=True, text=True).stdout
+    except OSError:
+        return False
+    return 'prefer-dark' in out
+
+
 def get_desktop() -> Desktop:
     desktop = os.getenv('XDG_CURRENT_DESKTOP')
     if desktop is None:
