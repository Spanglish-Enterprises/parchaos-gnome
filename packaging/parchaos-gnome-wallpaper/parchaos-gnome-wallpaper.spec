# ==============================================================================
# ParchaOS (GNOME) default desktop wallpaper -- a single 4K (3840x2160)
# PNG, generated from branding/logo/: a dark vertical gradient (0x16161e
# to 0x26262e, matching parchaos-gtk-theme's ParchaOS-Dark palette) with
# ParchaOS's real passion-fruit logo centered as a very subtle (~6%
# opacity) watermark, not a loud centerpiece -- meant to look like a
# clean dark desktop background first, ParchaOS-branded second.
#
# Applied as both the light and dark picture-uri (GNOME only shows one
# wallpaper regardless of system theme unless picture-uri and
# picture-uri-dark differ; this image suits both, so both keys point
# at the same file) via customize.sh's existing dconf mechanism.
# ==============================================================================

Name:           parchaos-gnome-wallpaper
Version:        2026.09.23
Release:        7%{?dist}
Summary:        ParchaOS (GNOME) desktop wallpapers

License:        CC-BY-SA-4.0
URL:            https://github.com/Spanglish-Enterprises/parchaos-gnome
Source0:        parchaos-gnome-wallpaper-files.tar.gz
# Time-of-day "Hills" (ticket #166): drawn at build time, see the script.
Source1:        make-time-of-day.py
Source90:       LICENSE-ARTWORK
BuildArch:      noarch
BuildRequires:  python3
BuildRequires:  python3-cairo
BuildRequires:  ImageMagick

%description
ParchaOS's wallpapers, all drawn from scratch: "Hills", the same rolling hills
at dawn, by day, at dusk and at night, which can follow the time of day or
light and dark mode; and the default dark gradient with ParchaOS's
passion-fruit logo as a subtle watermark (generated from branding/logo/).

%prep
%setup -q -c -n %{name}-%{version}
cp -p %{SOURCE90} .

%build
python3 %{SOURCE1} hills

%install
mkdir -p %{buildroot}
cp -a usr %{buildroot}/
install -m 0644 hills/*.jpg hills/*-thumb.png %{buildroot}%{_datadir}/backgrounds/parchaos/hills/

%files
%license LICENSE-ARTWORK
%{_datadir}/backgrounds/parchaos/
%{_datadir}/gnome-background-properties/parchaos-wallpapers.xml

