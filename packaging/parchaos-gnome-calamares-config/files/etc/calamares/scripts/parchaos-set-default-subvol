#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Real bug found via a real full install + reboot test on actual UEFI
# hardware, reproduced and root-caused in a VM (2026-09-23), one step
# past Release 13's mount.conf fix: even with /boot merged into @root
# (no more separate sibling @boot subvolume), the GRUB menu still
# showed no OS entry -- only the auto-generated "UEFI Firmware
# Settings" fallback, and the system still fell back to booting
# whatever live media was still attached instead.
#
# Root cause: @root is a NAMED subvolume (id 256 in testing), not the
# btrfs filesystem's DEFAULT subvolume (id 5, the neutral top level).
# GRUB's generated grub.cfg does a raw `search --fs-uuid --set=root
# <uuid>` with no subvol= option at all -- exactly like mounting the
# partition with no -o subvol= -- which lands at the top level
# (subvolid 5), where the only visible things are the "@root"/"@home"
# subvolume directories themselves, not their contents. blscfg (which
# populates the BLS-based boot menu at boot time) then looks for
# /loader/entries relative to that top level and finds nothing, since
# the real files are nested inside @root, not at the top level.
# Confirmed directly, both ways: mounting the raw partition with no
# subvol= option before this fix showed only "@root"/"@home" as
# subdirectories; after running `btrfs subvolume set-default` on
# @root's own subvolume id, the exact same raw mount showed @root's
# real content directly at "/", including a correctly-reachable
# /boot/loader/entries/*.conf.
#
# Fixed the standard, real-world way btrfs-root distros make GRUB's
# subvolume-blind raw search work at all: set @root as the
# filesystem's own default subvolume, so anything that mounts the raw
# partition with no explicit subvol= option -- including GRUB itself
# at real boot time -- lands inside @root directly.
set -e

ROOT_SUBVOL_ID="$(btrfs subvolume show / | awk -F': *' '/Subvolume ID/ {print $2}')"
if [ -z "$ROOT_SUBVOL_ID" ]; then
    echo "parchaos-set-default-subvol: could not determine root subvolume id" >&2
    exit 1
fi

btrfs subvolume set-default "$ROOT_SUBVOL_ID" /
