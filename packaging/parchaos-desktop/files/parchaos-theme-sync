def extension_call(method, uuid):
    """Ask GNOME Shell to switch one extension on or off in this session."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync('org.gnome.Shell.Extensions', '/org/gnome/Shell/Extensions',
                      'org.gnome.Shell.Extensions', method, GLib.Variant('(s)', (uuid,)),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error:
        pass  # the shell is not up yet; the extension list settles at login


