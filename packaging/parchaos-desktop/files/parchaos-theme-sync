#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# parchaos-theme-sync: keep the GTK, window and Shell themes in step with
# the appearance (light or dark) and the ParchaOS style (Glass or Classic).
#
# Light/dark is GNOME's color-scheme; libadwaita apps follow it on their
# own, but GTK 3 apps and the Shell theme use a named theme. This service
# picks ParchaOS-Light or ParchaOS-Dark, with the -solid variant for the
# Classic style, whenever either setting changes (Parcha Controls, ParchaOS
# Welcome, ParchaOS Settings or GNOME Settings). Themes that aren't
# ParchaOS are the user's own choice and are left alone.
#
#   parchaos-theme-sync            run as a user service
#   parchaos-theme-sync --once     apply once and exit
#
# Original code for ParchaOS, GPL-3.0-or-later.

import os
import re
import subprocess
import sys

import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib  # noqa: E402

THEMES_DIR = '/usr/share/themes'
ICONS_DIR = '/usr/share/icons'
TARGETS = [
    ('org.gnome.desktop.interface', 'gtk-theme'),
    ('org.gnome.desktop.wm.preferences', 'theme'),
    ('org.gnome.shell.extensions.user-theme', 'name'),
]


def settings(schema_id):
    source = Gio.SettingsSchemaSource.get_default()
    found = source.lookup(schema_id, True) if source else None
    return Gio.Settings(settings_schema=found) if found else None


def wanted_theme(dark, classic):
    return f'ParchaOS-{"Dark" if dark else "Light"}{"-solid" if classic else ""}'


ICON_VARIANT = re.compile(r'^ParchaOS-(dark|light)-[A-Z][a-z]+$')


def wanted_icon_theme(dark, colour, current):
    """The icon theme that matches the light/dark scheme and folder colour.

    Returns None when nothing should change: an account that uses another
    icon theme is left alone, and the default colour changes nothing unless
    a colour variant is being switched off (ticket #79).
    """
    base = 'ParchaOS-dark' if dark else 'ParchaOS-light'
    if colour == 'passion':
        return base if ICON_VARIANT.match(current) else None
    if not current.startswith('ParchaOS'):
        return None
    return f'{base}-{colour.capitalize()}'


def available(name, roots):
    return any(os.path.isdir(os.path.join(root, name)) for root in roots)


def migrated(value, system_root):
    """Carry a pre-rename theme name across ticket #100.

    #100 renamed the installed theme dirs from MacTahoe* to ParchaOS*, so
    an existing account's stored value names a theme the package no longer
    ships. Rewrite it to the ParchaOS name whenever that theme is installed
    system-wide.

    A private ~/.themes or ~/.icons copy of the old name does NOT keep it:
    ParchaOS ships no MacTahoe-named theme any more, and the only such
    copies in practice are the ones useradd made from /etc/skel at account
    creation. Those are frozen at that moment, and the Shell and GTK 3
    prefer them over /usr/share, so honoring them (as the first version of
    this function did, treating them as "the user's own choice") meant the
    migration did nothing for anyone whose account came from the installer
    -- found on real hardware, where it also hid every later theme update.
    The old files are left in place, just no longer used.
    """
    if not value.startswith('MacTahoe'):
        return value
    renamed = 'ParchaOS' + value[len('MacTahoe'):]
    return renamed if available(renamed, [system_root]) else value


def gtk4_links(config_dir, themes_dir, theme):
    """Point the account's GTK 4 stylesheets at `theme`.

    libadwaita apps ignore the theme setting and read only ~/.config/gtk-4.0,
    which a new account gets from /etc/skel as links to one frozen copy of
    the dark glass stylesheet. So Classic and light mode never reached them
    (ticket #135: Parcher's folder button kept its glass capsule). The links
    are moved to the system theme that matches the style and appearance.
    Only links that still point at the skel copies (or at a ParchaOS theme)
    are touched; a stylesheet of the user's own is left alone. Returns True
    if anything changed.
    """
    source = os.path.join(themes_dir, theme, 'gtk-4.0', 'gtk.css')
    if not os.path.isfile(source) or not os.path.isdir(config_dir):
        return False
    changed = False
    for name in ('gtk.css', 'gtk-dark.css'):
        link = os.path.join(config_dir, name)
        if os.path.lexists(link):
            if not os.path.islink(link):
                continue
            current = os.readlink(link)
            ours = current in ('gtk-Dark.css', 'gtk-Light.css') or \
                os.path.join(themes_dir, 'ParchaOS-') in current
            if not ours:
                continue
            if current == source:
                continue
        tmp = link + '.parchaos-tmp'
        if os.path.lexists(tmp):
            os.remove(tmp)
        os.symlink(source, tmp)
        os.replace(tmp, link)
        changed = True
    return changed


class ThemeSync:
    def __init__(self):
        self.interface = Gio.Settings(schema_id='org.gnome.desktop.interface')
        self.desktop = settings('org.parchaos.desktop')
        self.targets = [(s, key) for s, key in ((settings(i), k) for i, k in TARGETS) if s]

    def watch(self):
        self.interface.connect('changed::color-scheme', lambda *_: self.apply())
        if self.desktop is not None:
            self.desktop.connect('changed::style', lambda *_: self.apply())
            if 'folder-colour' in self.desktop.props.settings_schema.list_keys():
                self.desktop.connect('changed::folder-colour', lambda *_: self.apply())

    def _sync_icon_theme(self, dark):
        if self.desktop is None or 'folder-colour' not in self.desktop.props.settings_schema.list_keys():
            return
        current = self.interface.get_string('icon-theme')
        wanted = wanted_icon_theme(dark, self.desktop.get_string('folder-colour'), current)
        if wanted and wanted != current and available(wanted, [ICONS_DIR]):
            self.interface.set_string('icon-theme', wanted)
            Gio.Settings.sync()

    def apply(self):
        # #100 migration first, so it runs even when the wanted theme is
        # missing and a stale name is the reason nothing can be applied.
        changed = False
        for target, key in self.targets:
            current = target.get_string(key)
            name = migrated(current, THEMES_DIR)
            if name != current:
                target.set_string(key, name)
                changed = True
        icon = self.interface.get_string('icon-theme')
        icon_name = migrated(icon, ICONS_DIR)
        if icon_name != icon:
            self.interface.set_string('icon-theme', icon_name)
            changed = True
        if changed:
            Gio.Settings.sync()

        dark = self.interface.get_string('color-scheme') == 'prefer-dark'
        self._sync_icon_theme(dark)
        classic = self.desktop is not None and self.desktop.get_string('style') == 'classic'
        theme = wanted_theme(dark, classic)
        if not os.path.isdir(os.path.join(THEMES_DIR, theme)):
            return
        gtk4_links(os.path.expanduser('~/.config/gtk-4.0'), THEMES_DIR, theme)
        for target, key in self.targets:
            current = target.get_string(key)
            if current.startswith('ParchaOS') and current != theme:
                target.set_string(key, theme)
        Gio.Settings.sync()


BLUR_DOCK_KEY = '/org/gnome/shell/extensions/blur-my-shell/dash-to-dock/blur'


class GlassEffects:
    """The optional refractive-glass switch (ParchaOS Settings > Appearance).

    The glass itself is drawn by ParchaOS's own glass library (parchaos-glass) from the
    session and Parcha Controls extensions, which watch this setting. What is left here:
      * refraction belongs to the Glass style: Classic switches it off;
      * the dock's own blur (Blur My Shell) would paint over the glass, so it is turned
        off while refraction is on and put back afterwards.
    """

    def __init__(self, desktop):
        self.desktop = desktop

    def usable(self):
        return (self.desktop is not None
                and 'glass-effects' in self.desktop.props.settings_schema.list_keys())

    def watch(self):
        if self.usable():
            self.desktop.connect('changed::glass-effects', lambda *_: self.apply(True))
            self.desktop.connect('changed::style', lambda *_: self.apply())

    def apply(self, changed=False):
        if not self.usable():
            return
        if (self.desktop.get_string('style') == 'classic'
                and self.desktop.get_boolean('glass-effects')):
            self.desktop.set_boolean('glass-effects', False)
            return
        if self.desktop.get_boolean('glass-effects'):
            subprocess.run(['dconf', 'write', BLUR_DOCK_KEY, 'false'], check=False)
        elif changed:
            subprocess.run(['dconf', 'reset', BLUR_DOCK_KEY], check=False)


RECOLOR = '/usr/libexec/parchaos-recolor-titlebuttons'


def recolor_user_buttons():
    """Give an older account's libadwaita window buttons the ParchaOS colours.

    ~/.config/gtk-4.0 is a copy of /etc/skel made when the account was
    created, so it still holds the original button art (ticket #111). The
    helper skips files it already recolored, so this is cheap to repeat.
    """
    assets = os.path.expanduser('~/.config/gtk-4.0/windows-assets')
    if os.path.isdir(assets) and os.access(RECOLOR, os.X_OK):
        subprocess.run([RECOLOR, assets], check=False, capture_output=True)


def main(argv):
    recolor_user_buttons()
    sync = ThemeSync()
    sync.apply()
    glass = GlassEffects(sync.desktop)
    glass.apply()
    if '--once' in argv:
        return 0
    sync.watch()
    glass.watch()
    GLib.MainLoop().run()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
