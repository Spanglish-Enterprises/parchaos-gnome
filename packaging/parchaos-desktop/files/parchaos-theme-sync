class GlassEffects:
    """The optional glass-effects switch (ParchaOS Settings > Appearance).

    On: the glass extension runs, drawing the standard Quick Settings toggles
    as separate pieces of glass, and Parcha Controls steps aside so that panel
    is the one shown. Off: back to Parcha Controls.
    """

    def __init__(self, desktop):
        self.desktop = desktop

    def usable(self):
        return (self.desktop is not None
                and 'glass-effects' in self.desktop.props.settings_schema.list_keys()
                and os.path.isdir('/usr/share/gnome-shell/extensions/' + GLASS_EXTENSION))

    def watch(self):
        if self.usable():
            self.desktop.connect('changed::glass-effects', lambda *_: self.apply(True))

    def apply_preset(self):
        """Give the extension ParchaOS's look each time the switch goes on.

        Every toggle is its own capsule of glass (mode 1), with the glass
        drawn exactly over the toggle and dark text chosen for bright
        backgrounds.
        """
        directory = os.path.join('/usr/share/gnome-shell/extensions', GLASS_EXTENSION, 'schemas')
        try:
            source = Gio.SettingsSchemaSource.new_from_directory(
                directory, Gio.SettingsSchemaSource.get_default(), False)
        except GLib.Error:
            return
        schema = source.lookup(GLASS_SCHEMA, False)
        if schema is None:
            return
        store = Gio.Settings(settings_schema=schema)
        keys = schema.list_keys()
        # The dock's own blur would paint over the glass.
        subprocess.run(['dconf', 'write', BLUR_DOCK_KEY, 'false'], check=False)
        for key, value in GLASS_PRESET.items():
            if key not in keys:
                continue
            if isinstance(value, bool):
                store.set_boolean(key, value)
            elif isinstance(value, int):
                store.set_int(key, value)
            elif isinstance(value, float):
                store.set_double(key, value)
            else:
                store.set_string(key, value)

    def apply(self, changed=False):
        if not self.usable():
            return
        if self.desktop.get_boolean('glass-effects'):
            self.apply_preset()
            extension_call('EnableExtension', GLASS_EXTENSION)
            extension_call('DisableExtension', CONTROLS_EXTENSION)
        elif changed:
            subprocess.run(['dconf', 'reset', BLUR_DOCK_KEY], check=False)
            extension_call('DisableExtension', GLASS_EXTENSION)
            extension_call('EnableExtension', CONTROLS_EXTENSION)


RECOLOR = '/usr/libexec/parchaos-recolor-titlebuttons'


def recolor_user_buttons():
    """Give an older account's libadwaita window buttons the ParchaOS colours.

    ~/.config/gtk-4.0 is a copy of /etc/skel made when the account was
    created, so it still holds the original button art (ticket #111). The
    helper skips files it already recolored, so this is cheap to repeat.
    """
    assets = os.path.expanduser('~/.config/gtk-4.0/windows-assets')
    if os.path.isdir(assets) and os.access(RECOLOR, os.X_OK):
        subprocess.run([RECOLOR, assets], check=False, capture_output=True)


def main(argv):
    recolor_user_buttons()
    sync = ThemeSync()
    sync.apply()
    glass = GlassEffects(sync.desktop)
    glass.apply()
    if '--once' in argv:
        return 0
    sync.watch()
    glass.watch()
    GLib.MainLoop().run()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
