[Unit]
Description=ParchaOS safe mode (extensions off when booted with parchaos.safe-mode)
Documentation=https://parchaos.org/support
# Has to be in place before anyone can log in.
Before=display-manager.service gdm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/parchaos-safe-mode
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
