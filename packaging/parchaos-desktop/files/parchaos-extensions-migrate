#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# parchaos-extensions-migrate: turn on newly added default extensions for
# users who have their own enabled-extensions list.
#
# The default list ships in /etc/dconf/db/local.d/00-parchaos-extensions,
# but it's only a default: once a user has turned any extension on or off,
# their own list replaces it, and extensions ParchaOS adds later (the
# launcher, Controls, session restore, ...) never turn on for them.
#
# Runs at login. Each default extension is offered once: if it isn't in
# the user's list, it's added, and it's remembered so an extension the
# user turns off afterwards stays off. Extensions in the user's
# disabled-extensions list are never added.
#
# The first run on an existing account only adds ParchaOS's own
# extensions (*@parchaos.org); other defaults may have been turned off on
# purpose before this tool existed, so they're only recorded as offered.
#
# It also undoes GNOME Shell's crash guard. When the shell dies while
# starting (or restarts several times in quick succession) it switches
# off every extension by setting disable-user-extensions, and the next
# login comes up with no menu bar, dock or launcher and nothing to say
# why. ParchaOS is those extensions, so the flag is cleared at login
# unless the boot asked for safe mode (see parchaos-safe-mode).
#
# Original code for ParchaOS, GPL-3.0-or-later.

import os

import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib  # noqa: E402

STATE_DIR = os.path.join(GLib.get_user_state_dir(), 'parchaos')
STATE_FILE = os.path.join(STATE_DIR, 'extensions-offered')


def safe_mode():
    try:
        with open(os.environ.get('PARCHAOS_SAFE_MODE_CMDLINE', '/proc/cmdline')) as f:
            return 'parchaos.safe-mode' in f.read().split()
    except OSError:
        return False


def main():
    settings = Gio.Settings.new('org.gnome.shell')
    if settings.get_boolean('disable-user-extensions') and not safe_mode():
        settings.set_boolean('disable-user-extensions', False)
        Gio.Settings.sync()
        print('cleared disable-user-extensions (shell crash guard)')
    defaults = settings.get_default_value('enabled-extensions').unpack()

    first_run = not os.path.exists(STATE_FILE)
    offered = set()
    if not first_run:
        with open(STATE_FILE) as f:
            offered = {line.strip() for line in f if line.strip()}

    user_value = settings.get_user_value('enabled-extensions')
    if user_value is not None:
        enabled = list(user_value.unpack())
        disabled = set(settings.get_strv('disabled-extensions'))
        added = []
        for uuid in defaults:
            if uuid in offered or uuid in enabled or uuid in disabled:
                continue
            if first_run and not uuid.endswith('@parchaos.org'):
                continue
            enabled.append(uuid)
            added.append(uuid)
        if added:
            settings.set_strv('enabled-extensions', enabled)
            Gio.Settings.sync()
            print('enabled:', ' '.join(added))

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, 'w') as f:
        f.write('\n'.join(sorted(offered | set(defaults))) + '\n')


if __name__ == '__main__':
    main()
