# Options for the ParchaOS repository (dnf5 distribution-level override).
#
# priority: prefer it over Fedora's for packages both provide. ParchaOS
# ships a few Fedora packages with patches (gnome-control-center with the
# ParchaOS Settings panel); without this, any newer Fedora build of them
# would silently replace the ParchaOS one. dnf's default priority is 99;
# lower wins. Only packages with the same name are affected.
#
# metadata_expire: check for new ParchaOS releases as often as Fedora's
# updates repository does (6 hours). The COPR repo file sets nothing, so
# dnf's 48-hour default applied and the app store could go two days
# without seeing an update.
[copr:copr.fedorainfracloud.org:alexgalicea:parchaos-gnome]
priority=90
metadata_expire=6h
