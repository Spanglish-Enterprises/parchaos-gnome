[org/gnome/desktop/interface]
gtk-theme='ParchaOS-Dark'
icon-theme='ParchaOS-dark'
cursor-theme='Adwaita'
color-scheme='prefer-dark'
# Real gap found via a live reference-desktop comparison 2026-09-25: the
# top bar's clock read "Sep 25", missing the day-of-week the reference
# always shows ("Wed Sep 16"). Fedora's own default already has
# clock-show-date=true (confirmed live, not this profile's own
# setting) -- clock-show-weekday is the one real GNOME key still at
# its stock default (false).
clock-show-weekday=true

# Location: the menu-bar weather needs it, but it's off (GNOME's own
# privacy default) until the user agrees.
# Location stays off until the user turns it on (ParchaOS Welcome asks
# at first login; also in Settings > Privacy).
[org/gnome/system/location]
enabled=false

[org/gnome/desktop/wm/preferences]
theme='ParchaOS-Dark'
button-layout='close,minimize,maximize:'

[org/gnome/shell/extensions/user-theme]
name='ParchaOS-Dark'

# Default dock favorites so Parcha Browser appears out of the box.
# Previously only the live session's customize.sh set these; installed
# systems fell back to Fedora's list (no browser).
[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'es.parchaos.Browser.desktop', 'org.gnome.Software.desktop', 'org.gnome.Geary.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop']

