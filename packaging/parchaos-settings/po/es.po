#: files/parchaos-settings:52
msgid "The share did not accept that username or password."
msgstr "La carpeta de red no aceptó ese usuario o contraseña."

#: files/parchaos-settings:54
msgid ""
"The server did not answer. Check the address and that it is switched on."
msgstr "El servidor no respondió. Revisa la dirección y que esté encendido."

#: files/parchaos-settings:56
msgid "That server or share could not be found. Check the address."
msgstr "No se encontró ese servidor o carpeta. Revisa la dirección."

#: files/parchaos-settings:119
msgid "Preview of the glass"
msgstr "Vista previa del cristal"

#: files/parchaos-settings:224 files/parchaos-settings:236
msgid "ParchaOS Settings"
msgstr "Ajustes de ParchaOS"

#: files/parchaos-settings:272 files/parchaos-settings:282
msgid "Sound"
msgstr "Sonido"

#: files/parchaos-settings:274
msgid "Ambient Sounds"
msgstr "Sonidos ambientales"

#: files/parchaos-settings:275
msgid ""
"Calm background sound that plays under everything else. All of it is "
"generated on this computer."
msgstr ""
"Sonido de fondo tranquilo que suena por debajo de todo lo demás. Todo se "
"genera en esta computadora."

#: files/parchaos-settings:279
msgid "Rain"
msgstr "Lluvia"

#: files/parchaos-settings:279 files/parchaos-settings:848
msgid "Ocean"
msgstr "Mar"

#: files/parchaos-settings:279
msgid "Stream"
msgstr "Arroyo"

#: files/parchaos-settings:280
msgid "Night"
msgstr "Noche"

#: files/parchaos-settings:280
msgid "White noise"
msgstr "Ruido blanco"

#: files/parchaos-settings:280
msgid "Pink noise"
msgstr "Ruido rosa"

#: files/parchaos-settings:281
msgid "Brown noise"
msgstr "Ruido marrón"

#: files/parchaos-settings:305
msgid "Volume"
msgstr "Volumen"

#: files/parchaos-settings:306
msgid "Tone"
msgstr "Tono"

#: files/parchaos-settings:306
msgid "Warmer"
msgstr "Más cálido"

#: files/parchaos-settings:306
msgid "Brighter"
msgstr "Más brillante"

#: files/parchaos-settings:308
msgid "15 minutes"
msgstr "15 minutos"

#: files/parchaos-settings:308
msgid "30 minutes"
msgstr "30 minutos"

#: files/parchaos-settings:308
msgid "1 hour"
msgstr "1 hora"

#: files/parchaos-settings:308
msgid "2 hours"
msgstr "2 horas"

#: files/parchaos-settings:309
msgid "4 hours"
msgstr "4 horas"

#: files/parchaos-settings:309
msgid "8 hours"
msgstr "8 horas"

#: files/parchaos-settings:309
msgid "Never"
msgstr "Nunca"

#: files/parchaos-settings:310
msgid "Stop after"
msgstr "Detener después de"

#: files/parchaos-settings:318 files/parchaos-settings:325
msgid "Play"
msgstr "Reproducir"

#: files/parchaos-settings:325
msgid "Stop"
msgstr "Detener"

#: files/parchaos-settings:369 files/parchaos-settings:372
msgid "Keyboard"
msgstr "Teclado"

#: files/parchaos-settings:373
msgid "How the Super key works for your account."
msgstr "Cómo funciona la tecla Super en tu cuenta."

#: files/parchaos-settings:377
msgid "Super as Ctrl"
msgstr "Super como Ctrl"

#: files/parchaos-settings:378
msgid ""
"Use the Super key for app shortcuts like copy, paste and quit (Super+C, "
"Super+V, Super+Q). Turn off to keep Super for system shortcuts and Ctrl for "
"app shortcuts."
msgstr ""
"Usa la tecla Super para los atajos de las apps, como copiar, pegar y salir "
"(Super+C, Super+V, Super+Q). Desactívalo para dejar Super para los atajos "
"del sistema y Ctrl para los de las apps."

#: files/parchaos-settings:384
msgid "Keyboard remapping is not installed."
msgstr "El remapeo del teclado no está instalado."

#: files/parchaos-settings:431
msgid "Desktop"
msgstr "Escritorio"

#: files/parchaos-settings:434
msgid "Sessions"
msgstr "Sesiones"

#: files/parchaos-settings:437
msgid "Reopen apps when logging back in"
msgstr "Reabrir las apps al volver a iniciar sesión"

#: files/parchaos-settings:438
msgid ""
"Apps you had open come back where they were, and apps that remember their "
"documents reopen them too."
msgstr ""
"Las apps que tenías abiertas vuelven a donde estaban, y las que recuerdan "
"sus documentos también los reabren."

#. Desktop icons (Desktop Icons NG keeps these keys).
#: files/parchaos-settings:458
msgid "Tiny"
msgstr "Diminuto"

#: files/parchaos-settings:458
msgid "Small"
msgstr "Pequeño"

#: files/parchaos-settings:458
msgid "Standard"
msgstr "Estándar"

#: files/parchaos-settings:458
msgid "Large"
msgstr "Grande"

#: files/parchaos-settings:462
msgid "Icons on the desktop"
msgstr "Iconos en el escritorio"

#: files/parchaos-settings:463
msgid "Files, folders and the Trash that sit on the desktop."
msgstr "Archivos, carpetas y la Papelera que están en el escritorio."

#: files/parchaos-settings:467 files/parchaos-settings:987
#: files/parchaos-settings:1133
msgid "Not available"
msgstr "No disponible"

#: files/parchaos-settings:468
msgid "The desktop icons package is not installed."
msgstr "El paquete de iconos del escritorio no está instalado."

#: files/parchaos-settings:474
msgid "Snap icons to the grid"
msgstr "Ajustar los iconos a la cuadrícula"

#: files/parchaos-settings:475
msgid "Off: an icon stays exactly where you drop it."
msgstr "Desactivado: un icono se queda exactamente donde lo sueltas."

#: files/parchaos-settings:478
msgid "Show Home"
msgstr "Mostrar Inicio"

#: files/parchaos-settings:478
msgid "Show Trash"
msgstr "Mostrar la Papelera"

#: files/parchaos-settings:484
msgid "Icon size"
msgstr "Tamaño de los iconos"

#: files/parchaos-settings:507
msgid "Focus"
msgstr "Concentración"

#: files/parchaos-settings:508
msgid "Silence notification popups at the same time every day."
msgstr "Silencia las notificaciones emergentes a la misma hora todos los días."

#: files/parchaos-settings:509
msgid "Scheduled Do Not Disturb"
msgstr "No molestar programado"

#: files/parchaos-settings:528
msgid "Schedule disabled — start time equals end time"
msgstr "Horario desactivado: la hora de inicio es igual a la de fin"

#: files/parchaos-settings:609
msgid "Your computer"
msgstr "Tu computadora"

#: files/parchaos-settings:610
msgid ""
"Tell others whether ParchaOS works on this computer. Nothing is sent until "
"you press Send on the website."
msgstr ""
"Cuéntales a otros si ParchaOS funciona en esta computadora. No se envía nada "
"hasta que pulses Enviar en el sitio web."

#: files/parchaos-settings:611
msgid "Report how ParchaOS works here"
msgstr "Informar cómo funciona ParchaOS aquí"

#: files/parchaos-settings:612
msgid "Computer model not found"
msgstr "No se encontró el modelo de la computadora"

#: files/parchaos-settings:613
msgid "Open form"
msgstr "Abrir formulario"

#: files/parchaos-settings:628
msgid "Photo search"
msgstr "Búsqueda de fotos"

#: files/parchaos-settings:629
msgid ""
"Find pictures by what is in them, with a small model that runs on this "
"computer. Nothing leaves it."
msgstr ""
"Encuentra imágenes por lo que contienen, con un modelo pequeño que se "
"ejecuta en esta computadora. Nada sale de ella."

#: files/parchaos-settings:633
msgid "Search photos by what is in them"
msgstr "Buscar fotos por lo que contienen"

#: files/parchaos-settings:634 files/parchaos-settings:653
msgid ""
"Type \"sunset over water\" in the search. The first time it downloads about "
"150 MB and asks for your password once."
msgstr ""
"Escribe \"atardecer sobre el agua\" en la búsqueda. La primera vez descarga "
"unos 150 MB y te pide la contraseña una sola vez."

#: files/parchaos-settings:648
msgid "Setting up..."
msgstr "Preparando..."

#: files/parchaos-settings:648
msgid "Turning off..."
msgstr "Apagando..."

#: files/parchaos-settings:656
msgid "It could not be set up. Check your connection and try again."
msgstr "No se pudo preparar. Revisa tu conexión e inténtalo de nuevo."

#: files/parchaos-settings:665
msgid "Appearance"
msgstr "Apariencia"

#: files/parchaos-settings:668
msgid "Style"
msgstr "Estilo"

#: files/parchaos-settings:669
msgid "How the menu bar, launcher and Parcha Controls look."
msgstr "Cómo se ven la barra de menús, el lanzador y Parcha Controls."

#: files/parchaos-settings:675
msgid "Styles are not available"
msgstr "Los estilos no están disponibles"

#: files/parchaos-settings:676
msgid "The ParchaOS desktop package is not installed."
msgstr "El paquete del escritorio de ParchaOS no está instalado."

#: files/parchaos-settings:682
msgid "Glass"
msgstr "Cristal"

#: files/parchaos-settings:683
msgid "Translucent, softly blurred surfaces with rounded shapes."
msgstr ""
"Superficies translúcidas y suavemente difuminadas, con formas redondeadas."

#: files/parchaos-settings:684
msgid "Classic"
msgstr "Clásico"

#: files/parchaos-settings:685
msgid "Calmer frosted surfaces, more opaque, with tighter corners."
msgstr ""
"Superficies esmeriladas más tranquilas y opacas, con esquinas más cerradas."

#: files/parchaos-settings:717
msgid "Menu bar background"
msgstr "Fondo de la barra de menús"

#: files/parchaos-settings:718
msgid "The text follows the wallpaper in every mode."
msgstr "El texto sigue el fondo de pantalla en todos los modos."

#: files/parchaos-settings:719 files/parchaos-settings:751
msgid "Clear"
msgstr "Transparente"

#: files/parchaos-settings:719 files/parchaos-settings:752
msgid "Tinted"
msgstr "Tintado"

#: files/parchaos-settings:719
msgid "Solid"
msgstr "Sólido"

#: files/parchaos-settings:744 files/parchaos-settings:756
#: files/parchaos-settings:757
msgid "Glass clarity"
msgstr "Transparencia del cristal"

#: files/parchaos-settings:745
msgid ""
"From very clear to dark and frosted. The whole desktop follows the slider as "
"you drag it."
msgstr ""
"De muy transparente a oscuro y esmerilado. Todo el escritorio sigue al "
"control mientras lo mueves."

#: files/parchaos-settings:781
msgid "Reset"
msgstr "Restablecer"

#: files/parchaos-settings:792
msgid "Glass effects"
msgstr "Efectos de cristal"

#: files/parchaos-settings:793
msgid ""
"Menus, Quick Settings, notifications and the dock drawn as glass that bends "
"what is behind it."
msgstr ""
"Menús, Ajustes rápidos, notificaciones y el dock dibujados como cristal que "
"curva lo que hay detrás."

#: files/parchaos-settings:795
msgid "Refractive glass"
msgstr "Cristal con refracción"

#: files/parchaos-settings:796
msgid ""
"Experimental. Needs more graphics power. Control Center keeps its own look."
msgstr ""
"Experimental. Necesita más potencia gráfica. El Centro de control mantiene "
"su propio aspecto."

#: files/parchaos-settings:818
msgid "Refraction needs the Glass style."
msgstr "La refracción necesita el estilo Cristal."

#: files/parchaos-settings:828
msgid "Turn on refraction too?"
msgstr "¿Activar también la refracción?"

#: files/parchaos-settings:829
msgid ""
"Refraction bends what is behind menus and the dock. It needs more graphics "
"power. You can change this any time in Glass effects."
msgstr ""
"La refracción dobla lo que hay detrás de los menús y el dock. Necesita más "
"potencia gráfica. Puedes cambiarlo cuando quieras en Efectos de cristal."

#: files/parchaos-settings:831
msgid "Not Now"
msgstr "Ahora no"

#: files/parchaos-settings:832
msgid "Turn On"
msgstr "Activar"

#: files/parchaos-settings:844
msgid "Passion"
msgstr "Pasión"

#: files/parchaos-settings:845
msgid "Berry"
msgstr "Baya"

#: files/parchaos-settings:846
msgid "Sunny"
msgstr "Soleado"

#: files/parchaos-settings:847
msgid "Leaf"
msgstr "Hoja"

#: files/parchaos-settings:849
msgid "Graphite"
msgstr "Grafito"

#: files/parchaos-settings:854
msgid "Folder colour"
msgstr "Color de las carpetas"

#: files/parchaos-settings:855
msgid "The colour of folders and the trash. Other icons stay as they are."
msgstr "El color de las carpetas y la papelera. Los demás iconos no cambian."

#: files/parchaos-settings:856
msgid "Colour"
msgstr "Color"

#: files/parchaos-settings:880 files/parchaos-settings:898
msgid "Backups"
msgstr "Copias de seguridad"

#: files/parchaos-settings:883
msgid "History on this disk"
msgstr "Historial en este disco"

#: files/parchaos-settings:884
msgid ""
"Snapshots let you look back at your files and put them back. They live on "
"the same disk, so they are history, not a backup."
msgstr ""
"Las instantáneas te permiten ver tus archivos como estaban y recuperarlos. "
"Están en el mismo disco, así que son un historial, no una copia de seguridad."

#: files/parchaos-settings:889
msgid "Snapshots are on"
msgstr "Las instantáneas están activadas"

#: files/parchaos-settings:889
msgid "Snapshots are not set up"
msgstr "Las instantáneas no están configuradas"

#: files/parchaos-settings:890
msgid ""
"Taken every hour, and before and after each update. Open the snapshot menu "
"in the top bar to browse them."
msgstr ""
"Se toman cada hora, y antes y después de cada actualización. Abre el menú de "
"instantáneas en la barra superior para verlas."

#: files/parchaos-settings:892
msgid "They need a Btrfs disk, which this computer does not use."
msgstr "Necesitan un disco Btrfs, que esta computadora no usa."

#: files/parchaos-settings:899
msgid "Copy your files to an external drive or a network share, on a schedule."
msgstr ""
"Copia tus archivos a una unidad externa o a una carpeta de red, con un "
"horario."

#: files/parchaos-settings:902
msgid "Parcha Backup"
msgstr "Parcha Backup"

#: files/parchaos-settings:903
msgid "Choose what to back up, where to, and how often."
msgstr "Elige qué respaldar, dónde y con qué frecuencia."

#: files/parchaos-settings:908
msgid "Parcha Backup is not installed."
msgstr "Parcha Backup no está instalado."

#: files/parchaos-settings:914 files/parchaos-settings:925
msgid "Network share login"
msgstr "Acceso a una carpeta de red"

#: files/parchaos-settings:915
msgid ""
"If your backup drive on the network asks for a username and password, enter "
"them here once. They are kept in your password keyring."
msgstr ""
"Si tu disco de copias en la red pide usuario y contraseña, escríbelos aquí "
"una vez. Se guardan en tu llavero de contraseñas."

#: files/parchaos-settings:917
msgid "Add Login…"
msgstr "Añadir acceso…"

#: files/parchaos-settings:926
msgid ""
"Connect to the share and remember the login, so Parcha Backup can use it."
msgstr ""
"Conecta con la carpeta y recuerda el acceso, para que Parcha Backup pueda "
"usarlo."

#: files/parchaos-settings:928
msgid "Share address, like smb://nas/backups"
msgstr "Dirección, como smb://nas/copias"

#: files/parchaos-settings:929
msgid "Username"
msgstr "Usuario"

#: files/parchaos-settings:930
msgid "Domain (leave empty if none)"
msgstr "Dominio (déjalo vacío si no hay)"

#: files/parchaos-settings:931
msgid "Password"
msgstr "Contraseña"

#: files/parchaos-settings:935
msgid "Cancel"
msgstr "Cancelar"

#: files/parchaos-settings:936
msgid "Connect"
msgstr "Conectar"

#: files/parchaos-settings:946
msgid "That is not a share address. Use smb://server/share."
msgstr "Eso no es una dirección de carpeta de red. Usa smb://servidor/carpeta."

#: files/parchaos-settings:949
msgid "Enter the username for the share."
msgstr "Escribe el usuario de la carpeta de red."

#: files/parchaos-settings:951
msgid "Connecting…"
msgstr "Conectando…"

#: files/parchaos-settings:955
msgid "Connected. The login is saved."
msgstr "Conectado. El acceso queda guardado."

#: files/parchaos-settings:966
msgid "Privacy"
msgstr "Privacidad"

#: files/parchaos-settings:973
msgid "Network access"
msgstr "Acceso a la red"

#: files/parchaos-settings:974
msgid ""
"Turn a switch off to keep that app off the network. It takes effect the next "
"time the app starts. A blocked app cannot reach the internet or your local "
"network."
msgstr ""
"Apaga el interruptor para que esa app no use la red. Se aplica la próxima "
"vez que la app se inicie. Una app bloqueada no puede llegar a internet ni a "
"tu red local."

#: files/parchaos-settings:977
msgid "Find an app"
msgstr "Buscar una app"

#: files/parchaos-settings:982 files/parchaos-settings:1130
msgid "Loading apps..."
msgstr "Cargando apps..."

#: files/parchaos-settings:988
msgid "The network access helper is not installed."
msgstr "El ayudante de acceso a la red no está instalado."

#: files/parchaos-settings:995 files/parchaos-settings:1140
#: files/parchaos-settings:1148 files/parchaos-settings:1210
msgid "Could not list apps"
msgstr "No se pudo mostrar la lista de apps"

#: files/parchaos-settings:1024
msgid "Recently used"
msgstr "Usado recientemente"

#: files/parchaos-settings:1025
msgid ""
"Apps that used the microphone, camera, location or screen sharing in the "
"last seven days. Only what goes through the desktop's own services shows "
"here: an app that opens a device directly, such as some command-line tools, "
"is not seen, and screen sharing does not say which app asked."
msgstr "Apps que usaron el micrófono, la cámara, la ubicación o la pantalla compartida en los últimos siete días. Solo aparece lo que pasa por los servicios del propio escritorio: una app que abre un dispositivo directamente, como algunas herramientas de línea de comandos, no se ve, y compartir pantalla no dice qué app lo pidió."

#: files/parchaos-settings:1030
msgid "Refresh"
msgstr "Actualizar"

#: files/parchaos-settings:1032
msgid "Keep this report"
msgstr "Guardar este informe"

#: files/parchaos-settings:1033
msgid "Kept on this computer for seven days. Turning it off deletes it."
msgstr "Se guarda en esta computadora por siete días. Al apagarlo se borra."

#: files/parchaos-settings:1039
msgid "Microphone"
msgstr "Micrófono"

#: files/parchaos-settings:1040
msgid "Camera"
msgstr "Cámara"

#: files/parchaos-settings:1041
msgid "Location"
msgstr "Ubicación"

#: files/parchaos-settings:1042
msgid "Screen sharing or recording"
msgstr "Pantalla compartida o grabación"

#: files/parchaos-settings:1057
msgid "Nothing in the last seven days"
msgstr "Nada en los últimos siete días"

#: files/parchaos-settings:1067
#, python-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d vez"
msgstr[1] "%d veces"

#: files/parchaos-settings:1068
msgid "An app"
msgstr "Una app"

#: files/parchaos-settings:1086
msgid "Suggestions"
msgstr "Sugerencias"

#: files/parchaos-settings:1087
msgid ""
"ParchaOS can learn which controls you use, to suggest them when you edit "
"Control Center. It keeps only the names of the controls and when they were "
"used, on this computer. Nothing is sent anywhere."
msgstr ""
"ParchaOS puede aprender qué controles usas para sugerírtelos cuando edites "
"el Centro de control. Solo guarda los nombres de los controles y cuándo se "
"usaron, en esta computadora. No se envía nada a ningún sitio."

#: files/parchaos-settings:1090
msgid "Learn from how I use Control Center"
msgstr "Aprender de cómo uso el Centro de control"

#: files/parchaos-settings:1099
msgid "Forget what was learned"
msgstr "Olvidar lo aprendido"

#: files/parchaos-settings:1100
msgid "Suggestions start over from the defaults."
msgstr "Las sugerencias vuelven a empezar desde las predeterminadas."

#: files/parchaos-settings:1101
msgid "Forget"
msgstr "Olvidar"

#: files/parchaos-settings:1117
msgid "Forgotten"
msgstr "Olvidado"

#: files/parchaos-settings:1126
msgid "App permissions"
msgstr "Permisos de las apps"

#: files/parchaos-settings:1127
msgid ""
"What each Flatpak app is allowed to use. A switch appears only for things "
"the app asks for. Changes apply the next time the app starts."
msgstr ""
"Lo que cada app de Flatpak puede usar. Solo aparece un interruptor para lo "
"que la app pide. Los cambios se aplican la próxima vez que la app se abra."

#: files/parchaos-settings:1153
msgid "No Flatpak apps with permissions to change"
msgstr "No hay apps de Flatpak con permisos que cambiar"

#: files/parchaos-settings:1157
msgid "Network"
msgstr "Red"

#: files/parchaos-settings:1157
msgid "Internet and local network"
msgstr "Internet y red local"

#: files/parchaos-settings:1158
msgid "Files"
msgstr "Archivos"

#: files/parchaos-settings:1158
msgid "Your home folder and other drives"
msgstr "Tu carpeta personal y otras unidades"

#: files/parchaos-settings:1159
msgid "Devices"
msgstr "Dispositivos"

#: files/parchaos-settings:1159
msgid "Cameras, game controllers and other hardware"
msgstr "Cámaras, controles de juego y otros aparatos"

#: files/parchaos-settings:1160
msgid "Background"
msgstr "Segundo plano"

#: files/parchaos-settings:1160
msgid "Keep running when no window is open"
msgstr "Seguir funcionando sin ventanas abiertas"

#: files/parchaos-settings:1191 files/parchaos-settings:1246
msgid "The change was not saved."
msgstr "El cambio no se guardó."

#: files/parchaos-settings:1195
msgid "Saved."
msgstr "Guardado."

#: files/parchaos-settings:1197
#, python-format
msgid "Saved. Restart %s for this to apply."
msgstr "Guardado. Reinicia %s para que se aplique."

#: files/parchaos-settings:1216
msgid "Flatpak app"
msgstr "App de Flatpak"

#: files/parchaos-settings:1216
msgid "App"
msgstr "App"

#: files/parchaos-settings:1250
#, python-format
msgid "%s is blocked from the network. Restart it for this to apply."
msgstr "%s está bloqueada de la red. Reiníciala para que se aplique."

#: files/parchaos-settings:1253
#, python-format
msgid "%s can use the network again. Restart it for this to apply."
msgstr "%s puede volver a usar la red. Reiníciala para que se aplique."

#: files/parchaos-settings:1288
#, python-format
msgid "Could not change it: %s"
msgstr "No se pudo cambiar: %s"
