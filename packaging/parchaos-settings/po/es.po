#: files/parchaos-settings:1020
msgid "Mono"
msgstr "Mono"

#: files/parchaos-settings:1020
msgid "Every app in the accent colour."
msgstr "Todas las apps en el color de énfasis."

#: files/parchaos-settings:1037
msgid "Colours and icons"
msgstr "Colores e iconos"

#: files/parchaos-settings:1038
msgid ""
"The accent colour marks buttons, switches, selections and links in every app."
msgstr ""
"El color de énfasis marca botones, interruptores, selecciones y enlaces en "
"todas las apps."

#: files/parchaos-settings:1047
msgid "Accent colour"
msgstr "Color de énfasis"

#: files/parchaos-settings:1079
msgid "Icon style"
msgstr "Estilo de iconos"

#: files/parchaos-settings:1110
msgid "Hills Through the Day"
msgstr "Colinas a lo largo del día"

#: files/parchaos-settings:1110
msgid "Dawn, day, dusk and night, following the clock."
msgstr "Amanecer, día, atardecer y noche, según la hora."

#: files/parchaos-settings:1112
msgid "Hills, Light and Dark"
msgstr "Colinas, claro y oscuro"

#: files/parchaos-settings:1112
msgid "The hills by day in light mode and at night in dark mode."
msgstr "Las colinas de día en el modo claro y de noche en el modo oscuro."

#: files/parchaos-settings:1114
msgid "ParchaOS"
msgstr "ParchaOS"

#: files/parchaos-settings:1114
