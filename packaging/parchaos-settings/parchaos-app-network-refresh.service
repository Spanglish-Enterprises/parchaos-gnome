[Unit]
Description=Keep the launchers of network-blocked apps up to date
Documentation=https://github.com/Spanglish-Enterprises/parchaos-gnome/issues
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/parchaos-app-network refresh

[Install]
WantedBy=graphical-session.target
