        if settings is None:
            row.set_sensitive(False)
        else:
            settings.bind('restore-session', row, 'active', Gio.SettingsBindFlags.DEFAULT)
            self._general_settings = settings
        group.add(row)

        if os.path.exists('/usr/bin/parchaos-image-search'):
            page.add(self._photo_search_group())

        page.add(self._computer_group())

        if settings is not None:
            page.add(self._focus_group(settings))
