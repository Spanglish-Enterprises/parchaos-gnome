import json
import os
import subprocess
import sys

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, GLib, GObject, Gtk  # noqa: E402

APP_ID = 'org.parchaos.Settings'
KEYBOARD_STYLE = 'parchaos-keyboard-style'
APP_NETWORK = '/usr/libexec/parchaos-app-network'


def keyboard_style():
    try:
        out = subprocess.run([KEYBOARD_STYLE, 'status'], capture_output=True,
                             text=True, timeout=10)
        return out.stdout.strip() or 'super-ctrl'
    except (OSError, subprocess.TimeoutExpired):
        return None


class Window(Adw.ApplicationWindow):
    # A header bar with a page switcher over a stack of preference pages
    # (what Adw.PreferencesWindow drew, which libadwaita deprecated).
    def __init__(self, app):
        super().__init__(application=app, title='ParchaOS Settings')
        self.set_default_size(620, 560)

        self._stack = Adw.ViewStack()
        header = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(
            stack=self._stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        view = Adw.ToolbarView(content=self._stack)
        view.add_top_bar(header)
        self._toasts = Adw.ToastOverlay(child=view)
        self.set_content(self._toasts)

        self.add(self._general_page())
        self.add(self._appearance_page())
        self.add(self._privacy_page())

        page = Adw.PreferencesPage(title='Keyboard',
                                   icon_name='input-keyboard-symbolic')
        group = Adw.PreferencesGroup(
            title='Keyboard',
            description='How the Super key works for your account.')
        page.add(group)

        self._super_row = Adw.SwitchRow(
            title='Super as Ctrl',
            subtitle='Use the Super key for app shortcuts like copy, paste '
                     'and quit (Super+C, Super+V, Super+Q). Turn off to keep '
                     'Super for system shortcuts and Ctrl for app shortcuts.')
        style = keyboard_style()
        if style is None:
            self._super_row.set_sensitive(False)
            self._super_row.set_subtitle('Keyboard remapping is not installed.')
        else:
            self._super_row.set_active(style not in ('standard', 'windows'))
        self._super_row.connect('notify::active', self._on_super_toggled)
        group.add(self._super_row)
        self.add(page)

    def add(self, page):
        self._stack.add_titled_with_icon(page, page.get_title(), page.get_title(),
                                         page.get_icon_name())

    def add_toast(self, toast):
        self._toasts.add_toast(toast)

    def _desktop_settings(self):
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        return Gio.Settings(settings_schema=schema) if schema else None

    def _general_page(self):
        page = Adw.PreferencesPage(title='General',
                                   icon_name='preferences-system-symbolic')
        group = Adw.PreferencesGroup(title='Sessions')
        page.add(group)
        row = Adw.SwitchRow(
            title='Reopen apps when logging back in',
            subtitle='Apps you had open come back where they were, and apps '
                     'that remember their documents reopen them too.')
        settings = self._desktop_settings()
        if settings is None:
            row.set_sensitive(False)
        else:
            settings.bind('restore-session', row, 'active', Gio.SettingsBindFlags.DEFAULT)
            self._general_settings = settings
        group.add(row)

        if settings is not None:
            page.add(self._focus_group(settings))
        return page

    # Scheduled Do Not Disturb (parchaos-focus-schedule reads these keys).
    def _focus_group(self, settings):
        group = Adw.PreferencesGroup(
            title='Focus',
            description='Silence notification popups at the same time every day.')
        switch = Adw.SwitchRow(title='Scheduled Do Not Disturb')
        settings.bind('focus-schedule', switch, 'active', Gio.SettingsBindFlags.DEFAULT)
        group.add(switch)
        self._focus_start_row = self._time_row(settings, 'focus-start', 'From')
        self._focus_end_row = self._time_row(settings, 'focus-end', 'To')
        for row in (self._focus_start_row, self._focus_end_row):
            switch.bind_property('active', row, 'sensitive', GObject.BindingFlags.SYNC_CREATE)
            group.add(row)
        self._focus_settings = settings
        self._update_focus_hint()
        return group

    def _update_focus_hint(self):
        try:
            start = self._focus_settings.get_string('focus-start')
            end = self._focus_settings.get_string('focus-end')
        except AttributeError:
            return
        if start and end and start == end:
            self._focus_start_row.set_subtitle('Schedule disabled — start time equals end time')
        else:
            self._focus_start_row.set_subtitle('')

    def _time_row(self, settings, key, title):
        row = Adw.ActionRow(title=title)
        box = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        hours = Gtk.SpinButton.new_with_range(0, 23, 1)
        minutes = Gtk.SpinButton.new_with_range(0, 59, 1)
        for spin in (hours, minutes):
            spin.set_numeric(True)
            spin.set_wrap(True)
            spin.connect('output', self._two_digits)
        box.append(hours)
        box.append(Gtk.Label(label=':'))
        box.append(minutes)
        row.add_suffix(box)

        def load(*_):
            try:
                h, m = (int(x) for x in settings.get_string(key).split(':'))
            except ValueError:
                return
            hours.set_value(h)
            minutes.set_value(m)

        def store(*_):
            value = f'{int(hours.get_value()):02d}:{int(minutes.get_value()):02d}'
            if settings.get_string(key) != value:
                settings.set_string(key, value)
            self._update_focus_hint()

        load()
        hours.connect('value-changed', store)
        minutes.connect('value-changed', store)
        # Don't write back on load -- that would round any non-5-minute
        # value the user typed. Only write when the user actually changes
        # a spinbutton.
        return row

    @staticmethod
    def _two_digits(spin):
        spin.set_text(f'{int(spin.get_value()):02d}')
        return True

    def _appearance_page(self):
        page = Adw.PreferencesPage(title='Appearance',
                                   icon_name='applications-graphics-symbolic')
        group = Adw.PreferencesGroup(
            title='Style',
            description='How the menu bar, launcher and Parcha Controls look.')
        page.add(group)

        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        if schema is None:
            row = Adw.ActionRow(title='Styles are not available',
                                subtitle='The ParchaOS desktop package is not installed.')
            group.add(row)
            return page
        self._desktop = Gio.Settings(settings_schema=schema)

        choices = [
            ('glass', 'Glass',
             'Translucent, softly blurred surfaces with rounded shapes.'),
            ('classic', 'Classic',
             'Calmer frosted surfaces, more opaque, with tighter corners.'),
        ]
        first = None
        self._style_buttons = {}
        for value, title, subtitle in choices:
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = check
            else:
                check.set_group(first)
            row = Adw.ActionRow(title=title, subtitle=subtitle, activatable_widget=check)
            row.add_prefix(check)
            group.add(row)
            self._style_buttons[value] = check
            check.connect('toggled', self._on_style_toggled, value)
        self._sync_style()
        self._desktop.connect('changed::style', lambda *_: self._sync_style())
        if 'folder-colour' in schema.list_keys():
            page.add(self._folder_colour_group())
        return page

    FOLDER_COLOURS = [
        ('passion', 'Passion'),
        ('berry', 'Berry'),
        ('sunny', 'Sunny'),
        ('leaf', 'Leaf'),
        ('ocean', 'Ocean'),
        ('graphite', 'Graphite'),
    ]

    def _folder_colour_group(self):
        group = Adw.PreferencesGroup(
            title='Folder colour',
            description='The colour of folders and the trash. Other icons stay as they are.')
        row = Adw.ComboRow(title='Colour')
        row.set_model(Gtk.StringList.new([name for _value, name in self.FOLDER_COLOURS]))
        values = [value for value, _name in self.FOLDER_COLOURS]

        def load(*_):
            current = self._desktop.get_string('folder-colour')
            if current in values and row.get_selected() != values.index(current):
                row.set_selected(values.index(current))

        def store(*_):
            value = values[row.get_selected()]
            if self._desktop.get_string('folder-colour') != value:
                # parchaos-theme-sync (parchaos-desktop) switches the icon
                # theme to the matching dark or light variant.
                self._desktop.set_string('folder-colour', value)

        load()
        row.connect('notify::selected', store)
        self._desktop.connect('changed::folder-colour', load)
        group.add(row)
        return group

    # Which apps may use the network (ticket #126). The list comes from
    # parchaos-app-network; a change applies the next time the app starts.
    def _privacy_page(self):
        page = Adw.PreferencesPage(title='Privacy',
                                   icon_name='preferences-system-privacy-symbolic')
        self._net_group = Adw.PreferencesGroup(
            title='Network access',
            description='Turn a switch off to keep that app off the network. '
                        'It takes effect the next time the app starts. '
                        'A blocked app cannot reach the internet or your local network.')
        search = Gtk.SearchEntry(placeholder_text='Find an app', width_chars=18,
                                 valign=Gtk.Align.START)
        self._net_group.set_header_suffix(search)
        page.add(self._net_group)
        self._net_rows = []
        self._net_placeholder = Adw.ActionRow(title='Loading apps...')
        self._net_group.add(self._net_placeholder)
        search.connect('search-changed', self._on_net_search)
        if not os.access(APP_NETWORK, os.X_OK):
            self._net_placeholder.set_title('Not available')
            self._net_placeholder.set_subtitle('The network access helper is not installed.')
            return page
        try:
            proc = Gio.Subprocess.new([APP_NETWORK, 'list'],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            proc.communicate_utf8_async(None, None, self._on_net_list)
        except GLib.Error as err:
            self._net_placeholder.set_title('Could not list apps')
            self._net_placeholder.set_subtitle(err.message)
        return page

    def _on_net_list(self, proc, result):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(result)
            apps = json.loads(out or '[]')
        except (GLib.Error, ValueError) as err:
            self._net_placeholder.set_title('Could not list apps')
            self._net_placeholder.set_subtitle(str(err))
            return
        self._net_group.remove(self._net_placeholder)
        for app in apps:
            row = Adw.SwitchRow(title=GLib.markup_escape_text(app['name']),
                                subtitle='Flatpak app' if app['kind'] == 'flatpak' else 'App',
                                active=not app['blocked'])
            row.app = app
            row.connect('notify::active', self._on_net_toggled)
            self._net_group.add(row)
            self._net_rows.append(row)

    def _on_net_search(self, entry):
        needle = entry.get_text().strip().lower()
        for row in self._net_rows:
            row.set_visible(needle in row.app['name'].lower())

    def _on_net_toggled(self, row, _pspec):
        app = row.app
        action = 'allow' if row.get_active() else 'block'
        try:
            proc = Gio.Subprocess.new([APP_NETWORK, 'set', app['id'], action],
                                      Gio.SubprocessFlags.STDERR_PIPE)
            proc.communicate_utf8_async(None, None, self._on_net_set, (row, action))
        except GLib.Error as err:
            self._net_failed(row, action, err.message)

    def _on_net_set(self, proc, result, data):
        row, action = data
        try:
            _ok, _out, err = proc.communicate_utf8_finish(result)
        except GLib.Error as e:
            self._net_failed(row, action, e.message)
            return
        if proc.get_exit_status() != 0:
            self._net_failed(row, action, (err or '').strip() or 'The change was not saved.')
            return
        name = row.app['name']
        if action == 'block':
            self.add_toast(Adw.Toast(title=f'{name} is blocked from the network. '
                                           'Restart it for this to apply.'))
        else:
            self.add_toast(Adw.Toast(title=f'{name} can use the network again. '
                                           'Restart it for this to apply.'))

    def _net_failed(self, row, action, message):
        # Put the switch back to what is really saved.
        row.handler_block_by_func(self._on_net_toggled)
        row.set_active(action != 'allow')
        row.handler_unblock_by_func(self._on_net_toggled)
        self.add_toast(Adw.Toast(title=message))

    def _sync_style(self):
        current = self._desktop.get_string('style')
        button = self._style_buttons.get(current)
        if button is not None and not button.get_active():
            button.set_active(True)

    def _on_style_toggled(self, button, value):
        if button.get_active() and self._desktop.get_string('style') != value:
            # parchaos-theme-sync (parchaos-desktop) switches the GTK and
            # Shell themes to match.
            self._desktop.set_string('style', value)

    def _on_super_toggled(self, row, _pspec):
        style = 'super-ctrl' if row.get_active() else 'standard'
        row.set_sensitive(False)

        def done(proc, res):
            try:
                proc.wait_check_finish(res)
            except GLib.Error as e:
                self.add_toast(Adw.Toast(title=f'Could not change it: {e.message}'))
            row.set_sensitive(True)

        proc = Gio.Subprocess.new([KEYBOARD_STYLE, style], Gio.SubprocessFlags.NONE)
        proc.wait_check_async(None, done)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
