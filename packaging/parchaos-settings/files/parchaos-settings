#!/usr/bin/python3
# ParchaOS Settings: preferences specific to ParchaOS that GNOME's own
# Settings app has no place for. Original code for ParchaOS,
# GPL-3.0-or-later.

import subprocess
import sys

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = 'org.parchaos.Settings'
KEYBOARD_STYLE = 'parchaos-keyboard-style'


def keyboard_style():
    try:
        out = subprocess.run([KEYBOARD_STYLE, 'status'], capture_output=True,
                             text=True, timeout=10)
        return out.stdout.strip() or 'mac'
    except (OSError, subprocess.TimeoutExpired):
        return None


class Window(Adw.PreferencesWindow):
    def __init__(self, app):
        super().__init__(application=app, title='ParchaOS Settings')
        self.set_default_size(620, 480)
        self.set_search_enabled(False)

        self.add(self._general_page())
        self.add(self._appearance_page())

        page = Adw.PreferencesPage(title='Keyboard',
                                   icon_name='input-keyboard-symbolic')
        group = Adw.PreferencesGroup(
            title='Keyboard',
            description='How the Super key works for your account.')
        page.add(group)

        self._super_row = Adw.SwitchRow(
            title='Super as Ctrl',
            subtitle='Use the Super key for app shortcuts like copy, paste '
                     'and quit (Super+C, Super+V, Super+Q). Turn off to keep '
                     'Super for system shortcuts and Ctrl for app shortcuts.')
        style = keyboard_style()
        if style is None:
            self._super_row.set_sensitive(False)
            self._super_row.set_subtitle('Keyboard remapping is not installed.')
        else:
            self._super_row.set_active(style != 'windows')
        self._super_row.connect('notify::active', self._on_super_toggled)
        group.add(self._super_row)
        self.add(page)

    def _desktop_settings(self):
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        return Gio.Settings(settings_schema=schema) if schema else None

    def _general_page(self):
        page = Adw.PreferencesPage(title='General',
                                   icon_name='preferences-system-symbolic')
        group = Adw.PreferencesGroup(title='Sessions')
        page.add(group)
        row = Adw.SwitchRow(
            title='Reopen apps when logging back in',
            subtitle='Apps you had open come back where they were, and apps '
                     'that remember their documents reopen them too.')
        settings = self._desktop_settings()
        if settings is None:
            row.set_sensitive(False)
        else:
            settings.bind('restore-session', row, 'active', Gio.SettingsBindFlags.DEFAULT)
            self._general_settings = settings
        group.add(row)
        return page

    def _appearance_page(self):
        page = Adw.PreferencesPage(title='Appearance',
                                   icon_name='applications-graphics-symbolic')
        group = Adw.PreferencesGroup(
            title='Style',
            description='How the menu bar, launcher and Parcha Controls look.')
        page.add(group)

        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        if schema is None:
            row = Adw.ActionRow(title='Styles are not available',
                                subtitle='The ParchaOS desktop package is not installed.')
            group.add(row)
            return page
        self._desktop = Gio.Settings(settings_schema=schema)

        choices = [
            ('glass', 'Glass',
             'Translucent, softly blurred surfaces with rounded shapes.'),
            ('classic', 'Classic',
             'Calmer frosted surfaces, more opaque, with tighter corners.'),
        ]
        first = None
        self._style_buttons = {}
        for value, title, subtitle in choices:
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = check
            else:
                check.set_group(first)
            row = Adw.ActionRow(title=title, subtitle=subtitle, activatable_widget=check)
            row.add_prefix(check)
            group.add(row)
            self._style_buttons[value] = check
            check.connect('toggled', self._on_style_toggled, value)
        self._sync_style()
        self._desktop.connect('changed::style', lambda *_: self._sync_style())
        return page

    def _sync_style(self):
        current = self._desktop.get_string('style')
        button = self._style_buttons.get(current)
        if button is not None and not button.get_active():
            button.set_active(True)

    def _on_style_toggled(self, button, value):
        if button.get_active() and self._desktop.get_string('style') != value:
            self._desktop.set_string('style', value)

    def _on_super_toggled(self, row, _pspec):
        style = 'mac' if row.get_active() else 'windows'
        row.set_sensitive(False)

        def done(proc, res):
            try:
                proc.wait_check_finish(res)
            except GLib.Error as e:
                self.add_toast(Adw.Toast(title=f'Could not change it: {e.message}'))
            row.set_sensitive(True)

        proc = Gio.Subprocess.new([KEYBOARD_STYLE, style], Gio.SubprocessFlags.NONE)
        proc.wait_check_async(None, done)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
