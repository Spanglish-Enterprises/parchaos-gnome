    ICON_SIZES = [('tiny', _('Tiny')), ('small', _('Small')), ('standard', _('Standard')), ('large', _('Large'))]

    def _icons_group(self):
        group = Adw.PreferencesGroup(
            title=_('Icons on the desktop'),
            description=_('Files, folders and the Trash that sit on the desktop.'))
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.gnome.shell.extensions.ding', True) if source else None
        if schema is None:
            group.add(Adw.ActionRow(title=_('Not available'),
                                    subtitle=_('The desktop icons package is not installed.')))
            return group
        self._ding = Gio.Settings(settings_schema=schema)
        keys = schema.list_keys()
        if 'snap-to-grid' in keys:
            row = Adw.SwitchRow(
                title=_('Snap icons to the grid'),
                subtitle=_('Off: an icon stays exactly where you drop it.'))
            self._ding.bind('snap-to-grid', row, 'active', Gio.SettingsBindFlags.DEFAULT)
            group.add(row)
        for key, title in (('show-home', _('Show Home')), ('show-trash', _('Show Trash'))):
            if key in keys:
                row = Adw.SwitchRow(title=title)
                self._ding.bind(key, row, 'active', Gio.SettingsBindFlags.DEFAULT)
                group.add(row)
        if 'icon-size' in keys:
            row = Adw.ComboRow(title=_('Icon size'))
            row.set_model(Gtk.StringList.new([name for _v, name in self.ICON_SIZES]))
            values = [v for v, _n in self.ICON_SIZES]

            def load(*_):
                cur = self._ding.get_string('icon-size')
                if cur in values and row.get_selected() != values.index(cur):
                    row.set_selected(values.index(cur))

            def store(*_):
                value = values[row.get_selected()]
                if self._ding.get_string('icon-size') != value:
                    self._ding.set_string('icon-size', value)

            load()
            row.connect('notify::selected', store)
            self._ding.connect('changed::icon-size', load)
            group.add(row)
        return group

    # Scheduled Do Not Disturb (parchaos-focus-schedule reads these keys).
    def _focus_group(self, settings):
        group = Adw.PreferencesGroup(
            title=_('Focus'),
            description=_('Silence notification popups at the same time every day.'))
        switch = Adw.SwitchRow(title=_('Scheduled Do Not Disturb'))
        settings.bind('focus-schedule', switch, 'active', Gio.SettingsBindFlags.DEFAULT)
        group.add(switch)
        self._focus_start_row = self._time_row(settings, 'focus-start', 'From')
        self._focus_end_row = self._time_row(settings, 'focus-end', 'To')
        for row in (self._focus_start_row, self._focus_end_row):
            switch.bind_property('active', row, 'sensitive', GObject.BindingFlags.SYNC_CREATE)
            group.add(row)
        self._focus_settings = settings
        self._update_focus_hint()
        return group

    def _update_focus_hint(self):
        try:
            start = self._focus_settings.get_string('focus-start')
            end = self._focus_settings.get_string('focus-end')
        except AttributeError:
            return
        if start and end and start == end:
            self._focus_start_row.set_subtitle(_('Schedule disabled — start time equals end time'))
        else:
            self._focus_start_row.set_subtitle('')

    def _time_row(self, settings, key, title):
        row = Adw.ActionRow(title=title)
        box = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        hours = Gtk.SpinButton.new_with_range(0, 23, 1)
        minutes = Gtk.SpinButton.new_with_range(0, 59, 1)
        for spin in (hours, minutes):
            spin.set_numeric(True)
            spin.set_wrap(True)
            spin.connect('output', self._two_digits)
        box.append(hours)
        box.append(Gtk.Label(label=':'))
        box.append(minutes)
        row.add_suffix(box)

        def load(*_):
            try:
                h, m = (int(x) for x in settings.get_string(key).split(':'))
            except ValueError:
                return
            hours.set_value(h)
            minutes.set_value(m)

        def store(*_):
            value = f'{int(hours.get_value()):02d}:{int(minutes.get_value()):02d}'
            if settings.get_string(key) != value:
                settings.set_string(key, value)
            self._update_focus_hint()

        load()
        hours.connect('value-changed', store)
        minutes.connect('value-changed', store)
        # Don't write back on load -- that would round any non-5-minute
        # value the user typed. Only write when the user actually changes
        # a spinbutton.
        return row

    @staticmethod
    def _two_digits(spin):
        spin.set_text(f'{int(spin.get_value()):02d}')
        return True

    @staticmethod
    def _read(path):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                return f.read().strip()
        except OSError:
            return ''

    def _computer_details(self):
        """(model, notes) for the hardware report: what the firmware and the system call this computer."""
        vendor = self._read('/sys/class/dmi/id/sys_vendor')
        product = self._read('/sys/class/dmi/id/product_name') or self._read('/sys/class/dmi/id/board_name')
        junk = ('To Be Filled By O.E.M.', 'System Product Name', 'Default string', 'Not Specified')
        model = ' '.join(x for x in (vendor, product) if x and x not in junk).strip()
        cpu = ''
        for line in self._read('/proc/cpuinfo').splitlines():
            if line.startswith('model name'):
                cpu = line.split(':', 1)[1].strip()
                break
        gpu = ''
        try:
            out = subprocess.run(['lspci', '-mm'], capture_output=True, text=True, timeout=5).stdout
            for line in out.splitlines():
                if 'VGA' in line or '3D controller' in line:
                    parts = [p for p in line.split('"') if p.strip()]
                    if len(parts) >= 4:
                        gpu = parts[3]
                        break
        except (OSError, subprocess.TimeoutExpired):
            pass
        notes = '; '.join(x for x in (f'CPU: {cpu}' if cpu else '', f'Graphics: {gpu}' if gpu else '') if x)
        return model, notes

    def _computer_group(self):
        model, notes = self._computer_details()
        group = Adw.PreferencesGroup(
            title=_('Your computer'),
            description=_('Tell others whether ParchaOS works on this computer. Nothing is sent until you press Send on the website.'))
        row = Adw.ActionRow(title=_('Report how ParchaOS works here'),
                            subtitle=model or _('Computer model not found'))
        button = Gtk.Button(label=_('Open form'), valign=Gtk.Align.CENTER)
        button.add_css_class('suggested-action')

        def opened(*_args):
            from urllib.parse import quote
            url = 'https://parchaos.org/hardware?machine=' + quote(model[:80]) + '&notes=' + quote(notes[:300])
            Gio.AppInfo.launch_default_for_uri(url, None)

        button.connect('clicked', opened)
        row.add_suffix(button)
        group.add(row)
        return group

    def _photo_search_group(self):
        group = Adw.PreferencesGroup(
            title=_('Photo search'),
            description=_('Find pictures by what is in them, with a small model that runs on this computer. Nothing leaves it.'))
        model = os.path.join(GLib.get_user_data_dir(), 'parchaos-image-search', 'model',
                             'vision_model_quantized.onnx')
        row = Adw.SwitchRow(
            title=_('Search photos by what is in them'),
            subtitle=_('Type "sunset over water" in the search. The first time it downloads about 150 MB and asks for your password once.'))
        row.set_active(os.path.exists(model))
        busy = {'on': False}

        def run(action, done):
            proc = Gio.Subprocess.new(['parchaos-image-search', action], Gio.SubprocessFlags.STDERR_SILENCE)
            proc.wait_async(None, lambda p, res: done(p.wait_finish(res) and p.get_successful()))

        def toggled(*_args):
            if busy['on']:
                return
            wanted = row.get_active()
            busy['on'] = True
            row.set_sensitive(False)
            row.set_subtitle(_('Setting up...') if wanted else _('Turning off...'))

            def done(ok):
                busy['on'] = False
                row.set_sensitive(True)
                row.set_subtitle(_('Type "sunset over water" in the search. The first time it downloads about 150 MB and asks for your password once.'))
                if not ok:
                    row.set_active(not wanted)
                    row.set_subtitle(_('It could not be set up. Check your connection and try again.'))

            run('enable' if wanted else 'disable', done)

        row.connect('notify::active', toggled)
        group.add(row)
        return group

    def _appearance_page(self):
        page = Adw.PreferencesPage(title=_('Appearance'),
                                   icon_name='applications-graphics-symbolic')
        group = Adw.PreferencesGroup(
            title=_('Style'),
            description=_('How the menu bar, launcher and Parcha Controls look.'))
        page.add(group)

        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        if schema is None:
            row = Adw.ActionRow(title=_('Styles are not available'),
                                subtitle=_('The ParchaOS desktop package is not installed.'))
            group.add(row)
            return page
        self._desktop = Gio.Settings(settings_schema=schema)

        choices = [
            ('glass', _('Glass'),
             _('Translucent, softly blurred surfaces with rounded shapes.')),
            ('classic', _('Classic'),
             _('Calmer frosted surfaces, more opaque, with tighter corners.')),
        ]
        first = None
        self._style_buttons = {}
        for value, title, subtitle in choices:
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = check
            else:
                check.set_group(first)
            row = Adw.ActionRow(title=title, subtitle=subtitle, activatable_widget=check)
            row.add_prefix(check)
            group.add(row)
            self._style_buttons[value] = check
            check.connect('toggled', self._on_style_toggled, value)
        self._sync_style()
        self._desktop.connect('changed::style', lambda *_: self._sync_style())
        if 'glass-effects' in schema.list_keys() and os.path.isdir(
                '/usr/share/gnome-shell/extensions/liquid-glass@thinkingcoding1231.gmail.com'):
            page.add(self._glass_effects_group())
