def normalize_share(text):
    """The address of a network share, as the file system layer wants it.

    Accepts smb://server/share, a Windows-style \\\\server\\share, or just
    server/share (taken as a Windows share). Returns None for anything else.
    """
    text = (text or '').strip()
    if not text:
        return None
    if '://' in text:
        scheme = text.split('://', 1)[0].lower()
        return text if scheme in ('smb', 'nfs', 'sftp', 'ftp', 'dav', 'davs') else None
    text = text.replace('\\', '/').lstrip('/')
    return 'smb://' + text if '/' in text else None


def share_error_text(error):
    """A plain-words reason for a failed mount."""
    message = (getattr(error, 'message', None) or str(error)).lower()
    if 'permission denied' in message or 'password' in message or 'logon' in message:
        return _('The share did not accept that username or password.')
    if 'timed out' in message or 'timeout' in message or 'refused' in message:
        return _('The server did not answer. Check the address and that it is switched on.')
    if 'not found' in message or 'no such' in message or 'resolve' in message or 'host' in message:
        return _('That server or share could not be found. Check the address.')
    return getattr(error, 'message', None) or str(error)


def mount_share(uri, username, domain, password, done):
    """Connect to a network share with a login and remember it in the keyring.

    done(None) on success, done(error) otherwise. The login is given up front;
    if the share asks again the answer was wrong, so the attempt stops instead
    of asking forever.
    """
    operation = Gio.MountOperation()
    operation.set_username(username)
    if domain:
        operation.set_domain(domain)
    operation.set_password(password)
    operation.set_password_save(Gio.PasswordSave.PERMANENTLY)
    asked = []

    def ask(op, _message, _user, _domain, _flags):
        asked.append(1)
        op.reply(Gio.MountOperationResult.ABORTED)

    operation.connect('ask-password', ask)
    target = Gio.File.new_for_uri(uri)

    def finished(source, result):
        try:
            source.mount_enclosing_volume_finish(result)
        except GLib.Error as err:
            if err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                done(None)
            elif asked:
                done(GLib.Error.new_literal(Gio.io_error_quark(), 'Permission denied',
                                            Gio.IOErrorEnum.PERMISSION_DENIED))
            else:
                done(err)
            return
        done(None)

    target.mount_enclosing_volume(Gio.MountMountFlags.NONE, operation, None, finished)


def keyboard_style():
    try:
        out = subprocess.run([KEYBOARD_STYLE, 'status'], capture_output=True,
                             text=True, timeout=10)
        return out.stdout.strip() or 'super-ctrl'
    except (OSError, subprocess.TimeoutExpired):
        return None


class Window(Adw.ApplicationWindow):
    # A sidebar of sections beside the page of the chosen section, the layout
    # GNOME's own Settings uses. It folds to a single column in a narrow window.
    def __init__(self, app):
        super().__init__(application=app, title=_('ParchaOS Settings'))
        self.set_default_size(860, 640)

        self._pages = []
        self._stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self._list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self._list.add_css_class('navigation-sidebar')
        self._list.connect('row-selected', self._on_section_selected)

        side_bar = Adw.HeaderBar(show_title=False)
        side = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=self._list, hscrollbar_policy=Gtk.PolicyType.NEVER))
        side.add_top_bar(side_bar)
        self._side_page = Adw.NavigationPage(child=side, title=_('ParchaOS Settings'), tag='sections')

        self._content_title = Adw.WindowTitle(title='')
        content_bar = Adw.HeaderBar(title_widget=self._content_title)
        content = Adw.ToolbarView(content=self._stack)
        content.add_top_bar(content_bar)
        self._content_page = Adw.NavigationPage(child=content, title='', tag='content')

        self._split = Adw.NavigationSplitView(sidebar=self._side_page, content=self._content_page,
                                              min_sidebar_width=210, max_sidebar_width=260)
        self._toasts = Adw.ToastOverlay(child=self._split)
        self.set_content(self._toasts)

        # Fold to one column in a narrow window.
        breakpoint_ = Adw.Breakpoint.new(Adw.BreakpointCondition.parse('max-width: 600sp'))
        breakpoint_.add_setter(self._split, 'collapsed', True)
        self.add_breakpoint(breakpoint_)

        self.add(self._appearance_page())
        self.add(self._desktop_page())
        self.add(self._privacy_page())
        self.add(self._backups_page())
        self.add(self._keyboard_page())
        self._list.select_row(self._list.get_row_at_index(0))

    def _keyboard_page(self):
        page = Adw.PreferencesPage(title=_('Keyboard'),
                                   icon_name='input-keyboard-symbolic')
        group = Adw.PreferencesGroup(
            title=_('Keyboard'),
            description=_('How the Super key works for your account.'))
        page.add(group)

        self._super_row = Adw.SwitchRow(
            title=_('Super as Ctrl'),
            subtitle=_('Use the Super key for app shortcuts like copy, paste '
                     'and quit (Super+C, Super+V, Super+Q). Turn off to keep '
                     'Super for system shortcuts and Ctrl for app shortcuts.'))
        style = keyboard_style()
        if style is None:
            self._super_row.set_sensitive(False)
            self._super_row.set_subtitle(_('Keyboard remapping is not installed.'))
        else:
            self._super_row.set_active(style not in ('standard', 'windows'))
        self._super_row.connect('notify::active', self._on_super_toggled)
        group.add(self._super_row)
        return page

    def add(self, page):
        name = page.get_title()
        self._stack.add_titled(page, name, name)
        icon = Gtk.Image(icon_name=page.get_icon_name(), margin_start=4, margin_end=4,
                         valign=Gtk.Align.CENTER)
        label = Gtk.Label(label=name, xalign=0, hexpand=True, valign=Gtk.Align.CENTER)
        box = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=6, margin_end=6)
        box.append(icon)
        box.append(label)
        row = Gtk.ListBoxRow(child=box)
        row.section = name
        self._list.append(row)
        self._pages.append(page)

    def _on_section_selected(self, _list, row):
        if row is None:
            return
        self._stack.set_visible_child_name(row.section)
        self._content_title.set_title(row.section)
        self._content_page.set_title(row.section)
        self._split.set_show_content(True)

    def add_toast(self, toast):
        self._toasts.add_toast(toast)

    def _desktop_settings(self):
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup('org.parchaos.desktop', True) if source else None
        return Gio.Settings(settings_schema=schema) if schema else None

    def _desktop_page(self):
        page = Adw.PreferencesPage(title=_('Desktop'),
                                   icon_name='preferences-desktop-symbolic')
        page.add(self._icons_group())
        group = Adw.PreferencesGroup(title=_('Sessions'))
        page.add(group)
