        if info is None:
            button.set_sensitive(False)
            brow.set_subtitle(_('Parcha Backup is not installed.'))
        else:
            button.connect('clicked', lambda *_: info.launch([], None))
        brow.add_suffix(button)
        backups.add(brow)
        share = Adw.ActionRow(
            title=_('Network share login'),
            subtitle=_('If your backup drive on the network asks for a username and password, enter them here once. '
                       'They are kept in your password keyring.'))
        add = Gtk.Button(label=_('Add Login\u2026'), valign=Gtk.Align.CENTER)
        add.connect('clicked', lambda *_: self._share_login_dialog())
        share.add_suffix(add)
        backups.add(share)
        return page

    def _share_login_dialog(self):
        dialog = Adw.AlertDialog(
            heading=_('Network share login'),
            body=_('Connect to the share and remember the login, so Parcha Backup can use it.'))
        group = Adw.PreferencesGroup()
        address = Adw.EntryRow(title=_('Share address, like smb://nas/backups'))
        user = Adw.EntryRow(title=_('Username'))
        domain = Adw.EntryRow(title=_('Domain (leave empty if none)'))
        password = Adw.PasswordEntryRow(title=_('Password'))
        for entry in (address, user, domain, password):
            group.add(entry)
        dialog.set_extra_child(group)
        dialog.add_response('cancel', _('Cancel'))
        dialog.add_response('connect', _('Connect'))
        dialog.set_response_appearance('connect', Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response('connect')
        dialog.set_close_response('cancel')

        def answered(dlg, result):
            if dlg.choose_finish(result) != 'connect':
                return
            uri = normalize_share(address.get_text())
            if uri is None:
                self.add_toast(Adw.Toast(title=_('That is not a share address. Use smb://server/share.')))
                return
            if not user.get_text().strip():
                self.add_toast(Adw.Toast(title=_('Enter the username for the share.')))
                return
            self.add_toast(Adw.Toast(title=_('Connecting\u2026')))

            def finished(error):
                if error is None:
                    self.add_toast(Adw.Toast(title=_('Connected. The login is saved.')))
                else:
                    self.add_toast(Adw.Toast(title=share_error_text(error)))

            mount_share(uri, user.get_text().strip(), domain.get_text().strip(), password.get_text(), finished)

        dialog.choose(self, None, answered)

    # Which apps may use the network (ticket #126). The list comes from
    # parchaos-app-network; a change applies the next time the app starts.
    def _privacy_page(self):
        page = Adw.PreferencesPage(title=_('Privacy'),
                                   icon_name='preferences-system-privacy-symbolic')
        self._net_group = Adw.PreferencesGroup(
            title=_('Network access'),
            description=_('Turn a switch off to keep that app off the network. '
                        'It takes effect the next time the app starts. '
                        'A blocked app cannot reach the internet or your local network.'))
        search = Gtk.SearchEntry(placeholder_text=_('Find an app'), width_chars=18,
                                 valign=Gtk.Align.START)
        self._net_group.set_header_suffix(search)
        page.add(self._net_group)
        self._net_rows = []
        self._net_placeholder = Adw.ActionRow(title=_('Loading apps...'))
        self._net_group.add(self._net_placeholder)
        search.connect('search-changed', self._on_net_search)
        self._add_permissions_group(page)
        if not os.access(APP_NETWORK, os.X_OK):
            self._net_placeholder.set_title(_('Not available'))
            self._net_placeholder.set_subtitle(_('The network access helper is not installed.'))
            return page
        try:
            proc = Gio.Subprocess.new([APP_NETWORK, 'list'],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            proc.communicate_utf8_async(None, None, self._on_net_list)
        except GLib.Error as err:
            self._net_placeholder.set_title(_('Could not list apps'))
            self._net_placeholder.set_subtitle(err.message)
        return page

    # What each Flatpak app may use (ticket #160): its files, devices and
    # network. Each switch is Flatpak's own override, so turning it back on
    # undoes the change.

    def _add_permissions_group(self, page):
        self._perm_group = Adw.PreferencesGroup(
            title=_('App permissions'),
            description=_('What each Flatpak app is allowed to use. A switch appears only for '
                          'things the app asks for. Changes apply the next time the app starts.'))
        page.add(self._perm_group)
        self._perm_placeholder = Adw.ActionRow(title=_('Loading apps...'))
        self._perm_group.add(self._perm_placeholder)
        if not os.access(APP_PERMISSIONS, os.X_OK):
            self._perm_placeholder.set_title(_('Not available'))
            return
        try:
            proc = Gio.Subprocess.new([APP_PERMISSIONS, 'list'],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            proc.communicate_utf8_async(None, None, self._on_perm_list)
        except GLib.Error as err:
            self._perm_placeholder.set_title(_('Could not list apps'))
            self._perm_placeholder.set_subtitle(err.message)

    def _on_perm_list(self, proc, result):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(result)
            apps = json.loads(out or '[]')
        except (GLib.Error, ValueError) as err:
            self._perm_placeholder.set_title(_('Could not list apps'))
            self._perm_placeholder.set_subtitle(str(err))
            return
        apps = [a for a in apps if a['permissions']]
        if not apps:
            self._perm_placeholder.set_title(_('No Flatpak apps with permissions to change'))
            return
        self._perm_group.remove(self._perm_placeholder)
        labels = {
            'network': (_('Network'), _('Internet and local network')),
            'files': (_('Files'), _('Your home folder and other drives')),
            'devices': (_('Devices'), _('Cameras, game controllers and other hardware')),
        }
        for app in apps:
            expander = Adw.ExpanderRow(title=GLib.markup_escape_text(app['name']))
            for perm, (title, sub) in labels.items():
                state = app['permissions'].get(perm)
                if state is None:
                    continue
                row = Adw.SwitchRow(title=title, subtitle=sub, active=not state['blocked'])
                row.app_id, row.app_name, row.perm = app['id'], app['name'], perm
                row.connect('notify::active', self._on_perm_toggled)
                expander.add_row(row)
            self._perm_group.add(expander)

    def _on_perm_toggled(self, row, _pspec):
        action = 'allow' if row.get_active() else 'block'
        try:
            proc = Gio.Subprocess.new([APP_PERMISSIONS, 'set', row.app_id, row.perm, action],
                                      Gio.SubprocessFlags.STDERR_PIPE)
            proc.communicate_utf8_async(None, None, self._on_perm_set, (row, action))
        except GLib.Error as err:
            self._perm_failed(row, action, err.message)

    def _on_perm_set(self, proc, result, data):
        row, action = data
        try:
            _ok, _out, err = proc.communicate_utf8_finish(result)
        except GLib.Error as e:
            self._perm_failed(row, action, e.message)
            return
        if proc.get_exit_status() != 0:
            self._perm_failed(row, action, (err or '').strip() or _('The change was not saved.'))
            return
        self.add_toast(Adw.Toast(title=_('Saved. Restart %s for this to apply.') % row.app_name))

    def _perm_failed(self, row, action, message):
        row.handler_block_by_func(self._on_perm_toggled)
        row.set_active(action != 'allow')
        row.handler_unblock_by_func(self._on_perm_toggled)
        self.add_toast(Adw.Toast(title=message))

    def _on_net_list(self, proc, result):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(result)
            apps = json.loads(out or '[]')
        except (GLib.Error, ValueError) as err:
            self._net_placeholder.set_title(_('Could not list apps'))
            self._net_placeholder.set_subtitle(str(err))
            return
        self._net_group.remove(self._net_placeholder)
        for app in apps:
            row = Adw.SwitchRow(title=GLib.markup_escape_text(app['name']),
                                subtitle=_('Flatpak app') if app['kind'] == 'flatpak' else _('App'),
                                active=not app['blocked'])
            row.app = app
            row.connect('notify::active', self._on_net_toggled)
            self._net_group.add(row)
            self._net_rows.append(row)

    def _on_net_search(self, entry):
        needle = entry.get_text().strip().lower()
        for row in self._net_rows:
            row.set_visible(needle in row.app['name'].lower())

    def _on_net_toggled(self, row, _pspec):
        app = row.app
        action = 'allow' if row.get_active() else 'block'
        try:
            proc = Gio.Subprocess.new([APP_NETWORK, 'set', app['id'], action],
                                      Gio.SubprocessFlags.STDERR_PIPE)
            proc.communicate_utf8_async(None, None, self._on_net_set, (row, action))
        except GLib.Error as err:
            self._net_failed(row, action, err.message)

    def _on_net_set(self, proc, result, data):
        row, action = data
        try:
            _ok, _out, err = proc.communicate_utf8_finish(result)
        except GLib.Error as e:
            self._net_failed(row, action, e.message)
            return
        if proc.get_exit_status() != 0:
            self._net_failed(row, action, (err or '').strip() or _('The change was not saved.'))
            return
        name = row.app['name']
        if action == 'block':
            self.add_toast(Adw.Toast(title=_('%s is blocked from the network. '
                                             'Restart it for this to apply.') % name))
        else:
            self.add_toast(Adw.Toast(title=_('%s can use the network again. '
                                             'Restart it for this to apply.') % name))

    def _net_failed(self, row, action, message):
        # Put the switch back to what is really saved.
        row.handler_block_by_func(self._on_net_toggled)
        row.set_active(action != 'allow')
        row.handler_unblock_by_func(self._on_net_toggled)
        self.add_toast(Adw.Toast(title=message))

    def _sync_style(self):
        current = self._desktop.get_string('style')
        button = self._style_buttons.get(current)
        if button is not None and not button.get_active():
            button.set_active(True)

    def _on_style_toggled(self, button, value):
        if button.get_active() and self._desktop.get_string('style') != value:
            # parchaos-theme-sync (parchaos-desktop) switches the GTK and
            # Shell themes to match.
            was = self._desktop.get_string('style')
            self._desktop.set_string('style', value)
            if value == 'classic' and 'glass-effects' in self._desktop.props.settings_schema.list_keys():
                self._desktop.set_boolean('glass-effects', False)
            elif (value == 'glass' and was != 'glass' and hasattr(self, '_refraction_row')):
                self._offer_refraction()

    def _on_super_toggled(self, row, _pspec):
        style = 'super-ctrl' if row.get_active() else 'standard'
        row.set_sensitive(False)

        def done(proc, res):
            try:
                proc.wait_check_finish(res)
            except GLib.Error as e:
                self.add_toast(Adw.Toast(title=_('Could not change it: %s') % e.message))
            row.set_sensitive(True)

        proc = Gio.Subprocess.new([KEYBOARD_STYLE, style], Gio.SubprocessFlags.NONE)
        proc.wait_check_async(None, done)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
