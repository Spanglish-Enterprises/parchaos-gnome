+/* ParchaOS: send the selection to a nearby computer or phone (ticket #149).
+ * Parcha Nearby (org.parchaos.Nearby) lists the devices and does the sending;
+ * folders are sent with what is inside them. */
+#define PARCHAOS_NEARBY_APP "org.parchaos.Nearby.desktop"
+
+static void
+action_send_nearby (GSimpleAction *action,
+                    GVariant      *state,
+                    gpointer       user_data)
+{
+    NautilusFilesView *view = user_data;
+    g_autolist (NautilusFile) selection = NULL;
+    g_autolist (GFile) files = NULL;
+    g_autoptr (GDesktopAppInfo) app_info = NULL;
+    g_autoptr (GAppLaunchContext) context = NULL;
+    g_autoptr (GError) error = NULL;
+
+    app_info = g_desktop_app_info_new (PARCHAOS_NEARBY_APP);
+    if (app_info == NULL)
+    {
+        return;
+    }
+
+    selection = nautilus_files_view_get_selection (NAUTILUS_VIEW (view));
+    for (GList *l = selection; l != NULL; l = l->next)
+    {
+        if (nautilus_file_has_local_path (l->data))
+        {
+            files = g_list_prepend (files, nautilus_file_get_activation_location (l->data));
+        }
+    }
+    if (files == NULL)
+    {
+        return;
+    }
+    files = g_list_reverse (files);
+
+    context = G_APP_LAUNCH_CONTEXT (gdk_display_get_app_launch_context (gtk_widget_get_display (GTK_WIDGET (view))));
+    if (!g_app_info_launch (G_APP_INFO (app_info), files, context, &error))
+    {
+        show_dialog (_("Could not open Nearby Devices."),
+                     error->message,
+                     nautilus_files_view_get_containing_window (view),
+                     GTK_MESSAGE_ERROR);
+    }
+}
+
+static gboolean
+can_send_nearby (GList *selection)
+{
+    static gint installed = -1;
+
+    if (installed < 0)
+    {
+        g_autoptr (GDesktopAppInfo) app_info = g_desktop_app_info_new (PARCHAOS_NEARBY_APP);
+        installed = app_info != NULL;
+    }
+    if (!installed || selection == NULL)
+    {
+        return FALSE;
+    }
+    for (GList *l = selection; l != NULL; l = l->next)
+    {
+        if (!nautilus_file_has_local_path (l->data))
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
