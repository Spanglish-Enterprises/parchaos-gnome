+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Natural-language file search for Parcher (ParchaOS ticket #120).
+ *
+ * Reads search text such as "pdf from last week" or "invoice photos
+ * yesterday" and turns it into a date range, file-type groups and the
+ * remaining name words. It has no dependency on the rest of Files, so the
+ * tests in packaging/parcher/tests/ build it on its own.
+ */
+#pragma once
+
+#include <glib.h>
+
+/**
+ * parcher_natural_search_parse:
+ * @text: the text typed in the search entry
+ * @now: the current time (tests pass a fixed one)
+ * @remaining_text: (out): the words left after the phrases are removed
+ * @time_phrase: (out): the time phrase as typed, cleaned up ("Last week")
+ * @groups: (out): a GArray of guint, the file-type group indexes named
+ *   (indexes of Files' mime type groups; empty when no type was named)
+ * @from: (out): first day of the range (local midnight)
+ * @to: (out): last day of the range, inclusive (local midnight)
+ *
+ * Returns TRUE only when the text names a time range ("last week",
+ * "yesterday", "3 days ago", "past 2 months", ...). Ordinary searches
+ * return FALSE and are left untouched.
+ */
+gboolean parcher_natural_search_parse (const char  *text,
+                                       GDateTime   *now,
+                                       char       **remaining_text,
+                                       char       **time_phrase,
+                                       GArray     **groups,
+                                       GDateTime  **from,
+                                       GDateTime  **to);
