+}
+
+static void
+clear_natural_tags (NautilusQueryEditor *editor)
+{
+    if (editor->natural_mime_tag != NULL)
+    {
+        gtk_box_remove (GTK_BOX (editor->tags_box), editor->natural_mime_tag);
+        editor->natural_mime_tag = NULL;
+    }
+    if (editor->natural_date_tag != NULL)
+    {
+        gtk_box_remove (GTK_BOX (editor->tags_box), editor->natural_date_tag);
+        editor->natural_date_tag = NULL;
+    }
+    gtk_widget_set_visible (editor->tags_box,
+                            (gtk_widget_get_first_child (editor->tags_box) != NULL));
+}
+
+/* Search text such as "pdf from last week": the time range and file types
+ * named in it become filters on the query, the rest is searched for in file
+ * names. Text without a time range is searched as before. */
+static void
+apply_natural_search (NautilusQueryEditor *editor,
+                      const gchar         *text)
+{
+    g_autofree gchar *remaining = NULL;
+    g_autofree gchar *phrase = NULL;
+    g_autoptr (GArray) groups = NULL;
+    g_autoptr (GDateTime) from = NULL;
+    g_autoptr (GDateTime) to = NULL;
+    g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+
+    if (!parcher_natural_search_parse (text, now, &remaining, &phrase, &groups, &from, &to))
+    {
+        nautilus_query_set_text (editor->query, text);
+        if (editor->natural_active)
+        {
+            g_autoptr (GPtrArray) none = g_ptr_array_new_full (0, g_free);
+
+            editor->natural_active = FALSE;
+            clear_natural_tags (editor);
+            nautilus_query_set_mime_types (editor->query,
+                                           editor->popover_mime_types != NULL ? editor->popover_mime_types : none);
+            nautilus_query_set_date_range (editor->query, editor->popover_date_range);
+        }
+        return;
+    }
+
+    {
+        g_autoptr (GPtrArray) date_range = g_ptr_array_new_full (2, (GDestroyNotify) g_date_time_unref);
+
+        g_ptr_array_add (date_range, g_date_time_ref (from));
+        g_ptr_array_add (date_range, g_date_time_ref (to));
+        nautilus_query_set_text (editor->query, remaining);
+        nautilus_query_set_date_range (editor->query, date_range);
+
+        g_free (editor->natural_remaining);
+        editor->natural_remaining = g_strdup (remaining);
+        editor->natural_active = TRUE;
+        clear_natural_tags (editor);
+
+        editor->natural_date_tag = create_tag (editor, phrase, G_CALLBACK (natural_tag_reset));
+        gtk_box_append (GTK_BOX (editor->tags_box), editor->natural_date_tag);
+    }
+
+    if (groups->len > 0)
+    {
+        g_autoptr (GPtrArray) mimetypes = g_ptr_array_new_full (16, g_free);
+        g_autoptr (GString) names = g_string_new (NULL);
+
+        for (guint i = 0; i < groups->len; i++)
+        {
+            guint group = g_array_index (groups, guint, i);
+            g_autoptr (GPtrArray) group_types = nautilus_mime_types_group_get_mimetypes (group);
+
+            for (guint j = 0; group_types != NULL && j < group_types->len; j++)
+            {
+                g_ptr_array_add (mimetypes, g_strdup (g_ptr_array_index (group_types, j)));
+            }
+            g_string_append_printf (names, "%s%s", i > 0 ? ", " : "",
+                                    nautilus_mime_types_group_get_name (group));
+        }
+        nautilus_query_set_mime_types (editor->query, mimetypes);
+        editor->natural_mime_tag = create_tag (editor, names->str, G_CALLBACK (natural_tag_reset));
+        gtk_box_append (GTK_BOX (editor->tags_box), editor->natural_mime_tag);
+    }
+    else
+    {
+        g_autoptr (GPtrArray) none = g_ptr_array_new_full (0, g_free);
+
+        nautilus_query_set_mime_types (editor->query,
+                                       editor->popover_mime_types != NULL ? editor->popover_mime_types : none);
+    }
+    gtk_widget_set_visible (editor->tags_box, TRUE);
+}
