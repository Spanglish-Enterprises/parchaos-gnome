diff --git a/src/parcher-natural-search.c b/src/parcher-natural-search.c
new file mode 100644
index 0000000..1ccec49
--- /dev/null
+++ b/src/parcher-natural-search.c
@@ -0,0 +1,425 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * See parcher-natural-search.h.
+ */
+#include "parcher-natural-search.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Indexes into Files' mime type groups (nautilus-mime-actions.c). */
+enum
+{
+    GROUP_DOCUMENTS = 3,
+    GROUP_MUSIC = 5,
+    GROUP_PDF = 6,
+    GROUP_PICTURE = 7,
+    GROUP_PRESENTATION = 8,
+    GROUP_SPREADSHEET = 9,
+    GROUP_VIDEO = 11,
+};
+
+typedef struct
+{
+    const char *word;
+    guint groups[2];
+} KindWord;
+
+static const KindWord kind_words[] = {
+    {"pdf", {GROUP_PDF, 0}}, {"pdfs", {GROUP_PDF, 0}},
+    {"image", {GROUP_PICTURE, 0}}, {"images", {GROUP_PICTURE, 0}},
+    {"photo", {GROUP_PICTURE, 0}}, {"photos", {GROUP_PICTURE, 0}},
+    {"picture", {GROUP_PICTURE, 0}}, {"pictures", {GROUP_PICTURE, 0}},
+    {"screenshot", {GROUP_PICTURE, 0}}, {"screenshots", {GROUP_PICTURE, 0}},
+    {"pic", {GROUP_PICTURE, 0}}, {"pics", {GROUP_PICTURE, 0}},
+    {"document", {GROUP_DOCUMENTS, GROUP_PDF}}, {"documents", {GROUP_DOCUMENTS, GROUP_PDF}},
+    {"doc", {GROUP_DOCUMENTS, GROUP_PDF}}, {"docs", {GROUP_DOCUMENTS, GROUP_PDF}},
+    {"spreadsheet", {GROUP_SPREADSHEET, 0}}, {"spreadsheets", {GROUP_SPREADSHEET, 0}},
+    {"sheet", {GROUP_SPREADSHEET, 0}}, {"sheets", {GROUP_SPREADSHEET, 0}},
+    {"presentation", {GROUP_PRESENTATION, 0}}, {"presentations", {GROUP_PRESENTATION, 0}},
+    {"slide", {GROUP_PRESENTATION, 0}}, {"slides", {GROUP_PRESENTATION, 0}},
+    {"video", {GROUP_VIDEO, 0}}, {"videos", {GROUP_VIDEO, 0}},
+    {"movie", {GROUP_VIDEO, 0}}, {"movies", {GROUP_VIDEO, 0}},
+    {"clip", {GROUP_VIDEO, 0}}, {"clips", {GROUP_VIDEO, 0}},
+    {"audio", {GROUP_MUSIC, 0}}, {"music", {GROUP_MUSIC, 0}},
+    {"song", {GROUP_MUSIC, 0}}, {"songs", {GROUP_MUSIC, 0}},
+    {"recording", {GROUP_MUSIC, 0}}, {"recordings", {GROUP_MUSIC, 0}},
+};
+
+/* Words that only make the sentence read naturally. */
+static const char *const filler_words[] = {
+    "that", "the", "a", "an", "my", "me", "i", "from", "in", "during", "of", "file", "files",
+    "find", "show", "edited", "modified", "changed", "made", "saved", "opened", "downloaded",
+    "created", "last", "and", "all", "some", "any", "for", "to", "were", "was", "have", "had",
+    "get", NULL
+};
+
+typedef enum
+{
+    PHRASE_LAST_N,
+    PHRASE_PAST_UNIT,
+    PHRASE_TODAY,
+    PHRASE_YESTERDAY,
+    PHRASE_THIS_WEEK,
+    PHRASE_LAST_WEEK,
+    PHRASE_THIS_MONTH,
+    PHRASE_LAST_MONTH,
+    PHRASE_THIS_YEAR,
+    PHRASE_LAST_YEAR,
+    PHRASE_N_AGO,
+    N_PHRASES
+} Phrase;
+
+/* Longer phrases first: "last 7 days" must win over "last". */
+static const char *const phrase_patterns[N_PHRASES] = {
+    "\\b(?:in |from |during )?(?:the )?(?:last|past|previous) (\\d+) (day|week|month|year)s?\\b",
+    "\\b(?:the )?past (day|week|month|year)\\b",
+    "\\btoday\\b",
+    "\\byesterday\\b",
+    "\\bthis week\\b",
+    "\\blast week\\b",
+    "\\bthis month\\b",
+    "\\blast month\\b",
+    "\\bthis year\\b",
+    "\\blast year\\b",
+    "\\b(\\d+) (day|week|month|year)s? ago\\b",
+};
+
+static GRegex *phrase_regexes[N_PHRASES];
+
+static void
+ensure_regexes (void)
+{
+    static gsize initialized = 0;
+
+    if (g_once_init_enter (&initialized))
+    {
+        for (int i = 0; i < N_PHRASES; i++)
+        {
+            phrase_regexes[i] = g_regex_new (phrase_patterns[i], G_REGEX_OPTIMIZE, 0, NULL);
+        }
+        g_once_init_leave (&initialized, 1);
+    }
+}
+
+static GDateTime *
+day_start (GDateTime *d)
+{
+    return g_date_time_new_local (g_date_time_get_year (d), g_date_time_get_month (d),
+                                  g_date_time_get_day_of_month (d), 0, 0, 0);
+}
+
+static GDateTime *
+minus_units (GDateTime *day, int n, const char *unit)
+{
+    if (g_str_equal (unit, "day"))
+    {
+        return g_date_time_add_days (day, -n);
+    }
+    if (g_str_equal (unit, "week"))
+    {
+        return g_date_time_add_days (day, -7 * n);
+    }
+    if (g_str_equal (unit, "month"))
+    {
+        return g_date_time_add_months (day, -n);
+    }
+    return g_date_time_add_years (day, -n);
+}
+
+static gboolean
+is_filler (const char *word)
+{
+    for (int i = 0; filler_words[i] != NULL; i++)
+    {
+        if (g_str_equal (word, filler_words[i]))
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static const KindWord *
+find_kind (const char *word)
+{
+    for (gsize i = 0; i < G_N_ELEMENTS (kind_words); i++)
+    {
+        if (g_str_equal (word, kind_words[i].word))
+        {
+            return &kind_words[i];
+        }
+    }
+    return NULL;
+}
+
+/* Trim non-alphanumeric characters from both ends; keep the word only when
+ * what is left is made of letters, digits and . _ - (safe to search for). */
+static char *
+clean_word (const char *raw)
+{
+    const char *start = raw;
+    const char *end = raw + strlen (raw);
+
+    while (start < end && !g_unichar_isalnum (g_utf8_get_char (start)))
+    {
+        start = g_utf8_next_char (start);
+    }
+    while (end > start)
+    {
+        const char *prev = g_utf8_prev_char (end);
+        if (g_unichar_isalnum (g_utf8_get_char (prev)))
+        {
+            break;
+        }
+        end = prev;
+    }
+    if (end <= start)
+    {
+        return NULL;
+    }
+    for (const char *p = start; p < end; p = g_utf8_next_char (p))
+    {
+        gunichar c = g_utf8_get_char (p);
+        if (!g_unichar_isalnum (c) && c != '.' && c != '_' && c != '-')
+        {
+            return NULL;
+        }
+    }
+    return g_strndup (start, end - start);
+}
+
+/* Lower case, with runs of white space collapsed to one space. */
+static char *
+normalize_text (const char *text)
+{
+    g_autofree char *down = g_utf8_strdown (text, -1);
+    g_auto (GStrv) parts = g_strsplit_set (down, " \t\r\n", -1);
+    g_autoptr (GPtrArray) kept = g_ptr_array_new ();
+
+    for (int i = 0; parts[i] != NULL; i++)
+    {
+        if (*parts[i] != '\0')
+        {
+            g_ptr_array_add (kept, parts[i]);
+        }
+    }
+    g_ptr_array_add (kept, NULL);
+    return g_strjoinv (" ", (char **) kept->pdata);
+}
+
+gboolean
+parcher_natural_search_parse (const char  *text,
+                              GDateTime   *now,
+                              char       **remaining_text,
+                              char       **time_phrase,
+                              GArray     **groups,
+                              GDateTime  **from,
+                              GDateTime  **to)
+{
+    g_autofree char *lower = NULL;
+    g_autofree char *rest = NULL;
+    g_autoptr (GDateTime) today = NULL;
+    GDateTime *range_from = NULL;
+    GDateTime *range_to = NULL;
+    g_autofree char *phrase_label = NULL;
+    g_auto (GStrv) tokens = NULL;
+    g_autoptr (GPtrArray) words = NULL;
+    g_autoptr (GArray) found_groups = NULL;
+
+    g_return_val_if_fail (text != NULL && now != NULL, FALSE);
+
+    lower = normalize_text (text);
+    if (g_utf8_strlen (lower, -1) < 3)
+    {
+        return FALSE;
+    }
+
+    ensure_regexes ();
+    today = day_start (now);
+
+    rest = g_strdup (lower);
+    for (int i = 0; i < N_PHRASES && range_from == NULL; i++)
+    {
+        g_autoptr (GMatchInfo) info = NULL;
+        g_autofree char *num = NULL;
+        g_autofree char *unit = NULL;
+        int start;
+        int end;
+
+        if (phrase_regexes[i] == NULL || !g_regex_match (phrase_regexes[i], rest, 0, &info))
+        {
+            continue;
+        }
+
+        switch ((Phrase) i)
+        {
+            case PHRASE_LAST_N:
+                num = g_match_info_fetch (info, 1);
+                unit = g_match_info_fetch (info, 2);
+                range_from = minus_units (today, atoi (num), unit);
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_PAST_UNIT:
+                unit = g_match_info_fetch (info, 1);
+                range_from = minus_units (today, 1, unit);
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_TODAY:
+                range_from = g_date_time_ref (today);
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_YESTERDAY:
+                range_from = g_date_time_add_days (today, -1);
+                range_to = g_date_time_ref (range_from);
+                break;
+
+            case PHRASE_THIS_WEEK:
+                range_from = g_date_time_add_days (today, -(g_date_time_get_day_of_week (today) - 1));
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_LAST_WEEK:
+            {
+                g_autoptr (GDateTime) monday = g_date_time_add_days (today, -(g_date_time_get_day_of_week (today) - 1));
+                range_from = g_date_time_add_days (monday, -7);
+                range_to = g_date_time_add_days (monday, -1);
+                break;
+            }
+
+            case PHRASE_THIS_MONTH:
+                range_from = g_date_time_new_local (g_date_time_get_year (today), g_date_time_get_month (today), 1, 0, 0, 0);
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_LAST_MONTH:
+            {
+                g_autoptr (GDateTime) first = g_date_time_new_local (g_date_time_get_year (today), g_date_time_get_month (today), 1, 0, 0, 0);
+                range_from = g_date_time_add_months (first, -1);
+                range_to = g_date_time_add_days (first, -1);
+                break;
+            }
+
+            case PHRASE_THIS_YEAR:
+                range_from = g_date_time_new_local (g_date_time_get_year (today), 1, 1, 0, 0, 0);
+                range_to = g_date_time_ref (today);
+                break;
+
+            case PHRASE_LAST_YEAR:
+            {
+                g_autoptr (GDateTime) jan1 = g_date_time_new_local (g_date_time_get_year (today), 1, 1, 0, 0, 0);
+                range_from = g_date_time_add_years (jan1, -1);
+                range_to = g_date_time_add_days (jan1, -1);
+                break;
+            }
+
+            case PHRASE_N_AGO:
+                num = g_match_info_fetch (info, 1);
+                unit = g_match_info_fetch (info, 2);
+                range_from = minus_units (today, atoi (num), unit);
+                range_to = g_date_time_ref (range_from);
+                break;
+
+            default:
+                break;
+        }
+
+        if (range_from != NULL && g_match_info_fetch_pos (info, 0, &start, &end))
+        {
+            g_autofree char *matched = g_strstrip (g_strndup (rest + start, end - start));
+            const char *label = matched;
+            static const char *const prefixes[] = {"in ", "from ", "during ", "the ", NULL};
+            g_autofree char *before = g_strndup (rest, start);
+
+            for (int pi = 0; prefixes[pi] != NULL; pi++)
+            {
+                if (g_str_has_prefix (label, prefixes[pi]))
+                {
+                    label += strlen (prefixes[pi]);
+                    pi = -1;
+                }
+            }
+            phrase_label = g_strdup (label);
+            if (phrase_label[0] != '\0')
+            {
+                phrase_label[0] = g_ascii_toupper (phrase_label[0]);
+            }
+            g_autofree char *after = g_strdup (rest + end);
+            g_free (rest);
+            rest = g_strconcat (before, " ", after, NULL);
+        }
+    }
+
+    if (range_from == NULL)
+    {
+        return FALSE;
+    }
+
+    words = g_ptr_array_new_with_free_func (g_free);
+    found_groups = g_array_new (FALSE, FALSE, sizeof (guint));
+    tokens = g_strsplit (rest, " ", -1);
+    for (int i = 0; tokens[i] != NULL; i++)
+    {
+        g_autofree char *word = clean_word (tokens[i]);
+        const KindWord *kind;
+
+        if (word == NULL || is_filler (word))
+        {
+            continue;
+        }
+        kind = find_kind (word);
+        if (kind != NULL)
+        {
+            for (int g = 0; g < 2 && kind->groups[g] != 0; g++)
+            {
+                gboolean known = FALSE;
+                for (guint k = 0; k < found_groups->len; k++)
+                {
+                    known |= g_array_index (found_groups, guint, k) == kind->groups[g];
+                }
+                if (!known)
+                {
+                    g_array_append_val (found_groups, kind->groups[g]);
+                }
+            }
+        }
+        else
+        {
+            g_ptr_array_add (words, g_steal_pointer (&word));
+        }
+    }
+    g_ptr_array_add (words, NULL);
+
+    if (remaining_text != NULL)
+    {
+        *remaining_text = g_strjoinv (" ", (char **) words->pdata);
+    }
+    if (time_phrase != NULL)
+    {
+        *time_phrase = g_steal_pointer (&phrase_label);
+    }
+    if (groups != NULL)
+    {
+        *groups = g_steal_pointer (&found_groups);
+    }
+    if (from != NULL)
+    {
+        *from = range_from;
+    }
+    else
+    {
+        g_date_time_unref (range_from);
+    }
+    if (to != NULL)
+    {
+        *to = range_to;
+    }
+    else
+    {
+        g_date_time_unref (range_to);
+    }
+    return TRUE;
+}
