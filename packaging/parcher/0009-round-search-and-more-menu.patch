--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -599,3 +599,23 @@
   opacity: 0;
   min-width: 0;
 }
+
+/* The search and more buttons are round, larger than the flat header buttons. */
+headerbar button.parcher-round-button,
+headerbar menubutton.parcher-round-button > button {
+  min-width: 34px;
+  min-height: 34px;
+  padding: 0;
+  border-radius: 999px;
+  background-color: alpha(currentColor, 0.1);
+}
+
+headerbar button.parcher-round-button:hover,
+headerbar menubutton.parcher-round-button > button:hover {
+  background-color: alpha(currentColor, 0.18);
+}
+
+headerbar button.parcher-round-button:checked,
+headerbar menubutton.parcher-round-button > button:checked {
+  background-color: alpha(currentColor, 0.28);
+}
