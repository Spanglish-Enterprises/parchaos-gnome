def load_config():
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(CONFIG, encoding='utf-8')
    sec = cp['Nearby'] if cp.has_section('Nearby') else {}
    receive = str(sec.get('Receive', 'true')).lower() not in ('false', 'no', '0', 'off')
    return {'receive': receive, 'alias': (sec.get('Alias') or '').strip()}


def save_config(conf):
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    cp['Nearby'] = {'Receive': 'true' if conf['receive'] else 'false'}
    if conf.get('alias'):
        cp['Nearby']['Alias'] = conf['alias']
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    tmp = CONFIG + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        cp.write(f)
    os.replace(tmp, CONFIG)


def ensure_identity(folder=None):
    """This computer's certificate and key (made once), and its fingerprint."""
    folder = folder or DATA
    cert, key = os.path.join(folder, 'cert.pem'), os.path.join(folder, 'key.pem')
    if not (os.path.exists(cert) and os.path.exists(key)):
        os.makedirs(folder, mode=0o700, exist_ok=True)
        old = os.umask(0o077)
        try:
            subprocess.run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-sha256', '-nodes',
                            '-days', '3650', '-subj', '/CN=ParchaOS Nearby',
                            '-keyout', key + '.tmp', '-out', cert + '.tmp'],
                           check=True, capture_output=True, timeout=60)
        finally:
            os.umask(old)
        os.replace(key + '.tmp', key)
        os.replace(cert + '.tmp', cert)
    with open(cert, encoding='ascii') as f:
        der = ssl.PEM_cert_to_DER_cert(f.read())
    return cert, key, fingerprint_of(der)


