# The network part: discovery, the receiving server, sending. No GTK here.
# ---------------------------------------------------------------------------------------------

class Incoming:
    """An accepted transfer to this computer."""

    def __init__(self, ip, alias, files, folder):
        self.id = secrets.token_hex(12)
        self.ip = ip
        self.alias = alias
        self.files = files                       # id -> metadata from the sender
        self.tokens = {fid: secrets.token_hex(16) for fid in files}
        self.folder = folder
        self.tops = {}                           # top-level name sent -> name used here
        self.saved = []                          # paths of finished items, top level
        self.done = set()
        self.failed = 0
        self.last = time.monotonic()

    def finished(self):
        return len(self.done) + self.failed >= len(self.files)


class Node:
    """One Nearby device on the network. The front end passes callbacks, all called from
    other threads:
      on_devices()                       the device list changed
      ask(offer) -> bool                 an offer arrived: offer = {id, alias, files, ip};
                                         block until answered (False on timeout)
      on_received(alias, paths, failed)  a transfer to this computer ended
      on_message(alias, text)            a text message arrived
      on_cancelled(alias)                the sender stopped a transfer
    """

    def __init__(self, conf=None, port=None, identity=None, folder=None, **callbacks):
        self.conf = conf or load_config()
        self.cert, self.key, self.fingerprint = identity or ensure_identity()
        self.folder = folder or downloads_dir()
        self.want_port = port or int(os.environ.get('PARCHAOS_NEARBY_PORT') or DEFAULT_PORT)
        self.port = None
        self.cb = callbacks
        self.devices = {}
        self.lock = threading.Lock()
        self.session = None
        self.pending = None
        self.declined = {}                       # ip -> time of the last decline
        self.discovering = False
        self.server = None
        self.msock = None
        self.joined = set()
        self.alive = True

    # -- identity --------------------------------------------------------------------------
    def alias(self):
        return self.conf.get('alias') or pretty_hostname()

    def info(self, announce=None):
        d = {'alias': self.alias(), 'version': PROTOCOL_VERSION, 'deviceModel': 'ParchaOS',
             'deviceType': 'desktop', 'fingerprint': self.fingerprint, 'port': self.port,
             'protocol': 'https', 'download': False}
        if announce is not None:
            d['announce'] = announce
        return d

    def visible(self):
        """Others may find this computer: receiving is on, or the window is looking."""
        return self.conf['receive'] or self.discovering

    def _call(self, name, *args):
        fn = self.cb.get(name)
        if fn:
            return fn(*args)
        return None

    # -- start / stop ----------------------------------------------------------------------
    def start(self):
        self._start_server()
        self._start_multicast()
        threading.Thread(target=self._housekeeping, daemon=True).start()
        if self.conf['receive']:
            self.announce()

    def stop(self):
        self.alive = False
        if self.server:
            self.server.shutdown()
            self.server.server_close()
        if self.msock:
            self.msock.close()

    def _start_server(self):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(self.cert, self.key)
        ctx.set_alpn_protocols(['http/1.1'])      # what LocalSend offers
        node = self

        class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
            daemon_threads = True
            allow_reuse_address = True

            def get_request(self):
                sock, addr = self.socket.accept()
                sock.settimeout(120)
                return ctx.wrap_socket(sock, server_side=True, do_handshake_on_connect=False), addr

            def handle_error(self, request, client_address):
                pass                              # a dropped connection is not news

        last = None
        for port in [self.want_port] + list(range(self.want_port + 1, self.want_port + 20)):
            try:
                self.server = Server(('0.0.0.0', port), make_handler(node))
                self.port = port
                break
            except OSError as e:
                last = e
        if self.server is None:
            raise last
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def _start_multicast(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if hasattr(socket, 'SO_REUSEPORT'):
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        s.bind(('', DEFAULT_PORT))
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
        self.msock = s
        self.join_groups()
        threading.Thread(target=self._listen, daemon=True).start()

    def join_groups(self):
        """Joins the multicast group on every network (call again when networks change)."""
        for _name, addr, _prefix in ipv4_interfaces():
            if addr in self.joined:
                continue
            try:
                self.msock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
                                      socket.inet_aton(GROUP) + socket.inet_aton(addr))
                self.joined.add(addr)
            except OSError:
                pass

    # -- discovery -------------------------------------------------------------------------
    def _send_multicast(self, msg):
        data = json.dumps(msg).encode()
        addrs = [a for _n, a, _p in ipv4_interfaces()] or ['0.0.0.0']
        for addr in addrs:
            try:
                out = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
                out.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
                if addr != '0.0.0.0':
                    out.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(addr))
                out.sendto(data, (GROUP, DEFAULT_PORT))
                out.close()
            except OSError:
                pass

    def announce(self):
        self._send_multicast(self.info(announce=True))

    def _listen(self):
        while self.alive:
            try:
                data, (ip, _port) = self.msock.recvfrom(65536)
            except OSError:
                if not self.alive:
                    return
                time.sleep(1)
                continue
            try:
                msg = json.loads(data)
            except ValueError:
                continue
            dev = parse_device(msg, ip)
            if dev is None or dev['fingerprint'] == self.fingerprint:
                continue
            self.add_device(dev)
            if msg.get('announce') and self.visible():
                threading.Thread(target=self._answer, args=(dev,), daemon=True).start()

    def _answer(self, dev):
        """Answer an announcement: register over HTTP, or reply by multicast if that fails."""
        try:
            self.register_with(dev['ip'], dev['port'], dev['protocol'], timeout=3)
        except (OSError, ValueError, http.client.HTTPException, ssl.SSLError):
            self._send_multicast(self.info(announce=False))

    def register_with(self, ip, port, protocol='https', timeout=2):
        """POST /register to ip:port. Adds and returns the device that answers."""
        conn = self._connection(ip, port, protocol, timeout)
        try:
            body = json.dumps(self.info()).encode()
            conn.request('POST', API + '/register', body, {'Content-Type': 'application/json'})
            resp = conn.getresponse()
            data = resp.read(MAX_JSON)
            if resp.status != 200:
                raise ValueError(f'status {resp.status}')
            msg = json.loads(data)
            if protocol == 'https':
                msg['fingerprint'] = fingerprint_of(conn.sock.getpeercert(binary_form=True))
            msg.setdefault('port', port)
            msg.setdefault('protocol', protocol)
            dev = parse_device(msg, ip)
            if dev and dev['fingerprint'] != self.fingerprint:
                self.add_device(dev)
            return dev
        finally:
            conn.close()

    def add_device(self, dev):
        with self.lock:
            old = self.devices.get(dev['fingerprint'])
            self.devices[dev['fingerprint']] = dev
            changed = old is None or any(old[k] != dev[k] for k in ('alias', 'ip', 'port', 'model'))
        if changed:
            self._call('on_devices')

    def device_list(self):
        with self.lock:
            return sorted(self.devices.values(), key=lambda d: d['alias'].lower())

    def start_discovery(self):
        """While the window is open: announce now and every few seconds; if nothing answers
        multicast, ask the local network address by address."""
        if self.discovering:
            self.announce()
            return
        self.discovering = True
        with self.lock:
            self.devices.clear()
        self._call('on_devices')

        def loop():
            started = time.monotonic()
            scanned = False
            while self.discovering and self.alive:
                self.announce()
                for _ in range(ANNOUNCE_EVERY * 4):
                    if not self.discovering:
                        return
                    time.sleep(0.25)
                    if not scanned and time.monotonic() - started > 3 and not self.devices:
                        scanned = True
                        threading.Thread(target=self.scan, daemon=True).start()
        threading.Thread(target=loop, daemon=True).start()

    def stop_discovery(self):
        self.discovering = False

    def scan(self):
        targets = scan_targets(ipv4_interfaces())

        def one(ip):
            try:
                self.register_with(ip, DEFAULT_PORT, 'https', timeout=1)
            except Exception:        # noqa: BLE001 - nothing there
                pass
        with ThreadPoolExecutor(max_workers=48) as pool:
            list(pool.map(one, targets))

    def _housekeeping(self):
        while self.alive:
            time.sleep(2)
            now = time.monotonic()
            if self.discovering:
                with self.lock:
                    gone = [fp for fp, d in self.devices.items() if now - d['seen'] > SEEN_SECONDS]
                    for fp in gone:
                        del self.devices[fp]
                if gone:
                    self._call('on_devices')
            s = self.session
            if s and now - s.last > IDLE_SESSION_SECONDS:
                self._end_session(s, cancelled=True)

    # -- sending ---------------------------------------------------------------------------
    def _connection(self, ip, port, protocol, timeout):
        if protocol == 'http':
            return http.client.HTTPConnection(ip, port, timeout=timeout)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE           # self-signed: checked by fingerprint instead
        ctx.load_cert_chain(self.cert, self.key)  # newer LocalSend asks for one
        ctx.set_alpn_protocols(['http/1.1'])
        return http.client.HTTPSConnection(ip, port, timeout=timeout, context=ctx)

    def send(self, dev, files, progress, cancel):
        """Sends files ([(id, path, name, size, type)]) to dev. progress(stage, done, total)
        with stage 'waiting' or 'sending'; cancel is a threading.Event. Returns None when
        everything was sent, or a message for the person."""
        alias = dev['alias']
        conn = self._connection(dev['ip'], dev['port'], dev['protocol'], 10)
        session = None
        try:
            try:
                conn.connect()
            except (OSError, ssl.SSLError):
                return _('Could not reach {device}. Check that it is on the same network.').format(device=alias)
            if dev['protocol'] == 'https':
                got = fingerprint_of(conn.sock.getpeercert(binary_form=True))
                if got != dev['fingerprint'].upper():
                    return _('Could not confirm that this is really {device}. Nothing was sent.').format(device=alias)
            meta = {fid: {'id': fid, 'fileName': name, 'size': size, 'fileType': mime,
                          'sha256': None, 'preview': None}
                    for fid, _path, name, size, mime in files}
            body = json.dumps({'info': self.info(), 'files': meta}).encode()
            progress('waiting', 0, 0)
            conn.sock.settimeout(ANSWER_SECONDS + 30)
            conn.request('POST', API + '/prepare-upload', body, {'Content-Type': 'application/json'})
            resp = conn.getresponse()
            data = resp.read(MAX_JSON)
            if cancel.is_set():
                return _('Cancelled.')
            if resp.status == 204:
                return None
            if resp.status != 200:
                return error_text(resp.status, alias)
            answer = json.loads(data)
            session = answer['sessionId']
            tokens = answer.get('files') or {}
            todo = [f for f in files if f[0] in tokens]
            total = sum(f[3] for f in todo)
            sent = 0
            conn.sock.settimeout(60)
            for fid, path, _name, size, _mime in todo:
                query = urllib.parse.urlencode({'sessionId': session, 'fileId': fid, 'token': tokens[fid]})
                conn.putrequest('POST', f'{API}/upload?{query}')
                conn.putheader('Content-Type', 'application/octet-stream')
                conn.putheader('Content-Length', str(size))
                conn.endheaders()
                with open(path, 'rb') as f:
                    left = size
                    while left > 0:
                        if cancel.is_set():
                            raise InterruptedError
                        chunk = f.read(min(CHUNK, left))
                        if not chunk:
                            raise OSError(_('{name} got shorter while it was being sent.').format(name=_name))
                        conn.send(chunk)
                        left -= len(chunk)
                        sent += len(chunk)
                        progress('sending', sent, total)
                resp = conn.getresponse()
                resp.read()
                if resp.status != 200:
                    return error_text(resp.status, alias)
            session = None
            return None
        except InterruptedError:
            return _('Cancelled.')
        except (OSError, ssl.SSLError, http.client.HTTPException, ValueError, KeyError) as e:
            if cancel.is_set():
                return _('Cancelled.')
            if isinstance(e, socket.timeout):
                return _('{device} did not answer.').format(device=alias)
            return _('The transfer to {device} stopped: {error}').format(device=alias, error=e)
        finally:
            conn.close()
            if session:                           # tell the receiver we stopped
                try:
                    c = self._connection(dev['ip'], dev['port'], dev['protocol'], 3)
                    c.request('POST', f'{API}/cancel?sessionId={urllib.parse.quote(session)}')
                    c.getresponse().read()
                    c.close()
                except Exception:      # noqa: BLE001
                    pass

    # -- receiving -------------------------------------------------------------------------
    def offer(self, ip, body):
        """prepare-upload: returns (status, json or None)."""
        if not self.conf['receive']:
            return 403, None
        info, files = body.get('info'), body.get('files')
        if not isinstance(info, dict) or not isinstance(files, dict) or not files:
            return 400, None
        alias = info.get('alias') if isinstance(info.get('alias'), str) else ip
        alias = alias.strip()[:64] or ip
        clean = {}
        for fid, f in files.items():
            if not isinstance(f, dict) or not isinstance(f.get('size', 0), int) or f.get('size', 0) < 0:
                return 400, None
            if safe_parts(f.get('fileName')) is None:
                return 400, None
            clean[str(fid)] = f
        text = is_message(clean)
        if text is not None:
            self._call('on_message', alias, text)
            return 204, None
        if time.monotonic() - self.declined.get(ip, -1e9) < 30:
            return 429, None
        with self.lock:
            if self.session or self.pending:
                return 409, None
            self.pending = {'id': secrets.token_hex(6), 'alias': alias, 'files': clean, 'ip': ip}
            offer = self.pending
        try:
            accepted = bool(self._call('ask', offer))
        finally:
            with self.lock:
                self.pending = None
        if not accepted:
            self.declined[ip] = time.monotonic()
            return 403, None
        need = sum(f.get('size', 0) for f in clean.values())
        os.makedirs(self.folder, exist_ok=True)
        if shutil.disk_usage(self.folder).free < need + 64 * 1024 * 1024:
            self._call('on_received', alias, [], len(clean))
            return 403, None
        s = Incoming(ip, alias, clean, self.folder)
        with self.lock:
            self.session = s
        return 200, {'sessionId': s.id, 'files': s.tokens}

    def receive(self, ip, query, rfile, headers):
        """upload: returns the status."""
        s = self.session
        sid, fid, token = (query.get(k, [''])[0] for k in ('sessionId', 'fileId', 'token'))
        if not sid or not fid or not token:
            return 400
        if s is None or s.id != sid or s.ip != ip:
            return 409 if s else 403
        if s.tokens.get(fid) != token or fid in s.done:
            return 403
        meta = s.files[fid]
        parts = safe_parts(meta.get('fileName'))
        top = parts[0]
        if top not in s.tops:
            s.tops[top] = free_name(s.folder, top)
            s.saved.append(os.path.join(s.folder, s.tops[top]))
        dest = os.path.join(s.folder, s.tops[top], *parts[1:])
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        part = os.path.join(os.path.dirname(dest), '.' + os.path.basename(dest) + '.part')
        digest = hashlib.sha256()
        size = meta.get('size', 0)
        try:
            with open(part, 'wb') as f:
                def sink(data):
                    f.write(data)
                    digest.update(data)
                    s.last = time.monotonic()
                got = read_body(rfile, headers, sink, size)
            if got != size:
                raise EOFError('short')
            want = meta.get('sha256')
            if isinstance(want, str) and want and want.lower() != digest.hexdigest():
                os.unlink(part)
                s.failed += 1
                self._maybe_end(s)
                return 422
            os.replace(part, dest)
            mtime = (meta.get('metadata') or {}).get('modified') if isinstance(meta.get('metadata'), dict) else None
            if isinstance(mtime, str):
                try:
                    t = time.mktime(time.strptime(mtime[:19], '%Y-%m-%dT%H:%M:%S')) - time.timezone
                    os.utime(dest, (t, t))
                except (ValueError, OverflowError, OSError):
                    pass
        except (OSError, EOFError, ValueError):
            try:
                os.unlink(part)
            except OSError:
                pass
            s.failed += 1
            self._maybe_end(s)
            return 500
        s.done.add(fid)
        self._maybe_end(s)
        return 200

    def _maybe_end(self, s):
        if s.finished():
            self._end_session(s)

    def _end_session(self, s, cancelled=False):
        with self.lock:
            if self.session is not s:
                return
            self.session = None
        if cancelled:
            self._call('on_cancelled', s.alias)
        saved = [p for p in s.saved if os.path.exists(p)]
        if saved or s.failed:
            self._call('on_received', s.alias, saved, s.failed + (len(s.files) - len(s.done) - s.failed
                                                                  if cancelled else 0))

    def cancel_from(self, ip, sid):
        s = self.session
        if s and s.id == sid and s.ip == ip:
            self._end_session(s, cancelled=True)
            return 200
        return 403


def make_handler(node):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = 'HTTP/1.1'
        server_version = 'ParchaOS-Nearby'
        sys_version = ''

        def log_message(self, *args):
            pass

        def reply(self, status, obj=None):
            body = json.dumps(obj).encode() if obj is not None else b''
            self.send_response(status)
            if obj is not None:
                self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            if body:
                self.wfile.write(body)

        def json_body(self):
            buf = bytearray()
            read_body(self.rfile, self.headers, buf.extend, MAX_JSON)
            return json.loads(buf or b'{}')

        def do_GET(self):
            path = urllib.parse.urlsplit(self.path).path
            if path == API + '/info' and node.visible():
                info = node.info()
                info.pop('port')
                info.pop('protocol')
                self.reply(200, info)
            else:
                self.reply(404)

        def do_POST(self):
            url = urllib.parse.urlsplit(self.path)
            query = urllib.parse.parse_qs(url.query)
            ip = self.client_address[0]
            try:
                if url.path == API + '/register':
                    body = self.json_body()
                    if not node.visible():
                        return self.reply(403)
                    dev = parse_device(body, ip)
                    if dev and dev['fingerprint'] != node.fingerprint:
                        node.add_device(dev)
                    info = node.info()
                    info.pop('port')
                    info.pop('protocol')
                    return self.reply(200, info)
                if url.path == API + '/prepare-upload':
                    body = self.json_body()
                    status, answer = node.offer(ip, body if isinstance(body, dict) else {})
                    return self.reply(status, answer)
                if url.path == API + '/upload':
                    status = node.receive(ip, query, self.rfile, self.headers)
                    if status != 200:
                        self.close_connection = True
                    return self.reply(status)
                if url.path == API + '/cancel':
                    return self.reply(node.cancel_from(ip, query.get('sessionId', [''])[0]))
            except (ValueError, EOFError):
                self.close_connection = True
                return self.reply(400)
            self.reply(404)
    return Handler


