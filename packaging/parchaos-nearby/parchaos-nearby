def run_app(argv, service):
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Adw, Gio, GLib, Gtk

    TYPE_ICONS = {'mobile': 'phone-symbolic', 'web': 'web-browser-symbolic',
                  'headless': 'network-server-symbolic', 'server': 'network-server-symbolic'}

    def idle(fn, *args):
        GLib.idle_add(lambda: (fn(*args), False)[1])

    class DeviceRow(Adw.ActionRow):
        def __init__(self, win, dev):
            super().__init__(activatable=True)
            self.win = win
            self.dev = dev
            self.cancel = None
            self.icon = Gtk.Image(icon_name=TYPE_ICONS.get(dev['type'], 'computer-symbolic'))
            self.add_prefix(self.icon)
            self.bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER, width_request=90, visible=False)
            self.state = Gtk.Image(visible=False)
            self.stop = Gtk.Button(icon_name='process-stop-symbolic', valign=Gtk.Align.CENTER,
                                   tooltip_text=_('Stop'), visible=False, css_classes=['flat', 'circular'])
            self.stop.connect('clicked', lambda *_: self.cancel and self.cancel.set())
            for w in (self.bar, self.state, self.stop):
                self.add_suffix(w)
            self.connect('activated', lambda *_: self.win.send_to(self))
            self.update(dev)

        def update(self, dev):
            self.dev = dev
            self.set_title(GLib.markup_escape_text(dev['alias']))
            if self.cancel is None and not self.state.get_visible():
                self.set_subtitle(GLib.markup_escape_text(dev['model'] or
                                  (_('Phone') if dev['type'] == 'mobile' else _('Computer'))))

        def progress(self, stage, done, total):
            if stage == 'waiting':
                self.set_subtitle(_('Waiting for {device} to accept…').format(
                    device=GLib.markup_escape_text(self.dev['alias'])))
                self.bar.set_visible(True)
                self.bar.pulse()
            else:
                self.bar.set_fraction(done / total if total else 1)
                self.set_subtitle(_('{done} of {total}').format(done=format_size(done), total=format_size(total)))

        def finished(self, error):
            self.cancel = None
            self.bar.set_visible(False)
            self.stop.set_visible(False)
            self.state.set_visible(True)
            if error:
                self.state.set_from_icon_name('dialog-warning-symbolic')
                self.set_subtitle(GLib.markup_escape_text(error))
            else:
                self.state.set_from_icon_name('object-select-symbolic')
                self.set_subtitle(_('Sent'))

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=_('Nearby Devices'), default_width=440,
                             default_height=600)
            self.app = app
            self.files = []
            self.rows = {}
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            self.page = Adw.PreferencesPage()
            view.set_content(self.page)
            self.toasts = Adw.ToastOverlay(child=view)
            self.set_content(self.toasts)

            # What is being sent
            self.what = Adw.PreferencesGroup()
            self.what_row = Adw.ActionRow()
            self.what_row.add_prefix(Gtk.Image(icon_name='document-send-symbolic'))
            choose = Gtk.Button(label=_('Choose Files…'), valign=Gtk.Align.CENTER)
            choose.connect('clicked', lambda *_: self.choose_files())
            self.what_row.add_suffix(choose)
            self.what.add(self.what_row)
            self.page.add(self.what)

            # Offers and messages for this computer
            self.incoming = Adw.PreferencesGroup(title=_('For This Computer'), visible=False)
            self.offer_row = Adw.ActionRow(visible=False)
            self.offer_row.add_prefix(Gtk.Image(icon_name='folder-download-symbolic'))
            decline = Gtk.Button(label=_('Decline'), valign=Gtk.Align.CENTER)
            accept = Gtk.Button(label=_('Accept'), valign=Gtk.Align.CENTER, css_classes=['suggested-action'])
            decline.connect('clicked', lambda *_: self.app.answer(False))
            accept.connect('clicked', lambda *_: self.app.answer(True))
            self.offer_row.add_suffix(decline)
            self.offer_row.add_suffix(accept)
            self.incoming.add(self.offer_row)
            self.message_row = Adw.ActionRow(visible=False, subtitle_lines=6)
            self.message_row.add_prefix(Gtk.Image(icon_name='mail-unread-symbolic'))
            copy = Gtk.Button(label=_('Copy'), valign=Gtk.Align.CENTER)
            copy.connect('clicked', lambda *_: self.copy_message())
            self.message_row.add_suffix(copy)
            self.incoming.add(self.message_row)
            self.page.add(self.incoming)

            # Nearby devices
            self.group = Adw.PreferencesGroup(title=_('Nearby Devices'))
            spinner = Adw.Spinner()
            self.group.set_header_suffix(spinner)
            self.empty = Adw.ActionRow(
                title=_('Looking for devices…'),
                subtitle=_('Devices on the same network show up here. On a phone or another '
                           'computer, open LocalSend. Other ParchaOS computers show up by themselves.'),
                subtitle_lines=4)
            self.group.add(self.empty)
            self.page.add(self.group)

            # Receiving
            me = Adw.PreferencesGroup(title=_('This Computer'))
            self.receive = Adw.SwitchRow(title=_('Let Nearby Devices Send Me Files'), subtitle_lines=3)
            self.receive.set_active(app.node.conf['receive'])
            self.receive.connect('notify::active', self.receive_changed)
            me.add(self.receive)
            self.page.add(me)
            self.receive_subtitle()

            self.set_files([])
            self.connect('close-request', self.closing)
            self.refresh_devices()
            self.show_incoming()

        def receive_subtitle(self):
            name = GLib.markup_escape_text(self.app.node.alias())
            if self.receive.get_active():
                text = _('Shows up as “{name}”. You are always asked first; files go to Downloads.')
            else:
                text = _('Off. Others can see “{name}” only while this window is open.')
            self.receive.set_subtitle(text.format(name=name))

        def receive_changed(self, *_):
            self.app.node.conf['receive'] = self.receive.get_active()
            save_config(self.app.node.conf)
            self.receive_subtitle()
            if self.receive.get_active():
                self.app.node.announce()

        def set_files(self, paths):
            self.files = collect_files(paths)
            if self.files:
                names = top_names(f[2] for f in self.files)
                total = sum(f[3] for f in self.files)
                self.what_row.set_title(GLib.markup_escape_text(names_text(names)))
                self.what_row.set_subtitle(ngettext('{n} file · {size}', '{n} files · {size}',
                                                    len(self.files)).format(n=len(self.files), size=format_size(total)))
                self.what.set_title(_('Send'))
            else:
                self.what.set_title('')
                self.what_row.set_title(_('Choose what to send'))
                self.what_row.set_subtitle(_('Then click a device below.'))
            for row in self.rows.values():
                if row.cancel is None:
                    row.state.set_visible(False)
                    row.update(row.dev)

        def choose_files(self, then=None):
            dialog = Gtk.FileDialog(title=_('Choose Files to Send'), modal=True)

            def done(d, res):
                try:
                    files = d.open_multiple_finish(res)
                except GLib.Error:
                    return
                paths = [f.get_path() for f in files if f.get_path()]
                if paths:
                    self.set_files(paths)
                    if then:
                        then()
            dialog.open_multiple(self, None, done)

        def refresh_devices(self):
            devs = {d['fingerprint']: d for d in self.app.node.device_list()}
            for fp in list(self.rows):
                if fp not in devs and self.rows[fp].cancel is None:
                    self.group.remove(self.rows.pop(fp))
            for fp, dev in devs.items():
                if fp in self.rows:
                    self.rows[fp].update(dev)
                else:
                    self.rows[fp] = DeviceRow(self, dev)
                    self.group.add(self.rows[fp])
            self.empty.set_visible(not self.rows)

        def send_to(self, row):
            if row.cancel is not None:
                return
            if not self.files:
                self.choose_files(lambda: self.send_to(row))
                return
            row.cancel = threading.Event()
            row.state.set_visible(False)
            row.stop.set_visible(True)
            row.bar.set_fraction(0)
            files, dev, cancel = list(self.files), dict(row.dev), row.cancel

            def work():
                err = self.app.node.send(dev, files, lambda *a: idle(row.progress, *a), cancel)
                idle(row.finished, err)
            threading.Thread(target=work, daemon=True).start()

        def show_incoming(self):
            offer = self.app.offer
            if offer:
                title, detail = offer_text(offer['alias'], offer['files'])
                self.offer_row.set_title(GLib.markup_escape_text(title))
                self.offer_row.set_subtitle(GLib.markup_escape_text(detail))
            self.offer_row.set_visible(bool(offer))
            msg = self.app.message
            if msg:
                self.message_row.set_title(GLib.markup_escape_text(_('Message from {device}').format(device=msg[0])))
                self.message_row.set_subtitle(GLib.markup_escape_text(msg[1][:600]))
            self.message_row.set_visible(bool(msg))
            self.incoming.set_visible(bool(offer or msg))

        def copy_message(self):
            if self.app.message:
                self.get_clipboard().set(self.app.message[1])
                self.toasts.add_toast(Adw.Toast(title=_('Copied')))

        def closing(self, *_):
            self.app.node.stop_discovery()
            self.app.win = None
            return False

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
            self.node = None
            self.win = None
            self.offer = None
            self.answer_event = None
            self.answer_value = False
            self.message = None
            self.skip_activate = service      # the service starts without a window
            for name, kind, fn in (('answer', 's', self.on_answer_action),
                                   ('show-items', 's', self.on_show_items),
                                   ('show-window', None, lambda *_: self.present_window()),
                                   ('copy-message', None, self.on_copy_message)):
                act = Gio.SimpleAction.new(name, GLib.VariantType.new(kind) if kind else None)
                act.connect('activate', fn)
                self.add_action(act)

        def do_startup(self):
            Adw.Application.do_startup(self)
            self.node = Node(on_devices=lambda: idle(self.devices_changed),
                             ask=self.ask, on_received=lambda *a: idle(self.received, *a),
                             on_message=lambda *a: idle(self.got_message, *a),
                             on_cancelled=lambda a: idle(self.cancelled, a))
            try:
                self.node.start()
            except OSError as e:
                print(f'parchaos-nearby: could not start: {e}', file=sys.stderr)
            Gio.NetworkMonitor.get_default().connect('network-changed', lambda *_: self.network_changed())
            if service:
                self.hold()

        def network_changed(self):
            threading.Thread(target=self._rejoin, daemon=True).start()

        def _rejoin(self):
            time.sleep(2)
            self.node.join_groups()
            if self.node.visible():
                self.node.announce()

        def present_window(self, paths=None):
            if self.win is None:
                self.win = Window(self)
            if paths:
                self.win.set_files(paths)
            self.win.present()
            self.node.start_discovery()

        def do_activate(self):
            if self.skip_activate:
                self.skip_activate = False
                return
            self.present_window()

        def do_open(self, files, n_files, hint):
            self.present_window([f.get_path() for f in files if f.get_path()])

        def devices_changed(self):
            if self.win:
                self.win.refresh_devices()

        # An offer: called in a server thread; waits for the person.
        def ask(self, offer):
            event = threading.Event()

            def show():
                self.offer, self.answer_event, self.answer_value = offer, event, False
                title, detail = offer_text(offer['alias'], offer['files'])
                n = Gio.Notification.new(title)
                n.set_body(detail)
                n.set_icon(Gio.ThemedIcon.new('folder-download-symbolic'))
                n.set_priority(Gio.NotificationPriority.HIGH)
                n.set_default_action('app.show-window')
                n.add_button_with_target(_('Decline'), 'app.answer', GLib.Variant('s', offer['id'] + ':no'))
                n.add_button_with_target(_('Accept'), 'app.answer', GLib.Variant('s', offer['id'] + ':yes'))
                self.send_notification('offer', n)
                if self.win:
                    self.win.show_incoming()
            idle(show)
            event.wait(ANSWER_SECONDS)
            value = self.answer_value if event.is_set() else False
            idle(self.offer_over, offer)
            return value

        def offer_over(self, offer):
            if self.offer is offer:
                self.offer = None
                self.answer_event = None
                self.withdraw_notification('offer')
                if self.win:
                    self.win.show_incoming()

        def answer(self, yes):
            if self.answer_event:
                self.answer_value = yes
                self.answer_event.set()

        def on_answer_action(self, _act, param):
            oid, _sep, what = param.get_string().partition(':')
            if self.offer and self.offer['id'] == oid:
                self.answer(what == 'yes')

        def received(self, alias, paths, failed):
            if paths:
                n = Gio.Notification.new(ngettext('Received {n} item from {device}',
                                                  'Received {n} items from {device}',
                                                  len(paths)).format(n=len(paths), device=alias))
                body = names_text(os.path.basename(p) for p in paths)
                if failed:
                    body += ' · ' + ngettext('{n} file did not arrive', '{n} files did not arrive',
                                             failed).format(n=failed)
                n.set_body(body)
                uris = json.dumps([Gio.File.new_for_path(p).get_uri() for p in paths])
                n.set_default_action_and_target('app.show-items', GLib.Variant('s', uris))
                n.add_button_with_target(_('Show in Files'), 'app.show-items', GLib.Variant('s', uris))
            else:
                n = Gio.Notification.new(_('Files from {device} did not arrive').format(device=alias))
                n.set_body(_('There may not be enough space in Downloads, or the connection dropped.'))
            n.set_icon(Gio.ThemedIcon.new('folder-download-symbolic'))
            self.send_notification(None, n)

        def cancelled(self, alias):
            n = Gio.Notification.new(_('{device} stopped sending').format(device=alias))
            n.set_icon(Gio.ThemedIcon.new('folder-download-symbolic'))
            self.send_notification(None, n)

        def got_message(self, alias, text):
            self.message = (alias, text)
            n = Gio.Notification.new(_('Message from {device}').format(device=alias))
            n.set_body(text[:300])
            n.set_icon(Gio.ThemedIcon.new('mail-unread-symbolic'))
            n.set_default_action('app.show-window')
            n.add_button(_('Copy'), 'app.copy-message')
            self.send_notification('message', n)
            if self.win:
                self.win.show_incoming()

        def on_copy_message(self, *_):
            # Wayland only lets a focused window set the clipboard: show the window, then copy.
            self.present_window()
            GLib.timeout_add(300, lambda: (self.win and self.win.copy_message(), False)[1])

        def on_show_items(self, _act, param):
            uris = json.loads(param.get_string())
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            try:
                bus.call_sync('org.freedesktop.FileManager1', '/org/freedesktop/FileManager1',
                              'org.freedesktop.FileManager1', 'ShowItems',
                              GLib.Variant('(ass)', (uris, '')), None, Gio.DBusCallFlags.NONE, 5000)
            except GLib.Error:
                Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(downloads_dir()).get_uri())

    app = App()
    if service:
        app.register(None)
        if app.get_is_remote():
            return 0                  # already running for this session
    return app.run(argv)


def main(argv):
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    service = '--service' in argv
    argv = [a for a in argv if a != '--service']
    return run_app(argv, service)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
