def downloads_dir():
    """The Downloads folder from user-dirs.dirs, as GLib reads it."""
    env = os.environ.get('PARCHAOS_NEARBY_DOWNLOADS')
    if env:
        return env
    conf = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config'),
                        'user-dirs.dirs')
    try:
        with open(conf, encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line.startswith('XDG_DOWNLOAD_DIR='):
                    value = line.split('=', 1)[1].strip().strip('"')
                    value = value.replace('$HOME', HOME)
                    if os.path.isabs(value):
                        return value
    except OSError:
        pass
    return os.path.join(HOME, 'Downloads')


def safe_parts(name):
    """A received file name as safe path parts, or None. LocalSend sends folders as
    "Folder/sub/file"; nothing may climb out of the destination."""
    if not isinstance(name, str):
        return None
    parts = []
    for part in name.replace('\\', '/').split('/'):
        part = part.strip().replace('\0', '')
        if part in ('', '.', '..'):
            continue
        parts.append(part[:200])
    return parts or None


def free_name(folder, name):
    """name, or "name (2).ext", "name (3).ext"... whichever isn't taken in folder."""
    if not os.path.lexists(os.path.join(folder, name)):
        return name
    stem, ext = os.path.splitext(name)
    if stem.endswith('.tar'):
        stem, ext = stem[:-4], '.tar' + ext
    n = 2
    while os.path.lexists(os.path.join(folder, f'{stem} ({n}){ext}')):
        n += 1
    return f'{stem} ({n}){ext}'


def collect_files(paths):
    """The files to send: [(id, path, name sent, size, type)]. A folder is sent with what is
    inside it, as "Folder/inside/file"; hidden files inside it are left out."""
    out = []

    def add(path, name):
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        mime = mimetypes.guess_type(name)[0] or 'application/octet-stream'
        out.append((secrets.token_hex(8), path, name, size, mime))

    for path in paths:
        path = os.path.abspath(path)
        if os.path.isdir(path):
            top = os.path.basename(path.rstrip('/')) or 'Folder'
            for root, dirs, files in os.walk(path):
                dirs[:] = sorted(d for d in dirs if not d.startswith('.'))
                rel = os.path.relpath(root, path)
                for name in sorted(files):
                    if name.startswith('.'):
                        continue
                    full = os.path.join(root, name)
                    if not os.path.isfile(full):
                        continue
                    sent = '/'.join(p for p in (top, '' if rel == '.' else rel, name) if p)
                    add(full, sent)
        elif os.path.isfile(path):
            add(path, os.path.basename(path))
    return out


def parse_device(msg, ip):
    """A device from an announcement or a register body, or None if it doesn't look like one."""
    if not isinstance(msg, dict):
        return None
    alias = msg.get('alias')
    fp = msg.get('fingerprint')
    if not isinstance(alias, str) or not alias.strip() or not isinstance(fp, str) or not fp:
        return None
    port = msg.get('port', DEFAULT_PORT)
    if not isinstance(port, int) or not 0 < port < 65536:
        return None
    protocol = msg.get('protocol', 'https')
    if protocol not in ('http', 'https'):
        return None
    kind = msg.get('deviceType')
    if kind not in ('mobile', 'desktop', 'web', 'headless', 'server'):
        kind = 'desktop'
    model = msg.get('deviceModel')
    return {'alias': alias.strip()[:64], 'fingerprint': fp, 'ip': ip, 'port': port,
            'protocol': protocol, 'type': kind,
            'model': model.strip()[:64] if isinstance(model, str) and model.strip() else '',
            'seen': time.monotonic()}


def is_message(files):
    """A LocalSend text message: one text/plain "file" whose text is in preview."""
    if len(files) != 1:
        return None
    f = next(iter(files.values()))
    if isinstance(f, dict) and f.get('fileType') == 'text/plain' and isinstance(f.get('preview'), str):
        return f['preview']
    return None


def format_size(n):
    for unit, size in ((_('GB'), 1e9), (_('MB'), 1e6), (_('kB'), 1e3)):
        if n >= size:
            # Translators: a file size, e.g. "4.2 MB"
            return _('{number} {unit}').format(number=locale.format_string('%.1f', n / size), unit=unit)
    return ngettext('{n} byte', '{n} bytes', n).format(n=n)


def names_text(names):
    """photo.jpg / photo.jpg and notes.pdf / photo.jpg, notes.pdf and 3 more"""
    names = list(names)
    if len(names) == 1:
        return names[0]
    if len(names) == 2:
        return _('{a} and {b}').format(a=names[0], b=names[1])
    more = len(names) - 2
    return ngettext('{a}, {b} and {n} more', '{a}, {b} and {n} more', more).format(
        a=names[0], b=names[1], n=more)


def top_names(names):
    """What a transfer is, by its top-level items: a folder counts once."""
    seen = []
    for name in names:
        top = name.split('/', 1)[0]
        if top not in seen:
            seen.append(top)
    return seen


def offer_text(alias, files):
    """("Pixel 8 wants to send you 3 files", "photo.jpg, b.jpg and 1 more · 4.2 MB")"""
    names = [f.get('fileName', '?') for f in files.values()]
    total = sum(f.get('size', 0) for f in files.values() if isinstance(f.get('size'), int))
    title = ngettext('{device} wants to send you a file', '{device} wants to send you {n} files',
                     len(names)).format(device=alias, n=len(names))
    return title, f'{names_text(top_names(names))} · {format_size(total)}'


def error_text(status, alias):
    """Plain words for a receiver's answer."""
    return {
        403: _('{device} declined.'),
        409: _('{device} is busy with another transfer. Try again in a moment.'),
        429: _('{device} asked to wait. Try again in a moment.'),
        401: _('{device} asks for a PIN. Turn off the PIN in its LocalSend settings and try again.'),
        422: _('A file arrived damaged on {device}. Try again.'),
    }.get(status, _('{device} could not take the files (error {code}).')).format(device=alias, code=status)


def fingerprint_of(der):
    return hashlib.sha256(der).hexdigest().upper()


def ipv4_interfaces():
    """[(name, address, prefix)] of the IPv4 addresses that are up, without loopback."""
    try:
        out = subprocess.run(['ip', '-j', '-4', 'addr', 'show', 'up'], capture_output=True,
                             text=True, timeout=5).stdout
        data = json.loads(out or '[]')
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    result = []
    for iface in data:
        name = iface.get('ifname', '')
        if name == 'lo':
            continue
        for a in iface.get('addr_info', []):
            if a.get('family') == 'inet' and a.get('local'):
                result.append((name, a['local'], int(a.get('prefixlen', 24))))
    return result


def scan_targets(interfaces, limit=1024):
    """The other addresses on the real (not virtual) local networks, for the address-by-address
    search when multicast is blocked. Networks bigger than /22 are only searched near us."""
    out = []
    for name, addr, prefix in interfaces:
        if name.startswith(VIRTUAL_IFACES):
            continue
        net = ipaddress.ip_network(f'{addr}/{max(prefix, 22)}', strict=False)
        for host in net.hosts():
            if str(host) != addr:
                out.append(str(host))
            if len(out) >= limit:
                return out
    return out


def pretty_hostname():
    try:
        with open('/etc/machine-info', encoding='utf-8') as f:
            for line in f:
                if line.startswith('PRETTY_HOSTNAME='):
                    name = line.split('=', 1)[1].strip().strip('"').strip("'")
                    if name:
                        return name
    except OSError:
        pass
    return socket.gethostname().split('.')[0] or 'ParchaOS'


def read_body(rfile, headers, sink, limit):
    """Reads a request body (Content-Length or chunked) into sink(bytes). Returns the size.
    Raises ValueError if it is bigger than limit."""
    total = 0
    if 'chunked' in headers.get('Transfer-Encoding', '').lower():
        while True:
            line = rfile.readline(1024)
            if not line:
                raise EOFError('body ended early')
            size = int(line.split(b';', 1)[0].strip() or b'0', 16)
            if size == 0:
                while rfile.readline(1024) not in (b'\r\n', b'\n', b''):
                    pass
                return total
            total += size
            if total > limit:
                raise ValueError('too big')
            while size:
                data = rfile.read(min(CHUNK, size))
                if not data:
                    raise EOFError('body ended early')
                sink(data)
                size -= len(data)
            rfile.readline(4)
    length = int(headers.get('Content-Length') or 0)
    if length > limit:
        raise ValueError('too big')
    while total < length:
        data = rfile.read(min(CHUNK, length - total))
        if not data:
            raise EOFError('body ended early')
        sink(data)
        total += len(data)
    return total


