gettext.textdomain(DOMAIN)
_ = gettext.gettext
ngettext = gettext.ngettext

APP_ID = 'org.parchaos.Nearby'
PROTOCOL_VERSION = '2.2'
DEFAULT_PORT = 53317
GROUP = '224.0.0.167'
API = '/api/localsend/v2'
HOME = os.path.expanduser('~')
DATA = os.environ.get('PARCHAOS_NEARBY_DATA') or os.path.join(
    os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local', 'share'), 'parchaos', 'nearby')
