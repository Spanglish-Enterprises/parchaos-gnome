ANSWER_SECONDS = 60          # how long an offer waits for Accept or Decline
SEEN_SECONDS = 30            # a device that stops answering drops off the list
ANNOUNCE_EVERY = 5           # while the window is open
IDLE_SESSION_SECONDS = 300   # an accepted transfer that stops sending is dropped
MAX_JSON = 16 * 1024 * 1024
CHUNK = 64 * 1024
VIRTUAL_IFACES = ('lo', 'docker', 'veth', 'virbr', 'podman', 'br-', 'tun', 'tap', 'vnet', 'cni')


