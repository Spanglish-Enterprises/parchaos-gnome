#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# parchaos-os-release: write /etc/os-release and /etc/system-release as ParchaOS.
#
# generic-release-common (or fedora-release-common) owns /etc/os-release
# (a symlink to /usr/lib/os-release) and puts stock release files back on
# every update, so this runs at install and again from a trigger whenever
# that package changes.
#
# ID stays "parchaos" (ID_LIKE=fedora): with ID=fedora, the app store
# would offer new Fedora releases before ParchaOS supports them.
# CPE_NAME is updated to reflect ParchaOS, avoiding Fedora trademark issues.
# /etc/system-release is updated to "ParchaOS release <version_id>" to
# ensure login banners and system utilities show the correct distribution.

set -eu

SRC=/usr/lib/os-release
DEST=/etc/os-release
SITE=https://parchaos.org

[ -r "$SRC" ] || exit 0
# shellcheck source=/dev/null
version_id=$(. "$SRC" && echo "${VERSION_ID:-}")

tmp=$(mktemp /etc/.os-release.XXXXXX)
{
    grep -vE '^(NAME|VERSION|PRETTY_NAME|ID|ID_LIKE|ANSI_COLOR|LOGO|DEFAULT_HOSTNAME|HOME_URL|DOCUMENTATION_URL|SUPPORT_URL|BUG_REPORT_URL|CPE_NAME|REDHAT_[A-Z_]*)=' "$SRC"
    echo 'NAME="ParchaOS"'
    echo "VERSION=\"${version_id}\""
    echo "PRETTY_NAME=\"ParchaOS ${version_id}\""
    echo 'ID=parchaos'
    echo 'ID_LIKE=fedora'
    echo "CPE_NAME=\"cpe:/o:parchaos:parchaos:${version_id}\""
    echo 'ANSI_COLOR="0;38;2;93;0;147"'
    echo 'LOGO=parchaos-logo'
    echo 'DEFAULT_HOSTNAME="parchaos"'
    echo "HOME_URL=\"$SITE\""
    echo "DOCUMENTATION_URL=\"$SITE/#faq\""
    echo "SUPPORT_URL=\"$SITE/support\""
    echo "BUG_REPORT_URL=\"$SITE/support\""
} >"$tmp"
chmod 0644 "$tmp"
# Replaces stock symlink (or an older copy) in one step.
mv -f "$tmp" "$DEST"

# Update /etc/system-release to match ParchaOS release strings
if [ -n "$version_id" ]; then
    echo "ParchaOS release ${version_id}" > /etc/system-release
fi
