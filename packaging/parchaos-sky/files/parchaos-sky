def calendar_trips(days_ahead=10):
    """[(datetime local, location text, summary)] for events with a location, next days_ahead days."""
    test = os.environ.get('PARCHA_SKY_TRIPS')  # tests: "City|YYYY-MM-DD|Summary;..."
    if test:
        out = []
        for item in test.split(';'):
            city, day, summary = (item.split('|') + ['', ''])[:3]
            out.append((datetime.fromisoformat(day + 'T12:00'), city, summary))
        return out
    try:
        gi.require_version('ECal', '2.0')
        gi.require_version('EDataServer', '1.2')
        gi.require_version('ICalGLib', '3.0')
        from gi.repository import ECal, EDataServer, ICalGLib
    except (ValueError, ImportError):
        return []
    out = []
    try:
        registry = EDataServer.SourceRegistry.new_sync(None)
        start = int(time.time())
        end = start + days_ahead * 86400
        sexp = (f'(occur-in-time-range? (make-time "{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(start))}") '
                f'(make-time "{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(end))}"))')
        for source in registry.list_enabled(EDataServer.SOURCE_EXTENSION_CALENDAR):
            try:
                client = ECal.Client.connect_sync(source, ECal.ClientSourceType.EVENTS, 5, None)
                ok, comps = client.get_object_list_as_comps_sync(sexp, None)
            except GLib.Error:
                continue
            for comp in comps or []:
                loc = comp.get_location()
                if not loc:
                    continue
                dt = comp.get_dtstart()
                if not dt:
                    continue
                v = dt.get_value()
                when = datetime(v.get_year(), v.get_month(), v.get_day(), v.get_hour(), v.get_minute())
                summary = comp.get_summary()
                text = summary.get_value() if summary else ''
                out.append((when, loc, text))
    except GLib.Error:
        return []
    return sorted(out)[:6]


def find_city(text):
    """Look a city up in GWeather's offline world list (no network)."""
    try:
        gi.require_version('GWeather', '4.0')
        from gi.repository import GWeather
    except (ValueError, ImportError):
        return None
    parts = [p.strip().lower() for p in text.split(',') if p.strip()]
    if not parts:
        return None
    candidates = parts[::-1] if len(parts) > 2 else parts  # "123 Main St, Austin, TX" -> try Austin
    world = GWeather.Location.get_world()
    cities = _city_index(world, GWeather)
    for want in candidates:
        if want in cities:
            return cities[want]
    for want in candidates:
        for name, hit in cities.items():
            if name.startswith(want) and len(want) >= 4:
                return hit
    return None


_CITIES = None


def _city_index(world, GWeather):
    global _CITIES
    if _CITIES is None:
        _CITIES = {}
        stack = [world]
        while stack:
            loc = stack.pop()
            child = loc.next_child(None)
            while child:
                stack.append(child)
                child = loc.next_child(child)
            if loc.get_level() == GWeather.LocationLevel.CITY and loc.has_coords():
                name = (loc.get_name() or '').lower()
                if name and name not in _CITIES:
                    lat, lon = loc.get_coords()
                    _CITIES[name] = {'name': loc.get_name(), 'lat': lat, 'lon': lon}
    return _CITIES


