class TempBar(Gtk.DrawingArea):
    """A day's low-to-high bar on the range of the whole forecast."""

    def __init__(self, lo, hi, lo_all, hi_all):
        super().__init__(content_width=120, content_height=6, hexpand=True, valign=Gtk.Align.CENTER)
        self.lo, self.hi, self.lo_all, self.hi_all = lo, hi, lo_all, hi_all
        self.set_draw_func(self._draw)

    @staticmethod
    def _colour(c):
        # cold blue -> mild green -> warm yellow -> hot orange/red
        pts = [(-10, (0.45, 0.65, 1.0)), (8, (0.45, 0.85, 0.9)), (18, (0.55, 0.9, 0.5)),
               (26, (1.0, 0.85, 0.35)), (34, (1.0, 0.5, 0.25)), (40, (0.95, 0.3, 0.3))]
        for (a, ca), (b, cb) in zip(pts, pts[1:]):
            if c <= b:
                return mix(ca, cb, (c - a) / (b - a)) if c >= a else ca
        return pts[-1][1]

    def _draw(self, area, cr, w, h):
        span = max(1e-3, self.hi_all - self.lo_all)
        cr.set_source_rgba(1, 1, 1, 0.18)
        self._pill(cr, 0, 0, w, h)
        cr.fill()
        x0 = w * (self.lo - self.lo_all) / span
        x1 = w * (self.hi - self.lo_all) / span
        import cairo
        grad = cairo.LinearGradient(x0, 0, x1, 0)
        grad.add_color_stop_rgb(0, *self._colour(self.lo))
        grad.add_color_stop_rgb(1, *self._colour(self.hi))
        cr.set_source(grad)
        self._pill(cr, x0, 0, max(h, x1 - x0), h)
        cr.fill()

    @staticmethod
    def _pill(cr, x, y, w, h):
        r = h / 2
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, math.pi / 2)
        cr.arc(x + r, y + r, r, math.pi / 2, 3 * math.pi / 2)
        cr.close_path()


class SkyWindow(Adw.ApplicationWindow):
