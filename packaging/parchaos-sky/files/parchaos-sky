def summary_line(fc, playful, temp_text):
    now = fc.now()
    if not now:
        return ''
    es = spanish()
    hot = now['temp'] is not None and now['temp'] >= 30
    cold = now['temp'] is not None and now['temp'] <= 3
    kind, when = fc.rain_soon()
    when_txt = when.strftime('%-I %p').lower() if when and uses_imperial() else (when.strftime('%H:%M') if when else '')
    _icon, cond, thunder = symbol_info(now['symbol'])
    if not playful:
        if kind == 'starts':
            return (f'Lluvia a partir de las {when_txt}.' if es else f'Rain starting around {when_txt}.')
        if kind == 'stops':
            return (f'La lluvia para hacia las {when_txt}.' if es else f'Rain stopping around {when_txt}.')
        return f'{cond}, {temp_text}.'
    if thunder:
        return 'Truenos por ahí. Mejor adentro un rato.' if es else 'Thunder about. Good time for indoors.'
    if kind == 'starts':
        return (f'Seco por ahora; el aguacero llega como a las {when_txt}. Paraguas a mano.' if es
                else f'Dry for now, rain rolls in around {when_txt}. Keep the umbrella close.')
    if kind == 'stops':
        return (f'Llueve, pero escampa como a las {when_txt}.' if es
                else f'Wet out there, but it clears up around {when_txt}.')
    if hot:
        return 'Calorón. Agua, sombra y nada de prisa.' if es else 'Proper hot. Water, shade, no rushing.'
    if cold:
        return 'Frío de verdad. Abrígate bien.' if es else 'Properly cold. Layers on.'
    if now['clouds'] < 25:
        return 'Cielo limpio. Buen día para estar afuera.' if es else 'Clear skies. A good one to be outside.'
    if now['clouds'] > 85:
        return 'Gris y tranquilo. Día de café.' if es else 'Grey and quiet. Coffee weather.'
    return f'{cond}, {temp_text}. Nada que reportar.' if es else f'{cond}, {temp_text}. Nothing dramatic.'


