        self.set_content(overlay)

        self.cards = []
        self.add_tick_callback(self._track_cards)
        self._placeholder(_('Finding the sky over you...'))
        GLib.timeout_add_seconds(REFRESH_SECONDS, self._refresh_tick)
        self._start()

    # -- style ----------------------------------------------------------------------------------

    def _glass_style(self):
        if os.environ.get('PARCHA_SKY_STYLE'):
            return os.environ['PARCHA_SKY_STYLE'] != 'classic'
        src = Gio.SettingsSchemaSource.get_default()
        schema = src.lookup('org.parchaos.desktop', True) if src else None
        if not schema:
            return True
        settings = Gio.Settings(settings_schema=schema)
        self._desktop = settings
        settings.connect('changed::style', lambda *_: self._restyle())
        return settings.get_string('style') != 'classic'

    def _restyle(self):
        self.sky.glass = self._desktop.get_string('style') != 'classic'
        self.sky.queue_draw()

    # -- glass follows the cards ------------------------------------------------------------------

    def _track_cards(self, widget, clock):
        regions = []
        for card in self.cards:
            if not card.get_mapped():
                continue
            ok, b = card.compute_bounds(self.sky)
            if ok:
                regions.append((b.get_x(), b.get_y(), b.get_width(), b.get_height(), 22))
        self.sky.set_cards(regions)
        return GLib.SOURCE_CONTINUE

    # -- places ---------------------------------------------------------------------------------

    def _start(self):
        test = os.environ.get('PARCHA_SKY_PLACE')  # "Name,lat,lon" (tests)
        if test:
            name, lat, lon = test.rsplit(',', 2)
            self.places = [{'name': name, 'lat': float(lat), 'lon': float(lon)}]
        if not self.places:
            self.places = self._gnome_weather_places()
        if self.places:
            self._load()
        else:
            self._locate()

    def _gnome_weather_places(self):
        # Reuse the places saved in GNOME Weather (name, latitude and longitude in radians).
        src = Gio.SettingsSchemaSource.get_default()
        if not src or not src.lookup('org.gnome.Weather', True):
            return []
        out = []
        try:
            for v in Gio.Settings(schema_id='org.gnome.Weather').get_value('locations'):
                inner = v.get_variant() if hasattr(v, 'get_variant') else v
                _ver, loc = inner.unpack()
                name, _code, _x, coords, _y = loc
                if coords:
                    lat, lon = coords[0]
                    out.append({'name': name, 'lat': math.degrees(lat), 'lon': math.degrees(lon)})
        except (TypeError, ValueError, GLib.Error):
            return []
        if out:
            save_json(PLACES_FILE, out)
        return out

    def _locate(self):
        try:
            gi.require_version('Geoclue', '2.0')
            from gi.repository import Geoclue
        except (ValueError, ImportError):
            self._placeholder(_('Add a place to see its weather.'))
            return
        self._placeholder(_('Finding where you are...'))
        Geoclue.Simple.new(APP_ID, Geoclue.AccuracyLevel.CITY, None, self._on_located)

    def _on_located(self, _src, result):
        try:
            from gi.repository import Geoclue
            simple = Geoclue.Simple.new_finish(result)
            loc = simple.get_location()
            self.places = [{'name': _('Here'), 'lat': loc.props.latitude, 'lon': loc.props.longitude}]
            save_json(PLACES_FILE, self.places)
            self._load()
        except GLib.Error:
            self._placeholder(_('Location is off. Add a place with the list button.'))

    def _places_popover(self):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8, margin_bottom=8,
                      margin_start=8, margin_end=8, width_request=300)
        self.search = Gtk.SearchEntry(placeholder_text=_('Add a city'))
        self.search.connect('activate', self._on_search)
        box.append(self.search)
        self.place_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.place_list.add_css_class('boxed-list')
        box.append(self.place_list)
        pop.set_child(box)
        pop.connect('show', lambda *_: self._fill_places())
        return pop

    def _fill_places(self):
        while (row := self.place_list.get_row_at_index(0)):
            self.place_list.remove(row)
        for i, p in enumerate(self.places):
            row = Adw.ActionRow(title=p['name'], activatable=True)
            row.connect('activated', lambda _r, i=i: self._choose(i))
            rm = Gtk.Button(icon_name='user-trash-symbolic', valign=Gtk.Align.CENTER, tooltip_text=_('Remove'))
            rm.add_css_class('flat')
            rm.connect('clicked', lambda _b, i=i: self._remove(i))
            row.add_suffix(rm)
            self.place_list.append(row)

    def _choose(self, i):
        self.index = i
        self.places_button.popdown()
        self._load()

    def _remove(self, i):
        del self.places[i]
        save_json(PLACES_FILE, self.places)
        self.index = min(self.index, max(0, len(self.places) - 1))
        self._fill_places()
        if self.places:
            self._load()

    def _on_search(self, entry):
        text = entry.get_text().strip()
        if not text:
            return
        hit = self._find_city(text)
        if not hit:
            entry.set_text('')
            entry.set_placeholder_text(_('No city called "%s"') % text)
            return
        self.places.append(hit)
        save_json(PLACES_FILE, self.places)
        entry.set_text('')
        self._choose(len(self.places) - 1)

    def _find_city(self, text):
        # GWeather's offline world list: no network, nothing sent anywhere.
        try:
            gi.require_version('GWeather', '4.0')
            from gi.repository import GWeather
        except (ValueError, ImportError):
            return None
        want = text.lower().split(',')[0].strip()
        best = None
        stack = [GWeather.Location.get_world()]
        while stack:
            loc = stack.pop()
            child = loc.next_child(None)
            while child:
                stack.append(child)
                child = loc.next_child(child)
            if loc.get_level() == GWeather.LocationLevel.CITY and loc.has_coords():
                name = loc.get_name() or ''
                if name.lower() == want or (best is None and name.lower().startswith(want)):
                    lat, lon = loc.get_coords()
                    country = loc.get_country_name() or ''
                    best = {'name': name, 'lat': lat, 'lon': lon, 'country': country}
                    if name.lower() == want:
                        return best
        return best

    # -- data -----------------------------------------------------------------------------------

    def _load(self, force=False):
        if not self.places:
            return
        p = self.places[self.index]
        self.service.fetch(p['lat'], p['lon'], force=force)

    def _refresh_tick(self):
        self._load()
        return GLib.SOURCE_CONTINUE

    def _on_failed(self, _svc, message):
        self._placeholder(_("Couldn't reach the weather service.") + '\n' + message)

    def _on_alerts(self, _svc, alerts):
        self.alerts = alerts
        if self.forecast:
            self._render()

    def _on_forecast(self, _svc, fc):
        self.forecast = fc
        self._render()

    # -- sky ------------------------------------------------------------------------------------

    def _update_sky(self, fc):
        now = fc.now()
        st = self.sky.state
        utc = datetime.now(timezone.utc)
        st.sun = sun_elevation(fc.lat, fc.lon, utc)
        times = sun_times(fc.lat, fc.lon, utc)
        if times:
            rise, sset = times
            st.day_fraction = max(0.0, min(1.0, (utc - rise).total_seconds() / max(1, (sset - rise).total_seconds())))
        st.moon = moon_phase(utc)
        st.clouds = (now['clouds'] or 0) / 100
        st.wind, st.wind_from = now['wind'] or 0, now['wind_from'] or 0
        st.rain = now['precip'] or 0
        st.snow = 'snow' in now['symbol'] or 'sleet' in now['symbol'] or (now['temp'] is not None and now['temp'] < 0.5 and st.rain > 0)
        st.fog = (now['fog'] or 0) / 100 if now['fog'] else (0.6 if now['symbol'].startswith('fog') else 0)
        st.thunder = 'thunder' in now['symbol'] or (now['thunder_p'] or 0) >= 30
        demo = os.environ.get('PARCHA_SKY_DEMO')  # tests: clear | rain | storm | snow | night | fog | dusk
        if demo:
            presets = {
                'clear': dict(sun=45, day_fraction=0.45, clouds=0.1, rain=0, snow=False, fog=0, thunder=False),
                'rain': dict(sun=30, day_fraction=0.4, clouds=0.9, rain=2.5, snow=False, fog=0, thunder=False, wind=6, wind_from=250),
                'storm': dict(sun=20, day_fraction=0.6, clouds=1.0, rain=6, snow=False, fog=0, thunder=True, wind=12, wind_from=230),
                'snow': dict(sun=12, day_fraction=0.5, clouds=0.85, rain=1.2, snow=True, fog=0.15, thunder=False, wind=3),
                'night': dict(sun=-25, day_fraction=1, clouds=0.15, rain=0, snow=False, fog=0, thunder=False, moon=0.48),
                'fog': dict(sun=10, day_fraction=0.2, clouds=0.6, rain=0, snow=False, fog=0.8, thunder=False),
                'dusk': dict(sun=1.5, day_fraction=0.97, clouds=0.35, rain=0, snow=False, fog=0, thunder=False),
            }
            for k, v in presets.get(demo, {}).items():
                setattr(st, k, v)
        self.sky.queue_draw()

    # -- content --------------------------------------------------------------------------------

    def _clear(self):
        while (child := self.content.get_first_child()):
            self.content.remove(child)
        self.cards = []

    def _placeholder(self, text):
        self._clear()
        lbl = Gtk.Label(label=text, wrap=True, justify=Gtk.Justification.CENTER, margin_top=160)
        lbl.add_css_class('sky-cond')
        self.content.append(lbl)

    def _card(self, title=None):
        card = Card(title)
        self.cards.append(card)
        return card

    def _render(self):
        fc = self.forecast
        now = fc.now() if fc else None
        if not now:
            return
        self._update_sky(fc)
        self._clear()
        imp = self.imperial
        night = self.sky.state.sun < -2
        place = self.places[self.index]['name'] if self.places else ''
        icon, cond, _thunder = symbol_info(now['symbol'], night)
        days = fc.days(10)
        today = days[0] if days else None

        # Now
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0, margin_top=8)
        for text, css in ((place, 'sky-place'), (fmt_temp(now['temp'], imp), 'sky-temp'), (cond, 'sky-cond')):
            lbl = Gtk.Label(label=text)
            lbl.add_css_class(css)
            top.append(lbl)
        if today:
            hl = Gtk.Label(label=_('H:%s  L:%s') % (fmt_temp(today['hi'], imp), fmt_temp(today['lo'], imp)))
            hl.add_css_class('sky-cond')
            hl.add_css_class('sky-dim')
            top.append(hl)
        line = Gtk.Label(label=summary_line(fc, self.prefs.get('playful', True), fmt_temp(now['temp'], imp)),
                         wrap=True, justify=Gtk.Justification.CENTER, margin_top=10)
        line.add_css_class('sky-line')
        top.append(line)
        self.content.append(top)

        # Alerts
        for a in self.alerts[:3]:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.add_css_class('sky-alert')
            t = Gtk.Label(label='⚠ ' + a['event'], xalign=0, wrap=True)
            t.add_css_class('sky-cond')
            box.append(t)
            d = Gtk.Label(label=a['headline'], xalign=0, wrap=True)
            d.add_css_class('sky-small')
            box.append(d)
            self.content.append(box)

        # Hourly
        hours = fc.next_hours(24)
        if hours:
            card = self._card(_('Next 24 hours'))
            row = Gtk.Box(spacing=18)
            for i, h in enumerate(hours):
                local = h['time'].astimezone()
                hn = sun_elevation(fc.lat, fc.lon, h['time']) < -2
                ic, _c, _t = symbol_info(h['symbol'], hn)
                col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                tl = Gtk.Label(label=_('Now') if i == 0 else fmt_hour(local))
                tl.add_css_class('sky-small')
                col.append(tl)
                col.append(Gtk.Image(icon_name=ic, pixel_size=24))
                if (h['pop'] or 0) >= 20:
                    pl = Gtk.Label(label=f"{round(h['pop'])}%")
                    pl.add_css_class('sky-small')
                    pl.add_css_class('sky-dim')
                    col.append(pl)
                else:
                    col.append(Gtk.Label(label=' '))
                tt = Gtk.Label(label=fmt_temp(h['temp'], imp))
                tt.add_css_class('sky-hour-temp')
                col.append(tt)
                row.append(col)
            sc = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, child=row)
            sc.set_size_request(-1, 112)
            card.append(sc)
            self.content.append(card)

        # Ten days
        if days:
            card = self._card(_('%d days') % len(days))
            lo_all = min(d['lo'] for d in days)
            hi_all = max(d['hi'] for d in days)
            grid = Gtk.Grid(column_spacing=14, row_spacing=10)
            for r, d in enumerate(days):
                name = _('Today') if d['date'] == datetime.now().date() else d['date'].strftime('%a')
                dl = Gtk.Label(label=name, xalign=0, width_chars=6)
                dl.add_css_class('sky-day')
                grid.attach(dl, 0, r, 1, 1)
                ic, _c, _t = symbol_info(d['symbol'])
                grid.attach(Gtk.Image(icon_name=ic, pixel_size=22), 1, r, 1, 1)
                pl = Gtk.Label(label=f"{round(d['pop'])}%" if d['pop'] >= 20 else '', width_chars=4)
                pl.add_css_class('sky-small')
                pl.add_css_class('sky-dim')
                grid.attach(pl, 2, r, 1, 1)
                lo = Gtk.Label(label=fmt_temp(d['lo'], imp), width_chars=4, xalign=1)
                lo.add_css_class('sky-day')
                lo.add_css_class('sky-dim')
                grid.attach(lo, 3, r, 1, 1)
                grid.attach(TempBar(d['lo'], d['hi'], lo_all, hi_all), 4, r, 1, 1)
                hi = Gtk.Label(label=fmt_temp(d['hi'], imp), width_chars=4, xalign=0)
                hi.add_css_class('sky-day')
                grid.attach(hi, 5, r, 1, 1)
            card.append(grid)
            self.content.append(card)

        # Detail cards
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=14, row_spacing=14,
                           homogeneous=True, max_children_per_line=3, min_children_per_line=2)
        for title, big, small in self._details(fc, now, imp):
            card = self._card(title)
            b = Gtk.Label(label=big, xalign=0)
            b.add_css_class('sky-big')
            card.append(b)
            s = Gtk.Label(label=small, xalign=0, wrap=True)
            s.add_css_class('sky-small')
            s.add_css_class('sky-dim')
            card.append(s)
            card.set_size_request(-1, 118)
            flow.append(card)
        self.content.append(flow)

        attrib = Gtk.Label(label=_('Weather data: MET Norway (CC BY 4.0). Alerts: US National Weather Service.'),
                           wrap=True, margin_top=6)
        attrib.add_css_class('sky-attrib')
        self.content.append(attrib)

    def _details(self, fc, now, imp):
        out = []
        gust = f" · {_('gusts')} {fmt_wind(now['gust'], imp)}" if now.get('gust') else ''
        out.append((_('Wind'), fmt_wind(now['wind'], imp), _('From the %s') % compass(now['wind_from']) + gust))
        if now.get('uv') is not None:
            uv = now['uv']
            level = _('Low') if uv < 3 else _('Moderate') if uv < 6 else _('High') if uv < 8 else _('Very high')
            out.append((_('UV index'), f'{round(uv)}', level + (_(' · sunscreen') if uv >= 6 else '')))
        if now.get('humidity') is not None:
            dew = f"{_('Dew point')} {fmt_temp(now['dew'], imp)}" if now.get('dew') is not None else ''
            out.append((_('Humidity'), f"{round(now['humidity'])}%", dew))
        times = sun_times(fc.lat, fc.lon, datetime.now(timezone.utc))
        if times:
            rise, sset = (t.astimezone() for t in times)
            length = sset - rise
            out.append((_('Sun'), f"↑ {fmt_hour(rise)}", f"↓ {fmt_hour(sset)} · "
                        + _('%dh %dm of daylight') % (length.seconds // 3600, length.seconds % 3600 // 60)))
        if now.get('pressure') is not None:
            later = [h for h in fc.hours if h['time'] > now['time'] + timedelta(hours=2)]
            trend = ''
            if later and later[0]['pressure'] is not None:
                diff = later[0]['pressure'] - now['pressure']
                trend = _('Rising') if diff > 0.8 else _('Falling') if diff < -0.8 else _('Steady')
            out.append((_('Pressure'), f"{round(now['pressure'])} hPa", trend))
        phase = moon_phase(datetime.now(timezone.utc))
        names = [_('New moon'), _('Waxing crescent'), _('First quarter'), _('Waxing gibbous'),
                 _('Full moon'), _('Waning gibbous'), _('Last quarter'), _('Waning crescent')]
        out.append((_('Moon'), names[int(phase * 8 + 0.5) % 8], _('%d%% lit') % round((1 - math.cos(2 * math.pi * phase)) / 2 * 100)))
        return out

    # -- menu -----------------------------------------------------------------------------------

    def _main_menu(self):
        menu = Gio.Menu()
        menu.append(_('Playful summaries'), 'win.playful')
        menu.append(_('Fahrenheit and mph'), 'win.imperial')
        menu.append(_('About Parcha Sky'), 'win.about')
        playful = Gio.SimpleAction.new_stateful('playful', None, GLib.Variant('b', self.prefs.get('playful', True)))
        playful.connect('change-state', self._toggle('playful'))
        imperial = Gio.SimpleAction.new_stateful('imperial', None, GLib.Variant('b', self.imperial))
        imperial.connect('change-state', self._toggle('imperial'))
        about = Gio.SimpleAction.new('about', None)
        about.connect('activate', self._about)
        for a in (playful, imperial, about):
            self.add_action(a)
        return Gtk.MenuButton(icon_name='open-menu-symbolic', menu_model=menu, tooltip_text=_('Menu'))

    def _toggle(self, key):
        def handler(action, value):
            action.set_state(value)
            self.prefs[key] = value.get_boolean()
            if key == 'imperial':
                self.imperial = value.get_boolean()
            save_json(PREFS_FILE, self.prefs)
            if self.forecast:
                self._render()
        return handler

    def _about(self, *_a):
        about = Adw.AboutDialog(application_name=_('Parcha Sky'), application_icon=APP_ID, version=VERSION,
                                developer_name='Spanglish Enterprises LLC', license_type=Gtk.License.GPL_3_0,
                                website='https://www.parchaos.org',
                                comments=_('The sky outside, right now.'))
        about.add_credit_section(_('Weather data'), ['MET Norway https://api.met.no', 'US National Weather Service https://www.weather.gov'])
        about.present(self)


class SkyApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        GLib.set_application_name(_('Parcha Sky'))

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = self.props.active_window or SkyWindow(self)
        win.present()


if __name__ == '__main__':
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    sys.exit(SkyApp().run(sys.argv))
