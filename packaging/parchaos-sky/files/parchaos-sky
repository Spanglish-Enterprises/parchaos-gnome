def mood_for(hour, sun, feels=None, setting=False):
    """Which pose fits this hour. setting: the sun is on its way down."""
    sym = hour.get('symbol') or ''
    if 'thunder' in sym or (hour.get('thunder_p') or 0) >= 30:
        return 'storm'
    if 'snow' in sym or 'sleet' in sym:
        return 'snow'
    if (hour.get('precip') or 0) >= 0.1 or 'rain' in sym:
        return 'rain'
    if 'fog' in sym:
        return 'fog'
    if (hour.get('gust') or hour.get('wind') or 0) >= 11:
        return 'windy'
    if hour.get('temp') is not None and hour['temp'] <= 5:
        return 'cold'
    if sun < -2:
        return 'night'
    if setting and sun < 8 and (hour.get('clouds') or 0) < 60:
        return 'sunset'
    if (hour.get('clouds') or 0) < 35:
        return 'sunny'
    if (hour.get('clouds') or 0) < 80:
        return 'cloudy'
    return 'neutral'


