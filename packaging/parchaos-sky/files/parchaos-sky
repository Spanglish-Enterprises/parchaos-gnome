def fmt_temp(c, imperial):
    if c is None:
        return '–'
    return f'{round(c * 9 / 5 + 32)}°' if imperial else f'{round(c)}°'


def fmt_wind(ms, imperial):
    return f'{round(ms * 2.23694)} mph' if imperial else f'{round(ms * 3.6)} km/h'


def compass(deg):
    names = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'] if not spanish() else \
        ['N', 'NE', 'E', 'SE', 'S', 'SO', 'O', 'NO']
    return names[int((deg % 360) / 45 + 0.5) % 8]


def fmt_hour(dt):
    return dt.strftime('%-I %p') if uses_imperial() else dt.strftime('%H:%M')


