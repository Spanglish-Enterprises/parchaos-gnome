            GLib.idle_add(lambda: (self._render(), False)[1])

    def _hourly_card(self, fc, imp):
        hours = self._hours()
        titles = {'temp': _('Next 48 hours'), 'rain': _('Rain (%s), next 48 hours') % ('in' if imp else 'mm'),
                  'wind': _('Wind, next 48 hours'),
                  'comfort': _('Comfort, next 48 hours')}
        card = self._card(titles[self.lens])
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        cols = Gtk.Box(spacing=0)
        self.hour_cols = []
        for i, h in enumerate(hours):
            local = h['time'].astimezone()
            hn = sun_elevation(fc.lat, fc.lon, h['time']) < -2
            ic, _c, _t = symbol_info(h['symbol'], hn)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, width_request=self.COL_W)
            col.add_css_class('sky-hour')
            if i == self.scrub:
                col.add_css_class('selected')
            col.append(self._label(_('Now') if i == 0 else fmt_hour(local), 'sky-small'))
            col.append(Gtk.Image(icon_name=ic, pixel_size=22))
            if self.lens == 'temp':
                col.append(self._label(fmt_temp(h['temp'], imp), 'sky-hour-temp'))
            elif self.lens == 'rain':
                inches = h['precip'] / 25.4
                if h['precip'] < 0.1:
                    amount = '–'
                elif imp and inches < 0.01:
                    amount = '·'  # a trace
                else:
                    amount = f'{inches:.2f}'.lstrip('0') if imp else f"{h['precip']:.1f}"
                col.append(self._label(amount, 'sky-hour-temp'))
            elif self.lens == 'wind':
                col.append(self._label(f"{arrow(h['wind_from'] or 0)} {round((h['wind'] or 0) * (2.23694 if imp else 3.6))}", 'sky-hour-temp'))
            else:
                col.append(self._label(fmt_temp(feels_like(h), imp), 'sky-hour-temp'))
            click = Gtk.GestureClick()
            click.connect('released', lambda *_a, i=i: self._select(i))
            col.add_controller(click)
            cols.append(col)
            self.hour_cols.append(col)
        inner.append(cols)
        self.chart = HourChart(self, hours, self.lens, self.COL_W)
        inner.append(self.chart)
        sc = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, child=inner,
                                propagate_natural_height=True)   # as tall as the strip, no empty band
        self.hour_scroll = sc
        # scroll to the chosen hour once the strip knows its size
        # (after GTK has finished sizing it; a value set while it sizes is reset to 0)
        sc.get_hadjustment().connect('changed', lambda *_: GLib.idle_add(lambda: (self._scroll_to_hour(), False)[1]))
        card.append(sc)

        # The time scrubber: drag through the next two days and the sky follows.
        scrub = Gtk.Box(spacing=10)
        play = Gtk.Button(icon_name='media-playback-start-symbolic',
                          tooltip_text=_('Play the next 24 hours'))
        play.add_css_class('sky-play')
        play.connect('clicked', self._toggle_play)
        scrub.append(play)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, max(1, len(hours) - 1), 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.add_css_class('sky-scrub')
        self.scale.set_value(self.scrub)
        self.scale.connect('value-changed', lambda s: self._select(int(round(s.get_value())), from_scale=True))
        scrub.append(self.scale)
        card.append(scrub)
        if self.lens == 'comfort':
            card.append(self._label(_('White: dew point · gold: feels like'),
                                    'sky-small', 'sky-dim', xalign=0))
        elif self.lens == 'wind':
            card.append(self._label(_('White: wind · blue: gusts. Arrows show where it blows.'),
                                    'sky-small', 'sky-dim', xalign=0))
        return card

    def _days_card(self, fc, imp):
        days = fc.days(10)
        card = self._card(_('%d days') % len(days))
        if not days:
            return card
        grid = Gtk.Grid(column_spacing=14, row_spacing=10)
        hours = fc.hours
        for d in days:
            dh = [h for h in hours if h['time'].astimezone().date() == d['date']]
            d['wind_max'] = max([h['wind'] or 0 for h in dh] or [0])
            d['gust_max'] = max([h['gust'] or h['wind'] or 0 for h in dh] or [0])
            d['dew_max'] = max([h['dew'] for h in dh if h['dew'] is not None] or [0])
            d['uv_max'] = max([h['uv'] for h in dh if h['uv'] is not None] or [0])
        if self.lens == 'rain':
            lo_all, hi_all = 0, max(5.0, max(d['precip'] for d in days))
        elif self.lens == 'wind':
            lo_all, hi_all = 0, max(10.0, max(d['gust_max'] for d in days))
        elif self.lens == 'comfort':
            lo_all, hi_all = min(min(d['dew_max'] for d in days), 5), max(max(d['dew_max'] for d in days), 24)
        else:
            lo_all, hi_all = min(d['lo'] for d in days), max(d['hi'] for d in days)
        for r, d in enumerate(days):
            name = _('Today') if d['date'] == datetime.now().date() else day_name(d['date'], short=True).capitalize()
            grid.attach(self._label(name, 'sky-day', xalign=0, width_chars=6), 0, r, 1, 1)
            ic, _c, _t = symbol_info(d['symbol'])
            grid.attach(Gtk.Image(icon_name=ic, pixel_size=22), 1, r, 1, 1)
            if self.lens == 'rain':
                a, b = self._label(f"{round(d['pop'])}%" if d['pop'] else '', 'sky-day', 'sky-dim', width_chars=4, xalign=1), \
                    self._label(fmt_rain(d['precip'], imp), 'sky-day', width_chars=7, xalign=0)
                bar = RangeBar(0, d['precip'], lo_all, hi_all, 'rain')
            elif self.lens == 'wind':
                a = self._label(fmt_wind(d['wind_max'], imp), 'sky-day', 'sky-dim', width_chars=7, xalign=1)
                b = self._label(_('gusts ') + fmt_wind(d['gust_max'], imp), 'sky-day', width_chars=12, xalign=0)
                bar = RangeBar(0, d['gust_max'], lo_all, hi_all, 'wind')
            elif self.lens == 'comfort':
                a = self._label(comfort_words(d['dew_max']), 'sky-small', 'sky-dim', width_chars=13, xalign=1)
                b = self._label(_('UV ') + str(round(d['uv_max'])), 'sky-day', width_chars=5, xalign=0)
                bar = RangeBar(lo_all, d['dew_max'], lo_all, hi_all, 'comfort')
            else:
                a = self._label(fmt_temp(d['lo'], imp), 'sky-day', 'sky-dim', width_chars=4, xalign=1)
                b = self._label(fmt_temp(d['hi'], imp), 'sky-day', width_chars=4, xalign=0)
                bar = RangeBar(d['lo'], d['hi'], lo_all, hi_all, 'temp')
            grid.attach(a, 2, r, 1, 1)
            grid.attach(bar, 3, r, 1, 1)
            grid.attach(b, 4, r, 1, 1)
        card.append(grid)
        return card

    def _next_hour_card(self, nh):
        kind, mins, words = nh
        card = self._card(_('Next hour'))
        row = Gtk.Box(spacing=10)
        row.append(Gtk.Image(icon_name='weather-showers-symbolic' if kind != 'dry' else 'weather-clear-symbolic', pixel_size=22))
        row.append(self._label(words, 'sky-mid', xalign=0, hexpand=True))
        card.append(row)
        bars = Gtk.DrawingArea(content_height=34, hexpand=True)
        steps = self.next_hour

        def draw(area, cr, w, h):
            n = len(steps)
            for i, (_t, fut, d) in enumerate(steps):
                mm = dbz_to_mm(d) if d >= 13 else 0
                # square-root scale: drizzle still shows, a downpour fills the bar
                bh = (min(1.0, math.sqrt(mm / 10)) * (h - 8) + 4) if mm > 0 else 0
                x = i * w / n + 3
                cr.set_source_rgba(0.55, 0.78, 1.0, 0.9 if mm > 0 else 0.25)
                cr.rectangle(x, h - bh - 2, w / n - 6, max(2, bh))
                cr.fill()
        bars.set_draw_func(draw)
        card.append(bars)
        card.append(self._label(_('From radar, at this spot · now to +60 min'),
                                'sky-small', 'sky-dim', xalign=0))
        return card

    def _radar_card(self, fc):
        card = self._card(_('Radar'))
        p = self.places[self.index]
        self.radar_map = RadarMap(self, self.radar, p['lat'], p['lon'], self.radar_z)
        card.append(self.radar_map)
        bar = Gtk.Box(spacing=8)
        play = Gtk.Button(icon_name='media-playback-start-symbolic', tooltip_text=_('Play'))
        play.add_css_class('sky-play')
        when = self._label('', 'sky-small', xalign=0, hexpand=True)

        def show_label():
            frames = self.radar.frames
            if not frames:
                return
            t, _p, fut = frames[min(self.radar_map.index, len(frames) - 1)]
            stamp = fmt_hour(datetime.fromtimestamp(t))
            when.set_label((_('Forecast · ') if fut else '') + stamp)
        show_label()

        def step():
            n = len(self.radar.frames)
            if not n or not self.radar_map:
                self.radar_play = 0
                return GLib.SOURCE_REMOVE
            self.radar_map.index = (self.radar_map.index + 1) % n
            show_label()
            self.radar_map.queue_draw()
            return GLib.SOURCE_CONTINUE

        def toggle(btn):
            if self.radar_play:
                GLib.source_remove(self.radar_play)
                self.radar_play = 0
                btn.set_icon_name('media-playback-start-symbolic')
            else:
                self.radar_play = GLib.timeout_add(450, step)
                btn.set_icon_name('media-playback-pause-symbolic')
        play.connect('clicked', toggle)
        bar.append(play)
        bar.append(when)
        for icon, dz in (('zoom-out-symbolic', -1), ('zoom-in-symbolic', 1)):
            b = Gtk.Button(icon_name=icon)
            b.add_css_class('sky-play')

            def zoom(_b, dz=dz):
                self.radar_z = max(3, min(9, self.radar_z + dz))
                self.prefs['radar_z'] = self.radar_z
                save_json(PREFS_FILE, self.prefs)
                self.radar_map.set_zoom(self.radar_z)
            b.connect('clicked', zoom)
            bar.append(b)
        card.append(bar)
        if self.radar_play:
            GLib.source_remove(self.radar_play)
            self.radar_play = 0
        if os.environ.get('PARCHA_SKY_RADAR_FRAME'):  # tests
            self.radar_map.index = int(os.environ['PARCHA_SKY_RADAR_FRAME'])
            show_label()
        return card

    def _best_card(self, fc, imp):
