    elif pose not in ('rain', 'cloudy'):
        _limb(cr, cx - r * 0.95, cy + 8, cx - r * 1.22, cy + 20, 9)
        _limb(cr, cx + r * 0.95, cy + 8, cx + r * 1.22, cy + 20, 9)

    _fruit(cr, cx, cy, r)
    _face(cr, cx, cy, r, expr, glasses=pose in ('sunny', 'hot'))
    if cloud_front:
