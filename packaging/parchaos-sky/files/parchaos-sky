# Radar and the next hour: LibreWXR (radar composites from NOAA MRMS and other public sources,
# CC BY 4.0 data, free for commercial use with attribution) over a Natural Earth map (public
# domain) drawn here. The next-hour line reads the radar's own 60-minute nowcast at this spot.
# ---------------------------------------------------------------------------------------------

RADAR_HOST = os.environ.get('PARCHA_SKY_RADAR', 'https://api.librewxr.net')
RADAR_COLOURS = 2      # "Universal Blue": a neutral scheme, not one named after another weather brand
MAP_PATHS = [os.path.join(os.path.dirname(os.path.abspath(__file__)), 'parchaos-sky-map.json.gz'),
             '/usr/share/parchaos-sky/parchaos-sky-map.json.gz']
_MAP = None


def base_map():
    global _MAP
    if _MAP is None:
        import gzip
        for path in MAP_PATHS:
            try:
                with gzip.open(path) as f:
                    _MAP = json.load(f)
                break
            except OSError:
                continue
        else:
            _MAP = {}
        # bounding box per line, so the map only walks what is on screen
        for key in ('land', 'lakes', 'borders', 'states'):
            boxes = []
            for flat in _MAP.get(key, []):
                xs, ys = flat[0::2], flat[1::2]
                boxes.append((min(xs), min(ys), max(xs), max(ys)))
            _MAP[key + '_box'] = boxes
    return _MAP


def merc(lat, lon, world):
    x = (lon + 180) / 360 * world
    s = math.sin(math.radians(max(-85.05, min(85.05, lat))))
    y = (0.5 - math.log((1 + s) / (1 - s)) / (4 * math.pi)) * world
    return x, y


def dbz_to_mm(dbz):
    if dbz < 13:
        return 0.0
    return (10 ** (dbz / 10) / 200) ** (1 / 1.6)  # Marshall-Palmer


class RadarService(GObject.Object):
    """Frames list, radar images around a place, and the next-hour rain at the place."""

    __gsignals__ = {
        'frames': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'image': (GObject.SignalFlags.RUN_FIRST, None, (int,)),
        'next-hour': (GObject.SignalFlags.RUN_FIRST, None, (object,)),
    }

    def __init__(self, session):
        super().__init__()
        self.session = session
        self.frames = []        # [(unix time, path, is_forecast)]
        self.host = RADAR_HOST
        self.images = {}        # (time, z, lat, lon) -> GdkPixbuf
        self.point = {}

    def _get(self, url, callback, ctx=None):
        msg = Soup.Message.new('GET', url)
        self.session.send_and_read_async(msg, GLib.PRIORITY_LOW, None, callback, ctx)

    def refresh(self):
        self._get(f'{self.host}/public/weather-maps.json', self._on_maps)

    def _on_maps(self, session, result, _ctx):
        try:
            data = json.loads(session.send_and_read_finish(result).get_data().decode())
        except (GLib.Error, ValueError):
            return
        radar = data.get('radar', {})
        past = [(f['time'], f['path'], False) for f in radar.get('past', [])][-7:]
        future = [(f['time'], f['path'], True) for f in radar.get('nowcast', [])]
        self.host = data.get('host', self.host)
        self.frames = past + future
        self.emit('frames')

    @staticmethod
    def _pixbuf(data):
        gi.require_version('GdkPixbuf', '2.0')
        from gi.repository import GdkPixbuf
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        return loader.get_pixbuf()

    def image(self, index, z, lat, lon):
        t, path, _f = self.frames[index]
        key = (t, z, round(lat, 3), round(lon, 3))
        if key in self.images:
            return self.images[key]
        self.images[key] = None
        url = f'{self.host}{path}/512/{z}/{lat:.4f}/{lon:.4f}/{RADAR_COLOURS}/1_1.png'
        self._get(url, self._on_image, (key, index))
        return None

    def _on_image(self, session, result, ctx):
        key, index = ctx
        try:
            self.images[key] = self._pixbuf(session.send_and_read_finish(result).get_data())
        except (GLib.Error, TypeError):
            return
        self.emit('image', index)

    def next_hour(self, lat, lon):
        """Rain intensity at the spot now and in each nowcast step (raw dBZ tiles)."""
        frames = [f for f in self.frames if not f[2]][-1:] + [f for f in self.frames if f[2]]
        if not frames:
            return
        self.point = {'lat': lat, 'lon': lon, 'want': len(frames), 'got': {}}
        for t, path, fut in frames:
            url = f'{self.host}{path}/256/9/{lat:.4f}/{lon:.4f}/255/0_0.png'
            self._get(url, self._on_point, (t, fut, lat, lon))

    def _on_point(self, session, result, ctx):
        t, fut, lat, lon = ctx
        if self.point.get('lat') != lat or self.point.get('lon') != lon:
            return
        dbz = -99.0
        try:
            pb = self._pixbuf(session.send_and_read_finish(result).get_data())
            px = pb.get_pixels()
            stride, n = pb.get_rowstride(), pb.get_n_channels()
            c = pb.get_width() // 2
            for yy in range(c - 2, c + 3):
                for xx in range(c - 2, c + 3):
                    o = yy * stride + xx * n
                    if n == 4 and px[o + 3] == 0:
                        continue
                    dbz = max(dbz, px[o] / 2 - 32)  # pixel = (dBZ + 32) * 2
        except (GLib.Error, TypeError, IndexError):
            pass
        self.point['got'][t] = (fut, dbz)
        if len(self.point['got']) == self.point['want']:
            steps = sorted((tt, f, d) for tt, (f, d) in self.point['got'].items())
            self.emit('next-hour', steps)


def next_hour_text(steps):
    """('starts'|'stops'|'dry'|'wet', minutes, words) from [(time, is_forecast, dBZ)].
    Below 13 dBZ nothing reaches the ground worth mentioning; 13-18 is drizzle (about 0.2-0.5 mm/h);
    18 and up is rain."""
    if not steps:
        return None
    now = time.time()
    wet = [(t, d >= 13) for t, _f, d in steps]
    peak = max(d for _t, _f, d in steps)
    drizzle = peak < 18
    first_wet = wet[0][1]
    for t, w in wet[1:]:
        if w != first_wet:
            mins = max(5, int(round((t - now) / 60 / 5)) * 5)
            if w and drizzle:
                return 'starts', mins, _('Drizzle starting in about {mins} min').format(mins=mins)
            if w:
                return 'starts', mins, _('Rain starting in about {mins} min').format(mins=mins)
            if drizzle:
                return 'stops', mins, _('Drizzle ending in about {mins} min').format(mins=mins)
            return 'stops', mins, _('Rain ending in about {mins} min').format(mins=mins)
    if first_wet:
        return 'wet', 0, (_('Drizzle for the next hour') if drizzle
                          else _('Rain for the next hour'))
    return 'dry', 0, _('No rain in the next hour')


class RadarMap(Gtk.DrawingArea):
    """Natural Earth map in the radar's own projection, with the radar frame on top."""

    def __init__(self, win, radar, lat, lon, z):
        super().__init__(content_height=320, hexpand=True)
        self.win, self.radar, self.lat, self.lon, self.z = win, radar, lat, lon, z
        self.index = max(0, len([f for f in radar.frames if not f[2]]) - 1)
        self.set_draw_func(self._draw)
        self._want_all()

    def _want_all(self):
        for i in range(len(self.radar.frames)):
            self.radar.image(i, self.z, self.lat, self.lon)

    def set_zoom(self, z):
        self.z = max(3, min(9, z))
        self._want_all()
        self.queue_draw()

    def _draw(self, area, cr, w, h):
        world = (2 ** self.z) * 512
        cx, cy = merc(self.lat, self.lon, world)
        k = w / 512  # the 512 px radar window fills the width
        ox, oy = w / 2, h / 2

        def to_xy(lon, lat):
            x, y = merc(lat, lon, world)
            dx = (x - cx + world / 2) % world - world / 2  # wrap across the date line
            return ox + dx * k, oy + (y - cy) * k

        # visible lon/lat box (generous)
        span_lon = 360 / (2 ** self.z) * (w / 512) / k * 1.2 / max(k, 0.01) * k
        lon0, lon1 = self.lon - span_lon, self.lon + span_lon
        lat0, lat1 = self.lat - span_lon, self.lat + span_lon
        m = base_map()
        r = 18
        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.clip()
        cr.set_source_rgba(0.06, 0.14, 0.26, 0.85)  # sea
        cr.paint()

        def polys(key, fill=None, stroke=None, width=1.0):
            for flat, (x0, y0, x1, y1) in zip(m.get(key, []), m.get(key + '_box', [])):
                if x1 < lon0 or x0 > lon1 or y1 < lat0 or y0 > lat1:
                    continue
                for i in range(0, len(flat), 2):
                    x, y = to_xy(flat[i], flat[i + 1])
                    (cr.move_to if i == 0 else cr.line_to)(x, y)
                if fill:
                    cr.close_path()
                    cr.set_source_rgba(*fill)
                    cr.fill()
                else:
                    cr.set_source_rgba(*stroke)
                    cr.set_line_width(width)
                    cr.stroke()
        polys('land', fill=(0.20, 0.24, 0.22, 0.95))
        polys('lakes', fill=(0.06, 0.14, 0.26, 0.9))
        polys('states', stroke=(1, 1, 1, 0.22), width=0.8)
        polys('borders', stroke=(1, 1, 1, 0.45), width=1.2)

        # radar frame
        frames = self.radar.frames
        if frames:
            t, _p, _f = frames[min(self.index, len(frames) - 1)]
            pb = self.radar.images.get((t, self.z, round(self.lat, 3), round(self.lon, 3)))
            if pb:
                cr.save()
                cr.translate(ox - 256 * k, oy - 256 * k)
                cr.scale(k, k)
                Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
                cr.paint_with_alpha(0.85)
                cr.restore()

        # cities, more of them closer in
        cr.select_font_face('Sans', 0, 1)
        cr.set_font_size(11)
        drawn = []
        for name, lon, lat, rank, pop in sorted(m.get('places', []), key=lambda p: (p[3], -p[4])):
            if rank > self.z - 1 or not (lon0 < lon < lon1 and lat0 < lat < lat1):
                continue
            x, y = to_xy(lon, lat)
            if not (8 < x < w - 8 and 8 < y < h - 8) or any(abs(x - a) < 70 and abs(y - b) < 18 for a, b in drawn):
                continue
            drawn.append((x, y))
            cr.set_source_rgba(1, 1, 1, 0.85)
            cr.arc(x, y, 2.2, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.move_to(x + 6, y + 4 + 1)
            cr.show_text(name)
            cr.set_source_rgba(1, 1, 1, 0.92)
            cr.move_to(x + 5, y + 4)
            cr.show_text(name)
            if len(drawn) > 18:
                break

        # the place
        cr.set_source_rgba(1, 1, 1, 1)
        cr.arc(ox, oy, 6, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgba(0.25, 0.55, 1, 1)
        cr.arc(ox, oy, 4, 0, 2 * math.pi)
        cr.fill()

