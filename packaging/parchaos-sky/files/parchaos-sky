def symbol_info(code, night=False):
    base = (code or 'cloudy').split('_')[0]
    thunder = base.endswith('andthunder')
    base = base.replace('andthunder', '')
    for suffix in ('showers',):
        pass
    icon, en, es = SYMBOLS.get(base, ('weather-overcast', base, base))
    if thunder:
        icon, en, es = 'weather-storm', en + ' and thunder', es + ' con tormenta'
    if night and icon in ('weather-clear', 'weather-few-clouds'):
        icon += '-night'
    return icon + '-symbolic', (es if spanish() else en), thunder


class Forecast:
    """Parsed MET Norway 'complete' forecast for one place."""

    def __init__(self, data, lat, lon):
        self.lat, self.lon = lat, lon
        self.updated = data.get('properties', {}).get('meta', {}).get('updated_at', '')
        self.hours = []
        for entry in data.get('properties', {}).get('timeseries', []):
            t = datetime.fromisoformat(entry['time'].replace('Z', '+00:00'))
            d = entry['data']['instant']['details']
            n1 = entry['data'].get('next_1_hours') or {}
            n6 = entry['data'].get('next_6_hours') or {}
            nxt = n1 or n6
            details = nxt.get('details', {})
            precip = details.get('precipitation_amount', 0.0)
            if not n1 and n6:
                precip = precip / 6
            self.hours.append({
                'time': t,
                'temp': d.get('air_temperature'),
                'wind': d.get('wind_speed', 0.0),
                'gust': d.get('wind_speed_of_gust'),
                'wind_from': d.get('wind_from_direction', 0.0),
                'clouds': d.get('cloud_area_fraction', 0.0),
                'fog': d.get('fog_area_fraction', 0.0),
                'humidity': d.get('relative_humidity'),
                'dew': d.get('dew_point_temperature'),
                'pressure': d.get('air_pressure_at_sea_level'),
                'uv': d.get('ultraviolet_index_clear_sky'),
                'symbol': nxt.get('summary', {}).get('symbol_code', ''),
                'precip': precip,
                'pop': details.get('probability_of_precipitation'),
                'thunder_p': details.get('probability_of_thunder'),
                'hourly': bool(n1),
            })

    def now(self):
        now = datetime.now(timezone.utc)
        past = [h for h in self.hours if h['time'] <= now]
        return past[-1] if past else (self.hours[0] if self.hours else None)

    def next_hours(self, count=24):
        now = datetime.now(timezone.utc) - timedelta(hours=1)
        return [h for h in self.hours if h['time'] >= now and h['hourly']][:count]

    def days(self, count=10):
        out = {}
        for h in self.hours:
            local = h['time'].astimezone()
            key = local.date()
            day = out.setdefault(key, {'date': key, 'lo': None, 'hi': None, 'precip': 0.0,
                                       'pop': 0, 'symbols': []})
            if h['temp'] is not None:
                day['lo'] = h['temp'] if day['lo'] is None else min(day['lo'], h['temp'])
                day['hi'] = h['temp'] if day['hi'] is None else max(day['hi'], h['temp'])
            day['precip'] += h['precip'] * (1 if h['hourly'] else 6)
            if h['pop'] is not None:
                day['pop'] = max(day['pop'], h['pop'])
            if h['symbol'] and 9 <= local.hour <= 18:
                day['symbols'].append(h['symbol'])
        days = sorted(out.values(), key=lambda d: d['date'])
        for d in days:
            d['n'] = sum(1 for h in self.hours if h['time'].astimezone().date() == d['date'])
        # Late in the evening, "today" is only an hour or two: start from tomorrow instead.
        if days and days[0]['n'] < 3:
            days = days[1:]
        for d in days:
            syms = d['symbols'] or ['cloudy']
            d['symbol'] = max(set(syms), key=syms.count)
        return [d for d in days if d['hi'] is not None][:count]

    def rain_soon(self):
        """('starts'|'stops'|None, local datetime) for rain in the next six hours."""
        hours = self.next_hours(7)
        if not hours:
            return None, None
        wet = [h['precip'] >= 0.1 for h in hours]
        if not wet[0]:
            for h, w in zip(hours[1:], wet[1:]):
                if w:
                    return 'starts', h['time'].astimezone()
        else:
            for h, w in zip(hours[1:], wet[1:]):
                if not w:
                    return 'stops', h['time'].astimezone()
        return None, None


class WeatherService(GObject.Object):
    """Fetches and caches forecasts and alerts; honours MET's Expires header."""

    __gsignals__ = {
        'forecast': (GObject.SignalFlags.RUN_FIRST, None, (object,)),
        'alerts': (GObject.SignalFlags.RUN_FIRST, None, (object,)),
        'failed': (GObject.SignalFlags.RUN_FIRST, None, (str,)),
    }

    def __init__(self):
        super().__init__()
        self.session = Soup.Session(user_agent=USER_AGENT, timeout=20)

    def _cache_path(self, lat, lon):
        return os.path.join(CACHE_DIR, f'met-{lat:.2f},{lon:.2f}.json')

    def fetch(self, lat, lon, force=False):
        lat, lon = round(lat, 2), round(lon, 2)
        cached = load_json(self._cache_path(lat, lon), None)
        if cached and cached.get('data'):
            self.emit('forecast', Forecast(cached['data'], lat, lon))
            if not force and time.time() < cached.get('expires', 0):
                self._fetch_alerts(lat, lon)
                return
        msg = Soup.Message.new('GET', MET_URL.format(lat=lat, lon=lon))
        if cached and cached.get('last_modified'):
            msg.get_request_headers().append('If-Modified-Since', cached['last_modified'])
        self.session.send_and_read_async(msg, GLib.PRIORITY_DEFAULT, None, self._on_met, (lat, lon, cached))
        self._fetch_alerts(lat, lon)

    def _on_met(self, session, result, ctx):
        lat, lon, cached = ctx
        try:
            body = session.send_and_read_finish(result)
        except GLib.Error as err:
            if not cached:
                self.emit('failed', err.message)
            return
        msg = session.get_async_result_message(result)
        status = msg.get_status()
        headers = msg.get_response_headers()
        expires = headers.get_one('Expires')
        try:
            exp = datetime.strptime(expires, '%a, %d %b %Y %H:%M:%S GMT').replace(tzinfo=timezone.utc).timestamp()
        except (TypeError, ValueError):
            exp = time.time() + REFRESH_SECONDS
        if status == 304 and cached:
            cached['expires'] = exp
            save_json(self._cache_path(lat, lon), cached)
            return
        if status != 200:
            if not cached:
                self.emit('failed', _('The weather service answered %d.') % status)
            return
        try:
            data = json.loads(body.get_data().decode())
        except ValueError:
            self.emit('failed', _('The weather service sent something unreadable.'))
            return
        save_json(self._cache_path(lat, lon), {'data': data, 'expires': exp,
                                                'last_modified': headers.get_one('Last-Modified')})
        self.emit('forecast', Forecast(data, lat, lon))

    def _fetch_alerts(self, lat, lon):
        # The US National Weather Service covers the US and its territories (Puerto Rico included).
        in_us = (24 <= lat <= 72 and -180 <= lon <= -64) or (17 <= lat <= 19 and -68 <= lon <= -64) or \
                (18 <= lat <= 23 and -161 <= lon <= -154) or (13 <= lat <= 21 and 144 <= lon <= 146)
        if not in_us:
            self.emit('alerts', [])
            return
        msg = Soup.Message.new('GET', NWS_ALERTS_URL.format(lat=lat, lon=lon))
        msg.get_request_headers().append('Accept', 'application/geo+json')
        self.session.send_and_read_async(msg, GLib.PRIORITY_DEFAULT, None, self._on_alerts, None)

    def _on_alerts(self, session, result, _ctx):
        try:
            body = session.send_and_read_finish(result)
            data = json.loads(body.get_data().decode())
        except (GLib.Error, ValueError):
            self.emit('alerts', [])
            return
        alerts = []
        for f in data.get('features', []):
            p = f.get('properties', {})
            alerts.append({'event': p.get('event', ''), 'headline': p.get('headline', ''),
                           'severity': p.get('severity', ''), 'description': p.get('description', ''),
                           'ends': p.get('ends') or p.get('expires')})
        self.emit('alerts', alerts)


