class ParchiArt:
    """Loads each pose once and keeps a raster of it at the size on screen."""
    _handles = {}
    _cache = {}

    @classmethod
    def handle(cls, pose):
        if pose not in cls._handles:
            cls._handles[pose] = None
            try:
                gi.require_version('Rsvg', '2.0')
                from gi.repository import Rsvg
                for d in PARCHI_DIRS:
                    path = os.path.join(d, f'parchi-{pose}.svgz')
                    if os.path.exists(path):
                        cls._handles[pose] = Rsvg.Handle.new_from_file(path)
                        break
            except (ValueError, ImportError, GLib.Error):
                pass
        return cls._handles[pose]

    @classmethod
    def surface(cls, pose, w, h, scale):
        """The pose laid out in a w x h panel, the factor and offset used, and the face colour."""
        key = (pose, w, h, scale)
        if key not in cls._cache:
            handle = cls.handle(pose)
            if handle is None:
                return None
            from gi.repository import Rsvg
            (aw, ah), eyes = PARCHI_ART[pose]
            sky = None
            if pose in PARCHI_SCENE:
                # the circle a little wider than the panel; its edge fades out and the corners
                # take the scene's own sky, so the scene fills the panel with no circle showing
                cx, cy, r = PARCHI_SCENE[pose]
                fx, fy, span = PARCHI_FRAME.get(pose, (cx, cy, r / 0.58))
                k = min(w, h) / span
                ox, oy = w / 2 - fx * k, h / 2 - fy * k
                dcx, dcy = ox + cx * k, oy + cy * k     # the circle, in panel coordinates
            else:
                k = min((w - 14) / aw, (h - 10) / ah)
                ox, oy = (w - aw * k) / 2, h - ah * k - 4
            surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, int(w * scale), int(h * scale))
            surf.set_device_scale(scale, scale)
            cr = cairo.Context(surf)
            viewport = Rsvg.Rectangle()
            viewport.x, viewport.y, viewport.width, viewport.height = ox, oy, aw * k, ah * k
            if pose in PARCHI_SCENE and pose not in UNFADED:
                layer = cairo.ImageSurface(cairo.FORMAT_ARGB32, int(w * scale), int(h * scale))
                layer.set_device_scale(scale, scale)
                lc = cairo.Context(layer)
                handle.render_document(lc, viewport)
                layer.flush()
                sky = (cls._sample(layer, scale, dcx, max(4, dcy - r * k * 0.86)),
                       cls._sample(layer, scale, dcx, min(h - 4, dcy + r * k * 0.86)))
                fade = cairo.RadialGradient(dcx, dcy, r * k * 0.86, dcx, dcy, r * k * 0.99)
                fade.add_color_stop_rgba(0, 0, 0, 0, 1)
                fade.add_color_stop_rgba(1, 0, 0, 0, 0)
                cr.set_source_surface(layer, 0, 0)
                cr.mask(fade)
            else:
                handle.render_document(cr, viewport)
            surf.flush()
            pulp = cls._pulp(surf, scale, [(ox + x * k, oy + y * k, rx * k, ry * k) for x, y, rx, ry in eyes])
            if len(cls._cache) > 24:
                cls._cache.clear()
            cls._cache[key] = (surf, k, ox, oy, pulp, sky)
        return cls._cache[key]

    @staticmethod
    def _sample(surf, scale, x, y):
        """The average colour of a small patch, as (r, g, b) 0..1."""
        data, stride = surf.get_data(), surf.get_stride()
        sw, sh = surf.get_width(), surf.get_height()
        acc, n = [0, 0, 0], 0
        for dy in range(-3, 4):
            for dx in range(-6, 7):
                px, py = int(x * scale) + dx, int(y * scale) + dy
                if 0 <= px < sw and 0 <= py < sh:
                    b, g, r, a = data[py * stride + px * 4:py * stride + px * 4 + 4]
                    if a > 200:
                        acc[0] += r; acc[1] += g; acc[2] += b; n += 1
        if not n:
            return (0.6, 0.75, 0.9)
        return tuple(c / n / 255 for c in acc)

    @staticmethod
    def _pulp(surf, scale, eyes):
        """The face colour around the eyes, for the eyelids: the median of a ring of samples."""
        if not eyes:
            return None
        data, stride = surf.get_data(), surf.get_stride()
        sw, sh = surf.get_width(), surf.get_height()
        samples = []
        for cx, cy, rx, ry in eyes:
            for i in range(12):
                a = i / 12 * math.tau
                x, y = int((cx + math.cos(a) * rx * 1.35) * scale), int((cy + math.sin(a) * ry * 1.35) * scale)
                if 0 <= x < sw and 0 <= y < sh:
                    b, g, r, al = data[y * stride + x * 4:y * stride + x * 4 + 4]
                    if al > 200 and r + g + b > 330 and min(r, g, b) < 225:   # face, not a seed or the eye white
                        samples.append((r, g, b))
        if not samples:
            return (0.95, 0.72, 0.25)
        samples.sort(key=sum)
        r, g, b = samples[len(samples) // 2]
        return (r / 255, g / 255, b / 255)


def parchi_motion(pose, t):
    """Bob and sway per pose: (dx, dy, angle, pivot at the feet)."""
    if pose == 'windy':
        return (math.sin(t * 2.6) * 1.2, 0, -0.03 + math.sin(t * 3.1) * 0.035, True)
    if pose == 'storm':      # nodding along to the music
        return (0, -abs(math.sin(t * 4.2)) * 1.6, math.sin(t * 4.2) * 0.02, True)
    if pose == 'sunny':      # lounging
        return (0, math.sin(t * 1.1) * 1.0, math.sin(t * 0.9) * 0.012, True)
    if pose == 'cloudy':     # floating with the cloud
        return (math.sin(t * 0.7) * 1.5, math.sin(t * 1.4) * 2.5, 0, False)
    if pose == 'cold':       # shivering
        return (math.sin(t * 38) * 0.6 * (math.sin(t * 0.8) > 0.3), 0, 0, True)
    if pose == 'waving':     # a cheerful bounce
        return (0, -abs(math.sin(t * 2.4)) * 2.6, math.sin(t * 1.2) * 0.02, True)
    if pose in SCENE_POSES:  # round scenes stay level and just breathe
        return (0, math.sin(t * 1.0) * 1.2, 0, False)
    return (0, -abs(math.sin(t * 1.9)) * 2.2, math.sin(t * 0.95) * 0.015, True)


def parchi_lids(t, seed):
    """How shut the eyes are (0 open, 1 shut): a quick blink every few seconds."""
    period = 3.6 + (seed % 7) * 0.4
    phase = (t + seed) % period
    if phase < 0.16:
        return math.sin(phase / 0.16 * math.pi)
    if 0.5 < phase < 0.62 and seed % 3 == 0:   # now and then, a double blink
        return math.sin((phase - 0.5) / 0.12 * math.pi)
    return 0.0


def draw_lids(cr, eyes, shut, pulp):
    for cx, cy, rx, ry in eyes:
        top = cy - ry * 1.12
        edge = top + (ry * 1.12 + ry * 0.7) * shut      # fully shut, the lid rests just below centre
        cr.save()
        cr.translate(cx, cy)
        cr.scale(rx * 1.12, ry * 1.12)
        cr.arc(0, 0, 1, 0, math.tau)
        cr.restore()
        cr.save()
        cr.clip()
        cr.set_source_rgb(*pulp)
        cr.rectangle(cx - rx * 1.3, top - 2, rx * 2.6, edge - top + 2)
        if shut > 0.9:   # shut eyes cover the whole eye
            cr.rectangle(cx - rx * 1.3, top - 2, rx * 2.6, ry * 2.4)
        cr.fill()
        cr.restore()
        # lashes along the lid's edge, curving down as it closes
        half = math.sqrt(max(0.0, 1 - ((edge - cy) / (ry * 1.12)) ** 2)) * rx * 1.08
        sag = ry * 0.28 * shut
        cr.set_source_rgba(0.29, 0.13, 0.12, 0.95)
        cr.set_line_width(max(1.0, ry * 0.14))
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(cx - half, edge)
        cr.curve_to(cx - half * 0.4, edge + sag, cx + half * 0.4, edge + sag, cx + half, edge)
        cr.stroke()


class Parchita(Gtk.DrawingArea):
    """Parchi on screen: the pose follows the weather; Parchi bobs, sways and blinks."""

    def __init__(self, size=150, radius=22):
        super().__init__(content_width=size, content_height=size, valign=Gtk.Align.CENTER)
        self.radius = radius
        self.mood = 'happy'
        self.t0 = time.monotonic()
        self.seed = random.randrange(1000)
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._tick)

    def _tick(self, *_a):
        if Gtk.Settings.get_default().props.gtk_enable_animations:
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def set_mood(self, mood):
        self.mood = mood
        self.queue_draw()

    def _draw(self, area, cr, w, h):
        animate = Gtk.Settings.get_default().props.gtk_enable_animations
        t = time.monotonic() - self.t0 if animate else 0.0
        pose = POSE_ART.get(self.mood, 'front')
        r = self.radius
        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 1.5 * math.pi)
        cr.close_path()
        cr.clip()
        try:
            art = ParchiArt.surface(pose, w, h, self.get_scale_factor())
        except (GLib.Error, TypeError, cairo.Error):
            ParchiArt._handles[pose] = None
            art = None
        top, bottom = (art and art[5]) or PARCHI_SKY.get(pose, PARCHI_SKY['front'])
        sky = cairo.LinearGradient(0, 0, 0, h)
        sky.add_color_stop_rgb(0, *top)
        sky.add_color_stop_rgb(1, *bottom)
        cr.set_source(sky)
        cr.paint()
        if art is None:
            draw_parchi(cr, w, h, self.mood, t, animate)
            return
        surf, k, ox, oy, pulp, _sky = art
        dx, dy, angle, feet = parchi_motion(pose, t) if animate else (0, 0, 0, True)
        cr.save()
        px, py = w / 2, (h - 4 if feet else h / 2)
        cr.translate(px + dx, py + dy)
        cr.rotate(angle)
        cr.translate(-px, -py)
        cr.set_source_surface(surf, 0, 0)
        cr.paint()
        eyes = [(ox + x * k, oy + y * k, rx * k, ry * k) for x, y, rx, ry in PARCHI_ART[pose][1]]
        if eyes and pulp and animate:
            shut = parchi_lids(t, self.seed)
            if shut > 0.02:
                draw_lids(cr, eyes, shut, pulp)
        cr.restore()


