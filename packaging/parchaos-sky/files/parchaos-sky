class SkyState:
    FIELDS = ('sun', 'day_fraction', 'clouds', 'wind', 'wind_from', 'rain', 'fog', 'moon')

    def __init__(self):
        self.sun = 30.0          # degrees above the horizon
        self.day_fraction = 0.5  # 0 sunrise .. 1 sunset, for where the sun sits
        self.clouds = 0.2        # 0..1
        self.wind = 3.0          # m/s
        self.wind_from = 270.0   # degrees
        self.rain = 0.0          # mm/h
        self.snow = False
        self.fog = 0.0           # 0..1
        self.thunder = False
        self.moon = 0.5          # phase

    def copy(self):
        s = SkyState()
        s.__dict__.update(self.__dict__)
        return s


DAY_TOP, DAY_BOTTOM = (0.20, 0.47, 0.82), (0.58, 0.79, 0.95)
GOLD_TOP, GOLD_BOTTOM = (0.27, 0.36, 0.62), (0.98, 0.62, 0.38)
NIGHT_TOP, NIGHT_BOTTOM = (0.02, 0.04, 0.10), (0.08, 0.13, 0.26)
GREY_TOP, GREY_BOTTOM = (0.38, 0.43, 0.50), (0.62, 0.66, 0.71)


class SkyView(Gtk.Widget):
    """Draws the sky from a SkyState, moving gently, and the frosted glass under the cards.
    A new target state is eased into over about a second, so scrubbing through the forecast
    and the time-lapse play smoothly."""

    def __init__(self):
        super().__init__()
        self.state = SkyState()
        self.target = self.state.copy()
        self.cards = []        # (x, y, w, h, radius) in this widget's coordinates
        self.glass = True
        self.t0 = time.monotonic()
        self.last_frame = 0
        self.flash = 0.0
        self.next_flash = time.monotonic() + 3
        rnd = random.Random(7)
        self.cloud_seeds = [(rnd.random(), rnd.random() * 0.55, 0.6 + rnd.random() * 0.8, rnd.random())
                            for _ in range(14)]
        self.star_seeds = [(rnd.random(), rnd.random() * 0.75, rnd.random()) for _ in range(110)]
        self.drop_seeds = [(rnd.random(), rnd.random(), 0.6 + rnd.random() * 0.8) for _ in range(420)]
        self.add_tick_callback(self._tick)

    def animating(self):
        return Gtk.Settings.get_default().props.gtk_enable_animations and \
            os.environ.get('PARCHA_SKY_STILL') != '1'

    def set_target(self, state, instant=False):
        self.target = state
        if instant or not self.animating():
            self.state = state.copy()
        self.state.snow, self.state.thunder = state.snow, state.thunder
        self.queue_draw()

    def _ease(self):
        k = 0.12
        for f in SkyState.FIELDS:
            a, b = getattr(self.state, f), getattr(self.target, f)
            if f == 'wind_from':
                d = (b - a + 540) % 360 - 180
                setattr(self.state, f, (a + d * k) % 360)
            else:
                setattr(self.state, f, a + (b - a) * k)

    def _tick(self, widget, clock):
        now = time.monotonic()
        # 30 frames a second is plenty for drifting clouds and rain.
        if self.animating() and now - self.last_frame >= 1 / 30:
            self.last_frame = now
            self._ease()
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def set_cards(self, cards):
        if cards != self.cards:
            self.cards = cards
            self.queue_draw()

    # -- drawing --------------------------------------------------------------------------------

    def _colors(self):
        s = self.state
        if s.sun >= 8:
            top, bottom = DAY_TOP, DAY_BOTTOM
        elif s.sun >= -2:
            t = (s.sun + 2) / 10
            top, bottom = mix(GOLD_TOP, DAY_TOP, t), mix(GOLD_BOTTOM, DAY_BOTTOM, t)
        elif s.sun >= -10:
            t = (s.sun + 10) / 8
            top, bottom = mix(NIGHT_TOP, GOLD_TOP, t), mix(NIGHT_BOTTOM, GOLD_BOTTOM, t)
        else:
            top, bottom = NIGHT_TOP, NIGHT_BOTTOM
        # Overcast and rain grey the sky out (less at night, where it is dark anyway).
        grey = max(0.0, s.clouds - 0.45) / 0.55 * 0.85 + min(s.rain, 4) / 4 * 0.25
        night = 1 - max(0.0, min(1.0, (s.sun + 6) / 12))
        g_top, g_bottom = mix(GREY_TOP, NIGHT_TOP, night * 0.85), mix(GREY_BOTTOM, NIGHT_BOTTOM, night * 0.8)
        return mix(top, g_top, grey), mix(bottom, g_bottom, grey)

    def _sky_node(self, w, h, t):
        snap = Gtk.Snapshot()
        s = self.state
        top, bottom = self._colors()
        snap.append_linear_gradient(rect(0, 0, w, h), point(0, 0), point(0, h),
                                    stops((0, top + (1,)), (1, bottom + (1,))))
        night = 1 - max(0.0, min(1.0, (s.sun + 4) / 10))
        clear = 1 - s.clouds

        # Stars and the moon at night; the moon shows its real phase.
        if night > 0.05 and clear > 0.1:
            for sx, sy, ph in self.star_seeds:
                tw = 0.55 + 0.45 * math.sin(t * (0.6 + ph) + ph * 10)
                a = night * clear * tw * 0.9
                snap.append_color(rgba(1, 1, 1, a), rect(sx * w, sy * h, 1.6, 1.6))
            mx, my, mr = w * 0.80, h * 0.14, 24
            snap.append_radial_gradient(rect(mx - mr * 4, my - mr * 4, mr * 8, mr * 8), point(mx, my), mr * 4, mr * 4,
                                        0, 1, stops((0, (0.85, 0.9, 1, 0.20 * night * clear)), (1, (0.85, 0.9, 1, 0))))
            disc = Gsk.RoundedRect()
            disc.init_from_rect(rect(mx - mr, my - mr, mr * 2, mr * 2), mr)
            snap.push_rounded_clip(disc)
            snap.append_color(rgba(0.95, 0.94, 0.88, night), rect(mx - mr, my - mr, mr * 2, mr * 2))
            # the dark part: a disc offset by the phase (0 new .. 0.5 full .. 1 new)
            p = s.moon
            off = (1 - abs(1 - 2 * p)) * 2 * mr  # 0 at new, 2r at full
            sign = -1 if p < 0.5 else 1
            shade_x = mx + sign * off
            top_c, _b = self._colors()
            snap.append_radial_gradient(rect(shade_x - mr * 1.05, my - mr * 1.05, mr * 2.1, mr * 2.1),
                                        point(shade_x, my), mr * 1.05, mr * 1.05, 0, 1,
                                        stops((0, top_c + (0.92 * night,)), (0.93, top_c + (0.92 * night,)), (1, top_c + (0,))))
            snap.pop()

        # The sun travels along the upper right (clear of the temperature in the middle): lower and
        # to the right early and late, highest at noon, from its real elevation and the time of day.
        if s.sun > -4:
            sx = w * (0.64 + 0.26 * s.day_fraction)
            sy = h * (0.30 - 0.22 * max(0.0, min(1.0, s.sun / 60)))
            vis = max(0.0, min(1.0, (s.sun + 4) / 6)) * (1 - 0.85 * max(0.0, s.clouds - 0.3) / 0.7)
            r = 34
            warm = 1 - max(0.0, min(1.0, s.sun / 15))
            core = mix((1.0, 0.98, 0.88), (1.0, 0.72, 0.42), warm)
            snap.append_radial_gradient(rect(sx - r * 7, sy - r * 7, r * 14, r * 14), point(sx, sy), r * 7, r * 7, 0, 1,
                                        stops((0, core + (0.45 * vis,)), (0.35, core + (0.12 * vis,)), (1, core + (0,))))
            snap.append_radial_gradient(rect(sx - r, sy - r, r * 2, r * 2), point(sx, sy), r, r, 0, 1,
                                        stops((0, (1, 1, 0.97, vis)), (0.8, core + (vis,)), (1, core + (0,))))

        # Clouds: soft clusters drifting with the real wind (east-west component).
        n = int(round(2 + s.clouds * 12))
        drift = -math.sin(math.radians(s.wind_from)) * (6 + s.wind * 5)  # px/s, wind *from* -> moves away
        shade = mix((1, 1, 1), (0.55, 0.58, 0.64), max(0.0, s.clouds - 0.5) * 2 + min(s.rain, 3) / 6)
        shade = mix(shade, (0.32, 0.36, 0.46), night * 0.85)
        for i, (cx, cy, size, ph) in enumerate(self.cloud_seeds[:n]):
            span = w + 600
            x = ((cx * span + drift * t * (0.6 + size * 0.5)) % span) - 300
            y = cy * h * 0.75 + 20
            base = 110 * size * (0.8 + s.clouds * 0.7)
            fade = min(1.0, max(0.0, 2 + s.clouds * 12 - i))  # clouds appear and go softly
            alpha = (0.35 + 0.5 * s.clouds) * (0.85 + 0.15 * math.sin(t * 0.1 + ph * 6)) * fade
            for k in range(5):
                ox = (k - 2) * base * 0.55 + math.sin(ph * 9 + k) * base * 0.15
                oy = -abs(k - 2) * base * 0.14 + math.cos(ph * 7 + k) * base * 0.1
                rr = base * (0.75 if k in (0, 4) else 1.0)
                snap.append_radial_gradient(rect(x + ox - rr, y + oy - rr * 0.7, rr * 2, rr * 1.4),
                                            point(x + ox, y + oy), rr, rr * 0.7, 0, 1,
                                            stops((0, shade + (alpha,)), (0.6, shade + (alpha * 0.55,)), (1, shade + (0,))))

        # Rain or snow, slanted by the wind.
        if s.rain > 0.02:
            count = int(min(420, 40 + s.rain * 110))
            slant = max(-0.5, min(0.5, -math.sin(math.radians(s.wind_from)) * s.wind / 25))
            snap.save()
            snap.translate(point(w / 2, h / 2))
            snap.rotate(math.degrees(math.atan(slant)) * -1)
            snap.translate(point(-w, -h))
            if s.snow:
                for dx, dy, sp in self.drop_seeds[:count]:
                    x = (dx * 2 * w + math.sin(t * sp + dx * 20) * 18) % (2 * w)
                    y = ((dy * 2 * h) + t * 45 * sp) % (2 * h)
                    d = 4.2 * sp
                    flake = Gsk.RoundedRect()
                    flake.init_from_rect(rect(x, y, d, d), d / 2)
                    snap.push_rounded_clip(flake)
                    snap.append_color(rgba(1, 1, 1, 0.85), rect(x, y, d, d))
                    snap.pop()
            else:
                col = rgba(0.88, 0.93, 1, 0.55 if night < 0.5 else 0.38)
                for dx, dy, sp in self.drop_seeds[:count]:
                    x = dx * 2 * w
                    y = ((dy * 2 * h) + t * 900 * sp) % (2 * h)
                    snap.append_color(col, rect(x, y, 1.6, 22 * sp))
            snap.restore()

        # Fog: pale bands near the ground.
        if s.fog > 0.05:
            a = min(0.8, s.fog * 0.9)
            fogc = mix((0.85, 0.87, 0.9), (0.3, 0.33, 0.4), night)
            snap.append_linear_gradient(rect(0, 0, w, h), point(0, h * 0.25), point(0, h),
                                        stops((0, fogc + (0,)), (0.6, fogc + (a * 0.7,)), (1, fogc + (a,))))

        # Thunder: a short flash now and then.
        if self.flash > 0:
            snap.append_color(rgba(0.92, 0.94, 1, 0.55 * self.flash), rect(0, 0, w, h))
        return snap.to_node()

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        if w <= 0 or h <= 0:
            return
        now = time.monotonic()
        t = now - self.t0 if self.animating() else 0
        if self.state.thunder and self.animating():
            if now >= self.next_flash:
                self.flash = 1.0
                self.next_flash = now + random.uniform(4, 10)
            else:
                self.flash = max(0.0, self.flash - 0.08)
        else:
            self.flash = 0.0
        sky = self._sky_node(w, h, t)
        snapshot.append_node(sky)

        # Glass under each card: the sky behind it, blurred, tinted, with a bright rim.
        for (x, y, cw, ch, r) in self.cards:
            bounds = rect(x, y, cw, ch)
            rr = Gsk.RoundedRect()
            rr.init_from_rect(bounds, r)
            if self.glass:
                snapshot.push_rounded_clip(rr)
                snapshot.push_blur(28)
                snapshot.append_node(sky)
                snapshot.pop()
                snapshot.pop()
                snapshot.push_rounded_clip(rr)
                snapshot.append_color(rgba(0.08, 0.10, 0.16, 0.22), bounds)
                snapshot.append_linear_gradient(bounds, point(x, y), point(x, y + ch),
                                                stops((0, (1, 1, 1, 0.10)), (0.25, (1, 1, 1, 0.02)), (1, (1, 1, 1, 0.0))))
                snapshot.pop()
                white = rgba(1, 1, 1, 0.30)
                snapshot.append_border(rr, [1, 1, 1, 1], [white, rgba(1, 1, 1, 0.12), rgba(1, 1, 1, 0.08), rgba(1, 1, 1, 0.12)])
            else:
                snapshot.push_rounded_clip(rr)
                snapshot.append_color(rgba(0.13, 0.14, 0.17, 0.92), bounds)
                snapshot.pop()


def sky_state_for(fc, hour):
    """The sky for one forecast hour at that place."""
    st = SkyState()
    when = hour['time'] if hour['time'] > datetime.now(timezone.utc) else datetime.now(timezone.utc)
    st.sun = sun_elevation(fc.lat, fc.lon, when)
    times = sun_times(fc.lat, fc.lon, when)
    if times:
        rise, sset = times
        st.day_fraction = max(0.0, min(1.0, (when - rise).total_seconds() / max(1, (sset - rise).total_seconds())))
    st.moon = moon_phase(when)
    st.clouds = (hour['clouds'] or 0) / 100
    st.wind, st.wind_from = hour['wind'] or 0, hour['wind_from'] or 0
    st.rain = hour['precip'] or 0
    sym = hour['symbol'] or ''
    st.snow = 'snow' in sym or 'sleet' in sym or (hour['temp'] is not None and hour['temp'] < 0.5 and st.rain > 0)
    st.fog = (hour['fog'] or 0) / 100 if hour['fog'] else (0.6 if sym.startswith('fog') else 0)
    st.thunder = 'thunder' in sym or (hour['thunder_p'] or 0) >= 30
    return st


# ---------------------------------------------------------------------------------------------
# Making sense of the numbers: feels-like, comfort, heads-up, the best time to go out
# ---------------------------------------------------------------------------------------------

def feels_like(h):
    t, rh, wind = h.get('temp'), h.get('humidity'), h.get('wind') or 0
    if t is None:
        return None
    if t >= 27 and rh is not None and rh >= 40:
        # heat index (Rothfusz), in Fahrenheit
        f = t * 9 / 5 + 32
        hi = (-42.379 + 2.04901523 * f + 10.14333127 * rh - 0.22475541 * f * rh - 0.00683783 * f * f
              - 0.05481717 * rh * rh + 0.00122874 * f * f * rh + 0.00085282 * f * rh * rh - 0.00000199 * f * f * rh * rh)
        return max(t, (hi - 32) * 5 / 9)
    if t <= 10 and wind > 1.34:
        v = wind * 3.6
        return 13.12 + 0.6215 * t - 11.37 * v ** 0.16 + 0.3965 * t * v ** 0.16
    return t


def comfort_words(dew):
    """How the air feels, from the dew point (degrees C)."""
    if dew is None:
        return ''
    scale = [(10, _('Dry and crisp')), (13, _('Comfortable')),
             (16, _('Pleasant')), (18, _('A little humid')),
             (21, _('Humid')), (24, _('Sticky')), (99, _('Oppressive'))]
    for limit, words in scale:
        if dew < limit:
            return words
    return scale[-1][1]


def day_part(dt):
    """'this afternoon', 'tomorrow morning', 'Saturday evening'... as whole phrases, so each
    language can word them its own way."""
    h = dt.hour
    part = 'night' if h < 6 else 'morning' if h < 12 else 'afternoon' if h < 17 else 'evening' if h < 21 else 'tonight'
    today = datetime.now().date()
    if dt.date() == today:
        return {'night': _('overnight'), 'morning': _('this morning'),
                'afternoon': _('this afternoon'), 'evening': _('this evening'),
                'tonight': _('tonight')}[part]
    if dt.date() == today + timedelta(days=1):
        return {'night': _('overnight into tomorrow'), 'morning': _('tomorrow morning'),
                'afternoon': _('tomorrow afternoon'), 'evening': _('tomorrow evening'),
                'tonight': _('tomorrow night')}[part]
    day = day_name(dt)
    return {'night': _('{day} overnight').format(day=day), 'morning': _('{day} morning').format(day=day),
            'afternoon': _('{day} afternoon').format(day=day), 'evening': _('{day} evening').format(day=day),
            'tonight': _('{day} night').format(day=day)}[part]


def heads_up(fc, imp):
    """Notable weather in the next 48 hours, as a few short lines (icon, text)."""
    hours = fc.next_hours(48)
    out = []
    # Rain windows
    i = 0
    windows = []
    while i < len(hours):
        if hours[i]['precip'] >= 0.2:
            j = i
            # a dry hour between two wet ones does not split the window
            while j + 1 < len(hours) and (hours[j + 1]['precip'] >= 0.1 or
                                          (j + 2 < len(hours) and hours[j + 2]['precip'] >= 0.2)):
                j += 1
            windows.append((i, j))
            i = j + 1
        else:
            i += 1
    for a, b in windows[:2]:
        start = hours[a]['time'].astimezone()
        end = hours[b]['time'].astimezone() + timedelta(hours=1)
        peak = max(h['precip'] for h in hours[a:b + 1])
        heavy = _('heavy ') if peak >= 4 else ''
        thunder = any('thunder' in (h['symbol'] or '') or (h['thunder_p'] or 0) >= 30 for h in hours[a:b + 1])
        what = _('Storms') if thunder else (_('Heavy rain') if heavy else _('Rain'))
        out.append(('weather-storm-symbolic' if thunder else 'weather-showers-symbolic',
                    f'{what} {day_part(start)}, {fmt_hour(start)}–{fmt_hour(end)}'))
    # Gusts
    gusty = [h for h in hours if (h['gust'] or h['wind'] or 0) >= 14]
    if gusty:
        g = max(gusty, key=lambda h: h['gust'] or h['wind'])
        out.append(('weather-windy-symbolic', _('Gusty {when}, up to {wind}').format(when=day_part(g["time"].astimezone()), wind=fmt_wind(g["gust"] or g["wind"], imp))))
    # Heat and cold
    hottest = max(hours, key=lambda h: feels_like(h) or -99) if hours else None
    if hottest and (feels_like(hottest) or 0) >= 38:
        out.append(('temperature-symbolic', _('Heat {when}: feels like {temp}').format(when=day_part(hottest["time"].astimezone()), temp=fmt_temp(feels_like(hottest), imp))))
    coldest = min(hours, key=lambda h: h['temp'] if h['temp'] is not None else 99) if hours else None
    if coldest and coldest['temp'] is not None and coldest['temp'] <= 0:
        out.append(('weather-snow-symbolic', _('Freezing {when}, down to {temp}').format(when=day_part(coldest["time"].astimezone()), temp=fmt_temp(coldest["temp"], imp))))
    # Big change between days
    days = fc.days(3)
    if len(days) >= 2:
        d0, d1 = days[0], days[1]
        diff = d1['hi'] - d0['hi']
        name = _('Tomorrow') if d1['date'] == datetime.now().date() + timedelta(days=1) else day_name(d1['date']).capitalize()
        if diff <= -6:
            out.append(('weather-few-clouds-symbolic', _('{name} turns cooler, about {number}° below today').format(name=name, number=abs(round(diff * (1.8 if imp else 1))))))
        elif diff >= 6:
            out.append(('weather-clear-symbolic', _('{name} warms up, about {number}° above today').format(name=name, number=round(diff * (1.8 if imp else 1)))))
    if not out:
        out.append(('weather-clear-symbolic', _('Quiet weather for the next two days.')))
    return out[:4]


def best_window(fc, prefs):
    """The best stretch of the next 24 hours to be outside: dry, in the comfortable range, not too
    windy, in daylight. Returns (start, end, hours) or None."""
    lo, hi = prefs.get('comfort_lo', 16.0), prefs.get('comfort_hi', 29.0)
    hours = fc.next_hours(24)

    def good(h):
        fl = feels_like(h)
        sun = sun_elevation(fc.lat, fc.lon, h['time'])
        return (h['precip'] < 0.1 and (h['pop'] or 0) < 40 and fl is not None and lo <= fl <= hi
                and (h['wind'] or 0) < 9 and sun > -3)

    best, cur = None, None
    for i, h in enumerate(hours):
        if good(h):
            cur = (cur[0], i) if cur else (i, i)
            if best is None or cur[1] - cur[0] > best[1] - best[0]:
                best = cur
        else:
            cur = None
    if not best:
        return None
    a, b = best
    return hours[a]['time'].astimezone(), hours[b]['time'].astimezone() + timedelta(hours=1), hours[a:b + 1]


