        refresh.connect('clicked', lambda *_: self._load(force=True))
        header.pack_start(refresh)
        header.pack_end(self._main_menu())
        root.append(header)

        self.scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroller.set_overlay_scrolling(True)
