    def _comfort_popover(self):
        pop = Gtk.Popover()
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, margin_top=10, margin_bottom=10, margin_start=10, margin_end=10)
        imp = self.imperial

        def to_user(c):
            return c * 9 / 5 + 32 if imp else c

        def from_user(v):
            return (v - 32) * 5 / 9 if imp else v
        spins = []
        for r, (key, label, default) in enumerate((('comfort_lo', _('From'), 16.0), ('comfort_hi', _('To'), 29.0))):
            grid.attach(Gtk.Label(label=label, xalign=0), 0, r, 1, 1)
            spin = Gtk.SpinButton.new_with_range(-20 if not imp else 0, 45 if not imp else 115, 1)
            spin.set_value(round(to_user(self.prefs.get(key, default))))
            grid.attach(spin, 1, r, 1, 1)
            spins.append((key, spin))
        done = Gtk.Button(label=_('Save'))
        done.add_css_class('suggested-action')

        def save(*_):
            for key, spin in spins:
                self.prefs[key] = from_user(spin.get_value())
            save_json(PREFS_FILE, self.prefs)
            pop.popdown()
            GLib.idle_add(lambda: (self._render(), False)[1])
        done.connect('clicked', save)
        grid.attach(done, 0, 2, 2, 1)
        pop.set_child(grid)
        return pop

    def _tropics_card(self, fc, imp):
        card = self._card(_('Tropics'))
        storms = []
        for s in self.storms or []:
            try:
                lat, lon = float(s['latitudeNumeric']), float(s['longitudeNumeric'])
            except (KeyError, TypeError, ValueError):
                continue
            dist = distance_km(fc.lat, fc.lon, lat, lon)
            storms.append((dist, s, lat, lon))
        storms.sort(key=lambda x: x[0])
        if not storms:
            card.append(self._label(_('No active storms. Hurricane season runs through November 30.'),
                                    'sky-row-text', xalign=0, wrap=True))
        for dist, s, lat, lon in storms[:3]:
            kind = _(STORM_KINDS.get(s.get('classification', ''), s.get('classification', '')))
            kt = float(s.get('intensity') or 0)
            wind = fmt_wind(kt * 0.514444, imp)
            far = f"{round(dist * 0.621371):,} mi" if imp else f'{round(dist):,} km'
            near = dist < 800
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            row.append(self._label(f"{'⚠ ' if near else ''}{kind} {s.get('name', '')}", 'sky-mid', xalign=0))
            row.append(self._label(_('{wind} winds · {far} {direction} of here').format(wind=wind, far=far, direction=compass(bearing(fc.lat, fc.lon, lat, lon))),
                                   'sky-small', 'sky-dim', xalign=0, wrap=True))
            card.append(row)
        link = Gtk.LinkButton(uri='https://www.nhc.noaa.gov', label=_('National Hurricane Center'),
                              halign=Gtk.Align.START)
        card.append(link)
        return card

    def _trips_card(self, imp):
        if not self.prefs.get('trips'):
            if self.prefs.get('trips_asked'):
                return None
            card = self._card(_('Trips'))
            card.append(self._label(_('See the weather where your calendar says you are going? Parcha Sky reads your calendar on this computer only.'), 'sky-row-text', xalign=0, wrap=True))
            row = Gtk.Box(spacing=8)
            yes = Gtk.Button(label=_('Turn on'))
            yes.add_css_class('sky-pill-button')
            no = Gtk.Button(label=_('No thanks'))
            no.add_css_class('sky-pill-button')
            yes.connect('clicked', lambda *_: self._set_trips(True))
            no.connect('clicked', lambda *_: self._set_trips(False))
            row.append(yes)
            row.append(no)
            card.append(row)
            return card
        if not self.trips:
            return None
        card = self._card(_('Trips'))
        for when, place, summary in self.trips[:3]:
            key = (round(place['lat'], 2), round(place['lon'], 2))
            tfc = self.trip_forecasts.get(key)
            day = next((d for d in tfc.days(10) if d['date'] == when.date()), None) if tfc else None
            row = Gtk.Box(spacing=10)
            if day:
                ic, cond, _t = symbol_info(day['symbol'])
                row.append(Gtk.Image(icon_name=ic, pixel_size=22))
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(self._label(f"{place['name']} · {day_name(when, short=True).capitalize()} {when.day}", 'sky-mid', xalign=0))
            detail = summary or ''
            if day:
                detail = f"{fmt_temp(day['hi'], imp)} / {fmt_temp(day['lo'], imp)} · {cond}" + (f' · {summary}' if summary else '')
            elif tfc:
                detail = _('Beyond the forecast range for now')
            box.append(self._label(detail, 'sky-small', 'sky-dim', xalign=0, wrap=True))
            row.append(box)
            card.append(row)
        return card

    def _set_trips(self, on):
        self.prefs['trips'] = on
        self.prefs['trips_asked'] = True
        save_json(PREFS_FILE, self.prefs)
        if on:
            self._load_trips()
        self._render()

    def _details_flow(self, fc, now, imp):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=14, row_spacing=14,
                           homogeneous=True, max_children_per_line=2, min_children_per_line=2)
        for title, big, small in self._details(fc, now, imp):
            card = self._card(title)
            card.append(self._label(big, 'sky-big', xalign=0))
            card.append(self._label(small, 'sky-small', 'sky-dim', xalign=0, wrap=True))
            card.set_size_request(-1, 112)
            flow.append(card)
        return flow

    def _details(self, fc, now, imp):
        out = []
        gust = f" · {_('gusts')} {fmt_wind(now['gust'], imp)}" if now.get('gust') else ''
        out.append((_('Wind'), f"{arrow(now['wind_from'] or 0)} {fmt_wind(now['wind'], imp)}",
                    _('From the %s') % compass(now['wind_from'] or 0) + gust))
        if now.get('dew') is not None:
            out.append((_('Comfort'), comfort_words(now['dew']),
                        _('Dew point {temp} · humidity {number}%').format(temp=fmt_temp(now['dew'], imp), number=round(now['humidity'] or 0))))
        if now.get('uv') is not None:
            uv = now['uv']
            level = _('Low') if uv < 3 else _('Moderate') if uv < 6 else _('High') if uv < 8 else _('Very high')
            out.append((_('UV index'), f'{round(uv)}', level + (_(' · sunscreen') if uv >= 6 else '')))
        times = sun_times(fc.lat, fc.lon, datetime.now(timezone.utc))
        if times:
            rise, sset = (t.astimezone() for t in times)
            length = sset - rise
            out.append((_('Sun'), f"↑ {fmt_hour(rise)}", f"↓ {fmt_hour(sset)} · "
                        + _('{hours}h {minutes}m of daylight').format(hours=length.seconds // 3600, minutes=length.seconds % 3600 // 60)))
        if now.get('pressure') is not None:
            later = [h for h in fc.hours if h['time'] > now['time'] + timedelta(hours=2)]
            trend = ''
            if later and later[0]['pressure'] is not None:
                diff = later[0]['pressure'] - now['pressure']
                trend = _('Rising') if diff > 0.8 else _('Falling') if diff < -0.8 else _('Steady')
            out.append((_('Pressure'), f"{round(now['pressure'])} hPa", trend))
        phase = moon_phase(datetime.now(timezone.utc))
        names = [_('New moon'), _('Waxing crescent'), _('First quarter'),
                 _('Waxing gibbous'), _('Full moon'), _('Waning gibbous'),
                 _('Last quarter'), _('Waning crescent')]
        out.append((_('Moon'), names[int(phase * 8 + 0.5) % 8],
                    _('%d%% lit') % round((1 - math.cos(2 * math.pi * phase)) / 2 * 100)))
        return out

    # -- coquí nights -----------------------------------------------------------------------------

    def _update_coqui(self):
        fc = self.forecast
        want = False
        if fc and self.prefs.get('coqui') and self.is_active() and self.places:
            p = self.places[self.index]
            now = fc.now()
            sun = sun_elevation(p['lat'], p['lon'], datetime.now(timezone.utc))
            want = (in_puerto_rico(p['lat'], p['lon']) and sun < -6 and now and (now['temp'] or 0) >= 20
                    and ((now['humidity'] or 0) >= 70 or now['precip'] > 0))
            want = want or os.environ.get('PARCHA_SKY_COQUI') == '1'
        if want and not self.coqui:
            self.coqui = Gtk.MediaFile.new_for_filename(coqui_wav())
            self.coqui.set_loop(True)
            self.coqui.set_volume(0.35)
            self.coqui.play()
        elif not want:
            self._stop_coqui()

    def _stop_coqui(self):
        if self.coqui:
            self.coqui.pause()
            self.coqui = None

    # -- menu -----------------------------------------------------------------------------------

    def _main_menu(self):
        menu = Gio.Menu()
        menu.append(_('Playful summaries'), 'win.playful')
        menu.append(_('Show Parchi'), 'win.parchita')
        menu.append(_('Fahrenheit and mph'), 'win.imperial')
        menu.append(_('Weather for my trips'), 'win.trips')
        menu.append(_('Coquí nights (Puerto Rico)'), 'win.coqui')
        menu.append(_('About Parcha Sky'), 'win.about')
        for key, default in (('playful', True), ('parchita', True), ('imperial', self.imperial), ('trips', False), ('coqui', False)):
            act = Gio.SimpleAction.new_stateful(key, None, GLib.Variant('b', self.prefs.get(key, default)))
            act.connect('change-state', self._toggle(key))
            self.add_action(act)
        about = Gio.SimpleAction.new('about', None)
        about.connect('activate', self._about)
        self.add_action(about)
        return Gtk.MenuButton(icon_name='open-menu-symbolic', menu_model=menu, tooltip_text=_('Menu'))

    def _toggle(self, key):
        def handler(action, value):
            action.set_state(value)
            self.prefs[key] = value.get_boolean()
            if key == 'imperial':
                self.imperial = value.get_boolean()
            if key == 'trips':
                self.prefs['trips_asked'] = True
                if value.get_boolean():
                    self._load_trips()
            save_json(PREFS_FILE, self.prefs)
            if key == 'coqui':
                self._update_coqui()
            if self.forecast:
                self._render()
        return handler

    def _about(self, *_a):
        about = Adw.AboutDialog(application_name=_('Parcha Sky'), application_icon=APP_ID, version=VERSION,
                                developer_name='Spanglish Enterprises LLC', license_type=Gtk.License.GPL_3_0,
                                website='https://www.parchaos.org',
                                comments=_('The sky outside, right now.'))
        about.add_credit_section(_('Weather data'),
                                 ['MET Norway https://api.met.no', 'US National Weather Service https://www.weather.gov',
                                  'National Hurricane Center https://www.nhc.noaa.gov'])
        about.present(self)


class SkyApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        GLib.set_application_name(_('Parcha Sky'))

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        if os.environ.get('PARCHA_SKY_PARCHITA_SHEET'):  # tests: every mood side by side
            win = Adw.ApplicationWindow(application=self, default_width=1100, default_height=440)
            box = Gtk.Grid(column_spacing=24, row_spacing=12, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            for i, mood in enumerate(('happy', 'neutral', 'sunny', 'sunset', 'rain', 'cloudy',
                                      'fog', 'storm', 'snow', 'cold', 'windy', 'night')):
                col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                p = Parchita()
                p.set_mood(mood)
                col.append(p)
                col.append(Gtk.Label(label=mood))
                box.attach(col, i % 6, i // 6, 1, 1)
            win.set_content(box)
            win.present()
            return
        win = self.props.active_window or SkyWindow(self)
        win.present()


if __name__ == '__main__':
    try:
        locale.setlocale(locale.LC_ALL, '')
