def summary_line(fc, playful, temp_text):
    now = fc.now()
    if not now:
        return ''
    hot = (feels_like(now) or 0) >= 32
    cold = now['temp'] is not None and now['temp'] <= 3
    kind, when = fc.rain_soon()
    when_txt = fmt_hour(when) if when else ''
    _icon, cond, thunder = symbol_info(now['symbol'])
    if not playful:
        if kind == 'starts':
            return _('Rain starting around {when_txt}.').format(when_txt=when_txt)
        if kind == 'stops':
            return _('Rain stopping around {when_txt}.').format(when_txt=when_txt)
        return f'{cond}, {temp_text}.'
    if thunder:
        return _('Thunder about. Good time for indoors.')
    if kind == 'starts':
        return _('Dry for now, rain rolls in around {when_txt}. Keep the umbrella close.').format(when_txt=when_txt)
    if kind == 'stops':
        return _('Wet out there, but it clears up around {when_txt}.').format(when_txt=when_txt)
    if hot:
        return _('Proper hot. Water, shade, no rushing.')
    if cold:
        return _('Properly cold. Layers on.')
    if (now['dew'] or 0) >= 21:
        return _('Sticky out there. The air has weight to it.')
    if now['clouds'] < 25:
        return _('Clear skies. A good one to be outside.')
    if now['clouds'] > 85:
        return _('Grey and quiet. Coffee weather.')
    return _('{cond}, {temp_text}. Nothing dramatic.').format(cond=cond, temp_text=temp_text)


