                cr.line_to(x - er * 0.8, ey + er * 0.4)
                cr.stroke()
                continue
            _rgb(cr, (1, 1, 1))
            _ellipse(cr, x, ey, er, er * 1.1)
            cr.fill()
            _rgb(cr, INK, 0.6)
            cr.set_line_width(r * 0.02)
            _ellipse(cr, x, ey, er, er * 1.1)
            cr.stroke()
            iris = 0.72 if expr != 'surprised' else 0.55
            _rgb(cr, (0.47, 0.29, 0.12))
            _ellipse(cr, x, ey + er * 0.12, er * iris, er * iris * 1.05)
            cr.fill()
            _rgb(cr, INK)
            _ellipse(cr, x, ey + er * 0.15, er * iris * 0.55, er * iris * 0.58)
            cr.fill()
            _rgb(cr, (1, 1, 1))
            _ellipse(cr, x - er * 0.25, ey - er * 0.2, er * 0.24, er * 0.24)
            cr.fill()
            _ellipse(cr, x + er * 0.2, ey + er * 0.35, er * 0.1, er * 0.1)
            cr.fill()
        # brows
        _rgb(cr, INK)
        cr.set_line_width(r * 0.045)
        for sx in (-1, 1):
            x = cx + sx * ex
            by = ey - er * 1.45
            if expr in ('concerned', 'sad', 'storm'):
                cr.move_to(x - sx * er * 0.8, by + er * 0.35)
                cr.line_to(x + sx * er * 0.7, by - er * 0.15)
            elif expr == 'surprised':
                cr.arc(x, by + er * 0.1, er * 0.75, math.pi * 1.15, math.pi * 1.85)
            elif expr != 'sleepy':
                cr.set_line_width(r * 0.032)
                cr.move_to(x - er * 0.62, by + er * 0.18)
                cr.curve_to(x - er * 0.25, by - er * 0.22, x + er * 0.25, by - er * 0.22, x + er * 0.62, by + er * 0.18)
            cr.stroke()
    # cheeks
    _rgb(cr, CHEEK, 0.7)
    for sx in (-1, 1):
        _ellipse(cr, cx + sx * r * 0.52, cy + r * 0.18, r * 0.13, r * 0.08)
        cr.fill()
    # mouth
    my = cy + r * 0.30
    _rgb(cr, INK)
    cr.set_line_width(r * 0.045)
    if expr in ('happy', 'sunny'):
        cr.move_to(cx - r * 0.24, my - r * 0.04)
        cr.curve_to(cx - r * 0.17, my + r * 0.26, cx + r * 0.17, my + r * 0.26, cx + r * 0.24, my - r * 0.04)
        cr.close_path()
        _rgb(cr, (0.55, 0.12, 0.16))
        cr.fill_preserve()
        _rgb(cr, INK)
        cr.stroke()
        _rgb(cr, (0.95, 0.45, 0.5))
        _ellipse(cr, cx, my + r * 0.1, r * 0.08, r * 0.04)
        cr.fill()
    elif expr in ('concerned', 'storm'):
        cr.move_to(cx - r * 0.13, my + r * 0.06)
