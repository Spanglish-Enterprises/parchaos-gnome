class SkyState:
    def __init__(self):
        self.sun = 30.0          # degrees above the horizon
        self.day_fraction = 0.5  # 0 sunrise .. 1 sunset, for where the sun sits
        self.clouds = 0.2        # 0..1
        self.wind = 3.0          # m/s
        self.wind_from = 270.0   # degrees
        self.rain = 0.0          # mm/h
        self.snow = False
        self.fog = 0.0           # 0..1
        self.thunder = False
        self.moon = 0.5          # phase


DAY_TOP, DAY_BOTTOM = (0.20, 0.47, 0.82), (0.58, 0.79, 0.95)
GOLD_TOP, GOLD_BOTTOM = (0.27, 0.36, 0.62), (0.98, 0.62, 0.38)
NIGHT_TOP, NIGHT_BOTTOM = (0.02, 0.04, 0.10), (0.08, 0.13, 0.26)
GREY_TOP, GREY_BOTTOM = (0.38, 0.43, 0.50), (0.62, 0.66, 0.71)


class SkyView(Gtk.Widget):
    """Draws the sky from a SkyState, moving gently, and the frosted glass under the cards."""

    def __init__(self):
        super().__init__()
        self.state = SkyState()
        self.cards = []        # (x, y, w, h, radius) in this widget's coordinates
        self.glass = True
        self.t0 = time.monotonic()
        self.last_frame = 0
        self.flash = 0.0
        self.next_flash = time.monotonic() + 3
        rnd = random.Random(7)
        self.cloud_seeds = [(rnd.random(), rnd.random() * 0.55, 0.6 + rnd.random() * 0.8, rnd.random())
                            for _ in range(14)]
        self.star_seeds = [(rnd.random(), rnd.random() * 0.75, rnd.random()) for _ in range(110)]
        self.drop_seeds = [(rnd.random(), rnd.random(), 0.6 + rnd.random() * 0.8) for _ in range(420)]
        self.add_tick_callback(self._tick)

    def animating(self):
        return Gtk.Settings.get_default().props.gtk_enable_animations and \
            os.environ.get('PARCHA_SKY_STILL') != '1'

    def _tick(self, widget, clock):
        now = time.monotonic()
        # 30 frames a second is plenty for drifting clouds and rain.
        if self.animating() and now - self.last_frame >= 1 / 30:
            self.last_frame = now
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def set_cards(self, cards):
        if cards != self.cards:
            self.cards = cards
            self.queue_draw()

    # -- drawing --------------------------------------------------------------------------------

    def _colors(self):
        s = self.state
        if s.sun >= 8:
            top, bottom = DAY_TOP, DAY_BOTTOM
        elif s.sun >= -2:
            t = (s.sun + 2) / 10
            top, bottom = mix(GOLD_TOP, DAY_TOP, t), mix(GOLD_BOTTOM, DAY_BOTTOM, t)
        elif s.sun >= -10:
            t = (s.sun + 10) / 8
            top, bottom = mix(NIGHT_TOP, GOLD_TOP, t), mix(NIGHT_BOTTOM, GOLD_BOTTOM, t)
        else:
            top, bottom = NIGHT_TOP, NIGHT_BOTTOM
        # Overcast and rain grey the sky out (less at night, where it is dark anyway).
        grey = max(0.0, s.clouds - 0.45) / 0.55 * 0.85 + min(s.rain, 4) / 4 * 0.25
        night = 1 - max(0.0, min(1.0, (s.sun + 6) / 12))
        g_top, g_bottom = mix(GREY_TOP, NIGHT_TOP, night * 0.85), mix(GREY_BOTTOM, NIGHT_BOTTOM, night * 0.8)
        return mix(top, g_top, grey), mix(bottom, g_bottom, grey)

    def _sky_node(self, w, h, t):
        snap = Gtk.Snapshot()
        s = self.state
        top, bottom = self._colors()
        snap.append_linear_gradient(rect(0, 0, w, h), point(0, 0), point(0, h),
                                    stops((0, top + (1,)), (1, bottom + (1,))))
        night = 1 - max(0.0, min(1.0, (s.sun + 4) / 10))
        clear = 1 - s.clouds

        # Stars and the moon at night.
        if night > 0.05 and clear > 0.1:
            for sx, sy, ph in self.star_seeds:
                tw = 0.55 + 0.45 * math.sin(t * (0.6 + ph) + ph * 10)
                a = night * clear * tw * 0.9
                snap.append_color(rgba(1, 1, 1, a), rect(sx * w, sy * h, 1.6, 1.6))
            mx, my, mr = w * 0.78, h * 0.16, 26
            snap.append_radial_gradient(rect(mx - mr * 4, my - mr * 4, mr * 8, mr * 8), point(mx, my), mr * 4, mr * 4,
                                        0, 1, stops((0, (0.85, 0.9, 1, 0.22 * night * clear)), (1, (0.85, 0.9, 1, 0))))
            lit = abs(math.cos(math.pi * s.moon))  # 1 new/full..0 quarters -> brightness hint
            snap.append_radial_gradient(rect(mx - mr, my - mr, mr * 2, mr * 2), point(mx, my), mr, mr, 0, 1,
                                        stops((0, (0.97, 0.96, 0.9, night * (0.95 if s.moon > 0.03 else 0.2))),
                                              (0.96, (0.92, 0.92, 0.88, night * (0.9 - 0.3 * lit * (s.moon < 0.25 or s.moon > 0.75)))),
                                              (1, (0.92, 0.92, 0.88, 0))))

        # The sun travels along the upper right (clear of the temperature in the middle): lower and
        # to the right early and late, highest at noon, from its real elevation and the time of day.
        if s.sun > -4:
            sx = w * (0.64 + 0.26 * s.day_fraction)
            sy = h * (0.30 - 0.22 * max(0.0, min(1.0, s.sun / 60)))
            vis = max(0.0, min(1.0, (s.sun + 4) / 6)) * (1 - 0.85 * max(0.0, s.clouds - 0.3) / 0.7)
            r = 34
            warm = 1 - max(0.0, min(1.0, s.sun / 15))
            core = mix((1.0, 0.98, 0.88), (1.0, 0.72, 0.42), warm)
            snap.append_radial_gradient(rect(sx - r * 7, sy - r * 7, r * 14, r * 14), point(sx, sy), r * 7, r * 7, 0, 1,
                                        stops((0, core + (0.45 * vis,)), (0.35, core + (0.12 * vis,)), (1, core + (0,))))
            snap.append_radial_gradient(rect(sx - r, sy - r, r * 2, r * 2), point(sx, sy), r, r, 0, 1,
                                        stops((0, (1, 1, 0.97, vis)), (0.8, core + (vis,)), (1, core + (0,))))

        # Clouds: soft clusters drifting with the real wind (east-west component).
        n = int(round(2 + s.clouds * 12))
        drift = -math.sin(math.radians(s.wind_from)) * (6 + s.wind * 5)  # px/s, wind *from* -> moves away
        shade = mix((1, 1, 1), (0.55, 0.58, 0.64), max(0.0, s.clouds - 0.5) * 2 + min(s.rain, 3) / 6)
        shade = mix(shade, (0.32, 0.36, 0.46), night * 0.85)
        for i, (cx, cy, size, ph) in enumerate(self.cloud_seeds[:n]):
            span = w + 600
            x = ((cx * span + drift * t * (0.6 + size * 0.5)) % span) - 300
            y = cy * h * 0.75 + 20
            base = 110 * size * (0.8 + s.clouds * 0.7)
            alpha = (0.35 + 0.5 * s.clouds) * (0.85 + 0.15 * math.sin(t * 0.1 + ph * 6))
            for k in range(5):
                ox = (k - 2) * base * 0.55 + math.sin(ph * 9 + k) * base * 0.15
                oy = -abs(k - 2) * base * 0.14 + math.cos(ph * 7 + k) * base * 0.1
                rr = base * (0.75 if k in (0, 4) else 1.0)
                snap.append_radial_gradient(rect(x + ox - rr, y + oy - rr * 0.7, rr * 2, rr * 1.4),
                                            point(x + ox, y + oy), rr, rr * 0.7, 0, 1,
                                            stops((0, shade + (alpha,)), (0.6, shade + (alpha * 0.55,)), (1, shade + (0,))))

        # Rain or snow, slanted by the wind.
        if s.rain > 0.02:
            count = int(min(420, 40 + s.rain * 110))
            slant = max(-0.5, min(0.5, -math.sin(math.radians(s.wind_from)) * s.wind / 25))
            snap.save()
            snap.translate(point(w / 2, h / 2))
            snap.rotate(math.degrees(math.atan(slant)) * -1)
            snap.translate(point(-w, -h))
            if s.snow:
                for dx, dy, sp in self.drop_seeds[:count]:
                    x = (dx * 2 * w + math.sin(t * sp + dx * 20) * 18) % (2 * w)
                    y = ((dy * 2 * h) + t * 45 * sp) % (2 * h)
                    snap.append_color(rgba(1, 1, 1, 0.85), rect(x, y, 4 * sp, 4 * sp))
            else:
                col = rgba(0.88, 0.93, 1, 0.55 if night < 0.5 else 0.38)
                for dx, dy, sp in self.drop_seeds[:count]:
                    x = dx * 2 * w
                    y = ((dy * 2 * h) + t * 900 * sp) % (2 * h)
                    snap.append_color(col, rect(x, y, 1.6, 22 * sp))
            snap.restore()

        # Fog: pale bands near the ground.
        if s.fog > 0.05:
            a = min(0.8, s.fog * 0.9)
            fogc = mix((0.85, 0.87, 0.9), (0.3, 0.33, 0.4), night)
            snap.append_linear_gradient(rect(0, 0, w, h), point(0, h * 0.25), point(0, h),
                                        stops((0, fogc + (0,)), (0.6, fogc + (a * 0.7,)), (1, fogc + (a,))))

        # Thunder: a short flash now and then.
        if self.flash > 0:
            snap.append_color(rgba(0.92, 0.94, 1, 0.55 * self.flash), rect(0, 0, w, h))
        return snap.to_node()

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        if w <= 0 or h <= 0:
            return
        now = time.monotonic()
        t = now - self.t0 if self.animating() else 0
        if self.state.thunder and self.animating():
            if now >= self.next_flash:
                self.flash = 1.0
                self.next_flash = now + random.uniform(4, 10)
            else:
                self.flash = max(0.0, self.flash - 0.08)
        else:
            self.flash = 0.0
        sky = self._sky_node(w, h, t)
        snapshot.append_node(sky)

        # Glass under each card: the sky behind it, blurred, tinted, with a bright rim.
        for (x, y, cw, ch, r) in self.cards:
            bounds = rect(x, y, cw, ch)
            rr = Gsk.RoundedRect()
            rr.init_from_rect(bounds, r)
            if self.glass:
                snapshot.push_rounded_clip(rr)
                snapshot.push_blur(28)
                snapshot.append_node(sky)
                snapshot.pop()
                snapshot.pop()
                snapshot.push_rounded_clip(rr)
                snapshot.append_color(rgba(0.08, 0.10, 0.16, 0.22), bounds)
                # soft light from above
                snapshot.append_linear_gradient(bounds, point(x, y), point(x, y + ch),
                                                stops((0, (1, 1, 1, 0.10)), (0.25, (1, 1, 1, 0.02)), (1, (1, 1, 1, 0.0))))
                snapshot.pop()
                white = rgba(1, 1, 1, 0.30)
                snapshot.append_border(rr, [1, 1, 1, 1], [white, rgba(1, 1, 1, 0.12), rgba(1, 1, 1, 0.08), rgba(1, 1, 1, 0.12)])
            else:
                snapshot.push_rounded_clip(rr)
                snapshot.append_color(rgba(0.13, 0.14, 0.17, 0.92), bounds)
                snapshot.pop()


