class RangeBar(Gtk.DrawingArea):
    """A day's bar on the range of the whole forecast (temperature, rain or wind)."""

    def __init__(self, lo, hi, lo_all, hi_all, kind='temp'):
        super().__init__(content_width=120, content_height=6, hexpand=True, valign=Gtk.Align.CENTER)
        self.lo, self.hi, self.lo_all, self.hi_all, self.kind = lo, hi, lo_all, hi_all, kind
        self.set_draw_func(self._draw)

    @staticmethod
    def _temp_colour(c):
        pts = [(-10, (0.45, 0.65, 1.0)), (8, (0.45, 0.85, 0.9)), (18, (0.55, 0.9, 0.5)),
               (26, (1.0, 0.85, 0.35)), (34, (1.0, 0.5, 0.25)), (40, (0.95, 0.3, 0.3))]
        for (a, ca), (b, cb) in zip(pts, pts[1:]):
            if c <= b:
                return mix(ca, cb, (c - a) / (b - a)) if c >= a else ca
        return pts[-1][1]

    def _draw(self, area, cr, w, h):
        import cairo
        span = max(1e-3, self.hi_all - self.lo_all)
        cr.set_source_rgba(1, 1, 1, 0.18)
        self._pill(cr, 0, 0, w, h)
        cr.fill()
        x0 = w * (self.lo - self.lo_all) / span
        x1 = w * (self.hi - self.lo_all) / span
        if self.kind == 'temp':
            grad = cairo.LinearGradient(x0, 0, x1, 0)
            grad.add_color_stop_rgb(0, *self._temp_colour(self.lo))
            grad.add_color_stop_rgb(1, *self._temp_colour(self.hi))
            cr.set_source(grad)
        elif self.kind == 'rain':
            cr.set_source_rgb(0.45, 0.72, 1.0)
        elif self.kind == 'wind':
            cr.set_source_rgb(0.75, 0.92, 0.95)
        else:
            cr.set_source_rgb(*mix((0.6, 0.9, 0.7), (1.0, 0.6, 0.4), self.hi / 26))
        self._pill(cr, x0, 0, max(h, x1 - x0), h)
        cr.fill()

    @staticmethod
    def _pill(cr, x, y, w, h):
        r = h / 2
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, math.pi / 2)
        cr.arc(x + r, y + r, r, math.pi / 2, 3 * math.pi / 2)
        cr.close_path()


class HourChart(Gtk.DrawingArea):
    """The lens's line or bars under the hour columns, with the selected hour marked."""

    def __init__(self, win, hours, lens, col_w):
        super().__init__(content_width=len(hours) * col_w, content_height=64)
        self.win, self.hours, self.lens, self.col_w = win, hours, lens, col_w
        self.set_draw_func(self._draw)

    def _values(self):
        if self.lens == 'temp':
            return [h['temp'] for h in self.hours], None
        if self.lens == 'rain':
            return [h['precip'] for h in self.hours], [h['pop'] for h in self.hours]
        if self.lens == 'wind':
            return [h['wind'] for h in self.hours], [h['gust'] for h in self.hours]
        return [h['dew'] for h in self.hours], [feels_like(h) for h in self.hours]

    def _draw(self, area, cr, w, h):
        vals, extra = self._values()
        n = len(vals)
        if not n:
            return
        cw = self.col_w
        xs = [cw * (i + 0.5) for i in range(n)]
        sel = self.win.scrub
        cr.set_source_rgba(1, 1, 1, 0.9)
        cr.set_line_width(1)
        cr.move_to(xs[sel], 0)
        cr.line_to(xs[sel], h)
        cr.set_source_rgba(1, 1, 1, 0.35)
        cr.stroke()
        if self.lens == 'rain':
            top = max(2.0, max(v or 0 for v in vals))
            for x, v, p in zip(xs, vals, extra):
                bh = (v or 0) / top * (h - 8)
                cr.set_source_rgba(0.55, 0.78, 1.0, 0.35 + 0.65 * ((p or (60 if v else 0)) / 100))
                cr.rectangle(x - cw * 0.32, h - bh, cw * 0.64, bh)
                cr.fill()
            return
        good = [v for v in vals if v is not None] + [e for e in (extra or []) if e is not None]
        if not good:
            return
        lo, hi = min(good), max(good)
        span = max(1e-3, hi - lo)

        def y(v):
            return h - 8 - (v - lo) / span * (h - 16)
        series = [(vals, (1, 1, 1, 0.95), 2.4)]
        if extra and self.lens in ('wind', 'comfort'):
            series.append((extra, (1, 0.85, 0.5, 0.75) if self.lens == 'comfort' else (0.75, 0.92, 1, 0.6), 1.6))
        for data, col, lw in series:
            cr.set_source_rgba(*col)
            cr.set_line_width(lw)
            started = False
            for x, v in zip(xs, data):
                if v is None:
                    continue
                if not started:
                    cr.move_to(x, y(v))
                    started = True
                else:
                    cr.line_to(x, y(v))
            cr.stroke()
        v = vals[sel]
        if v is not None:
            cr.set_source_rgb(1, 1, 1)
            cr.arc(xs[sel], y(v), 4.5, 0, 2 * math.pi)
            cr.fill()


class SkyWindow(Adw.ApplicationWindow):
    COL_W = 54

    def __init__(self, app):
        size = os.environ.get('PARCHA_SKY_SIZE', '960x800').split('x')  # tests
        super().__init__(application=app, title=_('Parcha Sky'), default_width=int(size[0]), default_height=int(size[1]))
        self.add_css_class('sky-window')
        self.prefs = load_json(PREFS_FILE, {'playful': True})
        self.imperial = self.prefs.get('imperial', uses_imperial())
        self.lens = self.prefs.get('lens', 'temp')
        self.places = load_json(PLACES_FILE, [])
        self.index = 0
        self.forecast = None
        self.alerts = []
        self.storms = None
        self.trips = []
        self.trip_forecasts = {}
        self.scrub = int(os.environ.get('PARCHA_SKY_SCRUB', '0'))  # tests
        self.playing = 0
        self.coqui = None
        self.service = WeatherService()
        self.service.connect('forecast', self._on_forecast)
        self.service.connect('alerts', self._on_alerts)
        self.service.connect('failed', self._on_failed)
        self.radar = RadarService(self.service.session)
        self.radar.connect('frames', self._on_radar_frames)
        self.radar.connect('image', self._on_radar_image)
        self.radar.connect('next-hour', self._on_next_hour)
        self.next_hour = None
        self.radar_z = int(self.prefs.get('radar_z', 6))
        self.radar_map = None
        self.radar_play = 0

        self.sky = SkyView()
        self.sky.glass = self._glass_style()
        overlay = Gtk.Overlay(child=self.sky)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Adw.HeaderBar(show_title=False)
        header.add_css_class('sky-header')
        header.add_css_class('flat')
        self.places_button = Gtk.MenuButton(icon_name='view-list-symbolic', tooltip_text=_('Places'))
        self.places_button.set_popover(self._places_popover())
        header.pack_start(self.places_button)
        refresh = Gtk.Button(icon_name='view-refresh-symbolic', tooltip_text=_('Refresh'))
        refresh.connect('clicked', lambda *_: self._load(force=True))
        header.pack_start(refresh)
        header.pack_end(self._main_menu())
        root.append(header)

        self.scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.clamp = Adw.Clamp(maximum_size=760, tightening_threshold=600)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                               margin_start=16, margin_end=16, margin_bottom=24)
        self.content.add_css_class('sky-content')
        self.clamp.set_child(self.content)
        self.scroller.set_child(self.clamp)
        root.append(self.scroller)
        overlay.add_overlay(root)
        self.set_content(overlay)

        # Two columns on a wide window, one when narrow.
        self.wide = False
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse('min-width: 1000sp'))
        bp.connect('apply', lambda *_: self._set_wide(True))
        bp.connect('unapply', lambda *_: self._set_wide(False))
        self.add_breakpoint(bp)

        self.cards = []
        self.add_tick_callback(self._track_cards)
        self._placeholder(_('Finding the sky over you...'))
        GLib.timeout_add_seconds(REFRESH_SECONDS, self._refresh_tick)
        self.connect('notify::is-active', lambda *_: self._update_coqui())
        self.connect('close-request', lambda *_: self._stop_coqui() or False)
        self._start()

    def _set_wide(self, wide):
        if wide != self.wide:
            self.wide = wide
            self.clamp.set_maximum_size(1260 if wide else 760)
            if self.forecast:
                self._render()

    # -- style ----------------------------------------------------------------------------------

    def _glass_style(self):
        if os.environ.get('PARCHA_SKY_STYLE'):
            return os.environ['PARCHA_SKY_STYLE'] != 'classic'
        src = Gio.SettingsSchemaSource.get_default()
        schema = src.lookup('org.parchaos.desktop', True) if src else None
        if not schema:
            return True
        settings = Gio.Settings(settings_schema=schema)
        self._desktop = settings
        settings.connect('changed::style', lambda *_: self._restyle())
        return settings.get_string('style') != 'classic'

    def _restyle(self):
        self.sky.glass = self._desktop.get_string('style') != 'classic'
        self.sky.queue_draw()

    # -- glass follows the cards ------------------------------------------------------------------

    def _track_cards(self, widget, clock):
        regions = []
        for card in self.cards:
            if not card.get_mapped():
                continue
            ok, b = card.compute_bounds(self.sky)
            if ok:
                regions.append((b.get_x(), b.get_y(), b.get_width(), b.get_height(), 22))
        self.sky.set_cards(regions)
        return GLib.SOURCE_CONTINUE

    # -- places ---------------------------------------------------------------------------------

    def _start(self):
        test = os.environ.get('PARCHA_SKY_PLACE')  # "Name,lat,lon" (tests)
        if test:
            name, lat, lon = test.rsplit(',', 2)
            self.places = [{'name': name, 'lat': float(lat), 'lon': float(lon)}]
        if not self.places:
            self.places = self._gnome_weather_places()
        if self.places:
            self._load()
        else:
            self._locate()

    def _gnome_weather_places(self):
        # Reuse the places saved in GNOME Weather (name, latitude and longitude in radians).
        src = Gio.SettingsSchemaSource.get_default()
        if not src or not src.lookup('org.gnome.Weather', True):
            return []
        out = []
        try:
            for v in Gio.Settings(schema_id='org.gnome.Weather').get_value('locations'):
                inner = v.get_variant() if hasattr(v, 'get_variant') else v
                _ver, loc = inner.unpack()
                name, _code, _x, coords, _y = loc
                if coords:
                    lat, lon = coords[0]
                    out.append({'name': name, 'lat': math.degrees(lat), 'lon': math.degrees(lon)})
        except (TypeError, ValueError, GLib.Error):
            return []
        if out:
            save_json(PLACES_FILE, out)
        return out

    def _locate(self):
        try:
            gi.require_version('Geoclue', '2.0')
            from gi.repository import Geoclue
        except (ValueError, ImportError):
            self._placeholder(_('Add a place to see its weather.'))
            return
        self._placeholder(_('Finding where you are...'))
        Geoclue.Simple.new(APP_ID, Geoclue.AccuracyLevel.CITY, None, self._on_located)

    def _on_located(self, _src, result):
        try:
            from gi.repository import Geoclue
            simple = Geoclue.Simple.new_finish(result)
            loc = simple.get_location()
            self.places = [{'name': _('Here'), 'lat': loc.props.latitude, 'lon': loc.props.longitude}]
            save_json(PLACES_FILE, self.places)
            self._load()
        except GLib.Error:
            self._placeholder(_('Location is off. Add a place with the list button.'))

    def _places_popover(self):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8, margin_bottom=8,
                      margin_start=8, margin_end=8, width_request=300)
        self.search = Gtk.SearchEntry(placeholder_text=_('Add a city'))
        self.search.connect('activate', self._on_search)
        box.append(self.search)
        self.place_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.place_list.add_css_class('boxed-list')
        box.append(self.place_list)
        pop.set_child(box)
        pop.connect('show', lambda *_: self._fill_places())
        return pop

    def _fill_places(self):
        while (row := self.place_list.get_row_at_index(0)):
            self.place_list.remove(row)
        for i, p in enumerate(self.places):
            row = Adw.ActionRow(title=p['name'], activatable=True)
            row.connect('activated', lambda _r, i=i: self._choose(i))
            rm = Gtk.Button(icon_name='user-trash-symbolic', valign=Gtk.Align.CENTER, tooltip_text=_('Remove'))
            rm.add_css_class('flat')
            rm.connect('clicked', lambda _b, i=i: self._remove(i))
            row.add_suffix(rm)
            self.place_list.append(row)

    def _choose(self, i):
        self.index = i
        self.scrub = 0
        self.places_button.popdown()
        self._load()

    def _remove(self, i):
        del self.places[i]
        save_json(PLACES_FILE, self.places)
        self.index = min(self.index, max(0, len(self.places) - 1))
        self._fill_places()
        if self.places:
            self._load()

    def _on_search(self, entry):
        text = entry.get_text().strip()
        if not text:
            return
        hit = find_city(text)
        if not hit:
            entry.set_text('')
            entry.set_placeholder_text(_('No city called "%s"') % text)
            return
        self.places.append(dict(hit))
        save_json(PLACES_FILE, self.places)
        entry.set_text('')
        self._choose(len(self.places) - 1)

    # -- data -----------------------------------------------------------------------------------

    def _load(self, force=False):
        if not self.places:
            return
        p = self.places[self.index]
        self.service.fetch(p['lat'], p['lon'], force=force)
        self.next_hour = None
        self.radar.refresh()
        if hurricane_season(p['lat'], p['lon']):
            self._fetch_storms()
        else:
            self.storms = None
        if self.prefs.get('trips'):
            self._load_trips()

    def _refresh_tick(self):
        self._load()
        return GLib.SOURCE_CONTINUE

    def _on_failed(self, _svc, message):
        self._placeholder(_("Couldn't reach the weather service.") + '\n' + message)

    def _on_alerts(self, _svc, alerts):
        self.alerts = alerts
        if self.forecast:
            self._render()

    def _on_forecast(self, _svc, fc):
        p = self.places[self.index] if self.places else None
        if p and (abs(fc.lat - round(p['lat'], 2)) > 0.011 or abs(fc.lon - round(p['lon'], 2)) > 0.011):
            return  # a trip's forecast arriving; handled by its own request
        self.forecast = fc
        self.scrub = min(self.scrub, max(0, len(fc.next_hours(48)) - 1))
        self._render()

    def _on_radar_frames(self, _r):
        p = self.places[self.index] if self.places else None
        if p:
            self.radar.next_hour(p['lat'], p['lon'])
        if self.forecast:
            self._render()

    def _on_radar_image(self, _r, index):
        if self.radar_map:
            self.radar_map.queue_draw()

    def _on_next_hour(self, _r, steps):
        self.next_hour = steps
        if self.forecast:
            self._render()

    def _fetch_storms(self):
        msg = Soup.Message.new('GET', NHC_URL)
        self.service.session.send_and_read_async(msg, GLib.PRIORITY_DEFAULT, None, self._on_storms, None)

    def _on_storms(self, session, result, _ctx):
        try:
            data = json.loads(session.send_and_read_finish(result).get_data().decode())
        except (GLib.Error, ValueError):
            return
        self.storms = data.get('activeStorms', [])
        if self.forecast:
            self._render()

    def _load_trips(self):
        trips = calendar_trips()
        here = self.places[self.index]
        self.trips = []
        for when, loc, summary in trips:
            hit = find_city(loc)
            if not hit or distance_km(here['lat'], here['lon'], hit['lat'], hit['lon']) < 50:
                continue
            self.trips.append((when, hit, summary))
            key = (round(hit['lat'], 2), round(hit['lon'], 2))
            if key not in self.trip_forecasts:
                self._fetch_trip(key)

    def _fetch_trip(self, key):
        lat, lon = key
        cached = load_json(self.service._cache_path(lat, lon), None)
        if cached and cached.get('data'):
            self.trip_forecasts[key] = Forecast(cached['data'], lat, lon)
        msg = Soup.Message.new('GET', MET_URL.format(lat=lat, lon=lon))
        self.service.session.send_and_read_async(msg, GLib.PRIORITY_DEFAULT, None, self._on_trip, key)

    def _on_trip(self, session, result, key):
        try:
            data = json.loads(session.send_and_read_finish(result).get_data().decode())
        except (GLib.Error, ValueError):
            return
        save_json(self.service._cache_path(*key), {'data': data, 'expires': time.time() + REFRESH_SECONDS})
        self.trip_forecasts[key] = Forecast(data, *key)
        if self.forecast:
            self._render()

    # -- the selected hour: now, or wherever the scrubber is ----------------------------------------

    def _hours(self):
        return self.forecast.next_hours(48) if self.forecast else []

    def _selected(self):
        hours = self._hours()
        if not hours:
            return self.forecast.now() if self.forecast else None
        if self.scrub == 0:
            return self.forecast.now()
        return hours[min(self.scrub, len(hours) - 1)]

    def _select(self, i, from_scale=False):
        hours = self._hours()
        i = max(0, min(i, len(hours) - 1))
        if i == self.scrub:
            return
        self.scrub = i
        if not from_scale and getattr(self, 'scale', None):
            self.scale.set_value(i)
        self._update_selection()

    def _update_selection(self):
        h = self._selected()
        if not h:
            return
        self.sky.set_target(self._sky_for(h))
        self._fill_now(h)
        for i, col in enumerate(getattr(self, 'hour_cols', [])):
            (col.add_css_class if i == self.scrub else col.remove_css_class)('selected')
        self._scroll_to_hour()
        if getattr(self, 'chart', None):
            self.chart.queue_draw()

    def _scroll_to_hour(self):
        sc = getattr(self, 'hour_scroll', None)
        if not sc:
            return
        adj = sc.get_hadjustment()
        x = self.scrub * self.COL_W
        page = adj.get_page_size()
        if x < adj.get_value() or x + self.COL_W > adj.get_value() + page:
            adj.set_value(max(0, x - page / 2 + self.COL_W / 2))

    def _sky_for(self, h):
        st = sky_state_for(self.forecast, h)
        demo = os.environ.get('PARCHA_SKY_DEMO')  # tests: clear | rain | storm | snow | night | fog | dusk
        if demo and self.scrub == 0:
            presets = {
                'clear': dict(sun=45, day_fraction=0.45, clouds=0.1, rain=0, snow=False, fog=0, thunder=False),
                'rain': dict(sun=30, day_fraction=0.4, clouds=0.9, rain=2.5, snow=False, fog=0, thunder=False, wind=6, wind_from=250),
                'storm': dict(sun=20, day_fraction=0.6, clouds=1.0, rain=6, snow=False, fog=0, thunder=True, wind=12, wind_from=230),
                'snow': dict(sun=12, day_fraction=0.5, clouds=0.85, rain=1.2, snow=True, fog=0.15, thunder=False, wind=3),
                'night': dict(sun=-25, day_fraction=1, clouds=0.15, rain=0, snow=False, fog=0, thunder=False, moon=0.3),
                'fog': dict(sun=10, day_fraction=0.2, clouds=0.6, rain=0, snow=False, fog=0.8, thunder=False),
                'dusk': dict(sun=1.5, day_fraction=0.97, clouds=0.35, rain=0, snow=False, fog=0, thunder=False),
            }
            for k, v in presets.get(demo, {}).items():
                setattr(st, k, v)
        return st

    def _toggle_play(self, button):
        if self.playing:
            GLib.source_remove(self.playing)
            self.playing = 0
            button.set_icon_name('media-playback-start-symbolic')
            return
        button.set_icon_name('media-playback-pause-symbolic')
        start = 0 if self.scrub >= len(self._hours()) - 1 else self.scrub

        def step():
            nxt = self.scrub + 1
            if nxt >= min(len(self._hours()), start + 25):
                self.playing = 0
                button.set_icon_name('media-playback-start-symbolic')
                return GLib.SOURCE_REMOVE
            self._select(nxt)
            return GLib.SOURCE_CONTINUE
        # The next 24 hours in about 12 seconds.
        self.playing = GLib.timeout_add(480, step)

    # -- content --------------------------------------------------------------------------------

    def _clear(self):
        while (child := self.content.get_first_child()):
            self.content.remove(child)
        self.cards = []
        self.hour_cols = []
        self.chart = None
        self.scale = None
        self.radar_map = None

    def _placeholder(self, text):
        self._clear()
        lbl = Gtk.Label(label=text, wrap=True, justify=Gtk.Justification.CENTER, margin_top=160)
        lbl.add_css_class('sky-cond')
        self.content.append(lbl)

    def _card(self, title=None):
        card = Card(title)
        self.cards.append(card)
        return card

    def _label(self, text, *css, **kw):
        lbl = Gtk.Label(label=text, **kw)
        for c in css:
            lbl.add_css_class(c)
        return lbl

    def _render(self):
        fc = self.forecast
        if not fc or not fc.now():
            return
        imp = self.imperial
        self._clear()
        h = self._selected()
        self.sky.set_target(self._sky_for(h), instant=not getattr(self, '_rendered_once', False))
        self._rendered_once = True

        # Now (or the hour being looked at)
        self.now_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0, margin_top=4)
        self.content.append(self.now_box)
        self._fill_now(h)

        # Alerts
        for a in self.alerts[:3]:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.add_css_class('sky-alert')
            box.append(self._label('⚠ ' + a['event'], 'sky-cond', xalign=0, wrap=True))
            box.append(self._label(a['headline'], 'sky-small', xalign=0, wrap=True))
            self.content.append(box)

        # Heads-up: with Parchi on, Parchi tells it, next to the pose for the weather
        if self._parchi_on():
            card = self._card()
            row = Gtk.Box(spacing=16)
            self.parchita = Parchita(size=118, radius=14)
            self.parchita.set_valign(Gtk.Align.START)
            self.parchita.set_mood(self._parchi_mood(fc.now(), sun_elevation(fc.lat, fc.lon, datetime.now(timezone.utc))))
            self.parchita.set_tooltip_text(_('Parchi'))
            row.append(self.parchita)
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, hexpand=True, valign=Gtk.Align.CENTER)
            title = Gtk.Label(label=_('Heads-up').upper(), xalign=0)
            title.add_css_class('sky-card-title')
            body.append(title)
            body.append(self._label(self._summary(fc.now()), 'sky-mid', xalign=0, wrap=True))
            row.append(body)
            card.append(row)
            target = body
        else:
            self.parchita = None
            card = self._card(_('Heads-up'))
            target = card
        for icon, text in heads_up(fc, imp):
            row = Gtk.Box(spacing=10)
            row.append(Gtk.Image(icon_name=icon, pixel_size=18))
            row.append(self._label(text, 'sky-row-text', xalign=0, wrap=True, hexpand=True))
            target.append(row)
        # Heads-up and the next hour: full width in one column; at the top of the right-hand
        # column when wide, so no card stretches across the window with a few lines in it
        top = [card]
        nh = next_hour_text(self.next_hour)
        if nh:
            top.append(self._next_hour_card(nh))
        if not self.wide:
            for w in top:
                self.content.append(w)

        # Two columns when wide: forecasts on the left, the rest on the right.
        cols = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL if self.wide else Gtk.Orientation.VERTICAL,
                       spacing=14, homogeneous=False)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, hexpand=True)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, hexpand=True)
        if self.wide:
            left.set_size_request(620, -1)
            right.set_size_request(360, -1)
        cols.append(left)
        cols.append(right)
        self.content.append(cols)

        left.append(self._lens_bar())
        left.append(self._hourly_card(fc, imp))
        if self.radar.frames:
            left.append(self._radar_card(fc))
        left.append(self._days_card(fc, imp))

        if self.wide:
            for w in top:
                right.append(w)
        bw = self._best_card(fc, imp)
        if bw:
            right.append(bw)
        if self.storms is not None:
            right.append(self._tropics_card(fc, imp))
        trips = self._trips_card(imp)
        if trips:
            right.append(trips)
        right.append(self._details_flow(fc, h, imp))

        right.append(self._label(_('Weather data: MET Norway (CC BY 4.0). Alerts and storms: US National Weather Service '
                                   'and National Hurricane Center. Radar: LibreWXR (NOAA MRMS and other public radar '
                                   'networks, CC BY 4.0). Map: Natural Earth.'), 'sky-attrib', wrap=True, margin_top=6))
        self._update_coqui()
        if os.environ.get('PARCHA_SKY_SCROLL'):  # tests
            GLib.timeout_add(1200, lambda: self.scroller.get_vadjustment().set_value(float(os.environ['PARCHA_SKY_SCROLL'])) or False)

    def _fill_now(self, h):
        box = getattr(self, 'now_box', None)
        if not box:
            return
        while (child := box.get_first_child()):
            box.remove(child)
        fc, imp = self.forecast, self.imperial
        sun = sun_elevation(fc.lat, fc.lon, h['time'] if self.scrub else datetime.now(timezone.utc))
        night = sun < -2
        place = self.places[self.index]['name'] if self.places else ''
        _icon, cond, _thunder = symbol_info(h['symbol'], night)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER)
        text.append(self._label(place, 'sky-place'))
        if self.scrub:
            local = h['time'].astimezone()
            when = day_name(local, short=True).capitalize() + ' ' + fmt_hour(local)
            back = Gtk.Button(child=self._label(_('{when} · back to now').format(when=when), 'sky-when'),
                              halign=Gtk.Align.CENTER)
            back.add_css_class('flat')
            back.connect('clicked', lambda *_: self._select(0))
            text.append(back)
        text.append(self._label(fmt_temp(h['temp'], imp), 'sky-temp'))
        text.append(self._label(cond, 'sky-cond'))
        days = fc.days(10)
        today = days[0] if days else None
        fl = feels_like(h)
        bits = []
        if today and not self.scrub:
            bits.append(_('H:{high}  L:{low}').format(high=fmt_temp(today['hi'], imp), low=fmt_temp(today['lo'], imp)))
        if fl is not None and abs(fl - (h['temp'] or 0)) >= 1.5:
            bits.append(_('Feels like {temp}').format(temp=fmt_temp(fl, imp)))
        if bits:
            text.append(self._label('   '.join(bits), 'sky-cond', 'sky-dim'))
        box.append(text)
        if self._parchi_on():
            if getattr(self, 'parchita', None):
                self.parchita.set_mood(self._parchi_mood(h, sun))
        elif not self.scrub:
            box.append(self._label(self._summary(h),
                                   'sky-line', wrap=True, justify=Gtk.Justification.CENTER, margin_top=10))

    def _parchi_on(self):
        return self.prefs.get('playful', True) and self.prefs.get('parchita', True)

    def _parchi_mood(self, h, sun):
        when = h['time'] if self.scrub else datetime.now(timezone.utc)
        setting = sun_elevation(self.forecast.lat, self.forecast.lon, when + timedelta(minutes=30)) < sun
        return parchita_mood(h, sun, setting)

    def _summary(self, h):
        """The one-line story of the day (or of the next few minutes, when rain starts or stops)."""
        nh = next_hour_text(self.next_hour)
        line = summary_line(self.forecast, self.prefs.get('playful', True), fmt_temp(h['temp'], self.imperial))
        if nh and nh[0] in ('starts', 'stops'):
            line = nh[2] + '.'
        return line

    def _lens_bar(self):
        bar = Gtk.Box(spacing=2, halign=Gtk.Align.CENTER)
        bar.add_css_class('sky-lenses')
        first = None
        for key, icon, en in LENSES:
            content = Gtk.Box(spacing=6)
            content.append(Gtk.Image(icon_name=icon, pixel_size=14))
            content.append(Gtk.Label(label=_(en)))
            b = Gtk.ToggleButton(child=content, active=(key == self.lens))
            if first:
                b.set_group(first)
            else:
                first = b
            b.connect('toggled', self._on_lens, key)
