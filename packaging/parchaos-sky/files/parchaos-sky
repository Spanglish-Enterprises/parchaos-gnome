LENSES = [('temp', 'temperature-symbolic', N_('Temperature')),
          ('rain', 'weather-showers-symbolic', N_('Rain')),
          ('wind', 'weather-windy-symbolic', N_('Wind')),
          ('comfort', 'weather-few-clouds-symbolic', N_('Comfort'))]

ARROWS = ['↓', '↙', '←', '↖', '↑', '↗', '→', '↘']  # where the wind blows *to*, from its "from" direction


def fmt_temp(c, imperial):
    if c is None:
        return '–'
    return f'{round(c * 9 / 5 + 32)}°' if imperial else f'{round(c)}°'


def fmt_wind(ms, imperial):
    return f'{round(ms * 2.23694)} mph' if imperial else f'{round(ms * 3.6)} km/h'


def fmt_rain(mm, imperial):
    return f'{mm / 25.4:.2f} in' if imperial else f'{mm:.1f} mm'


def compass(deg):
    names = [_('N'), _('NE'), _('E'), _('SE'), _('S'), _('SW'), _('W'), _('NW')]
    return names[int((deg % 360) / 45 + 0.5) % 8]


def arrow(deg_from):
    return ARROWS[int((deg_from % 360) / 45 + 0.5) % 8]


def fmt_hour(dt):
    if uses_imperial():
        return dt.strftime('%-I %p') if dt.minute == 0 else dt.strftime('%-I:%M %p')
    return dt.strftime('%H:%M')


