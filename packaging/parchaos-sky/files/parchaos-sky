def rgba(r, g, b, a=1.0):
    c = Gdk.RGBA()
    c.red, c.green, c.blue, c.alpha = r, g, b, a
    return c


def mix(c1, c2, t):
    t = max(0.0, min(1.0, t))
    return tuple(a + (b - a) * t for a, b in zip(c1, c2))


def stops(*pairs):
    out = []
    for offset, col in pairs:
        s = Gsk.ColorStop()
        s.offset = offset
        s.color = rgba(*col)
        out.append(s)
    return out


def rect(x, y, w, h):
    return Graphene.Rect().init(x, y, w, h)


def point(x, y):
    return Graphene.Point().init(x, y)


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f)
    os.replace(tmp, path)


def uses_imperial():
    # Fahrenheit and mph where people expect them.
    loc = (os.environ.get('LC_MEASUREMENT') or os.environ.get('LC_ALL') or os.environ.get('LANG') or '')
    return any(loc.startswith(p) for p in ('en_US', 'es_US', 'en_LR', 'my_MM'))


def spanish():
    lang = os.environ.get('LANGUAGE') or os.environ.get('LC_MESSAGES') or os.environ.get('LANG') or ''
    return lang.startswith('es')


# ---------------------------------------------------------------------------------------------
# The sun: height above the horizon, sunrise and sunset (NOAA's simplified algorithm)
# ---------------------------------------------------------------------------------------------

def _sun_params(when):
    day = when.timetuple().tm_yday
    hour = when.hour + when.minute / 60 + when.second / 3600
    g = 2 * math.pi / 365 * (day - 1 + (hour - 12) / 24)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                       - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    return eqtime, decl


def sun_elevation(lat, lon, when_utc):
    eqtime, decl = _sun_params(when_utc)
    minutes = when_utc.hour * 60 + when_utc.minute + when_utc.second / 60
    tst = minutes + eqtime + 4 * lon
    ha = math.radians(tst / 4 - 180)
    la = math.radians(lat)
    cos_zen = math.sin(la) * math.sin(decl) + math.cos(la) * math.cos(decl) * math.cos(ha)
    return 90 - math.degrees(math.acos(max(-1.0, min(1.0, cos_zen))))


def sun_times(lat, lon, day_utc):
    """Sunrise and sunset (UTC datetimes) for the date of day_utc, or None in polar day/night."""
    noon = day_utc.replace(hour=12, minute=0, second=0, microsecond=0)
    eqtime, decl = _sun_params(noon)
    la = math.radians(lat)
    cos_ha = (math.cos(math.radians(90.833)) / (math.cos(la) * math.cos(decl))
              - math.tan(la) * math.tan(decl))
    if cos_ha < -1 or cos_ha > 1:
        return None
    ha = math.degrees(math.acos(cos_ha))
    base = noon.replace(hour=0)
    rise = base + timedelta(minutes=720 - 4 * (lon + ha) - eqtime)
    sset = base + timedelta(minutes=720 - 4 * (lon - ha) - eqtime)
    return rise, sset


def moon_phase(when_utc):
    """0 = new, 0.5 = full."""
    known_new = datetime(2000, 1, 6, 18, 14, tzinfo=timezone.utc)
    days = (when_utc - known_new).total_seconds() / 86400
    return (days % 29.530588853) / 29.530588853


