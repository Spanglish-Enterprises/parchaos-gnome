def _fruit(cr, cx, cy, r, face_clear=True):
    import cairo
    # rind
    g = cairo.RadialGradient(cx - r * 0.3, cy - r * 0.35, r * 0.1, cx, cy, r * 1.05)
    g.add_color_stop_rgb(0, *RIND_LIGHT)
    g.add_color_stop_rgb(1, *RIND)
    cr.set_source(g)
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.fill()
    # pink inner rim
    _rgb(cr, RIM)
    cr.arc(cx, cy, r * 0.84, 0, 2 * math.pi)
    cr.fill()
    # pulp
    p = r * 0.77
    g = cairo.RadialGradient(cx, cy, p * 0.1, cx, cy, p)
    g.add_color_stop_rgb(0, *PULP_IN)
    g.add_color_stop_rgb(1, *PULP_OUT)
    cr.set_source(g)
    cr.arc(cx, cy, p, 0, 2 * math.pi)
    cr.fill()
    # seeds in their sacs, pointing to the middle
    for a, rr, size in _seeds():
        x, y = cx + math.cos(a) * rr * p, cy + math.sin(a) * rr * p
        if face_clear and (abs(y - (cy - r * 0.06)) < r * 0.26 and abs(abs(x - cx) - r * 0.34) < r * 0.24
                           or abs(y - (cy + r * 0.34)) < r * 0.14 and abs(x - cx) < r * 0.28):
            continue
        _rgb(cr, SAC, 0.75)
        _ellipse(cr, x, y, p * 0.105 * size, p * 0.165 * size, a + math.pi / 2)
        cr.fill()
        _rgb(cr, SEED)
        _ellipse(cr, x, y, p * 0.05 * size, p * 0.095 * size, a + math.pi / 2)
        cr.fill()
    # soft shine
    cr.set_source_rgba(1, 1, 1, 0.12)
    _ellipse(cr, cx - p * 0.35, cy - p * 0.45, p * 0.35, p * 0.18, -0.5)
    cr.fill()


def draw_parchi(cr, w, h, pose='happy', t=0.0, animate=True):
    """pose: happy, neutral, sunny, rain, cloudy, storm, snow, windy, night, hot, cold, sad, surprised."""
    import cairo
    s = min(w / 120, h / 130)
    cr.save()
    cr.translate((w - 120 * s) / 2, (h - 130 * s) / 2)
    cr.scale(s, s)
    bob = math.sin(t * 2.2) * 2 if animate else 0
    lean = 0.0
    if pose == 'windy':
        lean = -0.12 + (math.sin(t * 5) * 0.03 if animate else 0)
    cx, cy, r = 60, 60 + bob, 41
    expr = {'sunny': 'sunny', 'hot': 'sunny', 'rain': 'happy', 'cloudy': 'happy', 'storm': 'storm',
            'snow': 'happy', 'cold': 'happy', 'windy': 'windy', 'night': 'sleepy'}.get(pose, pose)

    # shadow
    if pose != 'cloudy':
        cr.set_source_rgba(0, 0, 0, 0.18)
        _ellipse(cr, 60, 122, 30, 5)
        cr.fill()

    cr.save()
    cr.translate(cx, cy + r)
    cr.rotate(lean)
    cr.translate(-cx, -(cy + r))

    cloud_front = pose == 'cloudy'
    # legs and feet
    if pose != 'cloudy':
        for sx in (-1, 1):
            _limb(cr, cx + sx * 13, cy + r - 6, cx + sx * 14, 116, 10)
            foot = (0.98, 0.82, 0.18) if pose == 'rain' else ((0.85, 0.25, 0.25) if pose in ('snow', 'cold') else LIMB)
            _rgb(cr, foot)
            _ellipse(cr, cx + sx * 17, 119, 10 if pose == 'rain' else 9, 5.5)
            cr.fill()
    else:
        pass
    # raincoat behind the fruit (hood and coat)
    if pose == 'rain':
        _rgb(cr, (0.98, 0.80, 0.16))
        cr.arc(cx, cy, r * 1.14, 0, 2 * math.pi)  # hood
        cr.fill()
        cr.move_to(cx - r * 0.75, cy + r * 0.6)  # coat
        cr.curve_to(cx - r * 1.05, cy + r * 1.0, cx - r * 1.1, cy + r * 1.25, cx - r * 1.0, cy + r * 1.32)
        cr.line_to(cx + r * 1.0, cy + r * 1.32)
        cr.curve_to(cx + r * 1.1, cy + r * 1.25, cx + r * 1.05, cy + r * 1.0, cx + r * 0.75, cy + r * 0.6)
        cr.close_path()
        cr.fill()
        _rgb(cr, (0.85, 0.66, 0.10))
        cr.set_line_width(1.5)
        cr.move_to(cx, cy + r * 0.95)
        cr.line_to(cx, cy + r * 1.32)
        cr.stroke()
    # arms
    wave = math.sin(t * 4) * 0.15 if animate else 0
    if pose in ('happy', 'neutral'):
        _limb(cr, cx - r * 0.95, cy + 8, cx - r * 1.22, cy + 20, 9)
        _limb(cr, cx + r * 0.95, cy + 4, cx + r * 1.27 + wave * 10, cy - 12, 9)
        _rgb(cr, LIMB)
        cr.arc(cx + r * 1.3 + wave * 10, cy - 15, 6, 0, 2 * math.pi)
        cr.fill()
    elif pose in ('sunny', 'hot'):
        _limb(cr, cx - r * 0.95, cy + 10, cx - r * 1.25, cy + 24, 9)
        _limb(cr, cx + r * 0.95, cy + 8, cx + r * 1.3, cy + 2, 9)
        # a drink with a straw and a little umbrella
        dx, dy = cx + r * 1.38, cy - 6
        _rgb(cr, (0.62, 0.38, 0.18))
        cr.rectangle(dx - 5, dy, 10, 13)
        cr.fill()
        _rgb(cr, (0.6, 0.85, 0.35))
        cr.rectangle(dx - 5, dy, 10, 3)
        cr.fill()
        cr.set_line_width(1.4)
        _rgb(cr, (0.95, 0.4, 0.4))
        cr.move_to(dx + 2, dy)
        cr.line_to(dx + 6, dy - 10)
        cr.stroke()
        _rgb(cr, (0.2, 0.75, 0.75))
        cr.move_to(dx - 4, dy - 6)
        cr.curve_to(dx - 2, dy - 13, dx + 6, dy - 13, dx + 8, dy - 6)
        cr.close_path()
        cr.fill()
    elif pose == 'storm':
        _limb(cr, cx - r * 0.9, cy + 6, cx - r * 0.35, cy + 22, 9)
        _limb(cr, cx + r * 0.9, cy + 6, cx + r * 0.35, cy + 22, 9)
    elif pose == 'windy':
        _limb(cr, cx - r * 0.9, cy + 8, cx - r * 1.25, cy + 2, 9)
