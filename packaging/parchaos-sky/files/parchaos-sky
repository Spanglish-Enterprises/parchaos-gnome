def _seeds():
    global _SEEDS
    if _SEEDS is None:
        rnd = random.Random(5)
        out = []
        for ring, count, rad in ((0, 6, 0.26), (1, 11, 0.53), (2, 15, 0.79)):
            for k in range(count):
                a = (k + rnd.random() * 0.4) / count * 2 * math.pi + ring * 0.3
                r = rad + rnd.uniform(-0.04, 0.04)
                out.append((a, r, 0.85 + rnd.random() * 0.3))
