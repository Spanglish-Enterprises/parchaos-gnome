def _ellipse(cr, x, y, rx, ry, angle=0.0):
    cr.save()
    cr.translate(x, y)
    cr.rotate(angle)
    cr.scale(rx, ry)
    cr.arc(0, 0, 1, 0, 2 * math.pi)
    cr.restore()


def _rgb(cr, c, a=1.0):
    cr.set_source_rgba(c[0], c[1], c[2], a)


def _limb(cr, x0, y0, x1, y1, width, colour=LIMB):
    cr.set_line_cap(1)
    cr.set_line_width(width)
    _rgb(cr, colour)
    cr.move_to(x0, y0)
    cr.line_to(x1, y1)
    cr.stroke()


def _cloud(cr, cx, cy, s, alpha=1.0):
    import cairo
    for dx, dy, r in ((-0.55, 0.1, 0.42), (-0.15, -0.18, 0.5), (0.35, -0.05, 0.45), (0.7, 0.18, 0.32), (0.05, 0.22, 0.45)):
        g = cairo.RadialGradient(cx + dx * s, cy + dy * s - r * s * 0.3, 0, cx + dx * s, cy + dy * s, r * s)
        g.add_color_stop_rgba(0, 1, 1, 1, alpha)
        g.add_color_stop_rgba(1, 0.86, 0.89, 0.94, alpha)
        cr.set_source(g)
        cr.arc(cx + dx * s, cy + dy * s, r * s, 0, 2 * math.pi)
        cr.fill()


def _face(cr, cx, cy, r, expr, glasses=False):
    ey = cy - r * 0.06
    ex = r * 0.34
    er = r * 0.22
    if glasses:
        _rgb(cr, (0.08, 0.08, 0.1))
        for sx in (-1, 1):
            _ellipse(cr, cx + sx * ex, ey, er * 1.35, er * 1.0)
            cr.fill()
        cr.set_line_width(r * 0.05)
        cr.move_to(cx - ex + er, ey - er * 0.3)
        cr.line_to(cx + ex - er, ey - er * 0.3)
        cr.stroke()
        cr.set_source_rgba(1, 1, 1, 0.35)
        for sx in (-1, 1):
            _ellipse(cr, cx + sx * ex - er * 0.5, ey - er * 0.4, er * 0.35, er * 0.2, -0.4)
            cr.fill()
    else:
        for sx in (-1, 1):
            x = cx + sx * ex
