# Coquí nights: Puerto Rico's tree frogs on warm, humid nights (synthesised here, no recordings)
# ---------------------------------------------------------------------------------------------

def in_puerto_rico(lat, lon):
    return 17.8 <= lat <= 18.6 and -67.35 <= lon <= -65.2


def coqui_wav():
    """A 24-second loop of a few coquís at different distances, written once to the cache."""
    path = os.path.join(CACHE_DIR, 'coqui-night.wav')
    if os.path.exists(path):
        return path
    import struct
    import wave
    rate, seconds = 22050, 24
    buf = [0.0] * (rate * seconds)
    rnd = random.Random(11)
    frogs = [(0.55, 1.0), (0.3, 0.93), (0.18, 1.06), (0.12, 0.97)]  # (volume, pitch)
    for vol, pitch in frogs:
        t = rnd.uniform(0, 2)
        while t < seconds - 1:
            # "co": a short flat note; "quí": a rising whistle
            for start, dur, f0, f1, amp in ((t, 0.09, 1150, 1150, 1.0), (t + 0.12, 0.16, 1900, 2250, 0.85)):
                n0, n = int(start * rate), int(dur * rate)
                phase = 0.0
                for k in range(n):
                    if n0 + k >= len(buf):
                        break
                    f = (f0 + (f1 - f0) * k / n) * pitch
                    phase += 2 * math.pi * f / rate
                    env = math.sin(math.pi * k / n) ** 0.6
                    buf[n0 + k] += vol * amp * env * (math.sin(phase) + 0.18 * math.sin(2 * phase))
            t += rnd.uniform(1.6, 4.2)
    peak = max(1e-6, max(abs(x) for x in buf))
    os.makedirs(CACHE_DIR, exist_ok=True)
    with wave.open(path, 'wb') as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(b''.join(struct.pack('<h', int(x / peak * 0.6 * 32767)) for x in buf))
    return path


