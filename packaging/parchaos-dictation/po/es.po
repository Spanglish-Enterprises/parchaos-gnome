#: extension.js:106
msgid ""
"Setting up dictation once (about 200 MB). Press the shortcut again when it "
"says it is ready."
msgstr "Preparando el dictado por única vez (unos 200 MB). Oprime el atajo otra vez cuando diga que está listo."

#: extension.js:113
msgid "Ready. Press the shortcut and speak."
msgstr "Listo. Oprime el atajo y habla."

#: extension.js:113
msgid "Setup did not finish. Check your connection and try again."
msgstr "La preparación no terminó. Revisa tu conexión e inténtalo otra vez."