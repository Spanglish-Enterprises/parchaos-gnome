DOMAIN = 'parchaos-automations'
gettext.bindtextdomain(DOMAIN, os.environ.get('PARCHAOS_LOCALEDIR', '/usr/share/locale'))
gettext.textdomain(DOMAIN)
_ = gettext.gettext


def N_(s):
    return s


APP_ID = 'org.parchaos.Automations'
HOME = os.path.expanduser('~')
CONFIG = os.environ.get('PARCHAOS_AUTOMATIONS_DIR') or os.path.join(
    os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config'), 'parchaos', 'automations')
STATE = os.environ.get('PARCHAOS_AUTOMATIONS_STATE') or os.path.join(
    os.environ.get('XDG_STATE_HOME') or os.path.join(HOME, '.local', 'state'), 'parchaos', 'automations.json')

DAYS = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']
DAY_NAMES = [N_('Mon'), N_('Tue'), N_('Wed'), N_('Thu'), N_('Fri'), N_('Sat'), N_('Sun')]
DAYS_PLURAL = [N_('Mondays'), N_('Tuesdays'), N_('Wednesdays'), N_('Thursdays'), N_('Fridays'), N_('Saturdays'),
               N_('Sundays')]
TRIGGERS = ['time', 'display', 'network', 'app', 'folder']
ACTIONS = ['open', 'focus', 'appearance', 'setting', 'command', 'move', 'rename']
LASTING = {'display', 'network', 'app'}       # plus time with Until
FOCUS_MODES = ['work', 'personal', 'sleep', 'dnd', 'off']
TRIGGER_KEYS = {
    'time': ('At', 'Until', 'Days', 'Undo'), 'display': ('Match', 'Label', 'Ignore', 'Undo'),
    'network': ('Name', 'Undo'), 'app': ('App', 'Exec', 'Label', 'Undo'), 'folder': ('Folder', 'Pattern'),
}
ACTION_KEYS = {
    'open': ('Target', 'Label'), 'focus': ('Mode',), 'appearance': ('Style',),
    'setting': ('Schema', 'Key', 'Value'), 'command': ('Command', 'PassFile'),
    'move': ('From', 'Pattern', 'To', 'OlderThan'), 'rename': ('Name',),
}
CATCH_UP = datetime.timedelta(days=7)
SHELL_SCREENSHOTS = 'Screenshots'      # translated by GNOME Shell's own catalogue, not ours
PARTIAL = ('.part', '.crdownload', '.download', '.tmp', '.partial', '~')


# --- Files ---------------------------------------------------------------------------------

def parser():
    p = configparser.ConfigParser(interpolation=None, strict=False)
    p.optionxform = str           # keep the keys' capitals
    return p


def load(path):
    """An automation from its file: {id, path, name, enabled, trigger, actions}, or None."""
    p = parser()
    try:
        if not p.read(path, encoding='utf-8'):
            return None
    except configparser.Error:
        return None
    if not p.has_section('Trigger'):
        return None
    head = p['Automation'] if p.has_section('Automation') else {}
    actions = []
    names = sorted((s for s in p.sections() if re.fullmatch(r'Action( \d+)?', s)),
                   key=lambda s: int(s.split()[1]) if ' ' in s else 1)
    for s in names:
        actions.append(dict(p[s]))
    return {
        'id': os.path.splitext(os.path.basename(path))[0],
        'path': path,
        'name': head.get('Name', '') or os.path.splitext(os.path.basename(path))[0],
        'enabled': str(head.get('Enabled', 'true')).lower() not in ('false', '0', 'no', 'off'),
        'trigger': dict(p['Trigger']),
        'actions': actions,
    }


def load_all(folder=None):
    folder = folder or CONFIG
    out = []
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return out
    for name in names:
        if name.endswith('.ini') and not name.startswith('.'):
            a = load(os.path.join(folder, name))
            if a:
                out.append(a)
    return out


def dump(automation):
    """The file text for an automation."""
    lines = ['[Automation]', f"Name={automation['name']}",
             f"Enabled={'true' if automation.get('enabled', True) else 'false'}", '', '[Trigger]']
    lines += [f'{k}={v}' for k, v in automation['trigger'].items() if v != '']
    for i, action in enumerate(automation['actions'], 1):
        lines += ['', '[Action]' if i == 1 else f'[Action {i}]']
        lines += [f'{k}={v}' for k, v in action.items() if v != '']
    return '\n'.join(lines) + '\n'


def tidy(automation):
    """Drops the keys a trigger or action of another kind left behind (the editor switches kinds)."""
    t = automation['trigger']
    automation['trigger'] = {'Kind': t.get('Kind', '')} | {
        k: t[k] for k in TRIGGER_KEYS.get(t.get('Kind'), ()) if k in t and t[k] != ''}
    automation['actions'] = [{'Kind': a.get('Kind', '')} | {
        k: a[k] for k in ACTION_KEYS.get(a.get('Kind'), ()) if k in a and a[k] != ''} for a in automation['actions']]
    return automation


def slug(name):
    s = re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
    return s[:48] or 'automation'


def save(automation, folder=None):
    """Writes the automation; a new one gets a file named after it. Returns the path."""
    folder = folder or CONFIG
    os.makedirs(folder, exist_ok=True)
    path = automation.get('path')
    if not path:
        base = slug(automation['name'])
        path = os.path.join(folder, base + '.ini')
        n = 2
        while os.path.exists(path):
            path = os.path.join(folder, f'{base}-{n}.ini')
            n += 1
    tmp = path + '.new'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(dump(automation))
    os.replace(tmp, path)
    automation['path'] = path
    automation['id'] = os.path.splitext(os.path.basename(path))[0]
    return path


def read_state():
    try:
        with open(STATE, encoding='utf-8') as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + '.new'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(state, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


# --- Time ----------------------------------------------------------------------------------

def parse_hhmm(text):
    m = re.fullmatch(r'\s*(\d{1,2})[:.](\d{2})\s*', text or '')
    if not m:
        return None
    h, mi = int(m[1]), int(m[2])
    return (h, mi) if h < 24 and mi < 60 else None


def days_of(trigger):
    raw = (trigger.get('Days') or '').strip().lower()
    if not raw or raw in ('every day', 'daily', 'all'):
        return set(range(7))
    out = set()
    for part in re.split(r'[,\s]+', raw):
        if part[:3] in DAYS:
            out.add(DAYS.index(part[:3]))
    return out or set(range(7))


def occurrences(trigger, start, end, key='At'):
    """Every At (or Until) time of `trigger` in [start, end), oldest first."""
    hm = parse_hhmm(trigger.get(key))
    if not hm:
        return []
    days = days_of(trigger)
    out = []
    day = start.date() - datetime.timedelta(days=1)
    while day <= end.date():
        t = datetime.datetime.combine(day, datetime.time(*hm))
        if day.weekday() in days and start <= t < end:
            out.append(t)
        day += datetime.timedelta(days=1)
    return out


def next_time(trigger, now, key='At'):
    found = occurrences(trigger, now + datetime.timedelta(seconds=1), now + datetime.timedelta(days=8), key)
    return found[0] if found else None


def last_time(trigger, now, key='At'):
    found = occurrences(trigger, now - datetime.timedelta(days=8), now + datetime.timedelta(seconds=1), key)
    return found[-1] if found else None


def time_active(trigger, now):
    """For a time with Until: whether now is inside one of its periods (past midnight is fine)."""
    start = last_time(trigger, now)
    until = parse_hhmm(trigger.get('Until'))
    if start is None or until is None:
        return False
    end = datetime.datetime.combine(start.date(), datetime.time(*until))
    if end <= start:
        end += datetime.timedelta(days=1)
    return start <= now < end


def missed(trigger, now, last_seen):
    """For a time without Until: the run that came due while nothing was watching, or None."""
    if not last_seen:
        return None
    due = last_time(trigger, now)
    if due and last_seen < due <= now and now - due <= CATCH_UP:
        return due
    return None


# --- Matching ------------------------------------------------------------------------------

def display_matches(trigger, monitor):
    """monitor: {connector, vendor, product, serial, name, builtin}."""
    if monitor.get('builtin'):
        return False
    ignore = {s.strip() for s in (trigger.get('Ignore') or '').split(',') if s.strip()}
    if monitor_key(monitor) in ignore or monitor.get('connector') in ignore:
        return False
    want = (trigger.get('Match') or '').strip().lower()
    if not want:
        return True
    hay = ' '.join(str(monitor.get(k, '')) for k in ('connector', 'vendor', 'product', 'name')).lower()
    return want in hay


def monitor_key(monitor):
    return f"{monitor.get('vendor', '')}:{monitor.get('product', '')}:{monitor.get('serial', '')}"


def network_matches(trigger, active_names):
    want = (trigger.get('Name') or '').strip()
    return bool(want) and want in active_names


def app_matches(trigger, processes):
    """processes: list of (comm, argv) of running processes."""
    exe = (trigger.get('Exec') or '').strip()
    app = (trigger.get('App') or '').strip()
    flat = app[:-8] if app.endswith('.desktop') else app
    for comm, argv in processes:
        if exe and (os.path.basename(argv[0]) == exe if argv else False):
            return True
        if exe and comm == exe[:15]:
            return True
        if flat and argv and os.path.basename(argv[0]) in ('flatpak', 'bwrap') and flat in argv:
            return True
    return False


def file_matches(trigger, name):
    if name.startswith('.') or name.endswith(PARTIAL):
        return False
    pattern = (trigger.get('Pattern') or '*').strip() or '*'
    return any(fnmatch.fnmatch(name.lower(), p.strip().lower()) for p in pattern.split(';') if p.strip())


# --- Paths ---------------------------------------------------------------------------------

def expand(path):
    path = os.path.expanduser((path or '').strip())
    if path.startswith('xdg:'):            # xdg:PICTURES/Screenshots
        what, _sep, rest = path[4:].partition('/')
        base = xdg_dir(what) or HOME
        path = os.path.join(base, rest)
    return path


def xdg_dir(what):
    try:
        from gi.repository import GLib
    except ImportError:
        return None
    kinds = {'DESKTOP': GLib.UserDirectory.DIRECTORY_DESKTOP, 'DOCUMENTS': GLib.UserDirectory.DIRECTORY_DOCUMENTS,
             'DOWNLOAD': GLib.UserDirectory.DIRECTORY_DOWNLOAD, 'MUSIC': GLib.UserDirectory.DIRECTORY_MUSIC,
             'PICTURES': GLib.UserDirectory.DIRECTORY_PICTURES, 'VIDEOS': GLib.UserDirectory.DIRECTORY_VIDEOS}
    return GLib.get_user_special_dir(kinds[what]) if what in kinds else None


def fill(template, path, when):
    """{name} {ext} {year} {month} {day} {date} in a file or folder name."""
    stem, ext = os.path.splitext(os.path.basename(path)) if path else ('', '')
    try:
        mtime = datetime.datetime.fromtimestamp(os.path.getmtime(path)) if path else when
    except OSError:
        mtime = when
    values = {'name': stem, 'ext': ext.lstrip('.'), 'year': f'{mtime:%Y}', 'month': f'{mtime:%m}',
              'day': f'{mtime:%d}', 'date': f'{mtime:%Y-%m-%d}', 'today': f'{when:%Y-%m-%d}'}
    return re.sub(r'\{(\w+)\}', lambda m: values.get(m[1], m[0]), template)


def free_path(path):
    """`path`, or `name 2.ext`, `name 3.ext`... when it is taken."""
    if not os.path.lexists(path):
        return path
    stem, ext = os.path.splitext(path)
    n = 2
    while os.path.lexists(f'{stem} {n}{ext}'):
        n += 1
    return f'{stem} {n}{ext}'


def move_files(action, files, when):
    """Moves `files` (or, with none, the matching files in From) into To. Returns how many."""
    to = expand(action.get('To'))
    if not to:
        raise ValueError(_('No destination folder'))
    if not files:
        src = expand(action.get('From'))
        if not src or not os.path.isdir(src):
            return 0
        older = action.get('OlderThan', '').strip()
        cutoff = when - datetime.timedelta(days=int(older)) if older.isdigit() else None
        files = []
        for name in sorted(os.listdir(src)):
            path = os.path.join(src, name)
            if not os.path.isfile(path) or not file_matches(action, name):
                continue
            if cutoff and datetime.datetime.fromtimestamp(os.path.getmtime(path)) > cutoff:
                continue
            files.append(path)
    moved = 0
    for path in files:
        folder = fill(to, path, when)
        if os.path.abspath(folder) == os.path.abspath(os.path.dirname(path)):
            continue
        os.makedirs(folder, exist_ok=True)
        shutil.move(path, free_path(os.path.join(folder, os.path.basename(path))))
        moved += 1
    return moved


def rename_file(action, path, when):
    pattern = (action.get('Name') or '').strip()
    if not pattern or not path:
        return None
    new = fill(pattern, path, when).replace('/', '-').strip()
    if not new:
        return None
    stem, ext = os.path.splitext(path)
    if not os.path.splitext(new)[1] and ext:
        new += ext
    target = os.path.join(os.path.dirname(path), new)
    if target == path:
        return path
    target = free_path(target)
    os.rename(path, target)
    return target


# --- Words ---------------------------------------------------------------------------------

def days_text(trigger):
    days = days_of(trigger)
    if days == set(range(7)):
        return _('every day')
    if days == set(range(5)):
        return _('on weekdays')
    if days == {5, 6}:
        return _('at weekends')
    if len(days) == 1:
        return _('on {days}').format(days=_(DAYS_PLURAL[min(days)]))
    return _('on {days}').format(days=', '.join(_(DAY_NAMES[d]) for d in sorted(days)))


def and_list(items):
    if len(items) < 2:
        return ''.join(items)
    return _('{list} and {last}').format(list=', '.join(items[:-1]), last=items[-1])


def files_text(pattern):
    """'*.png;*.jpg' -> 'PNG and JPG files'; anything else as written."""
    parts = [p.strip() for p in (pattern or '*').split(';') if p.strip()]
    if all(re.fullmatch(r'\*\.\w+', p) for p in parts):
        return _('{kinds} files').format(kinds=and_list([p[2:].upper() for p in parts]))
    if parts in ([], ['*']):
        return _('files')
    return _('files like {pattern}').format(pattern=and_list(parts))


def folder_text(path):
    if re.search(r'\{year\}.*\{month\}|\{month\}', path or ''):
        return _('into a folder for each month')
    if '{year}' in (path or ''):
        return _('into a folder for each year')
    return _('to {folder}').format(folder=short_path(path))


def describe_trigger(t):
    kind = t.get('Kind', '')
    if kind == 'time':
        if t.get('Until'):
            return _('From {at} to {until} {days}').format(at=t.get('At', '?'), until=t['Until'], days=days_text(t))
        return _('At {at} {days}').format(at=t.get('At', '?'), days=days_text(t))
    if kind == 'display':
        if t.get('Match'):
            return _('While “{name}” is connected').format(name=t.get('Label') or t['Match'])
        return _('While a display I don’t usually use is connected')
    if kind == 'network':
        return _('While connected to “{name}”').format(name=t.get('Name', '?'))
    if kind == 'app':
        return _('While {app} is open').format(app=t.get('Label') or t.get('App') or t.get('Exec', '?'))
    if kind == 'folder':
        return _('When a file appears in {folder}').format(folder=short_path(t.get('Folder', '?')))
    return _('Unknown trigger')


def describe_action(a):
    kind = a.get('Kind', '')
    if kind == 'open':
        return _('Open {what}').format(what=a.get('Label') or a.get('Target', '?'))
    if kind == 'focus':
        mode = a.get('Mode', '')
        return {'work': _('Turn on Work Focus'), 'personal': _('Turn on Personal Focus'),
                'sleep': _('Turn on Sleep Focus'), 'dnd': _('Turn on Do Not Disturb'),
                'off': _('Turn Focus off')}.get(mode, _('Focus'))
    if kind == 'appearance':
        return _('Switch to dark mode') if a.get('Style') == 'dark' else _('Switch to light mode')
    if kind == 'setting':
        return _('Set {key} to {value}').format(key=a.get('Key', '?'), value=a.get('Value', '?'))
    if kind == 'command':
        return _('Run “{command}”').format(command=a.get('Command', '?'))
    if kind == 'move':
        if a.get('From'):
            return _('Move {files} from {src} {dst}').format(
                files=files_text(a.get('Pattern')), src=short_path(a['From']), dst=folder_text(a.get('To')))
        return _('Move it {dst}').format(dst=folder_text(a.get('To')))
    if kind == 'rename':
        return _('Rename it to {name}').format(name=a.get('Name', '?'))
    return _('Unknown action')


def short_path(path):
    path = path or ''
    if path.startswith('xdg:'):
        return path[4:].replace('PICTURES', _('Pictures')).replace('DOWNLOAD', _('Downloads')).replace(
            'DOCUMENTS', _('Documents')).replace('DESKTOP', _('Desktop'))
    if path.startswith(HOME):
        path = '~' + path[len(HOME):]
    return path


def lasting(trigger):
    return trigger.get('Kind') in LASTING or (trigger.get('Kind') == 'time' and bool(parse_hhmm(trigger.get('Until'))))


def undo_wanted(automation):
    return lasting(automation['trigger']) and str(automation['trigger'].get('Undo', 'true')).lower() != 'false'


# --- Templates -----------------------------------------------------------------------------

def screenshots_folder():
    """Where GNOME saves screenshots: Pictures/<"Screenshots" in GNOME Shell's language>."""
    return 'xdg:PICTURES/' + gettext.dgettext('gnome-shell', SHELL_SCREENSHOTS)


def templates(current_displays=()):
    """The ready-made automations the window offers."""
    shots = screenshots_folder()
    return [
        {'name': _('Work Focus on weekdays'), 'enabled': True,
         'trigger': {'Kind': 'time', 'At': '09:00', 'Until': '17:00', 'Days': 'mon,tue,wed,thu,fri'},
         'actions': [{'Kind': 'focus', 'Mode': 'work'}]},
        {'name': _('Tidy screenshots every week'), 'enabled': True,
         'trigger': {'Kind': 'time', 'At': '17:00', 'Days': 'fri'},
         'actions': [{'Kind': 'move', 'From': shots, 'Pattern': '*.png;*.jpg;*.webm;*.mp4',
                      'To': shots + '/{year}-{month}', 'OlderThan': '1'}]},
        {'name': _('Dark mode with a projector'), 'enabled': True,
         'trigger': {'Kind': 'display', 'Ignore': ','.join(monitor_key(m) for m in current_displays if not m.get('builtin'))},
         'actions': [{'Kind': 'appearance', 'Style': 'dark'}]},
    ]


# --- Running actions -----------------------------------------------------------------------

class Runner:
    """Runs actions and undoes them. Needs GLib/Gio (imported lazily so the tests need none)."""

    def __init__(self):
        from gi.repository import Gio
        self.Gio = Gio
        self._settings = {}

    def settings(self, schema):
        if schema not in self._settings:
            source = self.Gio.SettingsSchemaSource.get_default()
            if source.lookup(schema, True) is None:
                raise ValueError(_('Unknown settings group {schema}').format(schema=schema))
            self._settings[schema] = self.Gio.Settings.new(schema)
        return self._settings[schema]

    def set_value(self, schema, key, text):
        """Sets a key from its text form; returns (before, after) as text, for undoing."""
        from gi.repository import GLib
        s = self.settings(schema)
        if not s.props.settings_schema.has_key(key):
            raise ValueError(_('Unknown setting {key}').format(key=key))
        vtype = s.props.settings_schema.get_key(key).get_value_type()
        try:
            value = GLib.Variant.parse(vtype, text, None, None)
        except GLib.Error:
            value = GLib.Variant.parse(vtype, GLib.Variant('s', text).print_(False), None, None)
        before = s.get_value(key).print_(False)
        s.set_value(key, value)
        return before, value.print_(False)

    def run(self, action, files=(), when=None):
        """Runs one action. Returns an undo record or None."""
        when = when or datetime.datetime.now()
        kind = action.get('Kind')
        if kind == 'open':
            target = (action.get('Target') or '').strip()
            if target.endswith('.desktop'):
                info = self.Gio.DesktopAppInfo.new(target)
                if info is None:
                    raise ValueError(_('No app {app}').format(app=target))
                info.launch([self.Gio.File.new_for_path(f) for f in files], None)
            elif target:
                uri = target if re.match(r'^[a-z][a-z0-9+.-]*:', target) else self.Gio.File.new_for_path(expand(target)).get_uri()
                self.Gio.AppInfo.launch_default_for_uri(uri, None)
            return None
        if kind == 'focus':
            mode = action.get('Mode', 'off')
            records = []
            if mode == 'dnd':
                records.append(['org.gnome.desktop.notifications', 'show-banners', *self.set_value('org.gnome.desktop.notifications', 'show-banners', 'false')])
            else:
                value = '' if mode == 'off' else mode
                records.append(['org.parchaos.desktop', 'focus-mode', *self.set_value('org.parchaos.desktop', 'focus-mode', f"'{value}'")])
            return records
        if kind == 'appearance':
            style = "'prefer-dark'" if action.get('Style') == 'dark' else "'default'"
            return [['org.gnome.desktop.interface', 'color-scheme', *self.set_value('org.gnome.desktop.interface', 'color-scheme', style)]]
        if kind == 'setting':
            return [[action.get('Schema', ''), action.get('Key', ''),
                     *self.set_value(action.get('Schema', ''), action.get('Key', ''), action.get('Value', ''))]]
        if kind == 'command':
            argv = shlex.split(action.get('Command', ''))
            if not argv:
                raise ValueError(_('No command'))
            env = dict(os.environ)
            if files:
                env['PARCHAOS_FILE'] = files[0]
            subprocess.Popen(argv + list(files) if action.get('PassFile', 'false') == 'true' else argv,
                             env=env, cwd=HOME, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return None
        if kind == 'move':
            move_files(action, list(files), when)
            return None
        if kind == 'rename':
            for f in files:
                rename_file(action, f, when)
            return None
        raise ValueError(_('Unknown action'))

    def undo(self, records):
        """Puts each value back, unless it was changed again since (then the newer choice stays)."""
        for schema, key, before, after in records or []:
            try:
                s = self.settings(schema)
                if s.get_value(key).print_(False) == after:
                    self.set_value(schema, key, before)
            except (ValueError, Exception) as e:   # noqa: B014 - a broken record must not stop the rest
                print(f'parchaos-automations: could not undo {schema} {key}: {e}', file=sys.stderr)


