def running_processes():
    out = []
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/comm', encoding='utf-8', errors='replace') as f:
                comm = f.read().strip()
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                argv = [a.decode('utf-8', 'replace') for a in f.read().split(b'\0') if a]
        except OSError:
            continue
        out.append((comm, argv))
    return out


def active_networks():
    try:
        out = subprocess.run(['nmcli', '-t', '-f', 'NAME', 'connection', 'show', '--active'],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return set()
    return {line.replace('\\:', ':') for line in out.splitlines() if line and line != 'lo'}


def current_displays(bus=None):
    """The connected displays from Mutter: [{connector, vendor, product, serial, name, builtin}]."""
    from gi.repository import Gio, GLib
    try:
        bus = bus or Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply = bus.call_sync('org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
                              'org.gnome.Mutter.DisplayConfig', 'GetCurrentState', None, None,
                              Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error:
        return []
    _serial, monitors, _logical, _props = reply.unpack()
    out = []
    for (connector, vendor, product, serial), _modes, props in monitors:
        out.append({'connector': connector, 'vendor': vendor, 'product': product, 'serial': serial,
                    'name': props.get('display-name', product), 'builtin': bool(props.get('is-builtin', False))})
    return out


class Service:
    def __init__(self):
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.runner = Runner()
        self.state = read_state()
        self.automations = []
        self.timers = []
        self.folder_monitors = []
        self.poll_id = 0
        self.reload_id = 0
        self.fresh = {}            # folder -> set of names created but not finished writing
        self.ours = set()          # paths the actions just made, not new files to act on
        self.displays = []
        self.networks = set()
        self.processes = []

        os.makedirs(CONFIG, exist_ok=True)
        self.dir_monitor = Gio.File.new_for_path(CONFIG).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.dir_monitor.connect('changed', lambda *_a: self.queue_reload())

        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.bus.signal_subscribe('org.gnome.Mutter.DisplayConfig', 'org.gnome.Mutter.DisplayConfig',
                                  'MonitorsChanged', '/org/gnome/Mutter/DisplayConfig', None,
                                  Gio.DBusSignalFlags.NONE, lambda *_a: self.on_displays())
        self.netmon = Gio.NetworkMonitor.get_default()
        self.netmon.connect('network-changed', lambda *_a: GLib.timeout_add_seconds(2, self.on_networks))
        try:
            system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            system.signal_subscribe('org.freedesktop.login1', 'org.freedesktop.login1.Manager', 'PrepareForSleep',
                                    '/org/freedesktop/login1', None, Gio.DBusSignalFlags.NONE, self.on_sleep)
        except GLib.Error as e:
            print(f'parchaos-automations: not watching for resume: {e.message}', file=sys.stderr)
        self.reload()

    # Bookkeeping

    def entry(self, automation):
        return self.state.setdefault(automation['id'], {})

    def save_state(self):
        try:
            write_state(self.state)
        except OSError as e:
            print(f'parchaos-automations: could not save state: {e}', file=sys.stderr)

    def queue_reload(self):
        if self.reload_id:
            self.GLib.source_remove(self.reload_id)
        self.reload_id = self.GLib.timeout_add(400, self.reload)

    def reload(self):
        self.reload_id = 0
        for t in self.timers:
            self.GLib.source_remove(t)
        self.timers = []
        for m in self.folder_monitors:
            m.cancel()
        self.folder_monitors = []
        if self.poll_id:
            self.GLib.source_remove(self.poll_id)
            self.poll_id = 0

        self.automations = load_all()
        live = {a['id'] for a in self.automations if a['enabled']}
        # Removed or switched off while it was on: undo it, forget it.
        for key in list(self.state):
            if key not in live and self.state[key].get('active'):
                self.runner.undo(self.state[key].get('undo'))
                self.state[key]['active'] = False
                self.state[key]['undo'] = None
            if key not in {a['id'] for a in self.automations}:
                del self.state[key]

        kinds = {a['trigger'].get('Kind') for a in self.automations if a['enabled']}
        self.displays = current_displays(self.bus) if 'display' in kinds else []
        self.networks = active_networks() if 'network' in kinds else set()
        if 'app' in kinds:
            self.processes = running_processes()
            self.poll_id = self.GLib.timeout_add_seconds(3, self.on_poll)
        for a in self.automations:
            if a['enabled'] and a['trigger'].get('Kind') == 'folder':
                self.watch_folder(a)
        self.check_all(catch_up=True)
        self.schedule()
        self.save_state()
        return self.GLib.SOURCE_REMOVE

    # Deciding

    def condition(self, a, now):
        t = a['trigger']
        kind = t.get('Kind')
        if kind == 'time':
            return time_active(t, now) if lasting(t) else None
        if kind == 'display':
            return any(display_matches(t, m) for m in self.displays)
        if kind == 'network':
            return network_matches(t, self.networks)
        if kind == 'app':
            return app_matches(t, self.processes)
        return None

    def check_all(self, catch_up=False):
        now = datetime.datetime.now()
        for a in self.automations:
            if not a['enabled']:
                continue
            st = self.entry(a)
            on = self.condition(a, now)
            if on is None:
                t = a['trigger']
                if t.get('Kind') == 'time' and catch_up:
                    last = st.get('seen')
                    due = missed(t, now, datetime.datetime.fromisoformat(last) if last else None)
                    if due:
                        self.fire(a, note=_('late, the computer was off at {time}').format(time=f'{due:%H:%M}'))
                st['seen'] = now.isoformat(timespec='seconds')
                continue
            if on and not st.get('active'):
                st['active'] = True
                st['undo'] = self.fire(a)
            elif not on and st.get('active'):
                st['active'] = False
                if undo_wanted(a):
                    self.runner.undo(st.get('undo'))
                st['undo'] = None
        self.save_state()

    def fire(self, a, files=(), note=None):
        """Runs every action of `a`; returns the undo records."""
        st = self.entry(a)
        records, errors = [], []
        for action in a['actions']:
            try:
                r = self.runner.run(action, files)
                if r:
                    records += r
            except Exception as e:      # noqa: BLE001 - one failing action must not stop the rest
                errors.append(f"{describe_action(action)}: {e}")
        st['last_run'] = datetime.datetime.now().isoformat(timespec='seconds')
        st['last_error'] = '; '.join(errors) or None
        print(f"parchaos-automations: ran “{a['name']}”" + (f' ({note})' if note else '')
              + (f" with errors: {st['last_error']}" if errors else ''), file=sys.stderr)
        if errors:
            self.notify(a, st['last_error'])
        self.save_state()
        return records

    def notify(self, a, text):
        try:
            self.bus.call_sync('org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                               'org.freedesktop.Notifications', 'Notify',
                               self.GLib.Variant('(susssasa{sv}i)', (
                                   _('Automations'), 0, 'preferences-system-time-symbolic',
                                   _('“{name}” did not finish').format(name=a['name']), text, [],
                                   {'desktop-entry': self.GLib.Variant('s', APP_ID)}, -1)),
                               None, self.Gio.DBusCallFlags.NONE, 5000, None)
        except self.GLib.Error:
            pass

    # Clocks

    def schedule(self):
        now = datetime.datetime.now()
        soonest = None
        for a in self.automations:
            t = a['trigger']
            if not a['enabled'] or t.get('Kind') != 'time':
                continue
            for key in ('At', 'Until') if lasting(t) else ('At',):
                n = next_time(t, now, key)
                if n and (soonest is None or n < soonest):
                    soonest = n
        if soonest:
            seconds = max(1, int((soonest - now).total_seconds()) + 1)
            self.timers.append(self.GLib.timeout_add_seconds(seconds, self.on_clock))

    def on_clock(self):
        self.timers = []
        now = datetime.datetime.now()
        for a in self.automations:
            t = a['trigger']
            if a['enabled'] and t.get('Kind') == 'time' and not lasting(t):
                due = last_time(t, now)
                if due and now - due < datetime.timedelta(minutes=2):
                    st = self.entry(a)
                    if st.get('last_run', '') < due.isoformat(timespec='seconds'):
                        self.fire(a)
        self.check_all()
        self.schedule()
        return self.GLib.SOURCE_REMOVE

    def on_sleep(self, _c, _s, _p, _i, _sig, params):
        going, = params.unpack()
        if not going:
            self.GLib.timeout_add_seconds(5, lambda: (self.reload(), False)[1])

    # The world

    def on_displays(self):
        self.displays = current_displays(self.bus)
        self.check_all()

    def on_networks(self):
        self.networks = active_networks()
        self.check_all()
        return self.GLib.SOURCE_REMOVE

    def on_poll(self):
        self.processes = running_processes()
        self.check_all()
        return self.GLib.SOURCE_CONTINUE

    def watch_folder(self, a):
        Gio = self.Gio
        folder = expand(a['trigger'].get('Folder'))
        if not folder or not os.path.isdir(folder):
            print(f"parchaos-automations: “{a['name']}”: no folder {folder}", file=sys.stderr)
            return
        mon = Gio.File.new_for_path(folder).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        fresh = self.fresh.setdefault(folder, set())

        def changed(_m, file, other, event):
            E = Gio.FileMonitorEvent
            if event == E.MOVED_IN:
                self.new_file(a, file.get_path())
            elif event == E.RENAMED and other is not None:
                # A download finishing ("x.pdf.part" -> "x.pdf") is a new file; the user
                # renaming one already there is not.
                if not file_matches(a['trigger'], file.get_basename()):
                    self.new_file(a, other.get_path())
            elif event == E.CREATED:
                fresh.add(file.get_path())
            elif event == E.CHANGES_DONE_HINT and file.get_path() in fresh:
                fresh.discard(file.get_path())
                self.new_file(a, file.get_path())
        mon.connect('changed', changed)
        self.folder_monitors.append(mon)

    def new_file(self, a, path):
        if not path or path in self.ours or not os.path.isfile(path):
            return
        if file_matches(a['trigger'], os.path.basename(path)):
            folder = os.path.dirname(path)
            before = set(os.listdir(folder))
            self.fire(a, files=[path])
            # What the actions put in the folder is not a new file to act on again.
            try:
                made = {os.path.join(folder, n) for n in set(os.listdir(folder)) - before}
            except OSError:
                made = set()
            self.ours |= made
            self.GLib.timeout_add_seconds(10, lambda: (self.ours.difference_update(made), False)[1])


