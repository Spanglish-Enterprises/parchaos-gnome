def run_app(argv):
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    class Editor(Adw.Dialog):
        """One automation: its name, what starts it, and what it does."""

        def __init__(self, window, automation):
            super().__init__(title=_('Edit Automation') if automation.get('path') else _('New Automation'),
                             content_width=560, content_height=640)
            self.window = window
            self.a = json.loads(json.dumps(automation))
            if not self.a['actions']:
                self.a['actions'] = [{'Kind': 'open'}]
            view = Adw.ToolbarView()
            header = Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False)
            cancel = Gtk.Button(label=_('Cancel'))
            cancel.connect('clicked', lambda *_a: self.close())
            header.pack_start(cancel)
            self.save_button = Gtk.Button(label=_('Save'), css_classes=['suggested-action'])
            self.save_button.connect('clicked', self.on_save)
            header.pack_end(self.save_button)
            view.add_top_bar(header)
            self.page = Adw.PreferencesPage()
            view.set_content(self.page)
            self.set_child(view)

            top = Adw.PreferencesGroup()
            self.name = Adw.EntryRow(title=_('Name'), text=self.a.get('name', ''))
            self.name.connect('changed', lambda *_a: self.validate())
            top.add(self.name)
            self.page.add(top)
            self.trigger_group = Adw.PreferencesGroup(title=_('When'))
            self.page.add(self.trigger_group)
            self.action_group = Adw.PreferencesGroup(title=_('Do'))
            self.page.add(self.action_group)
            self.trigger_rows = []
            self.action_rows = []
            self.build_trigger()
            self.build_action()

        # Helpers that read and write the dict as the rows change.
        def entry(self, group, rows, title, data, key, placeholder=''):
            row = Adw.EntryRow(title=title, text=data.get(key, ''))
            if placeholder and not data.get(key):
                row.set_tooltip_text(placeholder)
            row.connect('changed', lambda r: (data.__setitem__(key, r.get_text().strip()), self.validate()))
            group.add(row)
            rows.append(row)
            return row

        def combo(self, group, rows, title, data, key, choices, on_change=None):
            """choices: [(value, label)]."""
            model = Gtk.StringList.new([label for _v, label in choices])
            row = Adw.ComboRow(title=title, model=model, enable_search=len(choices) > 12)
            values = [v for v, _l in choices]
            current = data.get(key, values[0] if values else '')
            if current in values:
                row.set_selected(values.index(current))
            elif values:
                data[key] = values[0]

            def picked(r, _p):
                i = r.get_selected()
                if 0 <= i < len(values):
                    data[key] = values[i]
                    if on_change:
                        on_change()
                    self.validate()
            row.connect('notify::selected', picked)
            group.add(row)
            rows.append(row)
            return row

        def folder(self, group, rows, title, data, key):
            row = Adw.ActionRow(title=title, subtitle=short_path(data.get(key, '')) or _('Not chosen'))
            button = Gtk.Button(icon_name='folder-open-symbolic', valign=Gtk.Align.CENTER,
                                css_classes=['flat'], tooltip_text=_('Choose Folder'))

            def choose(*_a):
                dialog = Gtk.FileDialog(title=title)
                start = expand(data.get(key, '')) if data.get(key) and '{' not in data.get(key, '') else HOME
                if os.path.isdir(start):
                    dialog.set_initial_folder(Gio.File.new_for_path(start))

                def done(d, res):
                    try:
                        f = d.select_folder_finish(res)
                    except GLib.Error:
                        return
                    data[key] = f.get_path()
                    row.set_subtitle(short_path(data[key]))
                    self.validate()
                dialog.select_folder(self.window, None, done)
            button.connect('clicked', choose)
            row.add_suffix(button)
            row.set_activatable_widget(button)
            group.add(row)
            rows.append(row)
            return row

        def clear(self, group, rows):
            for r in rows:
                group.remove(r)
            rows.clear()

        def build_trigger(self):
            g, rows, t = self.trigger_group, self.trigger_rows, self.a['trigger']
            self.clear(g, rows)
            self.combo(g, rows, _('Starts'), t, 'Kind', [
                ('time', _('At a time')), ('display', _('A display connects')),
                ('network', _('Joining a network')), ('app', _('An app opens')),
                ('folder', _('A new file in a folder'))], self.build_trigger)
            kind = t.get('Kind')
            if kind == 'time':
                self.entry(g, rows, _('At (HH:MM)'), t, 'At')
                self.entry(g, rows, _('Until (HH:MM, optional; then it is undone)'), t, 'Until')
                row = Adw.ActionRow(title=_('Days'))
                box = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
                chosen = days_of(t)
                buttons = []

                def toggled(*_a):
                    t['Days'] = ','.join(DAYS[i] for i, b in enumerate(buttons) if b.get_active())
                    self.validate()
                for i, name in enumerate(DAY_NAMES):
                    b = Gtk.ToggleButton(label=_(name)[:2], active=i in chosen, css_classes=['circular', 'day'])
                    b.connect('toggled', toggled)
                    buttons.append(b)
                    box.append(b)
                row.add_suffix(box)
                g.add(row)
                rows.append(row)
            elif kind == 'display':
                displays = [m for m in current_displays() if not m.get('builtin')]
                choices = [('', _('Any display I don’t usually use'))]
                choices += [(monitor_key(m), m['name']) for m in displays]
                if t.get('Match') and t['Match'] not in [c[0] for c in choices]:
                    choices.append((t['Match'], t.get('Label') or t['Match']))

                def chose_display():
                    match = t.get('Match', '')
                    if match:
                        t['Label'] = next((m['name'] for m in displays if monitor_key(m) == match), t.get('Label', ''))
                        t.pop('Ignore', None)
                    else:
                        t.pop('Label', None)
                        t['Ignore'] = ','.join(monitor_key(m) for m in displays)
                self.combo(g, rows, _('Display'), t, 'Match', choices, chose_display)
                chose_display()
                if not t.get('Match'):
                    hint = Adw.ActionRow(subtitle=_('The displays connected now count as your usual ones.'))
                    g.add(hint)
                    rows.append(hint)
            elif kind == 'network':
                names = sorted(active_networks())
                if names and not t.get('Name'):
                    t['Name'] = names[0]
                self.entry(g, rows, _('Network name'), t, 'Name')
            elif kind == 'app':
                apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id()),
                              key=lambda a: a.get_display_name().lower())

                def chose_app():
                    info = next((a for a in apps if a.get_id() == t.get('App')), None)
                    if info:
                        t['Label'] = info.get_display_name()
                        exe = os.path.basename(info.get_executable() or '')
                        t['Exec'] = '' if exe in ('flatpak', 'env', 'sh', 'bash') else exe
                self.combo(g, rows, _('App'), t, 'App', [(a.get_id(), a.get_display_name()) for a in apps], chose_app)
                chose_app()
            elif kind == 'folder':
                self.folder(g, rows, _('Folder'), t, 'Folder')
                self.entry(g, rows, _('Only files like (e.g. *.pdf)'), t, 'Pattern')
            if lasting(t):
                sw = Adw.SwitchRow(title=_('Undo when it ends'),
                                   subtitle=_('Put back what the actions changed'),
                                   active=str(t.get('Undo', 'true')).lower() != 'false')
                sw.connect('notify::active', lambda r, _p: t.__setitem__('Undo', 'true' if r.get_active() else 'false'))
                g.add(sw)
                rows.append(sw)
            self.build_action()

        def build_action(self):
            g, rows = self.action_group, self.action_rows
            if not hasattr(self, 'name'):
                return
            self.clear(g, rows)
            a = self.a['actions'][0]
            file_trigger = self.a['trigger'].get('Kind') == 'folder'
            kinds = [('open', _('Open an app or file')), ('focus', _('Change Focus')),
                     ('appearance', _('Light or dark mode')), ('setting', _('Change a setting')),
                     ('command', _('Run a command')), ('move', _('Move files'))]
            if file_trigger:
                kinds.append(('rename', _('Rename the file')))
            self.combo(g, rows, _('Action'), a, 'Kind', kinds, self.build_action)
            kind = a.get('Kind')
            if kind == 'open':
                apps = sorted((x for x in Gio.AppInfo.get_all() if x.should_show() and x.get_id()),
                              key=lambda x: x.get_display_name().lower())

                def chose():
                    info = next((x for x in apps if x.get_id() == a.get('Target')), None)
                    if info:
                        a['Label'] = info.get_display_name()
                self.combo(g, rows, _('App'), a, 'Target', [(x.get_id(), x.get_display_name()) for x in apps], chose)
                chose()
            elif kind == 'focus':
                self.combo(g, rows, _('Focus'), a, 'Mode', [
                    ('work', _('Work')), ('personal', _('Personal')), ('sleep', _('Sleep')),
                    ('dnd', _('Do Not Disturb')), ('off', _('Off'))])
            elif kind == 'appearance':
                self.combo(g, rows, _('Style'), a, 'Style', [('dark', _('Dark')), ('light', _('Light'))])
            elif kind == 'setting':
                self.entry(g, rows, _('Settings group (e.g. org.gnome.desktop.interface)'), a, 'Schema')
                self.entry(g, rows, _('Key'), a, 'Key')
                self.entry(g, rows, _('Value'), a, 'Value')
            elif kind == 'command':
                self.entry(g, rows, _('Command'), a, 'Command')
            elif kind == 'move':
                if not file_trigger:
                    self.folder(g, rows, _('From'), a, 'From')
                    self.entry(g, rows, _('Only files like (e.g. *.png)'), a, 'Pattern')
                self.folder(g, rows, _('To'), a, 'To')
                hint = Adw.ActionRow(subtitle=_('In names, {year}, {month} and {date} are filled in from the file.'))
                g.add(hint)
                rows.append(hint)
            elif kind == 'rename':
                self.entry(g, rows, _('New name, e.g. {date} {name}'), a, 'Name')
            self.validate()

        def problem(self):
            t, a = self.a['trigger'], self.a['actions'][0]
            if not self.name.get_text().strip():
                return _('Give it a name')
            kind = t.get('Kind')
            if kind == 'time':
                if not parse_hhmm(t.get('At')):
                    return _('Write the time as HH:MM')
                if t.get('Until') and not parse_hhmm(t['Until']):
                    return _('Write the time as HH:MM')
                if not t.get('Days'):
                    return _('Choose at least one day')
            if kind == 'network' and not t.get('Name'):
                return _('Write the network name')
            if kind == 'folder' and not t.get('Folder'):
                return _('Choose a folder')
            k = a.get('Kind')
            if k == 'setting' and not (a.get('Schema') and a.get('Key')):
                return _('Write the settings group and key')
            if k == 'command' and not a.get('Command', '').strip():
                return _('Write the command')
            if k == 'move' and not a.get('To'):
                return _('Choose where to move them')
            if k == 'rename' and not a.get('Name'):
                return _('Write the new name')
            return None

        def validate(self):
            if hasattr(self, 'save_button'):
                p = self.problem()
                self.save_button.set_sensitive(p is None)
                self.save_button.set_tooltip_text(p)

        def on_save(self, *_a):
            if self.problem():
                return
            self.a['name'] = self.name.get_text().strip()
            save(tidy(self.a))
            self.close()
            self.window.refresh()

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=_('Automations'), default_width=640, default_height=560)
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            header = Adw.HeaderBar()
            add = Gtk.MenuButton(icon_name='list-add-symbolic', tooltip_text=_('New Automation'))
            menu = Gio.Menu()
            for i, tpl in enumerate(templates()):
                menu.append(tpl['name'], f'win.template({i})')
            blank = Gio.Menu()
            blank.append(_('Start from Scratch…'), 'win.blank')
            menu.append_section(None, blank)
            add.set_menu_model(menu)
            header.pack_start(add)
            view.add_top_bar(header)
            self.banner = Adw.Banner(title=_('Automations are not running'), button_label=_('Start'))
            self.banner.connect('button-clicked', self.start_service)
            view.add_top_bar(self.banner)
            self.stack = Gtk.Stack()
            self.empty = Adw.StatusPage(icon_name='preferences-system-time-symbolic', title=_('No Automations'),
                                        description=_('Let the computer do things for you: turn on Focus at a '
                                                      'time, tidy a folder, change the look when a display '
                                                      'connects. Start with + above.'))
            self.stack.add_named(self.empty, 'empty')
            self.page = Adw.PreferencesPage()
            self.group = Adw.PreferencesGroup()
            self.page.add(self.group)
            self.stack.add_named(self.page, 'list')
            view.set_content(self.stack)
            self.toasts.set_child(view)
            self.set_content(self.toasts)
            self.rows = []

            t = Gio.SimpleAction.new('template', GLib.VariantType('i'))
            t.connect('activate', lambda _a, v: self.from_template(v.get_int32()))
            self.add_action(t)
            b = Gio.SimpleAction.new('blank', None)
            b.connect('activate', lambda *_a: Editor(self, {
                'name': '', 'enabled': True, 'trigger': {'Kind': 'time', 'At': '09:00', 'Days': ''},
                'actions': [{'Kind': 'open'}]}).present(self))
            self.add_action(b)

            os.makedirs(CONFIG, exist_ok=True)
            self.monitor = Gio.File.new_for_path(CONFIG).monitor_directory(Gio.FileMonitorFlags.NONE, None)
            self.monitor.connect('changed', lambda *_a: self.queue_refresh())
            self.refresh_id = 0
            self.refresh()
            GLib.timeout_add_seconds(5, lambda: (self.check_service(), True)[1])

        def queue_refresh(self):
            if self.refresh_id:
                GLib.source_remove(self.refresh_id)
            self.refresh_id = GLib.timeout_add(300, lambda: (self.refresh(), False)[1])

        def check_service(self):
            try:
                r = subprocess.run(['systemctl', '--user', 'is-active', 'parchaos-automations.service'],
                                   capture_output=True, text=True, timeout=5)
                running = r.stdout.strip() == 'active'
            except (OSError, subprocess.TimeoutExpired):
                running = True
            self.banner.set_revealed(not running and bool(self.rows))

        def start_service(self, *_a):
            subprocess.run(['systemctl', '--user', 'enable', '--now', 'parchaos-automations.service'],
                           capture_output=True, timeout=15)
            self.check_service()

        def from_template(self, i):
            tpl = templates(current_displays())[i]
            Editor(self, tpl).present(self)

        def refresh(self):
            self.refresh_id = 0
            for r in self.rows:
                self.group.remove(r)
            self.rows = []
            state = read_state()
            items = load_all()
            for a in items:
                self.group.add(self.row(a, state.get(a['id'], {})))
            self.stack.set_visible_child_name('list' if items else 'empty')
            self.check_service()

        def row(self, a, st):
            subtitle = describe_trigger(a['trigger']) + ' → ' + ', '.join(describe_action(x) for x in a['actions'])
            if st.get('last_error'):
                subtitle += '\n' + _('Last time: {error}').format(error=st['last_error'])
            elif st.get('active'):
                subtitle += '\n' + _('On now')
            elif st.get('last_run'):
                when = datetime.datetime.fromisoformat(st['last_run'])
                subtitle += '\n' + _('Last ran {when}').format(when=f'{when:%a %d %b, %H:%M}')
            row = Adw.ActionRow(title=GLib.markup_escape_text(a['name']), subtitle=GLib.markup_escape_text(subtitle),
                                subtitle_lines=3, activatable=True)
            row.connect('activated', lambda *_x: Editor(self, a).present(self))
            sw = Gtk.Switch(active=a['enabled'], valign=Gtk.Align.CENTER, tooltip_text=_('On or off'))

            def flip(s, _p):
                a['enabled'] = s.get_active()
                save(a)
            sw.connect('notify::active', flip)
            more = Gtk.MenuButton(icon_name='view-more-symbolic', valign=Gtk.Align.CENTER, css_classes=['flat'],
                                  tooltip_text=_('More'))
            pop = Gtk.Popover()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            for label, cb in ((_('Run Now'), lambda: self.run_now(a)), (_('Edit…'), lambda: Editor(self, a).present(self)),
                              (_('Delete'), lambda: self.delete(a))):
                b = Gtk.Button(label=label, css_classes=['flat'])
                b.get_child().set_halign(Gtk.Align.START)
                b.connect('clicked', lambda _b, cb=cb: (pop.popdown(), cb()))
                box.append(b)
            pop.set_child(box)
            more.set_popover(pop)
            row.add_suffix(sw)
            row.add_suffix(more)
            self.rows.append(row)
            return row

        def run_now(self, a):
            try:
                subprocess.Popen([sys.argv[0], '--run', a['path']], start_new_session=True)
                self.toasts.add_toast(Adw.Toast(title=_('Ran “{name}”').format(name=a['name'])))
            except OSError as e:
                self.toasts.add_toast(Adw.Toast(title=str(e)))

        def delete(self, a):
            try:
                os.remove(a['path'])
            except OSError:
                return
            toast = Adw.Toast(title=_('“{name}” deleted').format(name=a['name']), button_label=_('Undo'))
            toast.connect('button-clicked', lambda *_x: (a.pop('path', None), save(a), self.refresh()))
            self.toasts.add_toast(toast)
            self.refresh()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

        def do_startup(self):
            Adw.Application.do_startup(self)
            css = Gtk.CssProvider()
            css.load_from_string('.day:checked { background: var(--accent-bg-color); color: var(--accent-fg-color); }')
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def do_activate(self):
            win = self.props.active_window or Window(self)
            win.present()
            if len(argv) > 2 and argv[1] == '--edit':
                a = load(argv[2])
                if a:
                    Editor(win, a).present(win)
            elif len(argv) > 1 and argv[1] == '--new':
                win.activate_action('blank', None)

    return App().run(argv[:1])


def run_once(path):
    a = load(path)
    if not a:
        print(f'parchaos-automations: cannot read {path}', file=sys.stderr)
        return 1
    runner = Runner()
    status = 0
    for action in a['actions']:
        try:
            runner.run(action)
        except Exception as e:     # noqa: BLE001
            print(f'parchaos-automations: {describe_action(action)}: {e}', file=sys.stderr)
            status = 1
    return status


def main(argv):
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    if len(argv) > 1 and argv[1] == '--service':
        from gi.repository import GLib
        Service()
        GLib.MainLoop().run()
        return 0
    if len(argv) > 2 and argv[1] == '--run':
        return run_once(argv[2])
    return run_app(argv)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
