# Parcha Automations (ticket #186): "when this happens, do that".
#
#   parchaos-automations            the window: the list, switches, templates, the editor
#   parchaos-automations --service  the part that watches and runs them (a systemd --user
#                                   service for the whole session)
#   parchaos-automations --run FILE run one automation's actions now
#   parchaos-automations --edit FILE / --new   the window with the editor open
#
# Each automation is a plain file in ~/.config/parchaos/automations/, one per file:
#
#   [Automation]
#   Name=Work Focus on weekday mornings
#   Enabled=true
#
#   [Trigger]
#   Kind=time            time | display | network | app | folder
#   At=09:00
#   Until=17:00          optional: while it lasts, then the actions are undone
#   Days=mon,tue,wed,thu,fri
#
#   [Action]             more as [Action 2], [Action 3]...
#   Kind=focus           open | focus | appearance | setting | command | move | rename
#   Mode=work
#
# Triggers that last (a display or a network while connected, an app while open, a time
# with Until) undo what their actions changed when they end (Undo=false keeps it), and only
# when the value is still the one they set: a change the user made meanwhile stays.
# A time without Until that passed while the computer was off or asleep runs once when it is
# back, if it is less than a week late.
#
