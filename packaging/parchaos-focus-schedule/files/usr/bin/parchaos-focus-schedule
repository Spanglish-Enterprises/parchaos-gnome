#!/usr/bin/python3
# parchaos-focus-schedule: scheduled Do Not Disturb.
#
# Runs for the whole session (a systemd --user service). Every time the
# state could have changed -- at login, at each start/end time, after the
# computer wakes from sleep, and when the schedule is edited -- it works
# out from the clock whether focus time is on now and applies that. Fixed
# timers couldn't: a timer missed while the computer was off either never
# ran (Do Not Disturb stuck on all day) or ran late in the wrong order.
#
# Settings (org.parchaos.desktop, edited in ParchaOS Settings):
#   focus-schedule  on/off
#   focus-start     "HH:MM", e.g. "22:00"
#   focus-end       "HH:MM", e.g. "08:00" (past midnight is fine)
#
# Do Not Disturb is GNOME's own switch (org.gnome.desktop.notifications
# show-banners). This service only turns off what it turned on: if the
# user already had Do Not Disturb on when focus time began, it's left on
# at the end. The marker file records that it's this service's doing.
#
# Original code for ParchaOS, GPL-3.0-or-later.

import os
import sys

import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib  # noqa: E402

MARKER = os.path.join(GLib.get_user_cache_dir(), 'parchaos-focus-active')
DESKTOP_SCHEMA = 'org.parchaos.desktop'


def minutes(hhmm):
    """'22:00' -> 1320; None if malformed."""
    try:
        h, m = hhmm.strip().split(':')
        h, m = int(h), int(m)
    except ValueError:
        return None
    if 0 <= h < 24 and 0 <= m < 60:
        return h * 60 + m
    return None


def in_window(now, start, end):
    if start == end:
        return False
    if start < end:
        return start <= now < end
    return now >= start or now < end      # runs past midnight


class FocusSchedule:
    def __init__(self):
        source = Gio.SettingsSchemaSource.get_default()
        if source.lookup(DESKTOP_SCHEMA, True) is None:
            print(f'{DESKTOP_SCHEMA} schema not installed; nothing to do', file=sys.stderr)
            sys.exit(0)
        self.settings = Gio.Settings.new(DESKTOP_SCHEMA)
        self.notifications = Gio.Settings.new('org.gnome.desktop.notifications')
        self.timeout_id = 0
        for key in ('focus-schedule', 'focus-start', 'focus-end'):
            self.settings.connect(f'changed::{key}', lambda *_: self.sync())
        # Waking from sleep: logind announces PrepareForSleep(false).
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            bus.signal_subscribe('org.freedesktop.login1', 'org.freedesktop.login1.Manager',
                                 'PrepareForSleep', '/org/freedesktop/login1', None,
                                 Gio.DBusSignalFlags.NONE, self.on_sleep)
        except GLib.Error as e:
            print(f'not watching for resume: {e.message}', file=sys.stderr)
        self.sync()

    def on_sleep(self, _conn, _sender, _path, _iface, _signal, params):
        going_to_sleep, = params.unpack()
        if not going_to_sleep:
            # Give the clock a moment to settle after resume.
            GLib.timeout_add_seconds(5, lambda: (self.sync(), False)[1])

    def sync(self):
        if self.timeout_id:
            GLib.source_remove(self.timeout_id)
            self.timeout_id = 0
        start = minutes(self.settings.get_string('focus-start'))
        end = minutes(self.settings.get_string('focus-end'))
        enabled = self.settings.get_boolean('focus-schedule') and start is not None and end is not None
        now_dt = GLib.DateTime.new_now_local()
        now = now_dt.get_hour() * 60 + now_dt.get_minute()

        if enabled and in_window(now, start, end):
            self.start_focus()
        else:
            self.end_focus()

        if enabled:
            # Wake at the next start or end, whichever comes first.
            wait = min((t - now) % 1440 or 1440 for t in (start, end))
            seconds = wait * 60 - now_dt.get_second()
            self.timeout_id = GLib.timeout_add_seconds(max(1, seconds), self.on_boundary)

    def on_boundary(self):
        self.timeout_id = 0
        self.sync()
        return GLib.SOURCE_REMOVE

    def start_focus(self):
        if os.path.exists(MARKER):
            return
        if self.notifications.get_boolean('show-banners'):
            self.notifications.set_boolean('show-banners', False)
            os.makedirs(os.path.dirname(MARKER), exist_ok=True)
            open(MARKER, 'w').close()

    def end_focus(self):
        if not os.path.exists(MARKER):
            return
        self.notifications.set_boolean('show-banners', True)
        os.remove(MARKER)


def main():
    FocusSchedule()
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
