#!/bin/bash
# End scheduled focus time: turn Do Not Disturb back off, but only if
# parchaos-focus-start is the one that turned it on.
set -euo pipefail

MARKER="$HOME/.cache/parchaos-focus-active"
# leftover from the old Inhibit-based version
rm -f "$HOME/.cache/parchaos-focus-cookie"

[ -f "$MARKER" ] || exit 0
gsettings set org.gnome.desktop.notifications show-banners true
rm -f "$MARKER"
