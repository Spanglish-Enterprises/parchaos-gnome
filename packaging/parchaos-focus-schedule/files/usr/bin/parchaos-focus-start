#!/bin/bash
# Start scheduled focus time: turn on GNOME's own Do Not Disturb.
#
# GNOME Shell does not implement org.freedesktop.Notifications.Inhibit
# (that's a Plasma extension this script originally used), so the real
# GNOME mechanism is org.gnome.desktop.notifications show-banners=false --
# the same switch as the Do Not Disturb toggle in the top-bar calendar.
#
# If Do Not Disturb is already on (the user turned it on themselves), leave
# it alone and don't drop a marker, so parchaos-focus-end won't switch off
# something the user chose.
set -euo pipefail

MARKER="$HOME/.cache/parchaos-focus-active"
mkdir -p "$(dirname "$MARKER")"

if [ "$(gsettings get org.gnome.desktop.notifications show-banners)" = "true" ]; then
    gsettings set org.gnome.desktop.notifications show-banners false
    touch "$MARKER"
fi
