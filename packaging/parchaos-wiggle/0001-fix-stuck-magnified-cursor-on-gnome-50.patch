diff --git a/cursor.js b/cursor.js
index b0bb0a1..2479028 100644
--- a/cursor.js
+++ b/cursor.js
@@ -4,7 +4,8 @@ import Clutter from 'gi://Clutter';
 
 export default class Cursor {
     constructor() {
-        this._tracker = global.backend.get_cursor_tracker(global.display);
+        this._tracker = global.backend.get_cursor_tracker();
+        this._hidden = false;
     }
 
     get hot() {
@@ -22,8 +23,16 @@ export default class Cursor {
             seat.uninhibit_unfocus();
         }
 
-        this._tracker.disconnectObject(this);
-        this._tracker.set_pointer_visible(true);
+        if (!this._hidden)
+            return;
+        this._hidden = false;
+        if (this._tracker.uninhibit_cursor_visibility) {
+            // GNOME 49+: visibility is reference-counted inhibition
+            this._tracker.uninhibit_cursor_visibility();
+        } else {
+            this._tracker.disconnectObject(this);
+            this._tracker.set_pointer_visible(true);
+        }
     }
 
     hide() {
@@ -33,15 +42,25 @@ export default class Cursor {
             seat.inhibit_unfocus();
         }
 
-        this._tracker.set_pointer_visible(false);
-        this._tracker.disconnectObject(this);
-        this._tracker.connectObject(
-            'visibility-changed', () => {
-                if (this._tracker.get_pointer_visible()) {
-                    this._tracker.set_pointer_visible(false);
-                }
-            },
-            this
-        );
+        if (this._hidden)
+            return;
+        this._hidden = true;
+        if (this._tracker.inhibit_cursor_visibility) {
+            // GNOME 49+ removed set_pointer_visible(); inhibiting keeps the
+            // pointer hidden until the matching uninhibit, so the old
+            // visibility-changed workaround isn't needed.
+            this._tracker.inhibit_cursor_visibility();
+        } else {
+            this._tracker.set_pointer_visible(false);
+            this._tracker.disconnectObject(this);
+            this._tracker.connectObject(
+                'visibility-changed', () => {
+                    if (this._tracker.get_pointer_visible()) {
+                        this._tracker.set_pointer_visible(false);
+                    }
+                },
+                this
+            );
+        }
     }
 }
diff --git a/effect.js b/effect.js
