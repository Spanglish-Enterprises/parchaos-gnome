+            mode: Clutter.AnimationMode.EASE_IN_QUAD,
             scale_x: 1.0,
             scale_y: 1.0,
             pivot_point: this._pivot,
@@ -67,6 +73,7 @@ export default class Effect extends St.Icon {
         }
         this._isInTransition = true;
         this._unmagnifyDelayId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, this.unmagnifyDelay, () => {
+            this._unmagnifyDelayId = null;
             this.remove_all_transitions();
             this.ease({
                 duration: this.unmagnifyDuration,
@@ -74,23 +81,58 @@ export default class Effect extends St.Icon {
                 scale_x: 1.0 / this._ratio,
                 scale_y: 1.0 / this._ratio,
                 pivot_point: this._pivot,
-                onComplete: () => {
-                    Main.uiGroup.remove_child(this);
-                    if (this.isHidden) {
-                        this.cursor.show();
-                    }
-                    this.isWiggling = false;
-                    this._isInTransition = false;
-                },
+                // onStopped, not onComplete: an interrupted shrink never
+                // "completes", which used to leave the big cursor stuck on
+                // screen with every later unmagnify() ignored.
+                onStopped: () => this._finishUnmagnify(),
             });
-            this._unmagnifyDelayId = null;
+            // Watchdog: a transition whose actor isn't on any stage view
+            // never advances; don't let that strand the big cursor either.
+            this._watchdogId = GLib.timeout_add(GLib.PRIORITY_DEFAULT,
+                this.unmagnifyDuration + 500, () => {
+                    this._watchdogId = null;
+                    if (this._isInTransition) {
+                        this.remove_all_transitions();
+                        this._finishUnmagnify();
+                    }
+                    return GLib.SOURCE_REMOVE;
+                });
             return GLib.SOURCE_REMOVE;
         });
     }
 
-    destroy() {
+    _finishUnmagnify() {
+        if (!this._isInTransition)
+            return;
+        this._cancelUnmagnify();
+        if (this.get_parent())
+            Main.uiGroup.remove_child(this);
+        if (this.isHidden) {
+            this.cursor.show();
+        }
+        this.isWiggling = false;
+        this._isInTransition = false;
+    }
+
+    _cancelUnmagnify() {
         if (this._unmagnifyDelayId) {
             GLib.Source.remove(this._unmagnifyDelayId);
+            this._unmagnifyDelayId = null;
+        }
+        if (this._watchdogId) {
+            GLib.Source.remove(this._watchdogId);
+            this._watchdogId = null;
         }
+        this._isInTransition = false;
+    }
+
+    destroy() {
+        this._cancelUnmagnify();
+        this.remove_all_transitions();
+        if (this.get_parent())
+            Main.uiGroup.remove_child(this);
+        if (this.isWiggling && this.isHidden)
