#!/bin/bash
# parchaos-updates-check: check for COPR + Fedora updates and notify the user.
#
# Runs as a systemd user service from parchaos-updates.timer. Calls
# `dnf check-update` against the system repos (including the ParchaOS
# COPR override), and if any packages are available, sends a desktop
# notification telling the user how many and how to install them.
#
# Exit codes: 0 = no updates or notification sent, 1 = error.
#
# Original code for ParchaOS, GPL-3.0-or-later.

set -eu

export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

# Check for updates. dnf check-update exits 100 when updates are available,
# 0 when the system is up to date, and 1 on error.
output=$(dnf check-update --refresh 2>/dev/null) || {
    rc=$?
    if [ "$rc" -ne 100 ]; then
        # Error (not "updates available"). Silently exit — don't nag the
        # user about transient network/repo issues.
        exit 0
    fi
}

# Count the packages. dnf5 prints an "Upgrades" heading (and possibly
# "Obsoleting packages" etc.) above lines shaped "name.arch  version  repo";
# counting every line starting with a letter counted the heading too, so the
# notification always said one more than there were. Match the package
# lines only: unindented, with a name.arch first column.
count=$(printf '%s\n' "$output" | awk '/^[^ \t]/ && $1 ~ /\.(noarch|x86_64|aarch64|i686|src)$/ {n++} END {print n+0}')

# The menu bar's logo menu shows the count next to System Settings.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/parchaos"
mkdir -p "$cache" 2>/dev/null && printf '%s\n' "$count" > "$cache/updates-count" 2>/dev/null

if [ "$count" -eq 0 ]; then
    exit 0
fi

# Build the notification text. Installing from Parcha Store applies updates
# with a restart into an update screen and another back (more with a kernel
# update); a user who does not expect that can think the machine has crashed
# (ticket #134). Say so up front.
if [ "$count" -eq 1 ]; then
    what="1 update is"
    it="it"
else
    what="$count updates are"
    it="them"
fi
body="$what ready. Install $it from Parcha Store, or run 'sudo dnf upgrade'. "
body+="Updating from the Store restarts the computer a few times. That is normal, so let it finish."

# Send the notification. Prefer notify-send with a "See what's new" button
# (libnotify 0.7.10 and later); fall back to a plain notification.
if command -v notify-send >/dev/null 2>&1; then
    if notify-send --help 2>&1 | grep -q -- '--action'; then
        # -w waits for the button or for the banner to be dismissed. Bounded,
        # so the service never stays around for long.
        action=$(timeout 300 notify-send -w -A "whatsnew=See what's new" -u normal -a ParchaOS \
            "Software Updates" "$body" 2>/dev/null || true)
        if [ "$action" = whatsnew ] && command -v parchaos-updates-whatsnew >/dev/null 2>&1; then
            parchaos-updates-whatsnew || true
        fi
    else
        notify-send -u normal -a ParchaOS "Software Updates" "$body"
    fi
else
    # Fallback: use the session bus to show a GNOME notification.
    gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "ParchaOS" 0 "software-update-available" "Software Updates" "$body" \
        "['default', 'Run sudo dnf upgrade']" "{}" 10000 >/dev/null 2>&1 || :
fi

exit 0
