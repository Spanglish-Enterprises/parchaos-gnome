+        for (let i = icons.length - 1; i >= 0; i--) {
+            const paintable = icons[i];
+            const k = icons.length - 1 - i;
+            const ratio = paintable.get_intrinsic_aspect_ratio() || 1;
+            const w = ratio >= 1 ? card : Math.round(card * ratio);
+            const h = ratio >= 1 ? Math.round(card / ratio) : card;
+            snapshot.save();
+            snapshot.translate(new Graphene.Point({x: size / 2 + shifts[k] * size, y: size / 2 + 2}));
+            snapshot.rotate(angles[k]);
+            snapshot.translate(new Graphene.Point({x: -w / 2, y: -h / 2}));
+            paintable.snapshot(snapshot, w, h);
+            snapshot.restore();
+        }
+        const pile = snapshot.to_paintable(new Graphene.Size({width: size, height: size}));
+        this._icon.set_paintable(null);
+        this._icon.set_paintable(pile);
+    }
+
+    // Thumbnails arrive after the pile is made: redraw when a member's icon changes.
+    _watchMembers() {
+        if (this._memberSignals.length)
+            return;
+        for (const member of this._members.slice(0, 3)) {
+            if (!member._icon)
+                continue;
+            const id = member._icon.connect('notify::paintable', () => {
+                if (this._redrawId)
+                    return;
+                this._redrawId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+                    this._redrawId = 0;
+                    if (!this._destroyed)
+                        this._createStackTopIcon();
+                    return GLib.SOURCE_REMOVE;
+                });
+            });
+            this._memberSignals.push([member._icon, id]);
+        }
+    }
+
+    _onDestroy() {
+        for (const [icon, id] of this._memberSignals)
+            icon.disconnect(id);
+        this._memberSignals = [];
+        if (this._redrawId)
+            GLib.source_remove(this._redrawId);
+        this._redrawId = 0;
+        super._onDestroy?.();
     }
 
