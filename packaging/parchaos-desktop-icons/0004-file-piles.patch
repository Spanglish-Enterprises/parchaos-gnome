diff --git a/app/piles.js b/app/piles.js
new file mode 100644
index 0000000..555b865
--- /dev/null
+++ b/app/piles.js
@@ -0,0 +1,169 @@
+/* ParchaOS piles (ticket #175)
+ *
+ * Copyright (C) 2026 ParchaOS contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, version 3 of the License.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// Which pile a desktop file belongs to. DING already stacks files that share a content
+// type; ParchaOS groups them instead by what people think of as one kind (Pictures,
+// Screenshots, Recordings, Documents...), or by a date, or by Parcher's colour tag, as
+// chosen in the desktop menu (pile-by). A pile key is a plain string such as
+// "kind:pictures", "date-modified:today" or "tags:red"; pileLabel() names it.
+'use strict';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+const Gettext = imports.gettext.domain('ding');
+
+const _ = Gettext.gettext;
+
+export const MODES = ['kind', 'last-opened', 'date-added', 'date-modified', 'date-created', 'tags'];
+
+// The file time each date mode reads. "Added" has no record of its own on Linux; the
+// status-change time is updated when a file is moved, copied or saved into the folder.
+const TIME_ATTRIBUTE = {
+    'last-opened': 'time::access',
+    'date-added': 'time::changed',
+    'date-modified': 'time::modified',
+    'date-created': 'time::created',
+};
+
+const SCREENSHOT = /^(screenshot|screen shot|captura de pantalla|captura)\b/i;
+const RECORDING = /^(screencast|screen recording|grabaci[oó]n de pantalla)\b/i;
+const ARCHIVE = /(zip|tar|compressed|7z|rar|xz|gzip|bzip|zstd|lzma|cpio)/;
+const SPREADSHEET = /(spreadsheet|ms-excel|csv)/;
+const PRESENTATION = /(presentation|powerpoint)/;
+const DOCUMENT = /^(text\/|application\/(pdf|rtf|msword|vnd\.openxmlformats-officedocument\.wordprocessingml|vnd\.oasis\.opendocument\.text|epub|x-tex|json|xml))/;
+const PACKAGE = /(x-rpm|vnd\.appimage|vnd\.flatpak|x-executable|x-shellscript|x-iso9660|x-cd-image|x-raw-disk-image)/;
+
+/** The kind of a file from its content type and name: pictures, screenshots, ... */
+export function kindOf(contentType, name) {
+    const type = contentType ?? '';
+    if (type.startsWith('image/'))
+        return SCREENSHOT.test(name) ? 'screenshots' : 'pictures';
+    if (type.startsWith('video/'))
+        return RECORDING.test(name) ? 'recordings' : 'videos';
+    if (type.startsWith('audio/'))
+        return 'music';
+    if (SPREADSHEET.test(type))
+        return 'spreadsheets';
+    if (PRESENTATION.test(type))
+        return 'presentations';
+    if (ARCHIVE.test(type))
+        return 'archives';
+    if (PACKAGE.test(type))
+        return 'installers';
+    if (DOCUMENT.test(type))
+        return 'documents';
+    return 'other';
+}
+
+/** today, yesterday, week, month, year or older for a time in seconds, seen from `now`. */
+export function dateBucket(seconds, now = GLib.DateTime.new_now_local()) {
+    if (!seconds)
+        return 'none';
+    const then = GLib.DateTime.new_from_unix_local(seconds);
+    const startOfToday = GLib.DateTime.new_local(now.get_year(), now.get_month(), now.get_day_of_month(), 0, 0, 0);
+    if (then.compare(startOfToday) >= 0)
+        return 'today';
+    // Whole calendar days before today: anything yesterday is 1.
+    const days = Math.ceil(startOfToday.difference(then) / GLib.TIME_SPAN_DAY);
+    if (days === 1)
+        return 'yesterday';
+    if (days <= 7)
+        return 'week';
+    if (days <= 30)
+        return 'month';
+    if (then.get_year() === now.get_year())
+        return 'year';
+    return 'older';
+}
+
+/** The pile key of a file (its Gio.FileInfo and URI) in `mode`; `tags` maps URIs to colours. */
+export function pileKey(fileInfo, uri, mode, tags) {
+    if (mode === 'tags')
+        return `tags:${tags?.get(uri) ?? 'none'}`;
+    const attribute = TIME_ATTRIBUTE[mode];
+    if (attribute)
+        return `${mode}:${dateBucket(fileInfo.get_attribute_uint64(attribute))}`;
+    return `kind:${kindOf(fileInfo.get_content_type(), fileInfo.get_display_name())}`;
+}
+
+// Labels, and the order piles are shown in.
+const LABELS = {
+    'pictures': () => _('Pictures'),
+    'screenshots': () => _('Screenshots'),
+    'recordings': () => _('Screen Recordings'),
+    'videos': () => _('Videos'),
+    'music': () => _('Music'),
+    'documents': () => _('Documents'),
+    'spreadsheets': () => _('Spreadsheets'),
+    'presentations': () => _('Presentations'),
+    'archives': () => _('Archives'),
+    'installers': () => _('Installers and Disk Images'),
+    'other': () => _('Other Files'),
+    'today': () => _('Today'),
+    'yesterday': () => _('Yesterday'),
+    'week': () => _('Previous 7 Days'),
+    'month': () => _('Previous 30 Days'),
+    'year': () => _('Earlier This Year'),
+    'older': () => _('Older'),
+    'none': () => _('No Date'),
+};
+const TAG_LABELS = {
+    'red': () => _('Red'), 'orange': () => _('Orange'), 'yellow': () => _('Yellow'),
+    'green': () => _('Green'), 'blue': () => _('Blue'), 'purple': () => _('Purple'),
+    'grey': () => _('Grey'), 'gray': () => _('Grey'), 'none': () => _('No Tag'),
+};
+const ORDER = [...Object.keys(LABELS), ...Object.keys(TAG_LABELS)];
+
+export function pileLabel(key) {
+    const [mode, value] = key.split(':');
+    const label = mode === 'tags' ? TAG_LABELS[value] : LABELS[value];
+    return label ? label() : value;
+}
+
+/** Sorts pile keys in reading order (Pictures before Documents, Today before Older). */
+export function compareKeys(a, b) {
+    const ia = ORDER.indexOf(a.split(':')[1]), ib = ORDER.indexOf(b.split(':')[1]);
+    return (ia < 0 ? ORDER.length : ia) - (ib < 0 ? ORDER.length : ib) || a.localeCompare(b);
+}
+
+/** Parcher's colour tags (uri -> colour), from its store, kept up to date. */
+export class TagStore {
+    constructor(onChanged) {
+        this.tags = new Map();
+        this._file = Gio.File.new_for_path(GLib.build_filenamev([GLib.get_user_data_dir(), 'nautilus', 'folder-colors.conf']));
+        this._load();
+        try {
+            this._monitor = this._file.monitor_file(Gio.FileMonitorFlags.NONE, null);
+            this._monitor.connect('changed', () => {
+                this._load();
+                onChanged?.();
+            });
+        } catch (e) {
+            this._monitor = null;
+        }
+    }
+
+    _load() {
+        this.tags.clear();
+        const keyfile = new GLib.KeyFile();
+        try {
+            keyfile.load_from_file(this._file.get_path(), GLib.KeyFileFlags.NONE);
+            const [keys] = keyfile.get_keys('FolderColors');
+            for (const uri of keys)
+                this.tags.set(uri, keyfile.get_string('FolderColors', uri));
+        } catch (e) {
+            // no tags yet
+        }
+    }
+
+    destroy() {
+        this._monitor?.cancel();
+        this._monitor = null;
+    }
+}
