+/**
+ * Hover magnification scales the icon actor up to the magnification factor.
+ * Scaling a texture rendered at the resting size makes it visibly pixelated,
+ * so render the texture at the magnified size and fit it back into the
+ * resting size: crisp at rest (downscaled) and at full magnification.
+ *
+ * @param {St.Icon} icon the icon actor created for the dock
+ * @param {number} size the resting icon size in logical pixels
+ * @returns {St.Icon} the same icon
+ */
+export function renderForMagnification(icon, size) {
+    const settings = Docking.DockManager.settings;
+    const factor = settings.dockMagnification
+        ? Math.max(1, settings.magnificationSizeFactor || 1) : 1;
+    if (factor > 1 && icon instanceof St.Icon && size > 0) {
+        icon.icon_size = Math.ceil(size * factor);
+        icon.set_size(size, size);
+    }
+    return icon;
+}
