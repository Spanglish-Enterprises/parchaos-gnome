#: extension.js:34
msgid "Spanish"
msgstr "español"

#: extension.js:34
msgid "English"
msgstr "inglés"

#: extension.js:65
msgid "Translate"
msgstr "Traducir"

#: extension.js:65
msgid "Select some text first, then press the shortcut."
msgstr "Primero selecciona un texto y luego pulsa el atajo."

#: extension.js:76
msgid "Translating…"
msgstr "Traduciendo…"

#: extension.js:97
msgid "Could not translate this text."
msgstr "No se pudo traducir este texto."

#: extension.js:195
#, javascript-format
msgid "%s → %s"
msgstr "%s → %s"

#. Translators: for when the language was guessed wrong, e.g. "Translate from Spanish instead".
#: extension.js:201
#, javascript-format
msgid "Translate from %s instead"
msgstr "Traducir desde %s"

#: extension.js:215
msgid "Copy"
msgstr "Copiar"

#: extension.js:217
msgid "Copied"
msgstr "Copiado"

#: extension.js:224
msgid "Translated on this computer"
msgstr "Traducido en esta computadora"

#: extension.js:235
msgid "Set Up Translation"
msgstr "Configurar la traducción"

#: extension.js:237
msgid ""
"Translation between English and Spanish runs on this computer, so nothing "
"you translate is sent anywhere. It needs a one-time download of about 230 MB."
msgstr "La traducción entre inglés y español se hace en esta computadora, así que nada de lo que traduzcas se envía a ningún sitio. Necesita una descarga única de unos 230 MB."

#: extension.js:239
msgid "You will be asked for your password to add the translation engine."
msgstr "Se te pedirá la contraseña para añadir el motor de traducción."

#: extension.js:243
msgid "Not Now"
msgstr "Ahora no"

#: extension.js:244
msgid "Set Up"
msgstr "Configurar"

#: extension.js:251
msgid "Getting ready…"
msgstr "Preparando…"

#: extension.js:271
msgid "Adding the translation engine…"
msgstr "Añadiendo el motor de traducción…"

#: extension.js:273
msgid "Downloading the translation models…"
msgstr "Descargando los modelos de traducción…"

#. Translators: download progress, e.g. "Downloading… 42%"
#: extension.js:276
#, javascript-format
msgid "Downloading… %d%%"
msgstr "Descargando… %d%%"

#: extension.js:287
msgid "The translation engine was not added. Press the shortcut to try again."
msgstr "No se añadió el motor de traducción. Pulsa el atajo para volver a intentarlo."

#: extension.js:289
msgid ""
"The download did not finish. Check the internet connection and press the "
"shortcut to try again."
msgstr "La descarga no terminó. Comprueba la conexión a internet y pulsa el atajo para volver a intentarlo."