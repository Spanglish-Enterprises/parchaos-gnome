#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# parchaos-lookup-ocr IMAGE: print the text in a picture of part of the screen
# (Screen Lookup, ticket #180).
#
# Tesseract (Apache-2.0, with its Apache-licensed English and Spanish data) reads
# it on this computer. Screen text is small for OCR, so the picture is enlarged
# first; the text is printed with tidy line breaks, or nothing if there is none.
#
# Original code for ParchaOS, GPL-3.0-or-later.

import os
import re
import subprocess
import sys
import tempfile

TESSERACT = os.environ.get('PARCHAOS_TESSERACT', 'tesseract')
MAX_SIDE = 4000          # px after enlarging; Tesseract slows down past this
TARGET_HEIGHT = 1200     # small selections are enlarged towards this


def languages():
    """English plus Spanish when its data is installed."""
    try:
        out = subprocess.run([TESSERACT, '--list-langs'], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return 'eng'
    have = set(out.split())
    return '+'.join(lang for lang in ('eng', 'spa') if lang in have) or 'eng'


def scale_for(width, height):
    """How much to enlarge a width x height picture (1 to 4)."""
    factor = max(1.0, min(4.0, TARGET_HEIGHT / max(1, height)))
    return min(factor, MAX_SIDE / max(1, width, height)) if max(width, height) * factor > MAX_SIDE else factor


def enlarge(path, out):
    """Write an enlarged copy of `path` to `out`; returns False if it cannot be read."""
    import gi
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import GdkPixbuf
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
    except Exception:
        return False
    factor = scale_for(pixbuf.get_width(), pixbuf.get_height())
    if factor > 1.01:
        pixbuf = pixbuf.scale_simple(round(pixbuf.get_width() * factor), round(pixbuf.get_height() * factor),
                                     GdkPixbuf.InterpType.BILINEAR)
    pixbuf.savev(out, 'png', [], [])
    return True


def tidy(text):
    """Trim each line, drop page breaks and stray noise, keep paragraph breaks."""
    lines = [line.strip() for line in text.replace('\f', '\n').splitlines()]
    # A line that is only punctuation is usually a misread border or icon.
    lines = ['' if re.fullmatch(r'[\W_]{1,3}', line) else line for line in lines]
    return re.sub(r'\n{3,}', '\n\n', '\n'.join(lines)).strip()


def main(argv):
    if len(argv) != 2:
        print('usage: parchaos-lookup-ocr IMAGE', file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory(prefix='parchaos-lookup-') as tmp:
        big = os.path.join(tmp, 'area.png')
        source = big if enlarge(argv[1], big) else argv[1]
        try:
            result = subprocess.run([TESSERACT, source, 'stdout', '-l', languages()],
                                    capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as err:
            print(f'parchaos-lookup-ocr: {err}', file=sys.stderr)
            return 1
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        return 1
    print(tidy(result.stdout))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
