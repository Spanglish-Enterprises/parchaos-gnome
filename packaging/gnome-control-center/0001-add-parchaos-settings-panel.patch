diff --git a/panels/parchaos/cc-parchaos-panel.c b/panels/parchaos/cc-parchaos-panel.c
new file mode 100644
index 0000000..c54081b
--- /dev/null
+++ b/panels/parchaos/cc-parchaos-panel.c
@@ -0,0 +1,76 @@
+/* cc-parchaos-panel.c
+ *
+ * Settings sidebar entry for ParchaOS. ParchaOS keeps its own preferences
+ * (keyboard style, appearance style, ...) in a separate app, ParchaOS
+ * Settings, so this panel explains that and opens it. Keeping the patch
+ * to Settings this small is what lets it carry across GNOME releases.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <gio/gdesktopappinfo.h>
+
+#include "cc-parchaos-panel.h"
+
+#define PARCHAOS_SETTINGS_DESKTOP "org.parchaos.Settings.desktop"
+
+struct _CcParchaosPanel
+{
+  CcPanel    parent_instance;
+
+  GtkWidget *open_button;
+};
+
+G_DEFINE_TYPE (CcParchaosPanel, cc_parchaos_panel, CC_TYPE_PANEL)
+
+static void
+open_parchaos_settings (CcParchaosPanel *self)
+{
+  g_autoptr(GDesktopAppInfo) info = g_desktop_app_info_new (PARCHAOS_SETTINGS_DESKTOP);
+  g_autoptr(GAppLaunchContext) context = NULL;
+  g_autoptr(GError) error = NULL;
+
+  if (info == NULL)
+    return;
+
+  context = G_APP_LAUNCH_CONTEXT (gdk_display_get_app_launch_context (gtk_widget_get_display (GTK_WIDGET (self))));
+  if (!g_app_info_launch (G_APP_INFO (info), NULL, context, &error))
+    g_warning ("Could not open ParchaOS Settings: %s", error->message);
+}
+
+static void
+cc_parchaos_panel_class_init (CcParchaosPanelClass *klass)
+{
+}
+
+static void
+cc_parchaos_panel_init (CcParchaosPanel *self)
+{
+  g_autoptr(GDesktopAppInfo) info = g_desktop_app_info_new (PARCHAOS_SETTINGS_DESKTOP);
+  GtkWidget *toolbar_view;
+  GtkWidget *status;
+
+  adw_navigation_page_set_title (ADW_NAVIGATION_PAGE (self), "ParchaOS");
+
+  toolbar_view = adw_toolbar_view_new ();
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar_view), adw_header_bar_new ());
+
+  status = adw_status_page_new ();
+  adw_status_page_set_icon_name (ADW_STATUS_PAGE (status), "org.gnome.Settings-parchaos-symbolic");
+  adw_status_page_set_title (ADW_STATUS_PAGE (status), "ParchaOS");
+  adw_status_page_set_description (ADW_STATUS_PAGE (status),
+                                   info != NULL
+                                   ? "Settings made for ParchaOS, like how the Super key works, are in ParchaOS Settings."
+                                   : "ParchaOS Settings isn't installed.");
+
+  self->open_button = gtk_button_new_with_label ("Open ParchaOS Settings");
+  gtk_widget_set_halign (self->open_button, GTK_ALIGN_CENTER);
+  gtk_widget_add_css_class (self->open_button, "pill");
+  gtk_widget_add_css_class (self->open_button, "suggested-action");
+  gtk_widget_set_sensitive (self->open_button, info != NULL);
+  g_signal_connect_swapped (self->open_button, "clicked", G_CALLBACK (open_parchaos_settings), self);
+  adw_status_page_set_child (ADW_STATUS_PAGE (status), self->open_button);
+
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar_view), status);
+  adw_navigation_page_set_child (ADW_NAVIGATION_PAGE (self), toolbar_view);
+}
