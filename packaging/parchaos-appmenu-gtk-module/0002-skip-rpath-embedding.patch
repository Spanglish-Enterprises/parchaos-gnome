diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1a2b3c4..5d6e7f8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,14 @@
 
 project(appmenu-gtk-module-wayland)
 
+# Otherwise the built .so embeds an absolute build-tree RPATH
+# (pointing at .../redhat-linux-build/libdbusmenu), which real-world
+# rpmbuild's check-rpaths QA check correctly rejects as a packaging
+# bug -- everything this links against (glib, gtk3, the statically
+# linked dbusmenu-gtk) resolves fine via standard system library
+# paths, no custom runtime search path is actually needed.
+set(CMAKE_SKIP_RPATH TRUE)
+
 find_package(PkgConfig REQUIRED)
 pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0)
 
